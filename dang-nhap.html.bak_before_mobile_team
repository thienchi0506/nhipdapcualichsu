    <!-- ============================================================ -->
    <!--  FIREBASE SDK v9 (Modular) qua CDN                           -->
    <!--  Sử dụng bản "compat" để chạy trực tiếp trong trình duyệt    -->
    <!--  mà không cần bundler (Webpack/Vite).                         -->
    <!-- ============================================================ -->
    <script type="module">

        // ===================================================
        //  IMPORT FIREBASE MODULES (v9 Modular qua CDN)
        // ===================================================
        import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
        import {
            getAuth,
            signInWithPopup,
            GoogleAuthProvider,
            createUserWithEmailAndPassword,
            signInWithEmailAndPassword
        } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';


        // ===================================================
        //  CẤU HÌNH FIREBASE
        //  👉👉👉 DÁN FIREBASE CONFIG CỦA BẠN VÀO ĐÂY 👈👈👈
        //
        //  Hướng dẫn:
        //  1. Vào Firebase Console (https://console.firebase.google.com)
        //  2. Chọn Project → Project Settings → General
        //  3. Kéo xuống "Your apps" → chọn Web app (</>)
        //  4. Copy đoạn firebaseConfig và dán thay thế bên dưới
        // ===================================================
        const firebaseConfig = window.__FIREBASE_CONFIG__ || {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_PROJECT.firebaseapp.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT.appspot.com",
            messagingSenderId: "YOUR_SENDER_ID",
            appId: "YOUR_APP_ID"
        };

        const hasRealFirebaseConfig = !Object.values(firebaseConfig).some(function(value) {
            return typeof value === 'string' && value.includes('YOUR_');
        });

        let app = null;
        let auth = null;
        let googleProvider = null;

        if (hasRealFirebaseConfig) {
            app = initializeApp(firebaseConfig);
            auth = getAuth(app);
            googleProvider = new GoogleAuthProvider();
        } else {
            console.warn('Firebase chưa được cấu hình với project thật. Hãy thay giá trị trong firebaseConfig hoặc window.__FIREBASE_CONFIG__.');
        }


        // ===================================================
        //  HÀM TIỆN ÍCH: Hiển thị thông báo
        // ===================================================

        /**
         * Hiển thị thông báo lỗi hoặc thành công trên giao diện.
         * @param {string} noiDung - Nội dung thông báo
         * @param {string} loai   - 'error' hoặc 'success'
         */
        function hienThongBao(noiDung, loai = 'error') {
            const box = document.getElementById('message-box');
            box.textContent = noiDung;
            box.className = 'message-box ' + loai;
        }

        /**
         * Chuyển mã lỗi Firebase sang thông báo tiếng Việt dễ hiểu.
         * @param {string} errorCode - Mã lỗi từ Firebase
         * @returns {string} Thông báo tiếng Việt
         */
        function dịchLỗi(errorCode) {
            const bangLoi = {
                'auth/email-already-in-use':     '⚠️ Email này đã được ghi danh! Hãy đăng nhập.',
                'auth/invalid-email':            '⚠️ Định dạng email không hợp lệ.',
                'auth/weak-password':            '⚠️ Mật lệnh quá yếu! Cần ít nhất 6 ký tự.',
                'auth/user-not-found':           '⚠️ Không tìm thấy tướng quân nào với email này.',
                'auth/wrong-password':           '⚠️ Sai mật lệnh! Hãy thử lại.',
                'auth/invalid-credential':       '⚠️ Thông tin đăng nhập không chính xác.',
                'auth/too-many-requests':        '⚠️ Quá nhiều lần thử! Hãy đợi một lát.',
                'auth/popup-closed-by-user':     '⚠️ Cửa sổ đăng nhập Google đã bị đóng.',
                'auth/network-request-failed':   '⚠️ Lỗi mạng! Kiểm tra kết nối internet.',
                'auth/popup-blocked':            '⚠️ Trình duyệt chặn popup. Cho phép popup và thử lại.'
            };
            return bangLoi[errorCode] || ('⚠️ Có lỗi xảy ra: ' + errorCode);
        }

        /**
         * Lưu tên người dùng và chuyển hướng sang sảnh game.
         * @param {object} user - Đối tượng user từ Firebase Auth
         */
        function luuVaChuyenHuong(user) {
            // Lấy tên hiển thị: ưu tiên displayName, nếu không có thì lấy phần đầu email
            const tenHienThi = user.displayName || user.email.split('@')[0];

            // Lưu vào localStorage để các trang khác sử dụng
            localStorage.setItem('tenNguoiDung', tenHienThi);
            localStorage.setItem('emailNguoiDung', user.email);
            localStorage.setItem('uidNguoiDung', user.uid);

            hienThongBao('✅ Báo danh thành công! Đang kích hoạt cổng thành...', 'success');

            // Kích hoạt video chuyển cảnh điện ảnh vào Sảnh chính
            setTimeout(function() {
                if (typeof window.kichHoatChuyenCanhVideo === 'function') {
                    window.kichHoatChuyenCanhVideo('trang-chinh.html');
                } else {
                    window.location.href = 'trang-chinh.html';
                }
            }, 600);
        }


        // ===================================================
        //  XỬ LÝ ĐĂNG NHẬP BẰNG EMAIL & MẬT KHẨU
        // ===================================================

        /**
         * Xử lý khi người dùng bấm nút "Đăng Nhập".
         * Gọi signInWithEmailAndPassword từ Firebase Auth.
         */
        window.xuLyDangNhap = async function(event) {
            event.preventDefault(); // Ngăn form submit mặc định

            if (!auth) {
                hienThongBao('⚠️ Firebase chưa được cấu hình với project thật. Hãy cập nhật cấu hình Firebase trước khi đăng nhập.', 'error');
                return;
            }

            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;
            const btnDangNhap = document.getElementById('btn-dang-nhap');

            // Hiển thị trạng thái loading
            btnDangNhap.classList.add('loading');
            btnDangNhap.textContent = 'Đang xác thực...';

            try {
                const userCredential = await signInWithEmailAndPassword(auth, email, password);
                luuVaChuyenHuong(userCredential.user);
            } catch (error) {
                console.error('Lỗi đăng nhập:', error);
                hienThongBao(dịchLỗi(error.code));
            } finally {
                btnDangNhap.classList.remove('loading');
                btnDangNhap.textContent = '⚔️ ĐĂNG NHẬP';
            }
        };


        // ===================================================
        //  XỬ LÝ ĐĂNG KÝ (GHI DANH) BẰNG EMAIL & MẬT KHẨU
        // ===================================================

        /**
         * Xử lý khi người dùng bấm nút "Ghi Danh".
         * Kiểm tra mật khẩu khớp nhau, rồi gọi createUserWithEmailAndPassword.
         */
        window.xuLyDangKy = async function(event) {
            event.preventDefault();

            if (!auth) {
                hienThongBao('⚠️ Firebase chưa được cấu hình với project thật. Hãy cập nhật cấu hình Firebase trước khi ghi danh.', 'error');
                return;
            }

            const email = document.getElementById('reg-email').value.trim();
            const password = document.getElementById('reg-password').value;
            const confirmPassword = document.getElementById('reg-password-confirm').value;
            const btnDangKy = document.getElementById('btn-dang-ky');

            // Kiểm tra mật khẩu khớp nhau
            if (password !== confirmPassword) {
                hienThongBao('⚠️ Mật lệnh xác nhận không khớp! Hãy kiểm tra lại.');
                return;
            }

            // Kiểm tra độ dài mật khẩu
            if (password.length < 6) {
                hienThongBao('⚠️ Mật lệnh phải có ít nhất 6 ký tự!');
                return;
            }

            // Hiển thị trạng thái loading
            btnDangKy.classList.add('loading');
            btnDangKy.textContent = 'Đang ghi danh...';

            try {
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                luuVaChuyenHuong(userCredential.user);
            } catch (error) {
                console.error('Lỗi đăng ký:', error);
                hienThongBao(dịchLỗi(error.code));
            } finally {
                btnDangKy.classList.remove('loading');
                btnDangKy.textContent = '📜 GHI DANH';
            }
        };


        // ===================================================
        //  XỬ LÝ ĐĂNG NHẬP BẰNG GOOGLE
        // ===================================================

        /**
         * Xử lý khi người dùng bấm nút "Đăng nhập bằng Google".
         * Mở popup Google Sign-In.
         */
        window.dangNhapGoogle = async function() {
            const btnGoogle = document.getElementById('btn-google');

            if (!auth || !googleProvider) {
                hienThongBao('⚠️ Firebase chưa được cấu hình với project thật. Hãy cập nhật cấu hình Firebase trước khi dùng Google Sign-In.', 'error');
                return;
            }

            // Hiển thị trạng thái loading
            btnGoogle.classList.add('loading');

            try {
                const result = await signInWithPopup(auth, googleProvider);
                luuVaChuyenHuong(result.user);
            } catch (error) {
                console.error('Lỗi đăng nhập Google:', error);
                hienThongBao(dịchLỗi(error.code));
            } finally {
                btnGoogle.classList.remove('loading');
            }
        };

    </script>


    <!-- ============================================================ -->
    <!--  JAVASCRIPT KHÔNG LIÊN QUAN FIREBASE                          -->
    <!--  (Chuyển tab, hiệu ứng ngôi sao - không cần type="module")   -->
    <!-- ============================================================ -->
    <script>

        // ===================================================
        //  CHUYỂN ĐỔI TAB (Đăng Nhập ↔ Ghi Danh)
        // ===================================================

        /**
         * Chuyển đổi giữa tab Đăng Nhập và Ghi Danh.
         * Sử dụng class .active để điều khiển hiển thị & hiệu ứng CSS.
         * @param {string} tabId - ID của tab cần hiển thị ('dang-nhap' hoặc 'dang-ky')
         */
        function chuyenTab(tabId) {
            // Xóa class active khỏi tất cả tab button
            document.querySelectorAll('.tab-btn').forEach(function(btn) {
                btn.classList.remove('active');
            });

            // Ẩn tất cả nội dung tab
            document.querySelectorAll('.tab-content').forEach(function(content) {
                content.classList.remove('active');
            });

            // Kích hoạt tab được chọn
            document.querySelector('[data-tab="' + tabId + '"]').classList.add('active');
            document.getElementById('tab-' + tabId).classList.add('active');

            // Xóa thông báo cũ khi chuyển tab
            document.getElementById('message-box').textContent = '';
            document.getElementById('message-box').className = 'message-box';
        }

        // ===================================================
        //  HIỆU ỨNG NGÔI SAO LẤP LÁNH (trang trí nền trời)
        // ===================================================

        /**
         * Tạo các "ngôi sao" nhỏ lấp lánh trên nền tối
         * để tăng thêm cảm giác "cổng thành ban đêm".
         */
        document.addEventListener('DOMContentLoaded', function() {
            const starsContainer = document.getElementById('stars-container');
            const soNgoiSao = 50; // Số lượng ngôi sao

            for (let i = 0; i < soNgoiSao; i++) {
                const star = document.createElement('div');
                star.className = 'star';

                // Vị trí ngẫu nhiên
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';

                // Kích thước ngẫu nhiên (1px - 3px)
                const size = Math.random() * 2 + 1;
                star.style.width = size + 'px';
                star.style.height = size + 'px';

                // Độ trễ animation ngẫu nhiên (để các sao lấp lánh không đồng bộ)
                star.style.animationDelay = Math.random() * 3 + 's';
                star.style.animationDuration = (Math.random() * 2 + 2) + 's';

                starsContainer.appendChild(star);
            }
        });

        // ==========================================================================
        //  HỆ THỐNG VIDEO CHUYỂN CẢNH (MỖI LẦN CLICK 1 VIDEO KHÁC NHAU)
        // ==========================================================================

        const DANH_SACH_VIDEO = [
            {
                src: 'video1.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4',
                tieuDe: 'Chiến Thắng Điện Biên Phủ (1954)',
                moTa: 'Lừng lẫy năm châu, chấn động địa cầu — Đập tan tập đoàn cứ điểm bất khả xâm phạm.'
            },
            {
                src: 'video2.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4',
                tieuDe: 'Bạch Đằng Giang Dậy Sóng (938)',
                moTa: 'Cọc gỗ chôn ngầm theo dòng thủy triều, Ngô Quyền đập tan giặc Nam Hán mở nền độc lập.'
            },
            {
                src: 'video3.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/WeAreGoingOnBullrun.mp4',
                tieuDe: 'Hào Khí Thăng Long — Ngàn Năm Văn Hiến',
                moTa: 'Bốn ngàn năm lịch sử hào hùng — Dấu chân tiền nhân dựng nước và giữ nước trường tồn.'
            }
        ];

        const CHE_DO_CHON_VIDEO = 'xoay_vong'; // 'xoay_vong' hoặc 'ngau_nhien'
        var trangDichMacDinh = 'trang-chinh.html';
        var videoDaKetThuc = false;
        var videoElement = null;

        function layVideoTiepTheo() {
            if (!DANH_SACH_VIDEO || DANH_SACH_VIDEO.length === 0) return null;
            if (DANH_SACH_VIDEO.length === 1) return DANH_SACH_VIDEO[0];

            var lastIndex = parseInt(sessionStorage.getItem('lichSuVideoIndex'), 10);
            if (isNaN(lastIndex)) lastIndex = -1;

            var newIndex;
            if (CHE_DO_CHON_VIDEO === 'xoay_vong') {
                newIndex = (lastIndex + 1) % DANH_SACH_VIDEO.length;
            } else {
                do {
                    newIndex = Math.floor(Math.random() * DANH_SACH_VIDEO.length);
                } while (newIndex === lastIndex);
            }

            sessionStorage.setItem('lichSuVideoIndex', newIndex);
            return DANH_SACH_VIDEO[newIndex];
        }

        window.toggleAmThanhVideo = function(event) {
            if (event) event.stopPropagation();
            if (!videoElement) return;

            var btnText = document.getElementById('trans-audio-text');
            if (videoElement.muted) {
                videoElement.muted = false;
                if (btnText) btnText.textContent = 'Tắt tiếng';
            } else {
                videoElement.muted = true;
                if (btnText) btnText.textContent = 'Bật tiếng';
            }
        };

        window.ketThucChuyenCanh = function(event) {
            if (event) event.stopPropagation();
            if (videoDaKetThuc) return;
            videoDaKetThuc = true;

            if (videoElement) {
                videoElement.pause();
            }

            var transition = document.getElementById('page-transition');
            if (transition) {
                transition.style.transition = 'opacity 0.5s ease';
                transition.style.opacity = '0';
            }

            setTimeout(function() {
                window.location.href = trangDichMacDinh;
            }, 500);
        };

        window.kichHoatChuyenCanhVideo = function(urlDich) {
            if (urlDich) trangDichMacDinh = urlDich;
            videoDaKetThuc = false;

            var transition = document.getElementById('page-transition');
            videoElement = document.getElementById('transition-video');
            var progressBar = document.getElementById('trans-progress');
            var titleEl = document.getElementById('trans-title');
            var descEl = document.getElementById('trans-desc');
            var fallback = document.getElementById('trans-fallback');

            var currentVideo = layVideoTiepTheo();
            if (!currentVideo) {
                window.location.href = trangDichMacDinh;
                return;
            }

            if (titleEl) titleEl.textContent = currentVideo.tieuDe || 'Cổng Thành Lịch Sử';
            if (descEl) descEl.textContent = currentVideo.moTa || 'Đang mở cổng thành...';
            if (progressBar) progressBar.style.width = '0%';
            if (fallback) fallback.classList.remove('active');

            transition.classList.add('active');
            transition.style.opacity = '1';

            var daThuFallback = false;

            function hienFallbackVaChuyenTrang() {
                if (fallback) fallback.classList.add('active');
                setTimeout(function() {
                    window.ketThucChuyenCanh();
                }, 2000);
            }

            videoElement.onerror = function() {
                console.warn('Lỗi tải video nội bộ, chuyển sang dự phòng');
                if (!daThuFallback && currentVideo.fallbackSrc && videoElement.src !== currentVideo.fallbackSrc) {
                    daThuFallback = true;
                    videoElement.src = currentVideo.fallbackSrc;
                    videoElement.load();
                    videoElement.play().catch(function() {
                        hienFallbackVaChuyenTrang();
                    });
                } else {
                    hienFallbackVaChuyenTrang();
                }
            };

            videoElement.ontimeupdate = function() {
                if (videoElement.duration && progressBar) {
                    var phanTram = (videoElement.currentTime / videoElement.duration) * 100;
                    progressBar.style.width = phanTram + '%';
                }
            };

            videoElement.onended = function() {
                window.ketThucChuyenCanh();
            };

            videoElement.src = currentVideo.src;
            videoElement.muted = true;
            videoElement.load();

            var playPromise = videoElement.play();
            if (playPromise !== undefined) {
                playPromise.catch(function(err) {
                    console.warn('Autoplay bị chặn hoặc lỗi:', err);
                    if (currentVideo.fallbackSrc && !daThuFallback) {
                        daThuFallback = true;
                        videoElement.src = currentVideo.fallbackSrc;
                        videoElement.load();
                        videoElement.play().catch(function() {
                            hienFallbackVaChuyenTrang();
                        });
                    } else {
                        hienFallbackVaChuyenTrang();
                    }
                });
            }

            setTimeout(function() {
                if (!videoDaKetThuc) {
                    window.ketThucChuyenCanh();
                }
            }, 15000);
        };

    </script>

