<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đại Việt Hùng Ca - Báo Danh Nhập Ngũ</title>

    <!-- ======================================================== -->
    <!--  FONT CHỮ: Noto Serif & Playfair Display từ Google Fonts  -->
    <!-- ======================================================== -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">

    <style>
        /* ====================================================== */
        /*  PHẦN 1: RESET & BIẾN MÀU - CHỦ ĐỀ CỔNG THÀNH ĐÊM    */
        /* ====================================================== */

        :root {
            /* --- Bảng màu Cổng thành ban đêm --- */
            --mau-nen-toi:       #1E1815;   /* Nền tối tĩnh mịch     */
            --mau-go-sam:        #2C1E18;   /* Gỗ sẫm (khung form)   */
            --mau-go-nhat:       #3D2B22;   /* Gỗ nhạt hơn           */
            --mau-vang-dong:     #D4AF37;   /* Vàng đồng cao quý     */
            --mau-vang-hover:    #E8C84A;   /* Vàng sáng khi hover   */
            --mau-do-sam:        #7B1E1E;   /* Đỏ sẫm (nút bấm)     */
            --mau-do-hover:      #9B3030;   /* Đỏ sáng lên khi hover */
            --mau-loi:           #FF6B6B;   /* Màu thông báo lỗi     */
            --mau-thanh-cong:    #4ECB71;   /* Màu thành công         */
            --mau-chu-sang:      #E8D5B0;   /* Chữ sáng trên nền tối */
        }

        /* --- Reset mặc định --- */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Noto Serif', 'Times New Roman', serif;
            color: var(--mau-chu-sang);
            line-height: 1.6;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow-x: hidden;

            /* ======================================================
               ẢNH NỀN CỔNG THÀNH BAN ĐÊM:
               👉 Thay 'cong-thanh.jpg' bằng tên file ảnh của bạn.
               - Lớp overlay gradient đen phủ lên để chữ dễ đọc.
               - Nếu chưa có ảnh, nền tối gradient sẽ hiển thị.
            ====================================================== */
            background:
                /* Lớp overlay gradient tối */
                linear-gradient(
                    180deg,
                    rgba(30, 24, 21, 0.85) 0%,
                    rgba(30, 24, 21, 0.70) 40%,
                    rgba(30, 24, 21, 0.90) 100%
                ),
                /* Ảnh nền cổng thành */
                url('anh-nen.jpg') center/cover no-repeat fixed;

            /* Màu nền dự phòng nếu chưa có ảnh */
            background-color: var(--mau-nen-toi);
        }


        /* ====================================================== */
        /*  PHẦN 2: KHUNG CHỨA CHÍNH (CONTAINER)                   */
        /* ====================================================== */

        .container {
            width: 100%;
            max-width: 460px;
            padding: 20px;
            animation: fadeSlideUp 0.8s ease-out; /* Hiệu ứng xuất hiện */
        }

        /* Hiệu ứng xuất hiện ban đầu */
        @keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* ====================================================== */
        /*  PHẦN 3: TIÊU ĐỀ TRANG                                 */
        /* ====================================================== */

        .page-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .page-title__main {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.5rem, 5vw, 2.2rem);
            font-weight: 900;
            color: var(--mau-vang-dong);
            letter-spacing: 3px;
            text-shadow: 2px 3px 6px rgba(0,0,0,0.6);
            line-height: 1.3;
        }

        .page-title__sub {
            font-size: 0.9rem;
            color: #B8A88A;
            margin-top: 8px;
            font-style: italic;
        }

        .page-title__divider {
            display: inline-block;
            width: 60px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--mau-vang-dong), transparent);
            margin-top: 12px;
        }


        /* ====================================================== */
        /*  PHẦN 4: KHUNG FORM - BẢNG GỖ SẪM                      */
        /* ====================================================== */

        .form-box {
            background: var(--mau-go-sam);
            border: 2px solid var(--mau-vang-dong);
            border-radius: 12px;
            padding: 30px 28px;

            /* Bóng đổ 3D để form nổi bật như bảng gỗ */
            box-shadow:
                0 8px 32px rgba(0, 0, 0, 0.5),
                0 2px 8px rgba(212, 175, 55, 0.15),
                inset 0 1px 0 rgba(212, 175, 55, 0.1);
        }


        /* ====================================================== */
        /*  PHẦN 5: TAB CHUYỂN ĐỔI (Đăng Nhập / Ghi Danh)         */
        /* ====================================================== */

        .tabs {
            display: flex;
            border-bottom: 2px solid rgba(212, 175, 55, 0.3);
            margin-bottom: 25px;
        }

        .tab-btn {
            flex: 1;
            padding: 12px 0;
            background: none;
            border: none;
            font-family: 'Noto Serif', serif;
            font-size: 1rem;
            font-weight: 700;
            color: #8A7A66;
            cursor: pointer;
            position: relative;
            transition: color 0.3s ease;
            letter-spacing: 0.5px;
        }

        /* Tab đang được chọn (active) */
        .tab-btn.active {
            color: var(--mau-vang-dong);
        }

        /* Thanh vàng đồng dưới tab active - chuyển động mượt mà */
        .tab-btn::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            width: 0;
            height: 2px;
            background: var(--mau-vang-dong);
            transition: all 0.35s ease;
            transform: translateX(-50%);
        }

        .tab-btn.active::after {
            width: 100%;
        }

        .tab-btn:hover {
            color: var(--mau-vang-dong);
        }


        /* ====================================================== */
        /*  PHẦN 6: NỘI DUNG TAB (Form Đăng nhập & Đăng ký)       */
        /* ====================================================== */

        .tab-content {
            display: none;                  /* Ẩn mặc định         */
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .tab-content.active {
            display: block;                 /* Hiện tab đang chọn  */
            opacity: 1;
            transform: translateY(0);
        }


        /* ====================================================== */
        /*  PHẦN 7: TRƯỜNG NHẬP LIỆU (INPUT)                       */
        /* ====================================================== */

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: #B8A88A;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.05);
            border: none;
            border-bottom: 2px solid rgba(212, 175, 55, 0.4);
            border-radius: 4px;
            color: var(--mau-chu-sang);
            font-family: 'Noto Serif', serif;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            outline: none;
        }

        .form-group input::placeholder {
            color: #6A5A48;
            font-style: italic;
        }

        /* Hiệu ứng focus: viền dưới sáng vàng đồng */
        .form-group input:focus {
            border-bottom-color: var(--mau-vang-dong);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 2px 8px rgba(212, 175, 55, 0.15);
        }


        /* ====================================================== */
        /*  PHẦN 8: NÚT BẤM CHÍNH (Đăng Nhập / Ghi Danh)          */
        /* ====================================================== */

        .btn-primary {
            width: 100%;
            padding: 13px 0;
            background: linear-gradient(135deg, var(--mau-do-sam), #5A1515);
            color: var(--mau-vang-dong);
            border: 2px solid var(--mau-vang-dong);
            border-radius: 8px;
            font-family: 'Noto Serif', serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 5px;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--mau-do-hover), #7B1E1E);
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(123, 30, 30, 0.4);
        }

        .btn-primary:active {
            transform: translateY(0);
        }


        /* ====================================================== */
        /*  PHẦN 9: ĐƯỜNG PHÂN CÁCH "HOẶC"                         */
        /* ====================================================== */

        .divider {
            display: flex;
            align-items: center;
            margin: 25px 0;
            gap: 12px;
        }

        .divider__line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(212,175,55,0.3), transparent);
        }

        .divider__text {
            font-size: 0.8rem;
            color: #8A7A66;
            white-space: nowrap;
            font-style: italic;
        }


        /* ====================================================== */
        /*  PHẦN 10: NÚT ĐĂNG NHẬP BẰNG GOOGLE                    */
        /* ====================================================== */

        .btn-google {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 0;
            background: rgba(255, 255, 255, 0.08);
            border: 1.5px solid rgba(212, 175, 55, 0.4);
            border-radius: 8px;
            color: var(--mau-chu-sang);
            font-family: 'Noto Serif', serif;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-google:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--mau-vang-dong);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
        }

        /* Icon Google (SVG inline) */
        .google-icon {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }


        /* ====================================================== */
        /*  PHẦN 11: THÔNG BÁO LỖI / THÀNH CÔNG                   */
        /* ====================================================== */

        .message-box {
            min-height: 24px;
            margin-top: 15px;
            text-align: center;
            font-size: 0.85rem;
            line-height: 1.5;
            transition: all 0.3s ease;
        }

        .message-box.error {
            color: var(--mau-loi);
        }

        .message-box.success {
            color: var(--mau-thanh-cong);
        }

        /* ====================================================== */
        /*  PHẦN 12: NÚT QUAY VỀ TRANG CHỦ                        */
        /* ====================================================== */

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #8A7A66;
            font-size: 0.85rem;
            transition: color 0.3s ease;
        }

        .back-link:hover {
            color: var(--mau-vang-dong);
        }

        .back-link a {
            color: inherit;
            text-decoration: none;
        }


        /* ====================================================== */
        /*  PHẦN 13: HIỆU ỨNG LOADING KHI ĐANG XÁC THỰC          */
        /* ====================================================== */

        .btn-primary.loading,
        .btn-google.loading {
            opacity: 0.7;
            pointer-events: none;
            position: relative;
        }

        .btn-primary.loading::after,
        .btn-google.loading::after {
            content: '';
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid var(--mau-vang-dong);
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-left: 8px;
            vertical-align: middle;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }


        /* ====================================================== */
        /*  PHẦN 14: RESPONSIVE BỔ SUNG                             */
        /* ====================================================== */

        @media (max-width: 480px) {
            .form-box {
                padding: 24px 18px;
                border-radius: 8px;
            }

            .page-title__main {
                font-size: 1.4rem;
                letter-spacing: 2px;
            }

            .tab-btn {
                font-size: 0.9rem;
            }
        }

        /* Hiệu ứng ngôi sao lấp lánh trang trí (tuỳ chọn) */
        .stars {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }

        .star {
            position: absolute;
            width: 2px;
            height: 2px;
            background: rgba(212, 175, 55, 0.6);
            border-radius: 50%;
            animation: twinkle 3s infinite ease-in-out alternate;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.5); }
        }

        /* ====================================================== */
        /*  HIỆU ỨNG CHUYỂN CẢNH VIDEO (Cinematic Video Transition)*/
        /* ====================================================== */

        .page-transition {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.6s ease;
            overflow: hidden;
        }

        .page-transition.active {
            opacity: 1;
            pointer-events: all;
        }

        .page-transition__video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        .page-transition__overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                180deg,
                rgba(10, 8, 6, 0.75) 0%,
                rgba(10, 8, 6, 0.1) 35%,
                rgba(10, 8, 6, 0.2) 65%,
                rgba(10, 8, 6, 0.9) 100%
            );
            z-index: 2;
            pointer-events: none;
        }

        .page-transition__vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.75) 100%);
            z-index: 2;
            pointer-events: none;
        }

        .page-transition__info {
            position: absolute;
            bottom: 35px;
            left: 35px;
            right: 240px;
            z-index: 10;
            color: #fff;
            pointer-events: none;
            animation: fadeInSlow 1s ease-out 0.2s both;
        }

        .page-transition__tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            color: var(--mau-vang-dong);
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
            background: rgba(30, 24, 21, 0.75);
            padding: 4px 14px;
            border-radius: 20px;
            border: 1px solid rgba(212, 175, 55, 0.4);
            backdrop-filter: blur(5px);
        }

        .page-transition__title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.2rem, 3.2vw, 1.9rem);
            font-weight: 700;
            color: var(--mau-vang-dong);
            letter-spacing: 2px;
            margin-bottom: 6px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
        }

        .page-transition__desc {
            font-size: clamp(0.82rem, 1.8vw, 0.95rem);
            color: rgba(232, 213, 176, 0.92);
            line-height: 1.5;
            text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
        }

        .page-transition__controls {
            position: absolute;
            top: 25px;
            right: 25px;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .trans-btn {
            background: rgba(30, 24, 21, 0.85);
            color: var(--mau-chu-sang);
            border: 1px solid var(--mau-vang-dong);
            border-radius: 25px;
            padding: 8px 18px;
            font-family: 'Noto Serif', serif;
            font-size: 0.82rem;
            cursor: pointer;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            backdrop-filter: blur(8px);
        }

        .trans-btn:hover {
            background: var(--mau-do-sam);
            border-color: #FFF3D6;
            color: #FFF3D6;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
        }

        .trans-btn--skip {
            background: linear-gradient(135deg, var(--mau-do-sam), #5A1515);
            font-weight: 700;
            color: var(--mau-vang-dong);
        }

        .page-transition__progress-track {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: rgba(255, 255, 255, 0.18);
            z-index: 10;
        }

        .page-transition__progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--mau-do-sam), var(--mau-vang-dong));
            transition: width 0.1s linear;
        }

        .page-transition__fallback {
            position: absolute;
            inset: 0;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 5;
            text-align: center;
            padding: 20px;
            background: radial-gradient(ellipse at center, rgba(123, 30, 30, 0.4) 0%, rgba(10, 8, 6, 0.95) 75%);
        }

        .page-transition__fallback.active {
            display: flex;
        }

        .page-transition__fallback-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(212, 175, 55, 0.2);
            border-top-color: var(--mau-vang-dong);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        .btn-demo-transition {
            background: rgba(44, 30, 24, 0.8);
            color: var(--mau-vang-dong);
            border: 1px dashed var(--mau-vang-dong);
            border-radius: 20px;
            padding: 7px 16px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.25s ease;
            font-family: inherit;
        }

        .btn-demo-transition:hover {
            background: var(--mau-do-sam);
            color: #FFF3D6;
            border-style: solid;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 600px) {
            .page-transition__info {
                bottom: 25px;
                left: 20px;
                right: 20px;
            }
            .page-transition__controls {
                top: 15px;
                right: 15px;
            }
            .trans-btn {
                padding: 6px 12px;
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================ -->
    <!--  LỚP CHUYỂN TRANG VIDEO (Cinematic Video Transition)          -->
    <!-- ============================================================ -->
    <div class="page-transition" id="page-transition" aria-hidden="true">
        <video id="transition-video" class="page-transition__video" playsinline preload="none" muted></video>

        <div class="page-transition__overlay"></div>
        <div class="page-transition__vignette"></div>

        <div class="page-transition__fallback" id="trans-fallback">
            <div class="page-transition__fallback-spinner"></div>
            <h3 class="page-transition__title" id="fallback-title">⚔️ Đang mở cổng thành nhập ngũ...</h3>
            <p class="page-transition__desc">Chuẩn bị tiến vào sảnh chính Đại Việt</p>
        </div>

        <div class="page-transition__info" id="trans-info">
            <div class="page-transition__tag">
                <span>⚔️</span> Cảnh Chuyển Nhập Thành
            </div>
            <h2 class="page-transition__title" id="trans-title">Hào Khí Thăng Long</h2>
            <p class="page-transition__desc" id="trans-desc">Báo danh thành công — Mở cổng tiến vào sảnh chính</p>
        </div>

        <div class="page-transition__controls">
            <button class="trans-btn" id="btn-trans-audio" onclick="toggleAmThanhVideo(event)" type="button">
                🔊 <span id="trans-audio-text">Bật tiếng</span>
            </button>
            <button class="trans-btn trans-btn--skip" onclick="ketThucChuyenCanh(event)" type="button">
                Vào ngay ⏭️
            </button>
        </div>

        <div class="page-transition__progress-track">
            <div class="page-transition__progress-bar" id="trans-progress"></div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!--  HIỆU ỨNG NGÔI SAO LẤP LÁNH TRÊN NỀN (trang trí)           -->
    <!-- ============================================================ -->
    <div class="stars" id="stars-container" aria-hidden="true"></div>


    <!-- ============================================================ -->
    <!--  KHUNG CHỨA CHÍNH                                             -->
    <!-- ============================================================ -->
    <div class="container">

        <!-- ======== TIÊU ĐỀ TRANG ======== -->
        <div class="page-title">
            <h1 class="page-title__main">
                ĐẠI VIỆT HÙNG CA
            </h1>
            <p class="page-title__sub">
                ⚔️ Báo Danh Nhập Ngũ ⚔️
            </p>
            <div class="page-title__divider"></div>
        </div>


        <!-- ======== KHUNG FORM CHÍNH (bảng gỗ sẫm) ======== -->
        <div class="form-box">

            <!-- ---- TAB CHUYỂN ĐỔI ---- -->
            <div class="tabs">
                <button class="tab-btn active" data-tab="dang-nhap" onclick="chuyenTab('dang-nhap')">
                    🔓 Đăng Nhập
                </button>
                <button class="tab-btn" data-tab="dang-ky" onclick="chuyenTab('dang-ky')">
                    📝 Ghi Danh
                </button>
            </div>

            <!-- ======================================================== -->
            <!--  FORM ĐĂNG NHẬP                                           -->
            <!-- ======================================================== -->
            <div class="tab-content active" id="tab-dang-nhap">
                <form id="form-dang-nhap" onsubmit="xuLyDangNhap(event)">

                    <!-- Email -->
                    <div class="form-group">
                        <label for="login-email">📧 Thư tín (Email)</label>
                        <input type="email" id="login-email" 
                               placeholder="Nhập email của tướng quân..." 
                               required autocomplete="email">
                    </div>

