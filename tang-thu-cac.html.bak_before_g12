// =========================================================================
// 3. LOGIC HIỂN THỊ GIAO DIỆN & TÌM KIẾM
// =========================================================================
const totalLessons = Object.values(curriculumData).flatMap(groups => groups.flatMap(([, lessons]) => lessons)).length;
let currentGrade = 10, currentLesson = null, allOpen = false;
const completedKey = 'dcls_completedLessons';

function getCompleted() {
    try { return JSON.parse(localStorage.getItem(completedKey) || '[]'); }
    catch { return []; }
}

function updateProgress() {
    const done = getCompleted();
    document.getElementById('progress').textContent = `📜 Đã lĩnh hội: ${done.length} / ${totalLessons} bài học`;
    [10, 11, 12].forEach(g => {
        const tab = document.querySelector(`[data-grade="${g}"]`);
        const count = curriculumData[g].flatMap(([, items]) => items).length;
        tab.innerHTML = `<span>KHỐI ${g}</span><small>${curriculumData[g].length} Chủ đề • ${count} Bài</small>`;
    });
}

function setGrade(grade) {
    currentGrade = grade;
    document.querySelectorAll('.tab').forEach(tab => tab.classList.toggle('active', Number(tab.dataset.grade) === grade));
    document.getElementById('view-title').textContent = `Danh mục Chương trình Lịch sử Khối ${grade}`;
    render();
}

function render() {
    const container = document.getElementById('topics');
    container.replaceChildren();
    const done = getCompleted();
    const query = document.getElementById('search').value.trim().toLocaleLowerCase('vi');
    let matches = 0;
    const grades = query ? [10, 11, 12] : [currentGrade];

    grades.forEach(grade => curriculumData[grade].forEach(([topic, lessons], topicIndex) => {
        const filtered = lessons.filter(lesson => {
            if (!query) return true;
            const detailText = DU_LIEU_BAI_HOC[lesson]?.summary || '';
            return `${topic} ${lesson} ${detailText}`.toLocaleLowerCase('vi').includes(query);
        });
        if (!filtered.length) return;
        matches += filtered.length;

        const card = document.createElement('section');
        card.className = 'topic' + ((allOpen || (!query && topicIndex === 0) || Boolean(query)) ? ' open' : '');

        const head = document.createElement('button');
        head.className = 'topic-head';
        head.innerHTML = `<span>${query ? `[KHỐI ${grade}] ` : ''}📁 CHỦ ĐỀ ${topicIndex + 1}. ${topic}</span><span>▼</span>`;
        head.onclick = () => card.classList.toggle('open');

        const list = document.createElement('ul');
        list.className = 'topic-list';

        filtered.forEach(title => {
            const id = `k${grade}-${topicIndex}-${lessons.indexOf(title)}`;
            const li = document.createElement('li');
            li.className = 'lesson' + (done.includes(id) ? ' done' : '');
            li.innerHTML = `<span class="lesson-name">${done.includes(id) ? '✅' : '📜'} ${title}</span><button class="study">📖 Vào học</button>`;
            li.querySelector('button').onclick = () => openLesson({ id, title, topic, grade });
            list.append(li);
        });

        card.append(head, list);
        container.append(card);
    }));

    if (!matches) {
        container.innerHTML = '<div class="empty">Không tìm thấy bài học hoặc khái niệm phù hợp. Hãy thử từ khóa khác.</div>';
    }
    document.getElementById('view-title').textContent = query
        ? `Kết quả tìm kiếm cho: "${document.getElementById('search').value.trim()}"`
        : `Danh mục Chương trình Lịch sử Khối ${currentGrade}`;
}

function openLesson(lesson) {
    currentLesson = lesson;
    document.getElementById('breadcrumb').textContent = `Khối ${lesson.grade} • ${lesson.topic}`;
    document.getElementById('modal-title').textContent = lesson.title;

    const data = DU_LIEU_BAI_HOC[lesson.title] || {
        summary: `<ul><li>Nội dung chi tiết cho bài <b>${lesson.title}</b> đang được cập nhật.</li></ul>`,
        nodes: ['Bối cảnh lịch sử', 'Sự kiện & Nhân vật', 'Kết quả', 'Ý nghĩa'],
        reflection: 'Tìm hiểu lịch sử giúp ta trân trọng giá trị của hòa bình, hiểu cội nguồn và suy nghĩ có trách nhiệm hơn với tương lai.'
    };

    document.getElementById('summary').innerHTML = data.summary;
    document.getElementById('nodes').innerHTML = data.nodes.map(x => `<span class="node">${x}</span>`).join(' ➜ ');
    document.getElementById('reflection').textContent = data.reflection;

    const button = document.getElementById('mark-done');
    button.textContent = getCompleted().includes(lesson.id)
        ? '✓ Đã hoàn thành (bấm để bỏ đánh dấu)'
        : '✅ Đánh dấu Đã học';

    document.getElementById('modal').classList.add('active');
}

function closeModal() {
    document.getElementById('modal').classList.remove('active');
}

document.getElementById('tabs').innerHTML = [10, 11, 12].map(g => `<button class="tab${g === 10 ? ' active' : ''}" data-grade="${g}"></button>`).join('');
document.querySelectorAll('.tab').forEach(tab => tab.onclick = () => setGrade(Number(tab.dataset.grade)));
document.getElementById('search').addEventListener('input', render);
document.getElementById('toggle-all').onclick = () => {
    allOpen = !allOpen;
    document.querySelectorAll('.topic').forEach(card => card.classList.toggle('open', allOpen));
};
document.getElementById('close').onclick = closeModal;
document.getElementById('modal').addEventListener('click', event => {
    if (event.target.id === 'modal') closeModal();
});
document.getElementById('mark-done').onclick = () => {
    if (!currentLesson) return;
    let done = getCompleted();
    done = done.includes(currentLesson.id) ? done.filter(id => id !== currentLesson.id) : [...done, currentLesson.id];
    localStorage.setItem(completedKey, JSON.stringify(done));
    updateProgress();
    openLesson(currentLesson);
    render();
};

// =========================================================================
// 4. ĐỒNG BỘ NHẠC NỀN XUYÊN SUỐT CÁC TRANG (KHÔNG BỊ NGẮT KHI CHUYỂN MỤC)
// =========================================================================
const bgMusic = document.getElementById('bg-music');
const btnMusic = document.getElementById('btn-music');

function updateMusicButton() {
    if (bgMusic.paused) {
        btnMusic.textContent = '🔇 Nhạc nền: Đang tắt';
    } else {
        btnMusic.textContent = '🎵 Nhạc nền: Đang bật';
    }
}

function toggleMusic() {
    if (bgMusic.paused) {
        bgMusic.play().then(() => {
            localStorage.setItem('nhacDangPhat', 'true');
            updateMusicButton();
        }).catch(() => {});
    } else {
        bgMusic.pause();
        localStorage.setItem('nhacDangPhat', 'false');
        updateMusicButton();
    }
}

window.addEventListener('DOMContentLoaded', () => {
    const savedTime = localStorage.getItem('audioTime');
    const isPlaying = localStorage.getItem('nhacDangPhat');
    if (savedTime) {
        bgMusic.currentTime = parseFloat(savedTime);
    }
    if (isPlaying !== 'false') {
        bgMusic.play().then(() => {
            localStorage.setItem('nhacDangPhat', 'true');
            updateMusicButton();
        }).catch(() => {
            updateMusicButton();
        });
    } else {
        updateMusicButton();
    }
});

// Tự động phát nhạc ngay khi người dùng nhấp chuột lần đầu nếu trình duyệt chặn autoplay
document.body.addEventListener('click', (e) => {
    if (e.target.id === 'btn-music') return;
    if (bgMusic.paused && localStorage.getItem('nhacDangPhat') !== 'false') {
        bgMusic.play().then(() => {
            localStorage.setItem('nhacDangPhat', 'true');
            updateMusicButton();
        }).catch(() => {});
    }
}, { once: true });

// Lưu thời gian nhạc mỗi 500ms để chuyển trang mượt mà
setInterval(() => {
    if (!bgMusic.paused) {
        localStorage.setItem('audioTime', bgMusic.currentTime);
    }
}, 500);

updateProgress();
render();
</script>
