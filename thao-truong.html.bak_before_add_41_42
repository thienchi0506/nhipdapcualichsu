// 8. 45-MINUTE COUNTDOWN TIMER (45:00 -> 00:00 & AUTO-SUBMIT)
// =========================================================================
function startTimer45Min() {
  clearInterval(timerInterval);
  updateTimerDisplay();

  timerInterval = setInterval(() => {
    timerSeconds--;
    elapsedSeconds++;
    updateTimerDisplay();

    // When 45 minutes expire
    if (timerSeconds <= 0) {
      clearInterval(timerInterval);
      closeConfirmModal(); // Close modal if currently active
      alert('⏰ Đã hết thời gian 45 phút khảo thí! Hệ thống tự động thu bài và chấm điểm.');
      executeSubmitExam();
    }
  }, 1000);
}

function updateTimerDisplay() {
  const mins = Math.floor(timerSeconds / 60);
  const secs = timerSeconds % 60;
  const disp = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  
  const timerEl = $('timer-countdown');
  const timerCard = document.querySelector('.timer-card');
  timerEl.textContent = disp;

  // When under 5 minutes (<= 300 seconds): turn fiery red & pulse
  if (timerSeconds <= 300) {
    timerEl.classList.add('urgent');
    if (timerCard) timerCard.classList.add('urgent');
  } else {
    timerEl.classList.remove('urgent');
    if (timerCard) timerCard.classList.remove('urgent');
  }
}

