      conciseHighlight = `${allMissing[0]} và ${allMissing[1]}`;
    } else {
      conciseHighlight = `${allMissing[0]}, ${allMissing[1]} và ${allMissing.length - 2} câu/ý khác`;
    }

    let listItemsHtml = allMissing.slice(0, 12).map(m => `
      <li style="padding: 3px 0; display: flex; align-items: center; gap: 8px;">
        <span style="color: #b91c1c; font-weight: 800;">•</span>
