      missingP1.push(`Câu ${i + 1} (Trắc nghiệm)`);
    }
  });

  // 3. Audit Part 2: True/False statements
  const missingP2 = [];
  userAnswersP2.forEach((obj, pIdx) => {
    ['a', 'b', 'c', 'd'].forEach(k => {
      if (obj[k] === null) {
