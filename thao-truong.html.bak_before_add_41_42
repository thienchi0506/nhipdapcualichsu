// PART 1: MCQS (DIRECT CARD INTERACTION)
function renderPart1Continuous() {
  const container = $('part1-questions-list');
  container.innerHTML = '';
  const p1Len = currentExam.part1 ? currentExam.part1.length : 0;
  const p2Len = currentExam.part2 ? currentExam.part2.length : 0;
  const secP1 = $('sec-header-p1');

  if (p1Len === 0) {
    if (secP1) secP1.style.display = 'none';
    container.style.display = 'none';
    return;
  }
  if (secP1) secP1.style.display = 'flex';
  container.style.display = 'block';
  $('badge-p1-count').textContent = `${p1Len} Câu · ${p2Len > 0 ? '6.0' : '10.0'} Điểm`;

  const frag = document.createDocumentFragment();
  currentExam.part1.forEach((q, i) => {
    const card = document.createElement('div');
    card.className = 'question-card';
    card.id = `q-card-p1-${i}`;

    const ptsPerQ = (6.0 / currentExam.part1.length).toFixed(2);
    const letters = ['A', 'B', 'C', 'D'];

    const optsHtml = q.options.map((optText, optIdx) => {
      // Clean option letter prefix if duplicated
      const cleanText = optText.replace(/^[A-D]\s*[\.\:\)]\s*/i, '');
      const letter = letters[optIdx];
      const isSelected = userAnswersP1[i] === optIdx;

      return `
        <div class="opt-card ${isSelected ? 'selected' : ''}" 
             id="opt-card-${i}-${optIdx}" 
             onclick="selectP1Option(${i}, ${optIdx})"
             role="button"
             tabindex="0"
             aria-label="Phương án ${letter}: ${cleanText.replace(/"/g, '&quot;')}">
          <div class="opt-badge">${letter}</div>
          <div class="opt-text">${cleanText}</div>
          <div class="opt-indicator" id="opt-indicator-${i}-${optIdx}">
            ${isSelected ? '<span class="selected-tag">✓ Đã chọn</span>' : ''}
          </div>
        </div>
      `;
    }).join('');

    card.innerHTML = `
      <div class="question-meta">
        <span>Câu ${i + 1} / ${currentExam.part1.length} (Trắc nghiệm nhiều lựa chọn)</span>
        <span>${ptsPerQ} điểm</span>
      </div>
      <div class="question-stem">${q.q}</div>
      <div class="options-grid">
        ${optsHtml}
      </div>
      <div class="review-feedback-container" id="feedback-p1-${i}"></div>
    `;
    frag.appendChild(card);
  });
  container.appendChild(frag);
}

// PART 2: TRUE / FALSE (HORIZONTAL LAYOUT WITH SEGMENTED CONTROL BAR)
function renderPart2Continuous() {
  const container = $('part2-questions-list');
  container.innerHTML = '';
  const p2Len = currentExam.part2 ? currentExam.part2.length : 0;
  const secP2 = $('sec-header-p2');

  if (p2Len === 0) {
    if (secP2) secP2.style.display = 'none';
    container.style.display = 'none';
    return;
  }
  if (secP2) secP2.style.display = 'flex';
  container.style.display = 'block';
  $('badge-p2-count').textContent = `${p2Len} Đoạn · ${p2Len * 4} Ý · 4.0 Điểm`;

  const frag = document.createDocumentFragment();
  currentExam.part2.forEach((p, i) => {
    const card = document.createElement('div');
    card.className = 'question-card';
    card.id = `q-card-p2-${i}`;

    const statementsHtml = p.statements.map((stmt, sIdx) => {
      const letKey = stmt.letter.toLowerCase();
      const userVal = userAnswersP2[i][letKey];

      const trueActive = userVal === true ? 'active-true' : '';
      const falseActive = userVal === false ? 'active-false' : '';

      const rowStatusClass = userVal === true ? 'answered-true' : (userVal === false ? 'answered-false' : 'is-empty');
      const statusPillHtml = userVal === true ? '<span class="status-pill status-true">✓ Đã chọn: ĐÚNG</span>' :
                            (userVal === false ? '<span class="status-pill status-false">✗ Đã chọn: SAI</span>' :
                             '<span class="status-pill status-empty">⚪ Chưa chọn</span>');

      return `
        <div class="statement-row ${rowStatusClass}" id="stmt-row-${i}-${letKey}">
          <div class="statement-text">
            <span class="stmt-letter">${stmt.letter.toLowerCase()})</span>
            <span class="stmt-body">${stmt.text}</span>
          </div>
          <div class="statement-control-cluster">
            <div class="stmt-status-box" id="stmt-status-${i}-${letKey}">
              ${statusPillHtml}
            </div>
            <div class="segmented-control" role="group" aria-label="Lựa chọn Đúng hoặc Sai">
              <button type="button" class="segmented-btn btn-true ${trueActive}" 
