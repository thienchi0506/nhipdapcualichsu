// 7. PALETTE SETUP & PROGRESS TRACKING
// =========================================================================
function setupPaletteAndProgress() {
  const p1Len = currentExam.part1 ? currentExam.part1.length : 0;
  const p2Len = currentExam.part2 ? currentExam.part2.length : 0;
  const essaysList = currentExam.essays || currentExam.part3 || [];
  const p3Len = essaysList.length;

  const boxP1 = $('palette-p1-box');
  const boxP2 = $('palette-p2-box');
  const boxP3 = $('palette-p3-box');

  if (boxP1) boxP1.style.display = p1Len > 0 ? 'flex' : 'none';
  if (boxP2) boxP2.style.display = p2Len > 0 ? 'flex' : 'none';
  if (boxP3) boxP3.style.display = p3Len > 0 ? 'flex' : 'none';

  $('palette-p1-count').textContent = p1Len;
  $('palette-p2-count').textContent = p2Len;

  // Part 1 dots
  const gridP1 = $('palette-p1-grid');
  gridP1.innerHTML = '';
  for (let i = 0; i < p1Len; i++) {
    const dot = document.createElement('div');
    dot.className = 'palette-dot';
    dot.id = `dot-p1-${i}`;
    dot.textContent = i + 1;
    dot.title = `Đến câu ${i + 1}`;
    dot.onclick = () => scrollToQuestion(`q-card-p1-${i}`);
    gridP1.appendChild(dot);
  }

  // Part 2 dots
  const gridP2 = $('palette-p2-grid');
  gridP2.innerHTML = '';
  for (let i = 0; i < p2Len; i++) {
    const dot = document.createElement('div');
    dot.className = 'palette-dot';
    dot.id = `dot-p2-${i}`;
    dot.textContent = `Đ${i + 1}`;
    dot.title = `Đến đoạn tư liệu ${i + 1}`;
    dot.onclick = () => scrollToQuestion(`q-card-p2-${i}`);
    gridP2.appendChild(dot);
  }

  // Part 3 dots (if any)
  const gridP3 = $('palette-p3-grid');
  gridP3.innerHTML = '';
  for (let i = 0; i < p3Len; i++) {
    const dot = document.createElement('div');
    dot.className = 'palette-dot';
    dot.id = `dot-p3-${i}`;
    dot.textContent = `TL${i + 1}`;
    dot.title = `Đến câu tự luận ${i + 1}`;
    dot.onclick = () => scrollToQuestion(`q-card-p3-${i}`);
    gridP3.appendChild(dot);
  }

  updateProgress();
}

function scrollToQuestion(elementId) {
  const el = $(elementId);
  if (el) {
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
}

function updateProgress() {
  if (!currentExam) return;

  const p1Len = currentExam.part1 ? currentExam.part1.length : 0;
  const p2Len = currentExam.part2 ? currentExam.part2.length : 0;
  const essaysList = currentExam.essays || currentExam.part3 || [];
  const p3Len = essaysList.length;
  const totalUnits = p1Len + p2Len * 4;

  if (totalUnits === 0 && p3Len > 0) {
    let answeredP3 = 0;
    userAnswersP3.forEach(txt => { if (txt && txt.trim().length > 0) answeredP3++; });
    const pct = Math.round((answeredP3 / p3Len) * 100);
    $('progress-label').textContent = `${answeredP3}/${p3Len} câu (${pct}%)`;
    $('progress-fill').style.width = pct + '%';
    return;
  }

  let answeredUnits = 0;
  userAnswersP1.forEach(ans => {
    if (ans !== null) answeredUnits++;
  });
  userAnswersP2.forEach(obj => {
    ['a', 'b', 'c', 'd'].forEach(k => {
      if (obj[k] !== null) answeredUnits++;
    });
  });

  const pct = Math.round((answeredUnits / totalUnits) * 100);
  $('progress-label').textContent = `${answeredUnits}/${totalUnits} ý (${pct}%)`;
  $('progress-fill').style.width = pct + '%';
}

