// SELECT P1 OPTION (DIRECT CARD SELECTION & IMMEDIATE FEEDBACK)
function selectP1Option(qIdx, optIdx) {
  if (isSubmitted) return;

  userAnswersP1[qIdx] = optIdx;

  // Update card styles & selection tags
  for (let o = 0; o < 4; o++) {
    const optEl = $(`opt-card-${qIdx}-${o}`);
    const indicatorEl = $(`opt-indicator-${qIdx}-${o}`);
    if (optEl) {
      const isSelected = (o === optIdx);
      optEl.classList.toggle('selected', isSelected);
      if (indicatorEl) {
        indicatorEl.innerHTML = isSelected ? '<span class="selected-tag">✓ Đã chọn</span>' : '';
      }
    }
  }

  // Update palette dot
  const dot = $(`dot-p1-${qIdx}`);
  if (dot) dot.classList.add('answered');

  updateProgress();
}

// SELECT P2 STATEMENT (SEGMENTED CONTROL BAR & STATUS PILL)
function selectP2Statement(passageIdx, letter, boolVal) {
  if (isSubmitted) return;

  userAnswersP2[passageIdx][letter] = boolVal;

  const btnTrue = $(`seg-true-${passageIdx}-${letter}`);
  const btnFalse = $(`seg-false-${passageIdx}-${letter}`);
  const statusBox = $(`stmt-status-${passageIdx}-${letter}`);
  const row = $(`stmt-row-${passageIdx}-${letter}`);

  if (btnTrue && btnFalse) {
    btnTrue.classList.toggle('active-true', boolVal === true);
    btnFalse.classList.toggle('active-false', boolVal === false);
  }

  if (statusBox) {
    statusBox.innerHTML = boolVal === true 
      ? '<span class="status-pill status-true">✓ Đã chọn: ĐÚNG</span>' 
      : '<span class="status-pill status-false">✗ Đã chọn: SAI</span>';
  }

  if (row) {
    row.classList.remove('is-empty', 'answered-true', 'answered-false');
    row.classList.add(boolVal === true ? 'answered-true' : 'answered-false');
  }

  // Update palette dot for this passage
  const ansObj = userAnswersP2[passageIdx];
  const allAnswered = ['a', 'b', 'c', 'd'].every(k => ansObj[k] !== null);
  const dot = $(`dot-p2-${passageIdx}`);
  if (dot) {
    dot.classList.toggle('answered', allAnswered);
  }

  updateProgress();
}

// ESSAY INPUT
function onEssayInput(idx, val) {
  userAnswersP3[idx] = val;
  const dot = $(`dot-p3-${idx}`);
  if (dot) {
    dot.classList.toggle('answered', val.trim().length > 0);
  }
}

