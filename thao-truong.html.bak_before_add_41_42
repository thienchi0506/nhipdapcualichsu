// =========================================================================
// 10. SUBMISSION EXECUTION, SCORING & PEDAGOGICAL REVIEW
// =========================================================================
function executeSubmitExam() {
  if (isSubmitted) return;
  isSubmitted = true;
  clearInterval(timerInterval);

  const p1Len = currentExam.part1 ? currentExam.part1.length : 0;
  const p2Len = currentExam.part2 ? currentExam.part2.length : 0;
  const essaysList = currentExam.essays || currentExam.part3 || [];
  const p3Len = essaysList.length;

  // 1. Grade Part 1 (MCQs)
  let p1Correct = 0;
  if (p1Len > 0) {
    for (let i = 0; i < p1Len; i++) {
      const correctAns = currentExam.part1[i].ans !== undefined ? currentExam.part1[i].ans : currentExam.part1[i].answer;
      if (userAnswersP1[i] === correctAns) {
        p1Correct++;
      }
    }
  }
  const scoreP1 = p1Len > 0 ? (p1Correct / p1Len) * 6.0 : 0;

  // 2. Grade Part 2 (Standard GDPT 2025)
  const p2Scale = [0, 0.1, 0.25, 0.5, 1.0];
  let rawP2Score = 0;
  let p2StatementsCorrect = 0;
  let p2FullCorrectCount = 0;

  if (p2Len > 0) {
    for (let i = 0; i < p2Len; i++) {
      const p = currentExam.part2[i];
      let correctInThisPassage = 0;
      ['a', 'b', 'c', 'd'].forEach((key, sIdx) => {
        const userVal = userAnswersP2[i][key];
        const correctVal = p.statements[sIdx].isTrue;
        if (userVal === correctVal) {
          correctInThisPassage++;
          p2StatementsCorrect++;
        }
      });
      rawP2Score += p2Scale[correctInThisPassage];
      if (correctInThisPassage === 4) p2FullCorrectCount++;
    }
  }
  const scoreP2 = p2Len > 0 ? (rawP2Score / (p2Len * 1.0)) * 4.0 : 0;

  let totalScore = 0;
  if (p1Len > 0 && p2Len > 0) {
    totalScore = Math.min(10, Math.round((scoreP1 + scoreP2) * 100) / 100);
  } else if (p1Len > 0 && p2Len === 0) {
    totalScore = Math.min(10, Math.round(((p1Correct / p1Len) * 10.0) * 100) / 100);
  } else if (p1Len === 0 && p2Len > 0) {
    totalScore = Math.min(10, Math.round(((rawP2Score / (p2Len * 1.0)) * 10.0) * 100) / 100);
  } else if (p1Len === 0 && p2Len === 0 && p3Len > 0) {
    totalScore = 10.0;
  }

  // Best score save to localStorage
  const prevBest = localStorage.getItem('thao_truong_best_' + currentExam.id);
  if (!prevBest || totalScore > parseFloat(prevBest)) {
    localStorage.setItem('thao_truong_best_' + currentExam.id, totalScore.toFixed(2));
  }

  // Bonus peace points
  const peaceReward = Math.round(totalScore * 10);
  let peace = parseInt(localStorage.getItem('dcls_peaceScore') || '1000', 10);
  peace += peaceReward;
  localStorage.setItem('dcls_peaceScore', peace);
  $('peace-badge').textContent = '🕊️ Thái Bình: ' + peace;
  $('res-stat-bonus').textContent = `🕊️ +${peaceReward} Điểm Thái Bình`;

  // Render Top Result Summary Board
  $('res-score').textContent = totalScore.toFixed(2);
  if (p1Len > 0) {
    $('res-stat-p1').innerHTML = `<strong>Phần I (Trắc nghiệm):</strong> ${p1Correct}/${p1Len} câu đúng · <strong>${(p2Len > 0 ? scoreP1 : totalScore).toFixed(2)}/${p2Len > 0 ? '6.00' : '10.00'}đ</strong>`;
    $('res-stat-p1').style.display = 'block';
  } else {
    $('res-stat-p1').style.display = 'none';
  }

  if (p2Len > 0) {
    $('res-stat-p2').innerHTML = `<strong>Phần II (Đúng/Sai):</strong> ${p2StatementsCorrect}/${p2Len * 4} ý chính xác · <strong>${scoreP2.toFixed(2)}/4.00đ</strong>`;
    $('res-stat-p2').style.display = 'block';
  } else {
    $('res-stat-p2').style.display = 'none';
  }

  if (p3Len > 0) {
    let answeredP3 = 0;
    userAnswersP3.forEach(t => { if (t && t.trim().length > 0) answeredP3++; });
    let p3StatEl = $('res-stat-p3');
    if (!p3StatEl) {
      p3StatEl = document.createElement('div');
      p3StatEl.className = 'stat-pill';
      p3StatEl.id = 'res-stat-p3';
      $('res-stat-p2').parentElement.appendChild(p3StatEl);
    }
    p3StatEl.innerHTML = `<strong>Phần III (Tự luận):</strong> ${answeredP3}/${p3Len} câu đã hoàn thành`;
    p3StatEl.style.display = 'block';
  }
  
  const minsUsed = Math.floor(elapsedSeconds / 60);
  const secsUsed = elapsedSeconds % 60;
  $('res-stat-time').innerHTML = `⏱️ <strong>Thời gian hoàn thành:</strong> ${minsUsed} phút ${secsUsed.toString().padStart(2, '0')} giây`;

  // Rank message
  let rankTitle = 'Bậc Đại Tướng Lịch Sử';
  let rankMsg = '';
  if (totalScore >= 9.0) {
    rankTitle = '👑 Bậc Đại Tướng Toàn Năng (Thủ Khoa Sử Học)';
    rankMsg = 'Xuất sắc tuyệt đỉnh! Bạn sở hữu nền tảng tri thức lịch sử sâu rộng, khả năng phân tích tư liệu chuẩn xác và tư duy lập luận bậc thầy!';
  } else if (totalScore >= 8.0) {
    rankTitle = '🎖️ Thống Lĩnh Chiến Lược Sử Học';
    rankMsg = 'Rất giỏi! Nắm vững bản chất các giai đoạn lịch sử và kỹ năng làm bài thi trắc nghiệm theo chương trình mới.';
  } else if (totalScore >= 6.5) {
    rankTitle = '⚔️ Tiên Phong Khảo Thí';
    rankMsg = 'Khá tốt! Hãy chú ý các bẫy câu chữ ở phần đọc hiểu tư liệu Đúng/Sai để bứt phá lên mức 9+.';
  } else if (totalScore >= 5.0) {
    rankTitle = '🛡️ Chiến Binh Sử Học';
    rankMsg = 'Đạt chuẩn! Hãy xem kỹ phần giải thích chi tiết và dẫn chứng lịch sử bên dưới từng câu để lấp đầy lỗ hổng.';
  } else {
    rankTitle = '📜 Tân Binh Tập Sự';
    rankMsg = 'Cần kiên trì ôn luyện nhiều hơn! Hãy nhấp vào các liên kết sang Tàng Thư Các bên dưới để củng cố lại bài học trọng tâm.';
  }
  $('res-rank').textContent = rankTitle;
  $('res-comment').textContent = rankMsg;

  // Show top summary board and hide bottom submit button
  $('result-summary-box').style.display = 'block';
  $('bottom-submit-wrapper').style.display = 'none';

  // Apply Review styles directly to questions
  applyReviewStylingToQuestions();

  // Generate Roadmap to Tang Thu Cac
  generateRoadmapToTangThuCac(p1Correct < p1Len || p2StatementsCorrect < p2Len * 4);

  // Smooth scroll to top of exam paper
  $('result-summary-box').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// APPLY DIRECT IN-PLACE REVIEW STYLES (GREEN FOR CORRECT, RED FOR WRONG, EXPLANATIONS & WIDGETS)
function applyReviewStylingToQuestions() {
  const p1Len = currentExam.part1.length;
  const p2Len = currentExam.part2.length;
  const letters = ['A', 'B', 'C', 'D'];
  const lessonInfo = EXAM_LESSON_MAPPING[currentExam.id] || { title: currentExam.topic, grade: 12, topic: 'Lịch sử 12' };

  // PART 1 REVIEW
  currentExam.part1.forEach((q, i) => {
    const userVal = userAnswersP1[i];
    const correctAns = q.ans !== undefined ? q.ans : q.answer;
    const isCorrect = userVal === correctAns;

    // Palette dot color
    const dot = $(`dot-p1-${i}`);
    if (dot) {
      dot.classList.add(isCorrect ? 'dot-correct' : 'dot-wrong');
    }

    // Card options coloring & badges
    for (let o = 0; o < 4; o++) {
      const optEl = $(`opt-card-${i}-${o}`);
      const indicatorEl = $(`opt-indicator-${i}-${o}`);
      if (optEl) {
        optEl.classList.add('locked');
        if (o === correctAns) {
          optEl.classList.add('is-correct');
          if (indicatorEl) {
            indicatorEl.innerHTML = '<span class="result-badge correct-badge">✓ Đáp án đúng của đề</span>';
          }
        } else if (o === userVal && !isCorrect) {
          optEl.classList.add('is-wrong');
          if (indicatorEl) {
            indicatorEl.innerHTML = '<span class="result-badge wrong-badge">✗ Lựa chọn sai của bạn</span>';
          }
        } else if (indicatorEl && o !== userVal && o !== correctAns) {
          indicatorEl.innerHTML = '';
        }
      }
    }

    // Clean text of correct option
    const correctRawText = q.options[correctAns] || '';
    const cleanCorrectText = correctRawText.replace(/^[A-D]\s*[\.\:\)]\s*/i, '');

    // Explanation Box & Tang Thu Cac Widget
    const feedbackBox = $(`feedback-p1-${i}`);
    if (feedbackBox) {
      let html = `
        <div class="explain-box">
          <div class="explain-title">💡 Giải Thích Chi Tiết & Dẫn Chứng Lịch Sử:</div>
          <div style="margin-bottom: 8px; font-size: 13.5px; font-weight: 700; color: #15803d; background: #eafaf1; padding: 7px 12px; border-radius: 8px; border: 1px solid #86efac;">
            👉 Đáp án đúng của đề: <strong>${letters[correctAns]}. ${cleanCorrectText}</strong>
            ${!isCorrect && userVal !== null ? `<div style="color: #b91c1c; font-weight: 600; font-size: 12.5px; margin-top: 3px;">(Lựa chọn của bạn là ${letters[userVal]} - chưa chính xác)</div>` : ''}
            ${userVal === null ? `<div style="color: #d97706; font-weight: 600; font-size: 12.5px; margin-top: 3px;">(Bạn chưa chọn đáp án cho câu hỏi này)</div>` : ''}
          </div>
          <div style="line-height: 1.6; color: var(--ink); font-size: 14px;">
            ${q.explain || 'Căn cứ các sự kiện và bài học trong sách giáo khoa Lịch sử 12 chuẩn Bộ GD&ĐT.'}
          </div>
        </div>
      `;

      if (!isCorrect) {
        html += `
          <div class="tang-thu-cac-widget" style="margin-top: 10px;">
            <div class="widget-title">
              <div style="font-size: 13px; font-weight: 800; color: #92400e;">
                📚 Kiến thức cần củng cố tại Tàng Thư Các:
              </div>
              <div style="font-size: 14px; font-weight: 700; color: var(--ink);">
                ${lessonInfo.title}
              </div>
              <div style="font-size: 12px; color: var(--ink-muted);">
                📌 Giai đoạn: ${lessonInfo.topic} (Khối ${lessonInfo.grade})
              </div>
            </div>
            <a href="tang-thu-cac.html?grade=${lessonInfo.grade}&lesson=${encodeURIComponent(lessonInfo.title)}" 
               target="_blank" 
               class="widget-btn">📖 Đến Tàng Thư Các ôn ngay bài này ➔</a>
          </div>
        `;
      }
      feedbackBox.innerHTML = html;
    }
  });

  // PART 2 REVIEW (TRUE / FALSE)
  currentExam.part2.forEach((p, i) => {
    let passageAllCorrect = true;

    p.statements.forEach((stmt, sIdx) => {
      const letKey = stmt.letter.toLowerCase();
      const userVal = userAnswersP2[i][letKey];
      const correctVal = stmt.isTrue;
      const isStmtCorrect = userVal === correctVal;

      if (!isStmtCorrect) passageAllCorrect = false;

      // Lock segmented buttons
      const btnTrue = $(`seg-true-${i}-${letKey}`);
      const btnFalse = $(`seg-false-${i}-${letKey}`);
      if (btnTrue) btnTrue.classList.add('locked');
      if (btnFalse) btnFalse.classList.add('locked');

      const row = $(`stmt-row-${i}-${letKey}`);
      if (row) {
        row.classList.remove('answered-true', 'answered-false', 'is-empty');
        row.classList.add(isStmtCorrect ? 'correct-row' : 'wrong-row');
      }

      const statusBox = $(`stmt-status-${i}-${letKey}`);
      if (statusBox) {
        const userText = userVal === true ? 'ĐÚNG' : (userVal === false ? 'SAI' : 'CHƯA CHỌN');
        const correctText = correctVal ? 'ĐÚNG' : 'SAI';
        if (isStmtCorrect) {
          statusBox.innerHTML = `<span class="status-pill status-review-correct">✅ Bạn chọn chính xác: ${userText}</span>`;
        } else {
          statusBox.innerHTML = `<span class="status-pill status-review-wrong">❌ Bạn chọn sai: ${userText} ➔ Đáp án đúng của đề: ${correctText}</span>`;
        }
      }

      // Statement explanation
      const stmtFeedback = $(`feedback-stmt-${i}-${letKey}`);
      if (stmtFeedback) {
        stmtFeedback.innerHTML = `
          <div class="explain-box" style="margin-top: 5px; margin-bottom: 8px; font-size: 13.5px; padding: 10px 14px; background: ${isStmtCorrect ? '#f0fdf4' : '#fef2f2'}; border-color: ${isStmtCorrect ? '#86efac' : '#fca5a5'};">
            <strong style="color: ${correctVal ? '#15803d' : '#b91c1c'}; font-weight: 800;">Mệnh đề ${stmt.letter.toLowerCase()}) là ${correctVal ? 'ĐÚNG' : 'SAI'}:</strong> 
            <span style="color: var(--ink); line-height: 1.55;">${stmt.explain || 'Căn cứ các cứ liệu lịch sử trong sách giáo khoa Lịch sử 12.'}</span>
          </div>
        `;
      }
    });

    // Palette dot for passage
    const dot = $(`dot-p2-${i}`);
    if (dot) {
      dot.classList.add(passageAllCorrect ? 'dot-correct' : 'dot-wrong');
    }

    // Tang Thu Cac Widget if any statement in passage was wrong
    const feedbackBox = $(`feedback-p2-${i}`);
    if (feedbackBox && !passageAllCorrect) {
      feedbackBox.innerHTML = `
        <div class="tang-thu-cac-widget" style="margin-top: 14px;">
          <div class="widget-title">
            <div style="font-size: 13px; font-weight: 800; color: #92400e;">
              📚 Củng cố tư liệu lịch sử tại Tàng Thư Các:
            </div>
            <div style="font-size: 14px; font-weight: 700; color: var(--ink);">
              ${lessonInfo.title}
            </div>
            <div style="font-size: 12px; color: var(--ink-muted);">
              📌 Giai đoạn: ${lessonInfo.topic} (Khối ${lessonInfo.grade})
            </div>
          </div>
          <a href="tang-thu-cac.html?grade=${lessonInfo.grade}&lesson=${encodeURIComponent(lessonInfo.title)}" 
             target="_blank" 
             class="widget-btn">📖 Đến Tàng Thư Các xem tư liệu bài học ➔</a>
        </div>
      `;
    }
  });

  // PART 3 REVIEW (ESSAYS)
  const essaysList = currentExam.essays || currentExam.part3 || [];
  essaysList.forEach((essay, i) => {
    const textarea = $(`essay-input-${i}`);
    if (textarea) textarea.disabled = true;

    const guideBox = $(`essay-guide-${i}`);
    if (guideBox) {
      guideBox.style.display = 'block';
      guideBox.innerHTML = `
        <div class="essay-guide-box" style="margin-top: 14px; background: #fdfaf3; border: 1.5px solid var(--gold); border-radius: 10px; padding: 16px 20px;">
          <strong style="display: block; margin-bottom: 8px; color: var(--gold-dark); font-size: 14px;">📖 HƯỚNG DẪN CHẤM & GỢI Ý CÁC Ý CHÍNH CẦN ĐẠT:</strong>
          <div style="font-size: 14px; line-height: 1.6; color: var(--ink);">${essay.guide || essay.answer || essay.explain || 'Học sinh đối chiếu các luận điểm lịch sử trong SGK và tài liệu chuyên sâu.'}</div>
        </div>
      `;
    }
  });
}

// GENERATE ROADMAP TO TANG THU CAC
function generateRoadmapToTangThuCac(hasErrors) {
  const roadmapBox = $('roadmap-review-box');
  const itemsList = $('roadmap-items-list');
  itemsList.innerHTML = '';

  const lessonInfo = EXAM_LESSON_MAPPING[currentExam.id] || { title: currentExam.topic, grade: 12, topic: 'Lịch sử 12' };

  if (!hasErrors) {
    roadmapBox.style.display = 'block';
    $('roadmap-desc-text').textContent = 'Tuyệt vời! Bạn không mắc sai sót nào trong đề thi này. Hãy tiếp tục khám phá thêm các chuyên đề phong phú khác tại Tàng Thư Các để mở rộng tri thức và làm chủ kỳ thi Tốt nghiệp THPT 2025:';
    itemsList.innerHTML = `
      <div class="roadmap-item">
        <div class="roadmap-item-info">
          <h4 style="font-size: 16px; font-weight: 800; color: var(--gold-dark); margin-bottom: 4px;">🌟 Chuyên đề: ${lessonInfo.title}</h4>
          <p style="color: var(--green); font-size: 13.5px; font-weight: 600;">Bạn đã nắm vững 100% kiến thức của chuyên đề này!</p>
          <div style="font-size: 12px; color: var(--ink-muted); margin-top: 3px;">📌 Giai đoạn: ${lessonInfo.topic} (Khối ${lessonInfo.grade})</div>
        </div>
        <a href="tang-thu-cac.html?grade=${lessonInfo.grade}&lesson=${encodeURIComponent(lessonInfo.title)}" 
           target="_blank" 
           class="roadmap-link-btn">Xem lại tại Tàng Thư Các ➔</a>
      </div>
    `;
    return;
  }

  roadmapBox.style.display = 'block';
  $('roadmap-desc-text').textContent = 'Hệ thống đã phân tích các câu hỏi bạn làm sai và tự động tổng hợp các chuyên đề lịch sử trọng tâm bạn cần ôn luyện bổ sung tại Tàng Thư Các:';

  itemsList.innerHTML = `
    <div class="roadmap-item">
      <div class="roadmap-item-info">
        <h4 style="font-size: 16px; font-weight: 800; color: var(--gold-dark); margin-bottom: 4px;">Chuyên đề trọng tâm: ${lessonInfo.title}</h4>
        <p style="font-size: 13.5px; color: var(--ink);">Phát hiện có câu hỏi chưa chính xác trong bài thi • Cần đọc lại phần lý thuyết và phân tích tư liệu lịch sử</p>
        <div style="font-size: 12px; color: var(--ink-muted); margin-top: 3px;">📌 Giai đoạn: ${lessonInfo.topic} (Khối ${lessonInfo.grade})</div>
      </div>
      <a href="tang-thu-cac.html?grade=${lessonInfo.grade}&lesson=${encodeURIComponent(lessonInfo.title)}" 
         target="_blank" 
         class="roadmap-link-btn">Đến Tàng Thư Các ôn ngay bài này ➔</a>
    </div>
  `;
}

// RETAKE & BACK BUTTONS IN RESULT
$('btn-retake-exam').onclick = () => {
  if (currentExam) startExam(currentExam.id);
};
$('btn-back-to-catalog').onclick = () => {
  showScreen('screen-catalog');
};

// =========================================================================
// 11. INITIALIZATION
// =========================================================================
renderCatalog('all', '');

</script>
