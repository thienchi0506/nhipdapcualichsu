<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thao Trường Khảo Thí Lịch Sử 12 - Chuẩn Bộ GD&ĐT 2025</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #140c08;
      --paper: #fbf8f2;
      --paper-dark: #f0e9df;
      --paper-card: #ffffff;
      --ink: #1a1615;
      --ink-light: #574d47;
      --ink-muted: #8c7e75;
      --border: #e2d7c5;
      --border-dark: #b8a68d;
      --gold: #c59b27;
      --gold-light: #e6be53;
      --gold-dark: #927014;
      --gold-bg: rgba(197, 155, 39, 0.08);
      --red: #b91c1c;
      --red-light: #fef2f2;
      --green: #15803d;
      --green-light: #f0fdf4;
      --blue: #1d4ed8;
      --blue-light: #eff6ff;
      --radius: 12px;
      --font-serif: 'Cinzel', serif;
      --font-sans: 'Be Vietnam Pro', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-sans);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* HEADER */
    .header {
      background: rgba(20, 12, 8, 0.95);
      border-bottom: 2px solid var(--gold);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }
    .header-inner {
      max-width: 1440px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .home-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--gold);
      text-decoration: none;
      font-weight: 700;
      font-size: 13.5px;
      padding: 8px 16px;
      border: 1px solid var(--gold);
      border-radius: 8px;
      transition: all 0.2s ease;
      background: rgba(197, 155, 39, 0.1);
    }
    .home-btn:hover {
      background: var(--gold);
      color: var(--bg);
      transform: translateY(-1px);
    }
    .header-titles {
      text-align: center;
      flex: 1;
    }
    .header-titles h1 {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 800;
      color: var(--gold);
      letter-spacing: 1px;
    }
    .header-sub {
      font-size: 11.5px;
      color: #dfd0be;
      letter-spacing: 0.5px;
    }
    .header-badges {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .badge-pill {
      font-size: 12px;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 20px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(197, 155, 39, 0.3);
      color: #dfd0be;
    }

    main {
      flex: 1;
      width: 100%;
    }

    /* SCREENS */
    .screen { display: none; }
    .screen.active { display: block; }

    /* SCREEN 1: CATALOG */
    .catalog-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 30px 24px 60px;
    }
    .intro-box {
      background: linear-gradient(135deg, rgba(32, 19, 13, 0.9) 0%, rgba(20, 12, 8, 0.95) 100%);
      border: 2px solid var(--gold);
      border-radius: 16px;
      padding: 28px 32px;
      margin-bottom: 28px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
      color: #fbf8f2;
    }
    .intro-box h2 {
      font-family: var(--font-serif);
      color: var(--gold);
      font-size: 24px;
      margin-bottom: 12px;
    }
    .intro-box p {
      font-size: 14px;
      line-height: 1.7;
      color: #dfd0be;
    }

    .filter-bar {
      margin-bottom: 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .filter-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .filter-tab {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(197, 155, 39, 0.25);
      color: #dfd0be;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .filter-tab:hover {
      background: rgba(197, 155, 39, 0.15);
      border-color: var(--gold);
      color: var(--gold);
    }
    .filter-tab.active {
      background: var(--gold);
      color: var(--bg);
      border-color: var(--gold);
      font-weight: 700;
      box-shadow: 0 4px 12px rgba(197, 155, 39, 0.3);
    }
    .search-input {
      background: rgba(255,255,255,0.06);
      border: 1.5px solid rgba(197, 155, 39, 0.3);
      border-radius: 10px;
      padding: 12px 20px;
      color: #fff;
      font-size: 14px;
      width: 100%;
      outline: none;
      transition: all 0.2s ease;
    }
    .search-input:focus {
      border-color: var(--gold);
      background: rgba(255,255,255,0.1);
      box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.2);
    }

    .exam-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
      gap: 24px;
    }
    .exam-card {
      background: var(--paper);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
      transition: all 0.25s ease;
    }
    .exam-card:hover {
      transform: translateY(-4px);
      border-color: var(--gold);
      box-shadow: 0 12px 32px rgba(197, 155, 39, 0.2);
    }
    .exam-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
    }
    .exam-badge {
      background: var(--gold-bg);
      color: var(--gold-dark);
      border: 1px solid var(--gold);
      font-size: 11.5px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      max-width: 70%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .exam-time {
      font-size: 12px;
      font-weight: 700;
      color: var(--red);
      background: var(--red-light);
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid #fecaca;
    }
    .exam-card h3 {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .exam-topic {
      font-size: 13px;
      font-weight: 600;
      color: var(--gold-dark);
      margin-bottom: 10px;
    }
    .exam-desc {
      font-size: 13px;
      color: var(--ink-light);
      line-height: 1.5;
      margin-bottom: 16px;
      flex: 1;
    }
    .exam-specs {
      background: var(--paper-dark);
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 12px;
      color: var(--ink);
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .exam-specs span { color: var(--ink-muted); }
    .exam-card-actions {
      display: flex;
      gap: 10px;
      margin-top: auto;
    }
    .start-btn {
      flex: 1;
      background: var(--gold);
      color: var(--bg);
      border: none;
      padding: 12px 20px;
      font-weight: 800;
      font-size: 14px;
      border-radius: 10px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .start-btn:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(197, 155, 39, 0.4);
    }

    /* SCREEN 2: CONTINUOUS SCROLL EXAM TAKING */
    .exam-scroll-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 28px;
      align-items: start;
      max-width: 1440px;
      margin: 0 auto;
      padding: 24px 20px 80px;
    }
    @media (max-width: 1024px) {
      .exam-scroll-layout {
        grid-template-columns: 1fr;
      }
      .exam-sticky-sidebar {
        position: static !important;
        max-height: none !important;
      }
    }

    .exam-paper-container {
      min-width: 0;
    }

    /* EXAM PAPER BANNER */
    .paper-header {
      background: var(--paper);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 24px 28px;
      margin-bottom: 24px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.15);
      position: relative;
    }
    .paper-header h2 {
      font-family: var(--font-serif);
      font-size: 22px;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .paper-meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      font-size: 13px;
      color: var(--ink-light);
    }
    .paper-badge {
      background: var(--gold-bg);
      color: var(--gold-dark);
      border: 1px solid var(--gold);
      padding: 2px 10px;
      border-radius: 12px;
      font-weight: 700;
    }

    /* SECTION DIVIDER HEADERS */
    .section-divider {
      background: linear-gradient(135deg, rgba(32, 19, 13, 0.95) 0%, rgba(20, 12, 8, 0.98) 100%);
      border: 2px solid var(--gold);
      border-radius: 14px;
      padding: 16px 22px;
      margin: 32px 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #fbf8f2;
      box-shadow: 0 6px 18px rgba(0,0,0,0.3);
    }
    .section-divider h3 {
      font-family: var(--font-serif);
      font-size: 17px;
      color: var(--gold);
      font-weight: 800;
    }
    .section-divider .section-badge {
      font-size: 12px;
      background: rgba(197, 155, 39, 0.2);
      border: 1px solid var(--gold);
      padding: 4px 10px;
      border-radius: 20px;
      color: #fbf8f2;
      font-weight: 700;
    }

    /* QUESTION CARDS */
    .question-card {
      background: var(--paper);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 20px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
      scroll-margin-top: 90px;
      transition: all 0.2s ease;
    }
    .question-card:hover {
      border-color: var(--border-dark);
    }
    .question-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--gold-dark);
      margin-bottom: 10px;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 8px;
    }
    .question-stem {
      font-size: 15.5px;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.6;
      margin-bottom: 16px;
    }

    /* MCQ OPTIONS GRID (DIRECT CARD INTERACTION) */
    .options-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 14px;
    }
    .opt-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 13px 18px;
      background: #ffffff;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
      position: relative;
      box-shadow: 0 1px 4px rgba(0,0,0,0.02);
    }
    .opt-card:hover:not(.locked) {
      transform: translateY(-2px);
      border-color: var(--gold);
      box-shadow: 0 6px 16px rgba(197, 155, 39, 0.18);
      background: #fffdf9;
    }
    .opt-card.selected {
      background: linear-gradient(135deg, #fffdf8 0%, #fef7e7 100%);
      border-color: var(--gold);
      box-shadow: 0 0 0 1.5px var(--gold), 0 5px 16px rgba(197, 155, 39, 0.22);
    }
    .opt-badge {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--paper-dark);
      border: 1.5px solid var(--border-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 14px;
      color: var(--ink);
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .opt-card.selected .opt-badge {
      background: linear-gradient(135deg, #d4af37, #996515);
      color: #140c08;
      border-color: #996515;
      font-weight: 900;
      box-shadow: 0 2px 6px rgba(153, 101, 21, 0.35);
    }
    .opt-text {
      font-size: 14.5px;
      color: var(--ink);
      flex: 1;
      line-height: 1.5;
    }
    .opt-card.selected .opt-text {
      font-weight: 600;
      color: #140c08;
    }
    .opt-indicator {
      margin-left: auto;
      flex-shrink: 0;
    }
    .selected-tag {
      font-size: 11.5px;
      font-weight: 700;
      color: #927014;
      background: rgba(197, 155, 39, 0.12);
      padding: 3px 10px;
      border-radius: 12px;
      border: 1px solid rgba(197, 155, 39, 0.3);
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }
    .result-badge {
      font-size: 11.5px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }
    .result-badge.correct-badge {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #86efac;
    }
    .result-badge.wrong-badge {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fca5a5;
    }

    /* MCQ REVIEW STATES (POST-SUBMIT) */
    .opt-card.is-correct {
      background: var(--green-light) !important;
      border-color: var(--green) !important;
      box-shadow: 0 0 0 1.5px var(--green) !important;
    }
    .opt-card.is-correct .opt-badge {
      background: var(--green) !important;
      color: #fff !important;
      border-color: var(--green) !important;
    }
    .opt-card.is-wrong {
      background: var(--red-light) !important;
      border-color: var(--red) !important;
      box-shadow: 0 0 0 1.5px var(--red) !important;
    }
    .opt-card.is-wrong .opt-badge {
      background: var(--red) !important;
      color: #fff !important;
      border-color: var(--red) !important;
    }

    /* PASSAGE CONTAINER */
    .passage-box {
      background: #f5eedf;
      border-left: 4px solid var(--gold);
      border-radius: 8px;
      padding: 16px 20px;
      margin-bottom: 18px;
      font-style: italic;
      color: #3b2f27;
      font-size: 14.5px;
      line-height: 1.7;
    }
    .passage-title {
      font-style: normal;
      font-weight: 800;
      font-size: 12px;
      color: var(--gold-dark);
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      text-transform: uppercase;
    }
    .passage-source {
      font-style: normal;
      font-size: 12px;
      color: var(--ink-muted);
      text-align: right;
      margin-top: 10px;
    }

    /* PART 2 STATEMENTS ROW WITH SEGMENTED CONTROL BAR */
    .statement-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 13px 16px;
      background: #ffffff;
      border: 1.5px solid var(--border);
      border-left: 4px solid #dcd3c3;
      border-radius: 12px;
      margin-bottom: 10px;
      transition: all 0.22s ease;
      box-shadow: 0 1px 4px rgba(0,0,0,0.02);
    }
    .statement-row.is-empty {
      border-left-color: #dcd3c3;
    }
    .statement-row.answered-true {
      border-left-color: var(--green);
      background: #f8fdf9;
    }
    .statement-row.answered-false {
      border-left-color: var(--red);
      background: #fff8f8;
    }
    @media (max-width: 720px) {
      .statement-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      .statement-control-cluster {
        width: 100%;
        justify-content: space-between;
      }
    }
    .statement-text {
      font-size: 14px;
      color: var(--ink);
      flex: 1;
      line-height: 1.55;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .stmt-letter {
      font-weight: 800;
      color: var(--gold-dark);
      font-size: 14.5px;
      flex-shrink: 0;
    }
    .stmt-body {
      flex: 1;
    }

    .statement-control-cluster {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .status-pill {
      font-size: 11.5px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      letter-spacing: 0.2px;
      white-space: nowrap;
      user-select: none;
    }
    .status-pill.status-empty {
      background: #f4ede1;
      color: #8c7e75;
      border: 1px dashed #cbbda7;
    }
    .status-pill.status-true {
      background: #eafaf1;
      color: #15803d;
      border: 1px solid #86efac;
    }
    .status-pill.status-false {
      background: #fdf2f2;
      color: #b91c1c;
      border: 1px solid #fca5a5;
    }
    .status-pill.status-review-correct {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #86efac;
    }
    .status-pill.status-review-wrong {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fca5a5;
    }

    .segmented-control {
      display: inline-flex;
      background: #ebe4d7;
      border: 1.5px solid var(--border-dark);
      border-radius: 9px;
      padding: 3px;
      gap: 3px;
      flex-shrink: 0;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.06);
    }
    .segmented-btn {
      border: none;
      background: transparent;
      padding: 7px 15px;
      font-size: 13px;
      font-weight: 700;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.18s ease;
      color: var(--ink-light);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      user-select: none;
    }
    .segmented-btn:hover:not(.locked) {
      background: rgba(255, 255, 255, 0.7);
      color: var(--ink);
    }
    .segmented-btn.btn-true.active-true {
      background: linear-gradient(135deg, #16a34a, #15803d);
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(21, 128, 61, 0.35);
      font-weight: 800;
    }
    .segmented-btn.btn-false.active-false {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(185, 28, 28, 0.35);
      font-weight: 800;
    }
    .statement-row.correct-row {
      border-color: #86efac;
      border-left: 5px solid #15803d;
      background: #f0fdf4;
    }
    .statement-row.wrong-row {
      border-color: #fca5a5;
      border-left: 5px solid #b91c1c;
      background: #fff8f8;
    }

    /* PART 3 ESSAY CONTAINER */
    .essay-card {
      background: var(--paper);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 20px;
    }
    .essay-textarea {
      width: 100%;
      min-height: 120px;
      padding: 12px 16px;
      font-family: inherit;
      font-size: 14px;
      line-height: 1.6;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      background: #fff;
      outline: none;
      resize: vertical;
      margin-top: 10px;
    }
    .essay-textarea:focus:not(:disabled) {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.2);
    }
    .essay-guide-box {
      background: #eff6ff;
      border-left: 4px solid var(--blue);
      border-radius: 8px;
      padding: 14px 18px;
      margin-top: 14px;
      font-size: 13.5px;
      color: #1e3a8a;
      line-height: 1.6;
    }

    /* EXPLANATION BOX */
    .explain-box {
      background: #fdfaf3;
      border: 1.5px solid #f2e3be;
      border-left: 4px solid var(--gold);
      border-radius: 8px;
      padding: 14px 18px;
      margin-top: 14px;
      font-size: 13.5px;
      color: #45372c;
      line-height: 1.6;
    }
    .explain-title {
      font-weight: 800;
      color: var(--gold-dark);
      font-size: 12.5px;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* TANG THU CAC WIDGET */
    .tang-thu-cac-widget {
      background: #fffbeb;
      border: 1.5px solid #fde68a;
      border-radius: 10px;
      padding: 12px 18px;
      margin-top: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .widget-title {
      font-size: 13px;
      font-weight: 700;
      color: #92400e;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .widget-btn {
      background: #b45309;
      color: #ffffff;
      border: none;
      padding: 6px 14px;
      font-size: 12.5px;
      font-weight: 700;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .widget-btn:hover {
      background: #92400e;
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(180, 83, 9, 0.25);
    }

    /* STICKY SIDEBAR */
    .exam-sticky-sidebar {
      position: sticky;
      top: 80px;
      background: var(--paper);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* COUNTDOWN TIMER 45 MINUTES */
    .timer-card {
      background: #20130d;
      border: 2px solid var(--gold);
      border-radius: 12px;
      padding: 14px;
      text-align: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }
    .timer-card-label {
      font-size: 11px;
      font-weight: 800;
      color: #dfd0be;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .timer-countdown {
      font-family: var(--font-serif);
      font-size: 32px;
      font-weight: 900;
      color: var(--gold);
      letter-spacing: 2px;
      line-height: 1.1;
      transition: all 0.3s ease;
    }
    @keyframes pulseUrgent {
      0% { transform: scale(1); opacity: 1; }
      100% { transform: scale(1.06); opacity: 0.85; }
    }
    .timer-countdown.urgent {
      color: #ef4444 !important;
      animation: pulseUrgent 0.8s infinite alternate ease-in-out;
    }
    .timer-card.urgent {
      border: 2px solid #ef4444 !important;
      background: #fef2f2 !important;
      box-shadow: 0 0 16px rgba(239, 68, 68, 0.25) !important;
    }

    @keyframes cardPulseGlow {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      50% { box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .question-card.pulse-highlight, .essay-card.pulse-highlight {
      animation: cardPulseGlow 0.9s ease-in-out 2;
      border-color: #ef4444 !important;
    }

    /* PROGRESS BAR */
    .progress-box {
      background: var(--paper-dark);
      border-radius: 10px;
      padding: 12px;
    }
    .progress-header {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .progress-track {
      height: 8px;
      background: var(--border);
      border-radius: 4px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--gold) 0%, #22c55e 100%);
      width: 0%;
      transition: width 0.3s ease;
    }

    /* QUESTION PALETTE */
    .palette-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .palette-title {
      font-size: 12px;
      font-weight: 800;
      color: var(--ink-light);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .palette-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
      max-height: 240px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .palette-dot {
      aspect-ratio: 1;
      background: var(--paper-card);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: var(--ink-light);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .palette-dot:hover {
      border-color: var(--gold);
      transform: scale(1.08);
    }
    .palette-dot.answered {
      background: var(--gold);
      color: var(--bg);
      border-color: var(--gold);
    }
    .palette-dot.dot-correct {
      background: var(--green) !important;
      color: #fff !important;
      border-color: var(--green) !important;
    }
    .palette-dot.dot-wrong {
      background: var(--red) !important;
      color: #fff !important;
      border-color: var(--red) !important;
    }

    .sidebar-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 6px;
    }
    .submit-exam-btn {
      width: 100%;
      background: var(--red);
      color: #fff;
      border: none;
      padding: 12px;
      font-weight: 800;
      font-size: 14px;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.3);
      transition: all 0.2s ease;
    }
    .submit-exam-btn:hover {
      background: #991b1b;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(185, 28, 28, 0.4);
    }
    .sidebar-back-btn {
      width: 100%;
      background: var(--paper-dark);
      color: var(--ink);
      border: 1px solid var(--border-dark);
      padding: 10px;
      font-weight: 700;
      font-size: 12.5px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .sidebar-back-btn:hover {
      background: #e5ded3;
    }

    /* TOP SUMMARY BOARD (RESULT) */
    .result-summary-box {
      background: linear-gradient(135deg, #ffffff 0%, #fbf8f2 100%);
      border: 2.5px solid var(--gold);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 28px;
      box-shadow: 0 10px 30px rgba(197, 155, 39, 0.2);
      text-align: center;
    }
    .grand-score-circle {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: linear-gradient(135deg, #20130d 0%, #301d14 100%);
      border: 3px solid var(--gold);
      color: var(--gold);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }
    .grand-score-circle strong {
      font-size: 38px;
      font-family: var(--font-serif);
      font-weight: 900;
      line-height: 1;
    }
    .grand-score-circle small {
      font-size: 11px;
      color: #dfd0be;
    }
    .result-rank-title {
      font-family: var(--font-serif);
      font-size: 22px;
      color: var(--gold-dark);
      margin-bottom: 6px;
    }
    .result-comment {
      font-size: 14px;
      color: var(--ink-light);
      margin-bottom: 18px;
      max-width: 650px;
      margin-left: auto;
      margin-right: auto;
    }
    .result-stats-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .stat-pill {
      background: var(--paper-dark);
      border: 1px solid var(--border-dark);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
    }
    .result-actions-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }

    /* ROADMAP REVIEW BOX */
    .roadmap-review-box {
      background: var(--paper);
      border: 2px solid var(--gold);
      border-radius: 16px;
      padding: 26px 28px;
      margin-top: 36px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    .roadmap-title {
      font-family: var(--font-serif);
      font-size: 20px;
      color: var(--gold-dark);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .roadmap-desc {
      font-size: 14px;
      color: var(--ink-light);
      margin-bottom: 20px;
    }
    .roadmap-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .roadmap-item {
      background: #ffffff;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .roadmap-item-info h4 {
      font-size: 15px;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .roadmap-item-info p {
      font-size: 13px;
      color: var(--red);
      font-weight: 600;
    }
    .roadmap-link-btn {
      background: var(--gold);
      color: var(--bg);
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .roadmap-link-btn:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(197, 155, 39, 0.35);
    }

    /* CONFIRMATION MODAL */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 6, 4, 0.85);
      backdrop-filter: blur(8px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .confirmation-box {
      background: var(--paper);
      border: 3px solid var(--gold);
      border-radius: 16px;
      max-width: 540px;
      width: 100%;
      padding: 30px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.6);
      transform: scale(0.95);
      transition: transform 0.25s ease;
      text-align: center;
    }
    .modal-overlay.active .confirmation-box {
      transform: scale(1);
    }
    .modal-icon {
      font-size: 42px;
      margin-bottom: 12px;
    }
    .modal-title {
      font-family: var(--font-serif);
      font-size: 22px;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .modal-time-left {
      font-size: 16px;
      font-weight: 800;
      color: var(--gold-dark);
      background: #fdfaf3;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 16px;
      margin: 14px 0;
    }
    .modal-audit-box {
      text-align: left;
      font-size: 13.5px;
      margin: 16px 0 24px;
      max-height: 180px;
      overflow-y: auto;
      padding: 10px 14px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .modal-actions {
      display: flex;
      gap: 12px;
    }
    .modal-btn {
      flex: 1;
      padding: 12px 18px;
      font-size: 14px;
      font-weight: 800;
      border-radius: 8px;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
    }
    .modal-btn.continue {
      background: var(--paper-dark);
      color: var(--ink);
      border: 1.5px solid var(--border-dark);
    }
    .modal-btn.continue:hover {
      background: #e2d9cd;
    }
    .modal-btn.confirm {
      background: var(--red);
      color: #fff;
    }
    .modal-btn.confirm:hover {
      background: #991b1b;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.4);
    }

    /* FOOTER */
    .footer {
      background: #0f0906;
      border-top: 1px solid rgba(197, 155, 39, 0.3);
      padding: 30px 24px;
      text-align: center;
      color: #8c7e75;
      font-size: 12.5px;
      line-height: 1.8;
      margin-top: auto;
    }
    .footer strong { color: var(--gold); }
  </style>
</head>
