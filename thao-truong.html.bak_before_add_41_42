              </button>
              <button type="button" class="segmented-btn btn-false ${falseActive}" 
                      id="seg-false-${i}-${letKey}" 
                      onclick="selectP2Statement(${i}, '${letKey}', false)"
                      title="Chọn mệnh đề ${stmt.letter.toUpperCase()} là SAI">
                <span class="seg-cross">✗</span> Sai
              </button>
            </div>
          </div>
        </div>
        <div id="feedback-stmt-${i}-${letKey}"></div>
      `;
    }).join('');

    card.innerHTML = `
      <div class="question-meta">
        <span>Đoạn ${i + 1} / ${currentExam.part2.length} (Đọc hiểu tư liệu Đúng / Sai)</span>
