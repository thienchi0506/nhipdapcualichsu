// =========================================================================
// 3. CATALOG RENDERING & FILTERING
// =========================================================================
function renderCatalog(filter = 'all', searchQuery = '') {
  const grid = $('exam-catalog-grid');
  grid.innerHTML = '';
  
  const query = searchQuery.trim().toLowerCase();
  const filtered = EXAMS_DATA.filter(ex => {
    let matchesTab = false;
    if (filter === 'all') matchesTab = true;
    else matchesTab = (ex.category === filter || ex.id === filter);

    const matchesSearch = !query || 
      ex.title.toLowerCase().includes(query) || 
      ex.topic.toLowerCase().includes(query) || 
      ex.desc.toLowerCase().includes(query) || 
      (ex.badge && ex.badge.toLowerCase().includes(query));
    return matchesTab && matchesSearch;
  });

  if (filtered.length === 0) {
    grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--ink-light);">Không tìm thấy bộ đề phù hợp với tiêu chí lọc.</div>';
    return;
  }

  const frag = document.createDocumentFragment();
  filtered.forEach(ex => {
    const card = document.createElement('div');
    card.className = 'exam-card';
    
    const bestScore = localStorage.getItem('thao_truong_best_' + ex.id);
    const scoreBadge = bestScore !== null ? `<span style="font-size: 11px; font-weight: 700; color: var(--green); background: var(--green-light); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--green);">Kỷ lục: ${bestScore}/10đ</span>` : '';
    const p3Count = ex.essays ? ex.essays.length : (ex.part3 ? ex.part3.length : 0);

    card.innerHTML = `
      <div class="exam-card-header">
        <span class="exam-badge" title="${ex.badge}">${ex.badge.length > 36 ? ex.badge.slice(0, 33) + '...' : ex.badge}</span>
        <div class="exam-time">⏱️ 45 Phút</div>
      </div>
      <h3>${ex.title}</h3>
      <div class="exam-topic">📌 ${ex.topic}</div>
      <p class="exam-desc">${ex.desc}</p>
      <div class="exam-specs">
        ${ex.part1 && ex.part1.length > 0 ? `<div><span>Phần I (Trắc nghiệm nhiều lựa chọn):</span> <strong>${ex.part1.length} câu (${ex.part2 && ex.part2.length > 0 ? '6.0' : '10.0'} điểm)</strong></div>` : ''}
        ${ex.part2 && ex.part2.length > 0 ? `<div><span>Phần II (Trắc nghiệm Đúng/Sai tư liệu):</span> <strong>${ex.part2.length} đoạn · ${ex.part2.length * 4} ý (4.0 điểm)</strong></div>` : ''}
        ${p3Count > 0 ? `<div><span>Phần III (Tự luận & Gợi ý chấm):</span> <strong>${p3Count} câu chuyên sâu</strong></div>` : ''}
        <div><span>Bộ sách:</span> <strong>${ex.book || 'Dùng chung 3 bộ sách'}</strong></div>
      </div>
      ${scoreBadge ? `<div style="margin-bottom: 12px;">${scoreBadge}</div>` : ''}
      <div class="exam-card-actions">
        <button class="start-btn" onclick="startExam('${ex.id}')">⚔️ Vào Khảo Thí (Cuộn Liền Mạch) ➔</button>
      </div>
    `;
    frag.appendChild(card);
  });
  grid.appendChild(frag);
}

// FILTER BUTTONS EVENT
document.querySelectorAll('.filter-tab').forEach(btn => {
  btn.onclick = () => {
    document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderCatalog(btn.dataset.filter, $('search-input').value);
  };
});
$('search-input').oninput = e => {
  const activeTab = document.querySelector('.filter-tab.active');
  const filter = activeTab ? activeTab.dataset.filter : 'all';
  renderCatalog(filter, e.target.value);
};

// =========================================================================
// 4. START EXAM (CONTINUOUS SCROLL LAYOUT & 45 MINUTE TIMER)
// =========================================================================
function startExam(examId) {
  currentExam = EXAMS_DATA.find(e => e.id === examId);
  if (!currentExam) return;

  isSubmitted = false;
  userAnswersP1 = new Array(currentExam.part1.length).fill(null);
  userAnswersP2 = currentExam.part2.map(() => ({ a: null, b: null, c: null, d: null }));
  const essaysList = currentExam.essays || currentExam.part3 || [];
  userAnswersP3 = new Array(essaysList.length).fill('');

  timerSeconds = STANDARD_TIME; // 45 phút
  elapsedSeconds = 0;

  // Header information
  $('active-exam-title').textContent = currentExam.title;
  $('active-exam-badge').textContent = currentExam.badge;
  const p3Count = essaysList.length;
  const p1L = currentExam.part1 ? currentExam.part1.length : 0;
  const p2L = currentExam.part2 ? currentExam.part2.length : 0;
  let specsText = '';
  if (p1L > 0 && p2L > 0) {
    specsText = `${p1L} Câu TN · ${p2L} Đoạn Tư Liệu (${p2L * 4} Ý)${p3Count > 0 ? ` · ${p3Count} Câu Tự Luận` : ''}`;
  } else if (p1L > 0 && p2L === 0) {
    specsText = `${p1L} Câu TN Nhiều Lựa Chọn${p3Count > 0 ? ` · ${p3Count} Câu Tự Luận` : ''}`;
  } else if (p1L === 0 && p2L === 0 && p3Count > 0) {
    specsText = `${p3Count} Câu Tự Luận Chuyên Sâu (HSG) kèm Thang Điểm`;
  }
  $('active-exam-specs').textContent = specsText;

  // Hide review summary & roadmap boxes
  $('result-summary-box').style.display = 'none';
  $('roadmap-review-box').style.display = 'none';
  $('bottom-submit-wrapper').style.display = 'block';

  // Render continuous scroll lists
  renderPart1Continuous();
  renderPart2Continuous();
  renderPart3Continuous();

  // Setup sidebar palette & progress
  setupPaletteAndProgress();

  showScreen('screen-exam');
  startTimer45Min();
}

