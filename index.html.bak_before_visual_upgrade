        //  3. CẤU HÌNH & XỬ LÝ CHUYỂN CẢNH BẰNG VIDEO
        // ==========================================================================

        const DANH_SACH_VIDEO = [
            {
                src: 'video1.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4',
