            {
                src: 'video3.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/WeAreGoingOnBullrun.mp4',
                tieuDe: 'Hào Khí Thăng Long — Ngàn Năm Văn Hiến',
                moTa: 'Bốn ngàn năm lịch sử hào hùng — Dấu chân tiền nhân dựng nước và giữ nước trường tồn.'
            }
        ];

        const CHE_DO_CHON_VIDEO = 'ngau_nhien';
        const TRANG_DICH = 'trang-chinh.html';

        var videoDaKetThuc = false;
        var videoElement = null;

        /**
         * Lấy video cho lượt click này (đảm bảo khác video lượt trước)
         */
        function layVideoTiepTheo() {
            if (!DANH_SACH_VIDEO || DANH_SACH_VIDEO.length === 0) return null;
            if (DANH_SACH_VIDEO.length === 1) return DANH_SACH_VIDEO[0];

            var lastIndex = parseInt(sessionStorage.getItem('lichSuVideoIndex'), 10);
            if (isNaN(lastIndex)) lastIndex = -1;

            var newIndex;
            if (CHE_DO_CHON_VIDEO === 'xoay_vong') {
                newIndex = (lastIndex + 1) % DANH_SACH_VIDEO.length;
            } else {
                do {
                    newIndex = Math.floor(Math.random() * DANH_SACH_VIDEO.length);
                } while (newIndex === lastIndex);
            }

            sessionStorage.setItem('lichSuVideoIndex', newIndex);
            console.log('🎬 Chọn video #' + (newIndex + 1) + ': ' + DANH_SACH_VIDEO[newIndex].tieuDe);
            return DANH_SACH_VIDEO[newIndex];
        }

        /**
         * Chuyển hướng sang trang chính (khi video kết thúc hoặc người dùng bấm/nhấp chuột bỏ qua)
         * (Yêu cầu 4: Bỏ qua video khi nhấp chuột vào bất cứ đâu)
         */
        function ketThucChuyenCanh(event) {
            if (event) event.stopPropagation();
            if (videoDaKetThuc) return;
            videoDaKetThuc = true;

            // Lưu chính xác tiến trình nhạc trước khi chuyển hướng
            var nhac = document.getElementById('bg-music');
            if (nhac && !nhac.paused) {
                localStorage.setItem('audioTime', nhac.currentTime);
                localStorage.setItem('nhacDangPhat', 'true');
            }

            // Giữ nguyên màn hình chuyển cảnh màu đen che phủ toàn bộ trang index,
            // TUYỆT ĐỐI KHÔNG làm mờ (opacity: 0) để không làm lộ lại trang index trong lúc chuyển sang trang-chinh
            var transition = document.getElementById('page-transition');
            if (transition) {
                transition.classList.add('active');
                transition.style.opacity = '1';
                transition.style.background = '#000';
            }

            // Ẩn thanh tiến trình và dòng chữ gợi ý để màn hình chuyển cảnh sạch sẽ
            var hint = document.querySelector('.page-transition__hint');
            if (hint) hint.style.display = 'none';
            var track = document.querySelector('.page-transition__progress-track');
            if (track) track.style.display = 'none';

            if (videoElement) {
                videoElement.pause();
                videoElement.style.transition = 'opacity 0.2s ease';
                videoElement.style.opacity = '0';
            }

            sessionStorage.setItem('vuaXemVideo', 'true');
            sessionStorage.setItem('daXemChuyenCanh', 'true');

            // Chuyển ngay lập tức sang trang chính, không dùng setTimeout làm lộ trang index
            window.location.href = TRANG_DICH;
        }

        // Đảm bảo khi người dùng nhấn nút Back quay lại trang index thì giao diện được phục hồi bình thường
        window.addEventListener('pageshow', function(event) {
            videoDaKetThuc = false;
            var transition = document.getElementById('page-transition');
            if (transition) {
                transition.classList.remove('active');
                transition.style.opacity = '0';
            }
            var hint = document.querySelector('.page-transition__hint');
            if (hint) hint.style.display = '';
            var track = document.querySelector('.page-transition__progress-track');
            if (track) track.style.display = '';
            if (videoElement) {
                videoElement.style.opacity = '1';
            }
        });

        /**
         * Xử lý khi người dùng nhấn nút "⚔️ BẮT ĐẦU HÀNH TRÌNH"
         */
        function batDauHanhTrinh(event) {
            if (event) event.preventDefault();

            // =========================================================================
            // YÊU CẦU 1: TUYỆT ĐỐI KHÔNG dùng nhac.pause() ở đây.
            // Nhạc nền tiếp tục phát trong lúc xem video chuyển cảnh.
            // Nếu nhạc chưa chạy do trình duyệt chặn trước đó, kích hoạt phát nhạc ngay:
            // =========================================================================
            var nhacNen = document.getElementById('bg-music');
            if (nhacNen && nhacNen.paused && localStorage.getItem('nhacDangPhat') !== 'false') {
                nhacNen.play().then(function() {
                    dangPhatNhac = true;
                    var bars = document.getElementById('sound-bars');
                    if (bars) bars.classList.add('playing');
                    var text = document.getElementById('audio-text');
                    if (text) text.textContent = 'Đang phát';
                    localStorage.setItem('nhacDangPhat', 'true');
                }).catch(function(e) {
                    console.warn('Không thể tự động phát nhạc:', e);
                });
            }

            videoDaKetThuc = false;
            var transition = document.getElementById('page-transition');
            videoElement = document.getElementById('transition-video');
            var progressBar = document.getElementById('trans-progress');

            // 1. Lấy video cho lần bấm này
            var currentVideo = layVideoTiepTheo();
            if (!currentVideo) {
                window.location.href = TRANG_DICH;
                return;
            }

            if (progressBar) progressBar.style.width = '0%';

            // 2. Hiện overlay chuyển cảnh toàn màn hình
            transition.classList.add('active');
            transition.style.opacity = '1';

            // 3. Cơ chế tự động thử link nội bộ trước, nếu lỗi chuyển sang dự phòng online
            var daThuFallback = false;

            videoElement.onerror = function() {
                console.warn('Không tìm thấy hoặc lỗi video từ nguồn:', videoElement.src);
                if (!daThuFallback && currentVideo.fallbackSrc && videoElement.src !== currentVideo.fallbackSrc) {
                    daThuFallback = true;
                    console.log('🔄 Đang chuyển sang video dự phòng:', currentVideo.fallbackSrc);
                    videoElement.src = currentVideo.fallbackSrc;
                    videoElement.load();
                    videoElement.play().catch(function() {
                        ketThucChuyenCanh();
                    });
                } else {
                    ketThucChuyenCanh();
                }
            };

            // 4. Thanh tiến trình chạy theo thời gian thực của video
            videoElement.ontimeupdate = function() {
                if (videoElement.duration && progressBar) {
                    var phanTram = (videoElement.currentTime / videoElement.duration) * 100;
                    progressBar.style.width = phanTram + '%';
                }
            };

            // 5. Khi video kết thúc -> tự động chuyển vào Sảnh chính
            videoElement.onended = function() {
                ketThucChuyenCanh();
            };

            // =========================================================================
            // YÊU CẦU 2: Đảm bảo video chuyển cảnh luôn có muted (tắt tiếng)
            // =========================================================================
            videoElement.muted = true;
            videoElement.src = currentVideo.src;
            videoElement.load();

            var playPromise = videoElement.play();
            if (playPromise !== undefined) {
                playPromise.catch(function(err) {
                    console.warn('Trình duyệt cần thử video dự phòng hoặc bị chặn:', err);
                    if (currentVideo.fallbackSrc && !daThuFallback) {
                        daThuFallback = true;
                        videoElement.src = currentVideo.fallbackSrc;
                        videoElement.load();
                        videoElement.play().catch(function() {
                            ketThucChuyenCanh();
                        });
                    } else {
                        ketThucChuyenCanh();
                    }
                });
            }

            // An toàn: Tối đa 15 giây nếu video bị treo thì tự động chuyển trang
            setTimeout(function() {
                if (!videoDaKetThuc) {
                    ketThucChuyenCanh();
                }
            }, 15000);
        }
    </script>
</body>
</html>