    <!-- ============================================================ -->
    <!--  JAVASCRIPT TỔNG HỢP & TỰ ĐỘNG PHÁT NHẠC / VIDEO CHUYỂN CẢNH -->
    <!-- ============================================================ -->
    <script>
        // ===================================================
        //  1. HIỂN THỊ TÊN NGƯỜI DÙNG (nếu đã đăng nhập)
        // ===================================================
        document.addEventListener('DOMContentLoaded', function() {
            var ten = localStorage.getItem('tenNguoiDung');
            if (ten) {
                var elTen = document.getElementById('ten-nguoi-dung');
                if (elTen) elTen.textContent = ten;

                var btnAuth = document.getElementById('btn-auth');
                if (btnAuth) {
                    btnAuth.textContent = '👤 ' + ten;
                    btnAuth.href = '#';
                    btnAuth.title = 'Bạn đã đăng nhập';
                }
            }
        });


        // ===================================================
        //  2. QUẢN LÝ NHẠC NỀN & TỰ ĐỘNG PHÁT THÔNG MINH
        // ===================================================
        var dangPhatNhac = false;

        function capNhatTrangThaiNutNhac(dangPhat) {
            var trangThai = document.getElementById('trang-thai-nhac');
            if (trangThai) {
                trangThai.textContent = dangPhat ? 'Tắt Nhạc' : 'Nhạc Nền';
            }
        }

        function toggleNhac() {
            var nhac = document.getElementById('bg-music');
            if (!nhac) return;

            if (!nhac.paused) {
                nhac.pause();
                dangPhatNhac = false;
                capNhatTrangThaiNutNhac(false);
                localStorage.setItem('nhacDangPhat', 'false');
            } else {
                nhac.muted = false;
                nhac.play().then(function() {
                    dangPhatNhac = true;
                    capNhatTrangThaiNutNhac(true);
                    localStorage.setItem('nhacDangPhat', 'true');
                }).catch(function(err) {
                    console.warn('Không thể phát nhạc:', err);
                });
            }
        }

        // ===================================================
        //  2.1 TỰ ĐỘNG TẮT NHẠC KHI RỜI TAB / THOÁT TRÌNH DUYỆT
        // ===================================================
        document.addEventListener('visibilitychange', function() {
            var nhac = document.getElementById('bg-music');
            if (!nhac) return;

            if (document.hidden) {
                // Người dùng chuyển sang tab khác hoặc thu nhỏ trình duyệt -> Tắt nhạc ngay
                if (!nhac.paused) {
                    localStorage.setItem('audioTime', nhac.currentTime);
                    nhac.pause();
                }
            } else {
                // Người dùng quay lại tab web -> Tự động phát tiếp nếu trạng thái trước đó đang bật
                var trangThaiNhac = localStorage.getItem('nhacDangPhat');
                if (trangThaiNhac !== 'false') {
                    var savedTime = localStorage.getItem('audioTime');
                    if (savedTime && isFinite(savedTime)) {
                        nhac.currentTime = parseFloat(savedTime);
                    }
                    nhac.play().then(function() {
                        dangPhatNhac = true;
                        capNhatTrangThaiNutNhac(true);
                    }).catch(function(e) {
                        console.log('Chờ tương tác để phát tiếp nhạc:', e);
                    });
                }
            }
        });

        // Tắt nhạc ngay khi đóng tab, tải lại trang hoặc điều hướng thoát web
        window.addEventListener('pagehide', function() {
            var nhac = document.getElementById('bg-music');
            if (nhac) {
                localStorage.setItem('audioTime', nhac.currentTime);
                nhac.pause();
            }
        });

        window.addEventListener('beforeunload', function() {
            var nhac = document.getElementById('bg-music');
            if (nhac) {
                localStorage.setItem('audioTime', nhac.currentTime);
                nhac.pause();
            }
        });


        function kichHoatNhacNenTuDong() {
            var nhac = document.getElementById('bg-music');
            if (!nhac) return;

            var savedTime = localStorage.getItem('audioTime');
            if (savedTime && isFinite(savedTime)) {
                nhac.currentTime = parseFloat(savedTime);
            }

            var trangThaiNhac = localStorage.getItem('nhacDangPhat');
            // Mặc định luôn tự động phát nhạc nếu người dùng chưa bấm tắt thủ công
            if (trangThaiNhac !== 'false') {
                var p = nhac.play();
                if (p !== undefined) {
                    p.then(function() {
                        dangPhatNhac = true;
                        capNhatTrangThaiNutNhac(true);
                        localStorage.setItem('nhacDangPhat', 'true');
                    }).catch(function() {
                        console.log('Trình duyệt cần tương tác để mở tiếng, sẵn sàng mở tiếng ngay.');
                        // Tự động phát với muted để sẵn sàng và mở tiếng ngay cử chỉ đầu tiên
                        nhac.muted = true;
                        nhac.play().then(function() {
                            var moTieng = function() {
                                nhac.muted = false;
                                dangPhatNhac = true;
                                capNhatTrangThaiNutNhac(true);
                                localStorage.setItem('nhacDangPhat', 'true');
                                ['click', 'touchstart', 'pointerdown', 'mousemove', 'keydown', 'scroll'].forEach(function(e) {
                                    window.removeEventListener(e, moTieng);
                                });
                            };
                            ['click', 'touchstart', 'pointerdown', 'mousemove', 'keydown', 'scroll'].forEach(function(e) {
                                window.addEventListener(e, moTieng, { once: true, passive: true });
                            });
                        }).catch(function() {
                            var batNhac = function() {
                                nhac.muted = false;
                                nhac.play().then(function() {
                                    dangPhatNhac = true;
                                    capNhatTrangThaiNutNhac(true);
                                    localStorage.setItem('nhacDangPhat', 'true');
                                }).catch(function() {});
                                ['click', 'touchstart', 'pointerdown', 'keydown'].forEach(function(e) {
                                    window.removeEventListener(e, batNhac);
                                });
                            };
                            ['click', 'touchstart', 'pointerdown', 'keydown'].forEach(function(e) {
                                window.addEventListener(e, batNhac, { once: true });
                            });
                        });
                    });
                }
            }
        }


        // ===================================================
        //  3. MÀN CHUYỂN CẢNH BẰNG VIDEO (Cinematic Transition)
        // ===================================================
        const DANH_SACH_VIDEO_CHUYEN_CANH = [
            {
                src: 'video1.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4',
                tieuDe: 'Khúc Tráng Ca Lịch Sử — Điện Biên Phủ Hào Hùng'
            },
            {
                src: 'video2.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4',
                tieuDe: 'Bạch Đằng Giang Dậy Sóng — Ngô Quyền Đại Thắng'
            },
            {
                src: 'video3.mp4',
                fallbackSrc: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/WeAreGoingOnBullrun.mp4',
                tieuDe: 'Hào Khí Thăng Long — Ngàn Năm Văn Hiến'
            }
        ];

        var daKetThucVideo = false;

        // [YÊU CẦU 2] Chọn ngẫu nhiên 1 video bất kỳ trong danh sách mảng video có sẵn bằng Math.random()
        function layVideoChuyenCanhNgauNhien() {
            var indexNgauNhien = Math.floor(Math.random() * DANH_SACH_VIDEO_CHUYEN_CANH.length);
            return DANH_SACH_VIDEO_CHUYEN_CANH[indexNgauNhien];
        }

        function ketThucChuyenCanhVideo(event) {
            if (event) event.stopPropagation();
            if (daKetThucVideo) return;
            daKetThucVideo = true;

            // [YÊU CẦU 1] Ghi nhận đã xem/bỏ qua vào sessionStorage để KHÔNG BAO GIỜ phát lại khi quay về trang chính
            sessionStorage.setItem('daXemChuyenCanh', 'true');

            var video = document.getElementById('transition-video');
            var overlay = document.getElementById('page-transition');

            if (video) video.pause();

            // Kích hoạt ngay nhạc nền khi người dùng tương tác chuyển cảnh
            var nhac = document.getElementById('bg-music');
            if (nhac && (nhac.paused || nhac.muted) && localStorage.getItem('nhacDangPhat') !== 'false') {
                nhac.muted = false;
                nhac.play().then(function() {
                    dangPhatNhac = true;
                    capNhatTrangThaiNutNhac(true);
                    localStorage.setItem('nhacDangPhat', 'true');
                }).catch(function(e) { console.log(e); });
            }

            if (overlay) {
                overlay.style.transition = 'opacity 0.5s ease';
                overlay.style.opacity = '0';
                setTimeout(function() {
                    overlay.style.display = 'none';
                    overlay.classList.remove('active');
                }, 550);
            }
        }

        function khoiChayVideoChuyenCanh() {
            var overlay = document.getElementById('page-transition');
            var video = document.getElementById('transition-video');
            var progress = document.getElementById('trans-progress');
            if (!overlay || !video) return;

            // [YÊU CẦU 2] Dùng Math.random() chọn ngẫu nhiên một video bất kỳ
            var videoChon = layVideoChuyenCanhNgauNhien();
            console.log('🎬 Phát ngẫu nhiên video chuyển cảnh:', videoChon.src, '—', videoChon.tieuDe);

            // Gán nguồn video ngẫu nhiên đã chọn
            video.src = videoChon.src;
            video.load();

            overlay.style.display = 'flex';
            overlay.classList.add('active');
            overlay.style.opacity = '1';

            video.ontimeupdate = function() {
                if (video.duration && progress) {
                    var pct = (video.currentTime / video.duration) * 100;
                    progress.style.width = pct + '%';
                }
            };

            video.onended = function() {
                ketThucChuyenCanhVideo();
            };

            // Tự động chuyển fallback online nếu file cục bộ lỗi
            video.onerror = function() {
                console.warn('Lỗi nạp video cục bộ, chuyển sang video dự phòng hoặc kết thúc chuyển cảnh');
                if (videoChon.fallbackSrc && video.src !== videoChon.fallbackSrc) {
                    video.src = videoChon.fallbackSrc;
                    video.load();
                    video.play().catch(function() {
                        ketThucChuyenCanhVideo();
                    });
                } else {
                    ketThucChuyenCanhVideo();
                }
            };

            // Muted để trình duyệt luôn cho phép tự động phát video
            video.muted = true;
            var playPromise = video.play();
            if (playPromise !== undefined) {
                playPromise.catch(function(err) {
                    console.warn('Trình duyệt cần tương tác để bắt đầu video:', err);
                });
            }

            // Tự động kết thúc nếu video kéo dài hoặc mạng chậm quá 12 giây
            setTimeout(function() {
                if (!daKetThucVideo) {
                    ketThucChuyenCanhVideo();
                }
            }, 12000);
        }

        // [YÊU CẦU 1] Hàm kiểm tra trạng thái chuyển cảnh ngay khi mở trang chính
        function kiemTraVaXuLyChuyenCanh() {
            var daXemChuyenCanh = sessionStorage.getItem('daXemChuyenCanh') === 'true';
            var vuaXemTuSplash = sessionStorage.getItem('vuaXemVideo') === 'true';
            var urlParams = new URLSearchParams(window.location.search);
            var skipVideo = urlParams.get('skip') === 'true';

            var overlay = document.getElementById('page-transition');

