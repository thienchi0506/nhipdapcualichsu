    <!-- =========================================================
         KỊCH BẢN NÂNG CẤP ĐỘT PHÁ GIAO DIỆN THỊ GIÁC
         1. 3D Mouse Parallax & Hào quang Trống Đồng (.welcome-banner)
         2. 3D Tilt Cards & Vệt Sáng Ánh Kim (.cards-grid)
         3. Con trỏ chuột 'Đốm Lửa Lịch Sử' (Golden Ember Trail)
         ========================================================= -->
    <script>
    (function() {
        // --- 1. HIỆU ỨNG 3D MOUSE PARALLAX CHO WELCOME BANNER & TRỐNG ĐỒNG ---
        var banner = document.getElementById('welcome-banner-3d');
        var bannerBg = document.getElementById('banner-bg-layer');
        var bannerHalo = document.getElementById('banner-halo');
        var bannerDrumWrap = document.getElementById('banner-drum-wrap');
        var bannerContent = document.getElementById('banner-content');

        if (banner && bannerBg && bannerHalo && bannerContent) {
            banner.addEventListener('mousemove', function(e) {
                if (window.matchMedia && window.matchMedia('(hover: none)').matches) return;
                var rect = banner.getBoundingClientRect();
                var x = e.clientX - rect.left;
                var y = e.clientY - rect.top;
                var normX = (x / rect.width - 0.5) * 2; // -1 -> 1
                var normY = (y / rect.height - 0.5) * 2; // -1 -> 1

                // Nền trống đồng di chuyển nghịch hướng tạo chiều sâu
                var bgX = -normX * 22;
                var bgY = -normY * 16;
                bannerBg.style.transform = 'translate3d(' + bgX.toFixed(2) + 'px, ' + bgY.toFixed(2) + 'px, 0) scale(1.06)';

                // Vòng hào quang vàng kim dịch chuyển theo tâm ánh sáng
                var haloX = normX * 35;
                var haloY = normY * 26;
                bannerHalo.style.transform = 'translate3d(' + haloX.toFixed(2) + 'px, ' + haloY.toFixed(2) + 'px, 0)';

                // Mặt trống đồng Vector di chuyển nhẹ tạo chiều sâu nổi khối
                if (bannerDrumWrap) {
                    var drumX = normX * 18;
                    var drumY = normY * 14;
                    bannerDrumWrap.style.transform = 'translate3d(' + drumX.toFixed(2) + 'px, ' + drumY.toFixed(2) + 'px, 0) scale(1.02)';
                }

                // Chữ và tiêu đề nghiêng 3D tạo khối nổi bật
                var rotX = -normY * 6.5;
                var rotY = normX * 8.5;
                bannerContent.style.transform = 'perspective(900px) rotateX(' + rotX.toFixed(2) + 'deg) rotateY(' + rotY.toFixed(2) + 'deg) translateZ(24px)';
            });

            banner.addEventListener('mouseleave', function() {
                bannerBg.style.transition = 'transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';
                bannerHalo.style.transition = 'transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';
                if (bannerDrumWrap) bannerDrumWrap.style.transition = 'transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';
                bannerContent.style.transition = 'transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';

                bannerBg.style.transform = 'translate3d(0, 0, 0) scale(1)';
                bannerHalo.style.transform = 'translate3d(0, 0, 0)';
                if (bannerDrumWrap) bannerDrumWrap.style.transform = 'translate3d(0, 0, 0) scale(1)';
                bannerContent.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateZ(0)';

                setTimeout(function() {
                    bannerBg.style.transition = 'transform 0.12s ease-out';
                    bannerHalo.style.transition = 'transform 0.18s ease-out';
                    if (bannerDrumWrap) bannerDrumWrap.style.transition = 'transform 0.15s ease-out';
                    bannerContent.style.transition = 'transform 0.12s ease-out';
                }, 600);
            });
        }

        // --- 1.1 HIỆU ỨNG HẠT BỤI VÀNG LƠ LỬNG BẰNG CANVAS (GOLD DUST) ---
        (function initGoldDustCanvas() {
            if (window.self !== window.top) return;
            var canvas = document.getElementById('banner-gold-dust');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = 560, h = 560, particles = [];
            var dpr = Math.min(window.devicePixelRatio || 1, 2);

            function getTargetParticleCount() {
                return (window.innerWidth <= 768) ? 35 : 80;
            }

            function createParticle() {
                return {
                    x: Math.random() * w,
                    y: Math.random() * h,
                    r: Math.random() * 2 + 0.8,
                    speedY: Math.random() * 0.45 + 0.2,
                    speedX: (Math.random() - 0.5) * 0.35,
                    alpha: Math.random() * 0.7 + 0.3,
                    fadeSpeed: Math.random() * 0.015 + 0.005,
                    growing: Math.random() > 0.5
                };
            }

            function resize() {
                var rect = canvas.getBoundingClientRect();
                var cssW = rect.width || canvas.offsetWidth || 560;
                var cssH = rect.height || canvas.offsetHeight || 560;
                dpr = Math.min(window.devicePixelRatio || 1, 2);
                w = cssW;
                h = cssH;
                canvas.width = Math.round(cssW * dpr);
                canvas.height = Math.round(cssH * dpr);

                var targetCount = getTargetParticleCount();
                if (particles.length > targetCount) {
                    particles.length = targetCount;
                } else {
                    while (particles.length < targetCount) {
                        particles.push(createParticle());
                    }
                }
            }
            resize();
            window.addEventListener('resize', resize);

            var initialCount = getTargetParticleCount();
            for (var i = 0; i < initialCount; i++) {
                particles.push(createParticle());
            }

            function animate() {
                ctx.save();
                ctx.setTransform(1, 0, 0, 1, 0, 0);
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.scale(dpr, dpr);

                for (var i = 0; i < particles.length; i++) {
                    var p = particles[i];
                    p.y -= p.speedY;
                    p.x += p.speedX;

                    if (p.growing) {
                        p.alpha += p.fadeSpeed;
                        if (p.alpha >= 0.9) p.growing = false;
                    } else {
                        p.alpha -= p.fadeSpeed;
                        if (p.alpha <= 0.15) p.growing = true;
                    }

                    if (p.y < 0) { p.y = h; p.x = Math.random() * w; }
                    if (p.x < 0) p.x = w;
                    if (p.x > w) p.x = 0;

                    ctx.fillStyle = 'rgba(255, 215, 0, ' + (p.alpha * 0.38) + ')';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r * 2.2, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = 'rgba(255, 250, 220, ' + p.alpha + ')';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.restore();
                requestAnimationFrame(animate);
            }
            animate();
        })();

        // --- 2. THẺ BÀI 3D NGHIÊNG THEO GÓC CHUỘT (3D TILT CARDS) ---
        var tiltCards = document.querySelectorAll('.cards-grid .card');
        tiltCards.forEach(function(card) {
            var sheen = card.querySelector('.card__sheen');

            card.addEventListener('mousemove', function(e) {
                if (window.matchMedia && window.matchMedia('(hover: none)').matches) return;
                var rect = card.getBoundingClientRect();
                var x = e.clientX - rect.left;
                var y = e.clientY - rect.top;
                var normX = (x / rect.width - 0.5) * 2;
                var normY = (y / rect.height - 0.5) * 2;

                var rotX = -normY * 11.5;
                var rotY = normX * 11.5;

                if (sheen) {
                    sheen.style.setProperty('--mouse-x', x + 'px');
                    sheen.style.setProperty('--mouse-y', y + 'px');
                }

                card.style.transform = 'perspective(1100px) rotateX(' + rotX.toFixed(2) + 'deg) rotateY(' + rotY.toFixed(2) + 'deg) translateZ(14px) scale3d(1.028, 1.028, 1.028)';
                card.style.boxShadow = (-normX * 16) + 'px ' + (-normY * 16 + 18) + 'px 38px rgba(18, 9, 4, 0.42), 0 0 28px rgba(212, 175, 55, 0.32), inset 0 0 0 1.5px rgba(212, 175, 55, 0.75)';
            });

            card.addEventListener('mouseleave', function() {
                card.style.transition = 'transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.6s ease';
                card.style.transform = 'perspective(1100px) rotateX(0deg) rotateY(0deg) translateZ(0px) scale3d(1, 1, 1)';
                card.style.boxShadow = '';
                setTimeout(function() {
                    card.style.transition = '';
                }, 600);
            });

            card.addEventListener('mouseenter', function() {
                card.style.transition = 'transform 0.1s ease-out, box-shadow 0.2s ease-out';
            });
        });

        // --- PROMPT 28 - 31: ĐÃ XÓA DỨT ĐIỂM CANVAS ĐỐM LỬA KIM TUYẾN (GOLDEN EMBER TRAIL) ---
        // Giải phóng 100% GPU & RAM, loại bỏ bão sự kiện touchmove/mousemove.
        // Cảm ứng phản hồi 0ms, cuộn trang mát máy đạt chuẩn 60FPS.
    })();
    </script>

