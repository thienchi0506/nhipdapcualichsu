         */
        function khoiTaoProceduralTrongDong() {
            var canvas = document.getElementById('canvas-procedural-trongdong');
            if (!canvas) return;
            if (typeof THREE === 'undefined') {
                setTimeout(khoiTaoProceduralTrongDong, 100);
                return;
            }

            var w = canvas.parentElement ? canvas.parentElement.clientWidth : 500;
            var h = canvas.parentElement ? canvas.parentElement.clientHeight : 420;
            if (w < 50) w = 500;
            if (h < 50) h = 420;

            if (_threeState1.renderer) {
                _threeState1.renderer.setSize(w, h);
                _threeState1.camera.aspect = w / h;
                _threeState1.camera.updateProjectionMatrix();
                return;
            }

            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(40, w / h, 0.1, 100);
            camera.position.set(0, 2.8, 5.2);
            camera.lookAt(0, 0, 0);

            var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            renderer.setSize(w, h);
