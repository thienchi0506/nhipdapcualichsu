        /**
         * PROMPT 12: Thiết lập tương tác và Touch Isolation chống kẹt cuộn trang
         */
        function setup3DInteractions(canvas, state) {
            var isMouseDown = false;
            var prevX = 0, prevY = 0;
            var initDist = 0;

            // Xử lý chuột Desktop
            canvas.addEventListener('mousedown', function(e) {
                isMouseDown = true;
                prevX = e.clientX;
                prevY = e.clientY;
            });
            window.addEventListener('mouseup', function() { isMouseDown = false; });
            window.addEventListener('mousemove', function(e) {
                if (!isMouseDown || !state.meshGroup) return;
                var dx = e.clientX - prevX;
                var dy = e.clientY - prevY;
                state.meshGroup.rotation.y += dx * 0.01;
                state.meshGroup.rotation.x += dy * 0.01;
                prevX = e.clientX;
                prevY = e.clientY;
            });

            // Xử lý cuộn chuột Zoom
            canvas.addEventListener('wheel', function(e) {
                e.preventDefault();
                if (!state.camera) return;
                state.camera.position.z += e.deltaY * 0.005;
                state.camera.position.z = Math.max(2.0, Math.min(10.0, state.camera.position.z));
            }, { passive: false });

            // Xử lý Touch Mobile cách ly an toàn (Prompt 12)
            canvas.addEventListener('touchstart', function(e) {
                if (e.touches.length === 1) {
                    if (state.touchDrag) {
                        // Chế độ khóa cuộn để xoay 1 ngón
                        e.preventDefault();
                        prevX = e.touches[0].clientX;
                        prevY = e.touches[0].clientY;
                    }
                    // Nếu không bật touchDrag: để mặc định cuộn trang web mượt mà!
                } else if (e.touches.length === 2) {
                    // 2 ngón tay: kích hoạt xoay và zoom 3D
                    e.preventDefault();
                    prevX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
                    prevY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
                    initDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                }
            }, { passive: false });

            canvas.addEventListener('touchmove', function(e) {
                if (!state.meshGroup) return;
                if (e.touches.length === 1 && state.touchDrag) {
                    e.preventDefault();
                    var dx = e.touches[0].clientX - prevX;
                    var dy = e.touches[0].clientY - prevY;
                    state.meshGroup.rotation.y += dx * 0.012;
                    state.meshGroup.rotation.x += dy * 0.012;
                    prevX = e.touches[0].clientX;
                    prevY = e.touches[0].clientY;
                } else if (e.touches.length === 2) {
                    e.preventDefault();
                    var curX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
                    var curY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
                    var dx = curX - prevX;
                    var dy = curY - prevY;
                    state.meshGroup.rotation.y += dx * 0.012;
                    state.meshGroup.rotation.x += dy * 0.012;
                    prevX = curX;
                    prevY = curY;

                    var curDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    if (initDist > 0) {
                        var zoomFactor = initDist / curDist;
                        state.camera.position.z *= (zoomFactor - 1) * 0.2 + 1;
                        state.camera.position.z = Math.max(2.0, Math.min(10.0, state.camera.position.z));
                    }
                    initDist = curDist;
                }
            }, { passive: false });
        }

