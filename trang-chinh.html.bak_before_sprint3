                handle2.rotation.y = hSide * Math.PI / 2;
                handle2.rotation.z = Math.PI / 2;
                drumGroup.add(handle2);
            }

            scene.add(drumGroup);

            _threeState1.scene = scene;
            _threeState1.camera = camera;
            _threeState1.renderer = renderer;
            _threeState1.meshGroup = drumGroup;

            // Xử lý sự kiện kéo xoay / touch isolation (Prompt 12)
            setup3DInteractions(canvas, _threeState1);

