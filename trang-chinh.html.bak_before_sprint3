                    plainText += "STT " + r.stt + ": " + r.tenMoc + " (" + r.nam + ")\n" +
                        "- Quốc hiệu: " + r.quocHieu + "\n" +
                        "- Kinh đô / Trị sở: " + r.kinhDo + "\n" +
                        "- Biểu tượng: " + r.bieuTuong + "\n" +
                        "- Cương vực: " + r.cuongVuc + "\n\n";
                });
            } else {
                var moc = duLieuDocMoRong[index];
                if (!moc) return;
                plainText = moc.tieuDe + "\n" +
                    "Niên đại lịch sử: " + moc.nam + "\n\n" +
                    moc.lead + "\n\n" +
                    "🏛️ Quốc hiệu: " + moc.specs.quocHieu + "\n" +
                    "👑 Kinh đô: " + moc.specs.kinhDo + "\n" +
                    "⚜️ Biểu tượng: " + moc.specs.bieuTuong + "\n" +
