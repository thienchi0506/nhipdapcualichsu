                <!-- ========================================== -->
                <!-- TAB 7: TỔNG KẾT GIÁ TRỊ TƯ TƯỞNG & TRA CỨU -->
                <!-- ========================================== -->
                <div class="sach-tab-pane" id="pane-sach-tongket" style="display: ${tab === 'tongket' ? 'block' : 'none'};">
                    <div class="tu-lieu-reader-box" style="background: #FFFDF8; border: 2px solid var(--vang-dong); border-radius: 12px; padding: 26px 22px; box-shadow: 0 4px 18px rgba(44,30,24,0.08); font-family: 'Noto Serif', serif; color: #2C1E18; line-height: 1.8;">
                        <div style="text-align: center; border-bottom: 2px double var(--vang-dong); padding-bottom: 18px; margin-bottom: 22px;">
                            <span style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #7B1E1E; background: rgba(212,175,55,0.2); padding: 4px 14px; border-radius: 20px; border: 1px solid var(--vang-dong);">Mạch Nguồn Văn Hiến Dân Tộc Từ Thế Kỷ XIII Đến Thế Kỷ XX</span>
                            <h3 style="color: #7B1E1E; font-size: 1.5rem; margin: 12px 0 6px; font-family: 'Playfair Display', serif; font-weight: 900;">VIII. TỔNG KẾT GIÁ TRỊ TƯ TƯỞNG & NGUỒN TƯ LIỆU THAM KHẢO</h3>
                            <p style="font-style: italic; color: #5C3A21; font-size: 0.94rem; max-width: 820px; margin: 0 auto;">Ba trụ cột tư tưởng lớn của dân tộc Việt Nam kết tinh qua sáu kiệt tác thư tịch lịch sử kinh điển</p>
                        </div>

                        <div style="margin-bottom: 24px;">
                            <p style="text-align: justify; margin-bottom: 14px;">
                                Sáu tác phẩm trong <strong>Tủ Sách Lịch Sử Kinh Điển Đại Việt</strong> hợp thành một mạch nguồn văn hiến xuyên suốt từ thế kỷ XIII đến thế kỷ XX. Dù ra đời ở những thời đại khác nhau và được thể hiện bằng những thể tài đa dạng (sử biên niên, sử cương mục, thông sử Quốc ngữ, binh thư, thực lục khởi nghĩa và thơ Đường luật cách mạng), cả sáu kiệt tác đều gặp nhau ở <strong>ba trụ cột tư tưởng lớn</strong> của dân tộc Việt Nam:
                            </p>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0;">
                                <div style="background: rgba(123,30,30,0.05); border: 1.5px solid #7B1E1E; border-radius: 8px; padding: 16px;">
                                    <strong style="color: #7B1E1E; font-size: 1.02rem; display: block; margin-bottom: 8px;">👑 1. Ý thức độc lập tự chủ và quốc thống văn hiến</strong>
                                    <p style="font-size: 0.92rem; line-height: 1.7; margin-bottom: 0;">
