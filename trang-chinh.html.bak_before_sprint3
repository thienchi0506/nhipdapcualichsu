        /* =========================================================
           NÂNG CẤP ĐỘT PHÁ GIAO DIỆN THỊ GIÁC (VISUAL UPGRADES)
           1. 3D Parallax & Hào Quang Trống Đồng tại .welcome-banner
           2. 3D Tilt Cards & Ánh Kim Quét tại .cards-grid
           3. Sóng Sáng Lan Tỏa (Ripple Glow) & Cuộn Thư tại #interactive-timeline
           ========================================================= */

        /* --- 1. BANNER 3D PARALLAX & HÀO QUANG TRỐNG ĐỒNG --- */
        .welcome-banner {
            perspective: 1100px;
            transform-style: preserve-3d;
            overflow: hidden;
            position: relative;
        }

        .welcome-banner__bg-layer {
            position: absolute;
            inset: -45px;
            background-image: url('anh-nen2.jpg');
            background-size: cover;
            background-position: center 42%;
            background-repeat: no-repeat;
            opacity: 1;
            filter: url(#sharp-filter) contrast(118%) saturate(112%) brightness(96%);
            image-rendering: -webkit-optimize-contrast;
            image-rendering: high-quality;
            pointer-events: none;
            z-index: 1;
            will-change: transform;
            transition: transform 0.12s ease-out;
        }

        .welcome-banner__halo {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 580px;
            height: 580px;
            margin-left: -290px;
            margin-top: -290px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.38) 0%, rgba(212, 175, 55, 0.22) 40%, rgba(139, 37, 0, 0.08) 65%, transparent 75%);
            pointer-events: none;
            z-index: 2;
            filter: blur(28px);
            animation: haloPulseDongSon 7s ease-in-out infinite alternate;
            will-change: transform, opacity;
            transition: transform 0.18s ease-out;
        }

        @keyframes haloPulseDongSon {
            0% { transform: scale(0.92) rotate(0deg); opacity: 0.65; }
            50% { transform: scale(1.1) rotate(180deg); opacity: 0.9; }
            100% { transform: scale(0.96) rotate(360deg); opacity: 0.65; }
        }

        /* Khung chứa Mặt Trống Đồng Ngọc Lũ Vector 4K Độ Phân Giải Vô Cực */
        .welcome-banner__drum-wrap {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 560px;
            height: 560px;
            margin-left: -280px;
            margin-top: -280px;
            pointer-events: none;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            will-change: transform;
            transition: transform 0.15s ease-out;
        }

        .dongson-drum-svg {
            width: 100%;
            height: 100%;
            display: block;
            filter: drop-shadow(0 12px 35px rgba(0, 0, 0, 0.92)) drop-shadow(0 0 35px rgba(212, 175, 55, 0.32));
            overflow: visible;
        }

        /* 1. Vòng hoa văn hình học bên trong xoay thuận chiều kim đồng hồ (90s) */
        .drum-ring-inner {
            transform-origin: 0px 0px;
            animation: rotateClockwise 90s linear infinite;
            will-change: transform;
        }

        /* 2. Vòng Chim Lạc & Chiến binh bên ngoài xoay ngược chiều kim đồng hồ (120s) */
        .drum-ring-outer {
            transform-origin: 0px 0px;
            animation: rotateCounterClockwise 120s linear infinite;
            will-change: transform;
        }

        /* 3. Tâm trống ngôi sao 14 cánh nhịp thở phát sáng */
        .drum-center-sun {
            transform-origin: 0px 0px;
            animation: sunPulse 6s ease-in-out infinite alternate;
        }

        @keyframes rotateClockwise {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @keyframes rotateCounterClockwise {
            from { transform: rotate(0deg); }
            to { transform: rotate(-360deg); }
        }

        @keyframes sunPulse {
            0% { transform: scale(0.98); opacity: 0.92; }
            50% { transform: scale(1.03); opacity: 1; }
            100% { transform: scale(0.98); opacity: 0.92; }
        }

        /* Ánh kim lướt ngang mặt trống đồng */
        .welcome-banner__drum-wrap::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: linear-gradient(115deg, transparent 35%, rgba(255, 235, 150, 0.22) 50%, rgba(255, 255, 255, 0.35) 53%, transparent 68%);
            background-size: 250% 250%;
            animation: metallicShimmerSweep 7s infinite ease-in-out;
            pointer-events: none;
            mix-blend-mode: screen;
        }

        @keyframes metallicShimmerSweep {
            0% { background-position: -120% -120%; opacity: 0; }
            20% { opacity: 0.85; }
            40% { background-position: 120% 120%; opacity: 0; }
            100% { background-position: 120% 120%; opacity: 0; }
        }

        /* Canvas hạt bụi vàng bay lơ lửng */
        .banner-gold-dust-canvas {
            position: absolute;
            inset: -80px;
            width: calc(100% + 160px);
            height: calc(100% + 160px);
            pointer-events: none;
            z-index: 2;
        }

        /* Khối nội dung có lớp đệm tương phản bảo vệ chữ */
        .welcome-banner__content {
            position: relative;
            z-index: 5;
            pointer-events: auto;
            transform-style: preserve-3d;
            will-change: transform;
            transition: transform 0.12s ease-out;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            padding: 16px 20px;
            display: inline-block;
            max-width: 900px;
        }

        /* Tiêu đề "Chọn Hành Trình Của Bạn" chữ mạ vàng đồng có viền đổ bóng sâu 4K */
        .welcome-banner__title {
            font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
            font-size: 2.5rem;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
            background: linear-gradient(180deg, #FFFDF5 0%, #F5D77F 55%, #D4AF37 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 4px 12px rgba(0,0,0,0.95))
                    drop-shadow(0 2px 4px rgba(0,0,0,0.9));
            transition: transform 0.15s ease-out;
            transform-style: preserve-3d;
            margin-bottom: 12px;
            padding: 0 10px;
            position: relative;
        }

        /* --- 2. 3D TILT CARDS & ÁNH KIM QUÉT --- */
        .cards-grid {
            perspective: 1300px;
        }

        .card {
            transform-style: preserve-3d;
            will-change: transform, box-shadow;
            transition: transform 0.18s ease-out, box-shadow 0.25s ease-out, border-color 0.25s ease-out;
        }

        .card__sheen {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            pointer-events: none;
            z-index: 6;
            opacity: 0;
            mix-blend-mode: color-dodge;
            background: radial-gradient(circle 260px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 240, 190, 0.5) 0%, rgba(212, 175, 55, 0.2) 45%, transparent 80%);
            transition: opacity 0.35s ease;
        }

        .card:hover .card__sheen {
            opacity: 1;
        }

        .card__top, .card__title, .card__desc, .card__btn {
            transform-style: preserve-3d;
            transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .card:hover .card__top {
            transform: translateZ(30px);
        }

        .card:hover .card__title {
            transform: translateZ(40px);
            text-shadow: 0 4px 14px rgba(0,0,0,0.65), 0 0 25px rgba(212,175,55,0.45);
        }

        .card:hover .card__desc {
            transform: translateZ(24px);
        }

        .card:hover .card__btn {
            transform: translateZ(35px);
            box-shadow: 0 6px 22px rgba(123, 30, 30, 0.5);
        }

        /* --- 3. TIMELINE ACTIVE DOT RIPPLE GLOW & CUỘN THƯ --- */
        .tl-node.active .tl-node__dot {
            background: linear-gradient(135deg, #7B1E1E 0%, #4A0E0E 100%) !important;
            border-color: var(--vang-dong) !important;
            transform: scale(1.22) !important;
            box-shadow: 0 0 0 5px rgba(212, 175, 55, 0.38), 0 0 22px rgba(212, 175, 55, 0.65), 0 6px 18px rgba(0,0,0,0.35) !important;
            position: relative;
        }

        .tl-node.active .tl-node__dot::before,
        .tl-node.active .tl-node__dot::after {
            content: '';
            position: absolute;
            inset: -5px;
            border-radius: 50%;
            border: 2px solid #D4AF37;
            pointer-events: none;
            animation: tlRippleWave 2.4s cubic-bezier(0.2, 0.6, 0.35, 1) infinite;
        }

        .tl-node.active .tl-node__dot::after {
            animation-delay: 1.2s;
        }

        @keyframes tlRippleWave {
            0% {
                transform: scale(0.95);
                opacity: 0.95;
                box-shadow: 0 0 10px rgba(212, 175, 55, 0.85);
            }
            50% {
                opacity: 0.5;
                box-shadow: 0 0 22px rgba(212, 175, 55, 0.55);
            }
            100% {
                transform: scale(1.9);
                opacity: 0;
                box-shadow: 0 0 32px rgba(212, 175, 55, 0);
            }
        }

        .tl-content-card {
            transform-origin: top center;
            perspective: 1000px;
            transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.35s ease;
        }

        .tl-content-card.parchment-unroll-exit {
            opacity: 0;
            transform: translateY(-12px) rotateX(16deg) scale(0.97);
            filter: blur(1.5px);
        }

        .tl-content-card.parchment-unroll-enter {
            opacity: 0;
            transform: translateY(18px) rotateX(-14deg) scale(0.96);
            filter: blur(1.5px);
        }


