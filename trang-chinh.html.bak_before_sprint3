            var rimLight = new THREE.DirectionalLight(0xFFFFFF, 0.9);
            rimLight.position.set(0, 8, -4);
            scene.add(rimLight);

            var ambLight = new THREE.AmbientLight(0x4A3728, 1.2);
            scene.add(ambLight);

            // Nhóm chứa toàn bộ khối Trống Đồng
            var drumGroup = new THREE.Group();

            // Chất liệu đồng cổ hoàng gia Đông Sơn (#C5A059, roughness 0.35, metalness 0.75)
            var bronzeMat = new THREE.MeshStandardMaterial({
                color: 0xC5A059,
                roughness: 0.35,
                metalness: 0.75
            });
            var bronzeAccentMat = new THREE.MeshStandardMaterial({
                color: 0xE5C158,
                roughness: 0.28,
                metalness: 0.85
            });

            // 1. Mặt trống đồng tròn phẳng phía trên
            var tympanumGeo = new THREE.CylinderGeometry(2.0, 2.0, 0.12, 64);
            var tympanum = new THREE.Mesh(tympanumGeo, bronzeMat);
            tympanum.position.y = 1.0;
            drumGroup.add(tympanum);

            // Ngôi sao mặt trời 14 cánh đắp nổi ở tâm mặt trống
            var starShape = new THREE.Shape();
            var points = 14;
            var rOut = 0.85, rIn = 0.42;
            for (var i = 0; i < points * 2; i++) {
                var r = (i % 2 === 0) ? rOut : rIn;
                var angle = (i * Math.PI) / points;
                var x = Math.cos(angle) * r;
                var y = Math.sin(angle) * r;
                if (i === 0) starShape.moveTo(x, y);
                else starShape.lineTo(x, y);
            }
            starShape.closePath();

            var extrudeSettings = { depth: 0.05, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: 0.02, bevelThickness: 0.02 };
            var starGeo = new THREE.ExtrudeGeometry(starShape, extrudeSettings);
            var starMesh = new THREE.Mesh(starGeo, bronzeAccentMat);
            starMesh.rotation.x = Math.PI / 2;
            starMesh.position.y = 1.07;
            drumGroup.add(starMesh);

            // Các vành hoa văn đồng tâm
            var ring1 = new THREE.Mesh(new THREE.TorusGeometry(1.25, 0.02, 8, 48), bronzeAccentMat);
            ring1.rotation.x = Math.PI / 2;
            ring1.position.y = 1.07;
            drumGroup.add(ring1);

            var ring2 = new THREE.Mesh(new THREE.TorusGeometry(1.65, 0.025, 8, 48), bronzeAccentMat);
            ring2.rotation.x = Math.PI / 2;
            ring2.position.y = 1.07;
            drumGroup.add(ring2);

            // 4 con cóc đúc nổi ở 4 góc mặt trống
            for (var c = 0; c < 4; c++) {
                var toadAngle = (c * Math.PI / 2) + Math.PI / 4;
                var toad = new THREE.Mesh(new THREE.SphereGeometry(0.12, 12, 12), bronzeAccentMat);
                toad.scale.set(1.4, 0.8, 1.0);
                toad.position.set(Math.cos(toadAngle) * 1.78, 1.12, Math.sin(toadAngle) * 1.78);
                drumGroup.add(toad);
            }

            // 2. Tang trống phình nở phía trên
            var upperGeo = new THREE.CylinderGeometry(2.0, 1.6, 0.7, 64);
            var upperMesh = new THREE.Mesh(upperGeo, bronzeMat);
            upperMesh.position.y = 0.65;
            drumGroup.add(upperMesh);

            // 3. Thân trống thắt eo giữa (Lưng trống hình trụ)
            var waistGeo = new THREE.CylinderGeometry(1.5, 1.5, 0.8, 64);
            var waistMesh = new THREE.Mesh(waistGeo, bronzeMat);
            waistMesh.position.y = -0.1;
            drumGroup.add(waistMesh);

            // 4. Chân trống xòe rộng hình nón cụt
            var baseGeo = new THREE.CylinderGeometry(1.5, 2.1, 0.9, 64);
            var baseMesh = new THREE.Mesh(baseGeo, bronzeMat);
            baseMesh.position.y = -0.95;
            drumGroup.add(baseMesh);

            // 5. Cặp quai kép chữ U gắn hai bên thân trống
            for (var hSide = -1; hSide <= 1; hSide += 2) {
                var handleGeo = new THREE.TorusGeometry(0.38, 0.05, 12, 24, Math.PI);
