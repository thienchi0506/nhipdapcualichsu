rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isForumAdmin() {
      return request.auth != null
        && request.auth.uid == 'xTC4fHaFUeMQFe0jLyzJNy2sQN83';
    }

    function isAdminPostModerationUpdate() {
      return isForumAdmin() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationState', 'deletedAt', 'deletedBy'])
          && request.resource.data.moderationState == 'trashed'
          && resource.data.get('moderationState', 'active') != 'trashed'
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationState', 'restoredAt', 'restoredBy'])
          && resource.data.get('moderationState', 'active') == 'trashed'
          && request.resource.data.moderationState == 'active'
          && request.resource.data.restoredAt == request.time
          && request.resource.data.restoredBy == request.auth.uid)
      );
    }

    function isFeedbackMediaListValid(media) {
      return media is list
        && media.size() <= 3
        && (media.size() < 1 || (media[0] is string && media[0].size() <= 2048 && media[0].matches('https://res\\.cloudinary\\.com/[^/]+/(image|video)/upload/.*')))
        && (media.size() < 2 || (media[1] is string && media[1].size() <= 2048 && media[1].matches('https://res\\.cloudinary\\.com/[^/]+/(image|video)/upload/.*')))
        && (media.size() < 3 || (media[2] is string && media[2].size() <= 2048 && media[2].matches('https://res\\.cloudinary\\.com/[^/]+/(image|video)/upload/.*')));
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 32
        && request.resource.data.topic is string
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 1500
        && request.resource.data.likes == 0
        && request.resource.data.commentsCount == 0
        && !('moderationState' in request.resource.data)
        && !('deletedAt' in request.resource.data)
        && !('deletedBy' in request.resource.data)
        && !('restoredAt' in request.resource.data)
        && !('restoredBy' in request.resource.data)
        && (!('media' in request.resource.data)
          || request.resource.data.media == null
          || (request.resource.data.media.url is string
            && request.resource.data.media.type in ['image', 'video']));
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && (request.resource.data.likes == resource.data.get('likes', 0) + 1
            || (resource.data.get('likes', 0) > 0 && request.resource.data.likes == resource.data.get('likes', 0) - 1)))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1)
        || isAdminPostModerationUpdate()
      );
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 32
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get('moderationState', 'active') != 'trashed';
      allow delete: if false;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['postId', 'reporterUid', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['postId', 'reporterUid', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.postId is string
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['misinformation', 'spam', 'harassment', 'inappropriate', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get('moderationState', 'active') != 'trashed'
        && !exists(/databases/$(database)/documents/reports/$(reportId));

      allow read: if isForumAdmin();

      allow update: if isForumAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'reviewing', 'resolved', 'dismissed']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.details == resource.data.details
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /websiteFeedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'topic', 'content', 'reporterUid', 'reporterName', 'reporterEmail', 'media', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'topic', 'content', 'reporterUid', 'reporterName', 'reporterEmail', 'media', 'status', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.topic in ['bug', 'suggestion']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 3000
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() <= 80
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.size() <= 160
        && isFeedbackMediaListValid(request.resource.data.media)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read: if isForumAdmin();

      allow update: if isForumAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'reviewing', 'resolved', 'dismissed']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.title == resource.data.title
        && request.resource.data.topic == resource.data.topic
        && request.resource.data.content == resource.data.content
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reporterName == resource.data.reporterName
        && request.resource.data.reporterEmail == resource.data.reporterEmail
        && request.resource.data.media == resource.data.media
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }
match /battleRooms/{roomId} {
      allow read: if request.auth != null && (
        resource == null
        || resource.data.player1.uid == request.auth.uid
        || (resource.data.player2 != null && resource.data.player2.uid == request.auth.uid)
        || resource.data.status == 'waiting'
      );

      allow create: if request.auth != null
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() == 6
        && request.resource.data.status == 'waiting'
        && request.resource.data.player1.uid == request.auth.uid
        && request.resource.data.player2.uid == null
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() == 10
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && (
        (resource.data.status == 'waiting'
          && resource.data.player2.uid == null
          && request.resource.data.player2.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player2', 'status']))

        || (resource.data.player1.uid == request.auth.uid
          && resource.data.status in ['ready', 'waiting']
          && request.resource.data.status == 'in_progress'
          && request.resource.data.startedAt == request.time
          && request.resource.data.expiresAt == request.time + duration.value(180, 's'))

        || (resource.data.player1.uid == request.auth.uid
          && resource.data.status == 'in_progress'
          && request.time <= resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player1', 'status', 'winnerUid']))

        || (resource.data.player2.uid == request.auth.uid
          && resource.data.status == 'in_progress'
          && request.time <= resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player2', 'status', 'winnerUid']))
      );

      allow delete: if false;
    }
  }
}
