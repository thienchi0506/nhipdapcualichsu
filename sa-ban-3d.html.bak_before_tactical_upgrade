            hienThiThongBaoPopup("⚔️ KHỞI ĐỘNG HỒI 2", "Đại chiến Bạch Đằng bắt đầu! Nước lớn mênh mông, hãy dùng kế giả thua nhử địch!");
            phatGiongDoc("Toàn quân vào vị trí tác chiến! Hạm đội Lưu Hoằng Tháo đang tiến vào cửa sông. Hãy điều động Thuyền Nhẹ nhử giặc vào sâu trong trận địa bãi cọc!");
        }

        // 9. Vòng Lặp Thực Chiến Trận Đồ & Va Chạm Bãi Cọc (Combat Loop & Tidal Physics)
        function kiemTraVongLapChienTran(delta, elapsed) {
            if (Game3D.combatPhase === 'CHUA_BAT_DAU') return;

            // 1. Cập nhật di chuyển các đạo quân ta theo targetX & targetZ
            ['thuyenNhe', 'beLua', 'quanY'].forEach(unitKey => {
                const u = Game3D.units[unitKey];
                if (u && u.mesh && u.targetX !== undefined && u.targetZ !== undefined) {
                    const dx = u.targetX - u.pos.x;
                    const dz = u.targetZ - u.pos.z;
                    const dist = Math.hypot(dx, dz);

                    if (dist > 1.2) {
                        const moveStep = Math.min(dist, (u.speed || 12) * delta);
                        u.pos.x += (dx / dist) * moveStep;
                        u.pos.z += (dz / dist) * moveStep;
                        u.mesh.position.set(u.pos.x, u.pos.y, u.pos.z);

                        const heading = Math.atan2(dx, dz);
                        u.mesh.rotation.y = heading + Math.PI;
                    } else {
                        u.isMoving = false;
                    }
                }
            });

            const dich = Game3D.units.dichLauThuyen;
            const tn = Game3D.units.thuyenNhe;
            const bannerText = document.getElementById('stage-banner-text');

            // -----------------------------------------------------------------
            // GIAI ĐOẠN 1: NƯỚC LỚN (ĐỈNH TRIỀU +1.2m, CỌC CHÌM SÂU)
            // -----------------------------------------------------------------
            if (Game3D.combatPhase === 'NUOC_LON') {
                if (bannerText) bannerText.textContent = "⚔️ GIAI ĐOẠN 1: NƯỚC LỚN — CỌC CHÌM SÂU, TRÁNH ĐÁNH GIÁP LÁ CÀ!";

                // Thuyền giặc từ từ tiến vào sông
                if (dich && dich.pos.z > 45) {
                    dich.pos.z -= 3.2 * delta;
                    dich.mesh.position.z = dich.pos.z;
                }

                // Tự động kích hoạt Tình huống 1 sau 6.5s thực chiến
                if (!Game3D.dilemmasTriggered[1]) {
                    Game3D.trapCooldown = (Game3D.trapCooldown || 0) + delta;
                    if (Game3D.trapCooldown > 6.5) {
                        kichHoatTinhHuong(1);
                    }
                }

                // Nếu thuyền nhẹ rút lui qua bãi cọc (z <= 15) -> sang Giai đoạn 2
                if (tn && tn.pos.z <= 15) {
                    Game3D.combatPhase = 'NHU_DICH';
                    phatGiongDoc("Thuyền nhẹ tiên phong đã nhử được giặc qua bãi cọc! Thủy triều bắt đầu rút xiết!");
                }
            }

            // -----------------------------------------------------------------
            // GIAI ĐOẠN 2: NHỬ ĐỊCH QUA BÃI CỌC (TRIỀU RÚT XIẾT)
            // -----------------------------------------------------------------
            else if (Game3D.combatPhase === 'NHU_DICH') {
                if (bannerText) bannerText.textContent = "🌊 GIAI ĐOẠN 2: NHỬ ĐỊCH QUA BÃI CỌC — DỤ LÂU THUYỀN VÀO TRẬN ĐỊA!";

                // Thủy triều rút nhanh
                Game3D.thuyTrieu.dangTang = false;
                Game3D.thuyTrieu.phanTram = Math.max(15, Game3D.thuyTrieu.phanTram - delta * 12);

                // Giặc hăng máu đuổi theo vào đúng bãi cọc
                if (dich && dich.pos.z > 12) {
                    dich.pos.z -= 7.5 * delta;
                    dich.mesh.position.z = dich.pos.z;
                }

                // Khi triều rút xuống dưới 42% và giặc đã lọt vào bãi cọc -> Giai đoạn 3
                if (Game3D.thuyTrieu.phanTram <= 42 && dich && dich.pos.z <= 25) {
                    Game3D.combatPhase = 'NUOC_RUT_PHA_GIAC';
                    AudioEngine.playStakeImpact();
                    phatNoManhVoVaCotNuoc(dich.pos.x, dich.pos.y, dich.pos.z);
                    moKhoaHuanChuong('bacThayThuyChien');
                    hienThiThongBaoPopup("🔥 TRIỀU RÚT XIẾT — CỌC NHÔ LÊN", "Hàng cọc sắt đâm thủng vỏ tàu giặc! Mau dùng [Phím 3] Hỏa Long Xuất Hải phóng bè lửa!");
                    phatGiongDoc("Triều rút xiết rồi! Bãi cọc gỗ bịt sắt nhô lên đâm thủng soái hạm giặc! Toàn quân dốc sức phản công!");
                }
            }

            // -------------------------------------------------------------
            // GIAI ĐOẠN 3: NƯỚC RÚT XIẾT & PHÁ GIẶC (VA CHẠM BÃI CỌC 3D)
            // -------------------------------------------------------------
            else if (Game3D.combatPhase === 'NUOC_RUT_PHA_GIAC') {
                if (bannerText) bannerText.textContent = "🔥 GIAI ĐOẠN 3: NƯỚC RÚT XIẾT — CỌC SẮT NHÔ LÊN ĐÂM THỦNG SOÁI HẠM ĐỊCH!";

                // Thỉnh thoảng phát âm thanh cọc đâm va & vỡ vỏ tàu thời gian thực kèm bắn mảnh gỗ và cột nước
                if (Math.random() < 0.035) {
                    AudioEngine.playStakeImpact();
                    if (dich) phatNoManhVoVaCotNuoc(dich.pos.x, dich.pos.y, dich.pos.z);
                }

                // Hiệu ứng vật lý: Soái hạm và các tàu hộ vệ mắc cọc nghiêng ngả
                if (dich && dich.flagship) {
                    dich.flagship.rotation.z = Math.sin(elapsed * 4.2) * 0.14 + 0.24;
                    dich.flagship.rotation.x = -0.20;
                    if (dich.escorts) {
                        dich.escorts.forEach((e, idx) => {
                            e.rotation.z = Math.sin(elapsed * 3.5 + idx) * 0.28;
                        });
                    }

                    // Máu và sĩ khí giặc sụt giảm liên tục do vỡ tàu & cháy
                    dich.hp = Math.max(15, dich.hp - delta * 3.2);
                    dich.morale = Math.max(5, dich.morale - delta * 5.0);
                }

                // Kích hoạt Tình huống 2 khi giặc suy yếu và lửa cháy lan
                if (dich && dich.hp <= 75 && !Game3D.dilemmasTriggered[2]) {
                    kichHoatTinhHuong(2);
                }

                // Khi máu địch cạn kiệt hoặc đã chiêu hàng -> Giai đoạn 4
                if ((dich && dich.hp <= 22) || (dich && dich.surrendered)) {
                    Game3D.combatPhase = 'THANG_TRAN';
                    hienThiThongBaoPopup("🕊️ ĐẠI THẮNG BẠCH ĐẰNG", "Hạm đội Lưu Hoằng Tháo tan rã hoàn toàn! Giặc quỳ rạp xin hàng!");
                    phatGiongDoc("Đại thắng Bạch Đằng! Hạm đội Lưu Hoằng Tháo đã hoàn toàn tan rã! Tướng giặc đền tội, tàn quân quỳ rạp xin tha mạng!");
                }
            }

            // -----------------------------------------------------------------
            // GIAI ĐOẠN 4: ĐẠI THẮNG BẠCH ĐẰNG (KẾT TRẬN TỐI HẬU)
            // -----------------------------------------------------------------
            else if (Game3D.combatPhase === 'THANG_TRAN') {
                if (bannerText) bannerText.textContent = "🕊️ GIAI ĐOẠN 4: ĐẠI THẮNG BẠCH ĐẰNG — HẠM ĐỘI GIẶC TAN RÃ, XIN HÀNG!";

                // Kích hoạt Tình huống 3: Quyết định kết trận tối hậu
                if (!Game3D.dilemmasTriggered[3]) {
                    kichHoatTinhHuong(3);
                }
            }
        }

        // 10. Kích Hoạt & Xử Lý Tình Huống Nan Giải Chiến Thuật (Dilemmas & Traps)
        function kichHoatTinhHuong(id) {
            if (Game3D.dilemmasTriggered[id]) return;
            Game3D.dilemmasTriggered[id] = true;

            const d = Game3D.dilemmas[id];
            if (!d) return;

            const modal = document.getElementById('modal-tactical-dilemma');
            const iconEl = document.getElementById('dilemma-icon');
            const badgeEl = document.getElementById('dilemma-badge');
            const titleEl = document.getElementById('dilemma-title');
            const ctxEl = document.getElementById('dilemma-context');
            const container = document.getElementById('dilemma-choices-container');

            if (iconEl) iconEl.textContent = d.icon;
            if (badgeEl) badgeEl.textContent = d.badge;
            if (titleEl) titleEl.textContent = d.title;
            if (ctxEl) ctxEl.textContent = d.context;

            if (container) {
                container.innerHTML = '';
                d.choices.forEach((c, idx) => {
                    const card = document.createElement('div');
                    card.className = `dilemma-choice-card ${c.isTrap ? 'trap-choice' : ''}`;
                    card.innerHTML = `
                        <div class="choice-badge-row">
                            <span class="choice-key-tag">PHƯƠNG ÁN ${c.key}</span>
                            <span class="choice-type-hint" style="color: ${c.isTrap ? '#E74C3C' : (c.type.includes('TỐI ƯU') ? '#2ECC71' : '#F1C40F')}; font-weight: 700;">
                                ${c.type}
                            </span>
                        </div>
                        <div class="choice-title">${c.title}</div>
                        <div class="choice-desc">${c.desc}</div>
                        <button class="choice-action-btn" onclick="chonDapAnTinhHuong(${id}, ${idx})">
                            <span>Quyết Định Phương Án [${c.key}]</span>
                        </button>
                    `;
                    container.appendChild(card);
                });
            }

            if (modal) modal.classList.add('open');
            phatGiongDoc(d.context);
        }

        // 11. Xử Lý Chọn Đáp Án & Kích Hoạt Cinematic Camera 3D
        function chonDapAnTinhHuong(dilemmaId, choiceIdx) {
            const modalDilemma = document.getElementById('modal-tactical-dilemma');
            if (modalDilemma) modalDilemma.classList.remove('open');

            const d = Game3D.dilemmas[dilemmaId];
            if (!d) return;
            const choice = d.choices[choiceIdx];
            if (!choice) return;

            // Biến động chỉ số theo quyết sách
            const imp = choice.impact;
            Game3D.nhanDao = Math.max(0, Game3D.nhanDao + imp.nhanDao);
            Game3D.siKhi = Math.min(100, Math.max(10, Game3D.siKhi + imp.siKhi));
            Game3D.quanLuc = Math.max(1000, Game3D.quanLuc + imp.quanLuc);
            Game3D.thuongBinh = Math.max(0, Game3D.thuongBinh + imp.thuongBinh);
            capNhatHUD();

            if (choice.isTrap) {
                document.body.classList.add('screen-shake');
                setTimeout(() => document.body.classList.remove('screen-shake'), 1200);
                hienThiThongBaoPopup("⚠️ SA BẪY CHIẾN THUẬT!", choice.resultTitle);
            } else {
                hienThiThongBaoPopup("✨ QUYẾT SÁCH AN DÂN", choice.resultTitle);
            }

            // Chuyển sang CINEMATIC CAMERA 3D CẬN CẢNH
            Game3D.cheDoCamera = 'CINEMATIC';
            if (dilemmaId === 1) {
                const tn = Game3D.units.thuyenNhe;
                if (tn) {
                    Game3D.targetCamPos.set(tn.pos.x + 14, 8.5, tn.pos.z + 16);
                    Game3D.targetCamLook.set(tn.pos.x, 2.5, tn.pos.z);
                }
            } else if (dilemmaId === 2) {
                Game3D.targetCamPos.set(-16, 9.5, 22);
                Game3D.targetCamLook.set(0, 3.5, 8);
            } else if (dilemmaId === 3) {
                Game3D.targetCamPos.set(16, 14.0, 18);
                Game3D.targetCamLook.set(0, 3.0, 5);
            }

            // Mở Modal Lời Khuyên & Đạo Làm Tướng
            const modalPhil = document.getElementById('modal-general-philosophy');
            const philTitle = document.getElementById('philosophy-title');
            const philQuote = document.getElementById('philosophy-quote');
            const statsContainer = document.getElementById('philosophy-stats-impact');

            if (philTitle) philTitle.textContent = choice.resultTitle;
            if (philQuote) philQuote.textContent = choice.resultQuote;

            if (statsContainer) {
                statsContainer.innerHTML = `
                    <div class="stat-impact-pill" style="color:${imp.nhanDao >= 0 ? '#2ECC71' : '#E74C3C'};">
                        🌿 Nhân Đạo: ${imp.nhanDao >= 0 ? '+' : ''}${imp.nhanDao}
                    </div>
                    <div class="stat-impact-pill" style="color:${imp.siKhi >= 0 ? '#2ECC71' : '#E74C3C'};">
                        💚 Sĩ Khí: ${imp.siKhi >= 0 ? '+' : ''}${imp.siKhi}%
                    </div>
                    <div class="stat-impact-pill" style="color:${imp.quanLuc >= 0 ? '#2ECC71' : '#E74C3C'};">
                        🛡️ Quân Lực: ${imp.quanLuc >= 0 ? '+' : ''}${imp.quanLuc.toLocaleString()}
                    </div>
                    <div class="stat-impact-pill" style="color:${imp.thuongBinh > 0 ? '#E74C3C' : '#2ECC71'};">
                        🩸 Thương Binh: ${imp.thuongBinh > 0 ? '+' : ''}${imp.thuongBinh}
                    </div>
                `;
            }

            setTimeout(() => {
                if (modalPhil) modalPhil.classList.add('open');
                phatGiongDoc(choice.resultQuote);
            }, 500);
        }

        function dongModalDaoLamTuong() {
            const modalPhil = document.getElementById('modal-general-philosophy');
            if (modalPhil) modalPhil.classList.remove('open');
            // Nếu đã kết trận đại thắng, tự động chuyển sang Hồi 3: Bình Minh Hòa Bình
            if (Game3D.combatPhase === 'THANG_TRAN' && !Game3D.isPostWar) {
