        /*  H. HỆ THỐNG HẠT TÀN LỬA & ĐỐM SÁNG 3D (PARTICLES)                         */
        /* ========================================================================== */
        function dungHeThongHatTanLua() {
            const particleCount = 450;
            const geo = new THREE.BufferGeometry();
            const positions = new Float32Array(particleCount * 3);
            const speeds = new Float32Array(particleCount * 3);

            for (let i = 0; i < particleCount; i++) {
                // Tọa độ hạt trải rộng trên mặt sông và bến doanh trại
                positions[i * 3 + 0] = (Math.random() - 0.5) * 110;
                positions[i * 3 + 1] = 1 + Math.random() * 25;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 220;

                speeds[i * 3 + 0] = (Math.random() - 0.5) * 0.15;
                speeds[i * 3 + 1] = 0.05 + Math.random() * 0.12; // Bay lơ lửng lên trên
                speeds[i * 3 + 2] = -0.1 - Math.random() * 0.2;  // Xuôi theo chiều gió Đông Bắc
            }

            geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geo.userData = { speeds: speeds };

            // Shader / Point Material màu vàng đồng và cam lửa
            const mat = new THREE.PointsMaterial({
                color: 0xFFAA33,
                size: 1.2,
                transparent: true,
                opacity: 0.75,
                blending: THREE.AdditiveBlending
            });

            Game3D.particles = new THREE.Points(geo, mat);
            Game3D.scene.add(Game3D.particles);
        }

