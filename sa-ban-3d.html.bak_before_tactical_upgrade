        // 5. Khởi Tạo & Cập Nhật Sa Bàn Minimap Radar 2D
        function khoiTaoMinimap2D() {
            const canvas = document.getElementById('minimap-canvas');
            if (!canvas) return;
            canvas.width = 220;
            canvas.height = 160;
            Game3D.minimap.canvas = canvas;
            Game3D.minimap.ctx = canvas.getContext('2d');

            // Click trên Minimap để điều quân hoặc cơ động
            canvas.addEventListener('click', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                const worldX = -65 + (mx / 220) * 130;
                const worldZ = -120 + (my / 160) * 220;

                AudioEngine.playWarDrum();

                if (Game3D.selectedUnit) {
                    raLenhDiChuyenToaDo(Game3D.selectedUnit, worldX, worldZ);
                } else if (Game3D.player && Game3D.cheDoCamera === 'FIRST_PERSON') {
                    Game3D.player.pos.x = worldX;
                    Game3D.player.pos.z = worldZ;
                    if (Game3D.player.mesh) Game3D.player.mesh.position.copy(Game3D.player.pos);
                    hienThiThongBaoPopup("📍 ĐIỀU ĐỘNG SA BÀN", `Tướng quân cơ động đến tọa độ X:${Math.round(worldX)}, Z:${Math.round(worldZ)}`);
                }
            });
        }

        function capNhatMinimap2D() {
            const canvas = Game3D.minimap.canvas;
            const ctx = Game3D.minimap.ctx;
            if (!canvas || !ctx) return;

            const W = canvas.width;
            const H = canvas.height;

            // Nền sông nước sâu thẳm
            ctx.fillStyle = '#0B1520';
            ctx.fillRect(0, 0, W, H);

            function toMapX(x) { return ((x + 65) / 130) * W; }
            function toMapY(z) { return ((z + 120) / 220) * H; }

            // Lòng sông Bạch Đằng
            ctx.fillStyle = '#14384B';
            const riverLeft = toMapX(-38);
            const riverRight = toMapX(38);
            ctx.fillRect(riverLeft, 0, riverRight - riverLeft, H);

            // Viền bờ sông
            ctx.strokeStyle = '#1D556F';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(riverLeft, 0); ctx.lineTo(riverLeft, H);
            ctx.moveTo(riverRight, 0); ctx.lineTo(riverRight, H);
            ctx.stroke();

            // Vùng bãi cọc ngầm
            const stakeX1 = toMapX(-35);
            const stakeX2 = toMapX(35);
            const stakeY1 = toMapY(-25);
            const stakeY2 = toMapY(25);
            ctx.fillStyle = 'rgba(231, 76, 60, 0.22)';
            ctx.fillRect(stakeX1, stakeY1, stakeX2 - stakeX1, stakeY2 - stakeY1);
            ctx.strokeStyle = 'rgba(231, 76, 60, 0.65)';
            ctx.setLineDash([3, 3]);
            ctx.strokeRect(stakeX1, stakeY1, stakeX2 - stakeX1, stakeY2 - stakeY1);
            ctx.setLineDash([]);

            // Các công trình bên bờ sông
            const sites = Game3D.isPostWar ? Game3D.congTrinhHauChien : Game3D.congTrinhHauPhuong;
            if (sites) {
                Object.values(sites).forEach(s => {
                    if (s && s.pos) {
                        const sx = toMapX(s.pos.x);
                        const sy = toMapY(s.pos.z);
                        ctx.fillStyle = Game3D.isPostWar ? '#38EF7D' : '#1ABC9C';
                        ctx.beginPath();
                        ctx.arc(sx, sy, 3.5, 0, Math.PI * 2);
                        ctx.fill();
                    }
                });
            }

            // Các đạo thuyền quân ta
            if (Game3D.units) {
                ['thuyenNhe', 'beLua', 'quanY'].forEach(k => {
                    const u = Game3D.units[k];
                    if (u && u.pos) {
                        const ux = toMapX(u.pos.x);
                        const uy = toMapY(u.pos.z);
                        ctx.fillStyle = (u === Game3D.selectedUnit) ? '#00FFFF' : '#3498DB';
                        ctx.beginPath();
                        ctx.arc(ux, uy, (u === Game3D.selectedUnit) ? 5 : 3.5, 0, Math.PI * 2);
                        ctx.fill();
                    }
                });

                // Hạm đội giặc
                const dich = Game3D.units.dichLauThuyen;
                if (dich && dich.pos) {
                    const dx = toMapX(dich.pos.x);
                    const dy = toMapY(dich.pos.z);
                    ctx.fillStyle = dich.surrendered ? '#EAE2CF' : '#E74C3C';
                    ctx.beginPath();
                    ctx.arc(dx, dy, 5.5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = '#FFFFFF';
                    ctx.lineWidth = 1;
                    ctx.stroke();
                }
            }

            // Vị trí Tướng Quân (Player) - Golden Arrow
            if (Game3D.player && Game3D.player.pos) {
                const px = toMapX(Game3D.player.pos.x);
                const py = toMapY(Game3D.player.pos.z);
                const rot = Game3D.player.rotationY || 0;

                ctx.save();
                ctx.translate(px, py);
                ctx.rotate(-rot + Math.PI / 2);
                ctx.fillStyle = '#FFD700';
                ctx.beginPath();
                ctx.moveTo(0, -6);
                ctx.lineTo(4, 5);
                ctx.lineTo(0, 3);
                ctx.lineTo(-4, 5);
                ctx.closePath();
                ctx.fill();
                ctx.strokeStyle = '#7B1E1E';
                ctx.lineWidth = 1;
                ctx.stroke();
                ctx.restore();
            }

            // Tọa độ HUD
            const coordsEl = document.getElementById('minimap-coords');
            if (coordsEl && Game3D.player && Game3D.player.pos) {
                coordsEl.textContent = `[X: ${Math.round(Game3D.player.pos.x)}, Z: ${Math.round(Game3D.player.pos.z)}]`;
            }
        }

