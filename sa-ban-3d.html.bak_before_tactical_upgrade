        // 1. Dựng Vòng Sáng Chọn Quân 3D
        function taoVongSangChonQuan3D() {
            const ringGeo = new THREE.RingGeometry(5.2, 6.4, 40);
            ringGeo.rotateX(-Math.PI / 2);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0x00E5FF,
                transparent: true,
                opacity: 0.85,
                side: THREE.DoubleSide
            });
            Game3D.selectionRing3D = new THREE.Mesh(ringGeo, ringMat);
            Game3D.selectionRing3D.position.set(0, 1.4, 0);
            Game3D.selectionRing3D.visible = false;
            Game3D.scene.add(Game3D.selectionRing3D);
        }

        // 2. Khởi tạo Raycasting Chọn Đơn Vị & Ra Lệnh Điều Quân
        function khoiTaoRaycastingChonQuan() {
            const raycaster = new THREE.Raycaster();
            const mouse = new THREE.Vector2();
            let pointerDownPos = { x: 0, y: 0 };
            let pointerDownTime = 0;

            window.addEventListener('pointerdown', (e) => {
                pointerDownPos = { x: e.clientX, y: e.clientY };
                pointerDownTime = performance.now();
            });

            // Xử lý Click Chuột Trái: Chọn đơn vị hoặc di chuyển
            window.addEventListener('pointerup', (e) => {
                // Bỏ qua nếu click vào UI
                if (e.target.closest('.interactive') || e.target.closest('.modal-3d-container') || e.target.closest('.modal-base-upgrade') || e.target.closest('.modal-tactical-dilemma') || e.target.closest('.modal-general-philosophy')) {
                    return;
                }

                const dist = Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y);
                const duration = performance.now() - pointerDownTime;
                // Phân biệt với động tác kéo xoay Camera
                if (dist > 8 || duration > 450) return;

                if (e.button === 0) { // Chuột trái
                    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
                    raycaster.setFromCamera(mouse, Game3D.camera);

                    // 1. Kiểm tra va chạm với các đạo quân
                    const unitMeshes = [];
                    Object.values(Game3D.units).forEach(u => {
                        if (u.mesh) {
                            u.mesh.traverse(c => {
                                if (c.isMesh) {
                                    c.userData.unitId = u.id;
                                    unitMeshes.push(c);
                                }
                            });
                        }
                    });

                    const hits = raycaster.intersectObjects(unitMeshes, false);
                    if (hits.length > 0) {
                        const hitMesh = hits[0].object;
                        const unitId = hitMesh.userData.unitId;
                        const clickedUnit = Game3D.units[unitId];

                        if (clickedUnit) {
                            if (clickedUnit.type === 'ta') {
                                chonDaoQuan3D(clickedUnit);
                                return;
                            } else if (clickedUnit.type === 'dich') {
                                if (Game3D.selectedUnit) {
                                    raLenhTanCongMucTieu(clickedUnit);
                                    return;
                                }
                            }
                        }
                    }

                    // 2. Nếu đã chọn quân ta và nhấp lên mặt sông -> Ra lệnh cơ động
                    if (Game3D.selectedUnit && Game3D.waterMesh) {
                        const waterHits = raycaster.intersectObject(Game3D.waterMesh, false);
                        if (waterHits.length > 0) {
                            const pt = waterHits[0].point;
                            raLenhDiChuyenToaDo(Game3D.selectedUnit, pt.x, pt.z);
                        }
                    }
                }
            });

            // Xử lý Click Chuột Phải: Ra lệnh tác chiến nhanh
            window.addEventListener('contextmenu', (e) => {
                if (e.target.closest('.interactive') || e.target.closest('.modal-3d-container') || e.target.closest('.modal-base-upgrade') || e.target.closest('.modal-tactical-dilemma') || e.target.closest('.modal-general-philosophy')) {
                    return;
                }

                if (Game3D.selectedUnit) {
                    e.preventDefault();
                    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
                    raycaster.setFromCamera(mouse, Game3D.camera);

                    // Kiểm tra nếu click phải trúng hạm đội giặc -> Công kích
                    const enemyMeshes = [];
                    if (Game3D.units.dichLauThuyen && Game3D.units.dichLauThuyen.mesh) {
                        Game3D.units.dichLauThuyen.mesh.traverse(c => { if (c.isMesh) enemyMeshes.push(c); });
                    }
                    const enemyHits = raycaster.intersectObjects(enemyMeshes, false);
                    if (enemyHits.length > 0) {
                        raLenhTanCongMucTieu(Game3D.units.dichLauThuyen);
                        return;
                    }

                    // Nhấp lên sông -> Di chuyển đến tọa độ
                    if (Game3D.waterMesh) {
                        const waterHits = raycaster.intersectObject(Game3D.waterMesh, false);
                        if (waterHits.length > 0) {
                            const pt = waterHits[0].point;
                            raLenhDiChuyenToaDo(Game3D.selectedUnit, pt.x, pt.z);
                        }
                    }
                }
            });
        }

        // 3. Chọn & Bỏ Chọn Đạo Quân 3D
        function chonDaoQuan3D(unit) {
            if (!unit) return;
            Game3D.selectedUnit = unit;

            if (Game3D.selectionRing3D) {
                Game3D.selectionRing3D.position.set(unit.pos.x, 1.4, unit.pos.z);
                Game3D.selectionRing3D.visible = true;
            }

            const panel = document.getElementById('selected-unit-panel');
            const iconEl = document.getElementById('sel-unit-icon');
            const nameEl = document.getElementById('sel-unit-name');
            const hintEl = document.getElementById('sel-unit-hint');

            if (panel) panel.style.display = 'flex';
            if (iconEl) iconEl.textContent = unit.icon;
            if (nameEl) nameEl.textContent = `Đang Chọn: ${unit.name}`;
            if (hintEl) {
                hintEl.textContent = `HP: ${Math.round(unit.hp)}% | Sĩ Khí: ${Math.round(unit.morale)}% — Click chuột phải lên mặt sông để cơ động`;
            }

            hienThiThongBaoPopup(`🟦 ĐÃ CHỌN: ${unit.name}`, "Nhấp chuột phải lên mặt nước hoặc dùng nút lệnh để chỉ huy!");
        }

        function boChonDaoQuan() {
            Game3D.selectedUnit = null;
            if (Game3D.selectionRing3D) {
                Game3D.selectionRing3D.visible = false;
            }
            const panel = document.getElementById('selected-unit-panel');
            if (panel) panel.style.display = 'none';
        }

        // 4. Ra Lệnh Cơ Động Đến Tọa Độ & Marker Điểm Đến 3D
        function raLenhDiChuyenToaDo(unit, x, z) {
            if (!unit) return;
            unit.targetX = x;
            unit.targetZ = z;
            unit.isMoving = true;

            // Đặt Marker 3D phát sáng tại điểm đến
            taoMarkerDiemDen3D({ x: x, y: 1.4, z: z });

            // Nếu Thuyền Nhẹ rút lui qua bãi cọc (z <= 15) lúc Nước Lớn -> Kích hoạt Phase Nhử Địch
            if (unit.id === 'thuyenNhe' && z <= 15 && Game3D.combatPhase === 'NUOC_LON') {
                Game3D.combatPhase = 'NHU_DICH';
                hienThiThongBaoPopup("🌊 KẾ GIẢ THUA THÀNH CÔNG", "Thuyền nhẹ rút sâu qua bãi cọc! Hạm đội giặc đang kiêu ngạo đuổi vào bẫy!");
                phatGiongDoc("Kế giả thua đã thành công! Hạm đội Hoằng Tháo đang dốc toàn lực đuổi theo vào bãi cọc! Triều chuẩn bị rút xiết!");
            } else {
                hienThiThongBaoPopup("📍 LỆNH CƠ ĐỘNG", `${unit.name} đang chuyển hướng đến tọa độ chiến thuật!`);
            }
        }

        // 5. Ra Lệnh Công Kích & Kiểm Tra Bẫy Nước Lớn
        function raLenhTanCongMucTieu(targetUnit) {
            if (!Game3D.selectedUnit) return;
            AudioEngine.playWarDrum();

            // BẪY CHIẾN THUẬT: Đánh giáp lá cà lúc nước lớn!
            if (Game3D.thuyTrieu.phanTram > 75) {
                Game3D.quanLuc = Math.max(5000, Game3D.quanLuc - 2500);
                Game3D.thuongBinh += 550;
                Game3D.siKhi = Math.max(15, Game3D.siKhi - 35);
                capNhatHUD();

                document.body.classList.add('screen-shake');
                setTimeout(() => document.body.classList.remove('screen-shake'), 1200);

                hienThiThongBaoPopup("⚠️ SA BẪY CHIẾN THUẬT: NƯỚC LỚN!", "Lâu thuyền địch to lớn áp đảo đè bẹp thuyền nhẹ! Thương binh tăng vọt!");
                phatGiongDoc("Báo động nguy cấp! Đô úy đã trúng bẫy chiến thuật! Nước triều còn quá lớn, lâu thuyền địch to khỏe áp đảo, quân ta thương vong nặng nề! Mau rút lui qua bãi cọc!");

                banMuaTenLua3D();
                return;
            }

            // Tiến hành công kích
            const u = Game3D.selectedUnit;
            u.targetX = targetUnit.pos.x;
            u.targetZ = targetUnit.pos.z + 10;
            u.isMoving = true;

            taoMarkerDiemDen3D({ x: targetUnit.pos.x, y: 1.4, z: targetUnit.pos.z + 10 });
            hienThiThongBaoPopup("⚔️ LỆNH TẤN CÔNG", `${u.name} xông lên công kích hạm đội giặc!`);
            phatGiongDoc(`${u.name} xuất kích, bao vây tiêu diệt hạm đội địch!`);

            banMuaTenLua3D();
        }

        // 6. Ra Lệnh Di Chuyển Nhanh Từ Panel
        function raLenhDiChuyenDoiHinh(lenh) {
            if (!Game3D.selectedUnit) {
                if (Game3D.units.thuyenNhe) chonDaoQuan3D(Game3D.units.thuyenNhe);
            }

            const u = Game3D.selectedUnit;
            if (!u) return;

            if (lenh === 'tan_cong') {
                const dich = Game3D.units.dichLauThuyen;
                if (dich) raLenhTanCongMucTieu(dich);
            } else if (lenh === 'rut_lui') {
                raLenhDiChuyenToaDo(u, 0, -45);
                u.isRetreating = true;
                hienThiThongBaoPopup("🛡️ LỆNH RÚT LUI", `${u.name} cơ động rút sâu qua bãi cọc nhử địch!`);
                phatGiongDoc(`${u.name} mau chóng giả vờ thua rút lui, kéo hạm đội giặc vào bãi cọc ngầm!`);
                if (Game3D.combatPhase === 'NUOC_LON') {
                    Game3D.combatPhase = 'NHU_DICH';
                }
            }
        }

        // 7. Tạo & Cập Nhật Marker Điểm Đến 3D (Glowing Beacons)
        function taoMarkerDiemDen3D(pos) {
            const ringGeo = new THREE.RingGeometry(1.6, 2.6, 32);
            ringGeo.rotateX(-Math.PI / 2);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0x00FFCC,
                transparent: true,
                opacity: 0.9,
                side: THREE.DoubleSide
            });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.position.set(pos.x, 1.45, pos.z);

            const pillarGeo = new THREE.CylinderGeometry(0.35, 0.35, 14, 12);
            const pillarMat = new THREE.MeshBasicMaterial({
                color: 0x00FFCC,
                transparent: true,
                opacity: 0.45,
                blending: THREE.AdditiveBlending
            });
            const pillar = new THREE.Mesh(pillarGeo, pillarMat);
            pillar.position.set(0, 7, 0);
            ring.add(pillar);

            Game3D.scene.add(ring);

            Game3D.targetMarkers3D.push({
                mesh: ring,
                pillar: pillar,
                time: 0,
                maxLife: 3.2
            });
        }

        function capNhatMarkerDiemDen3D(delta) {
            for (let i = Game3D.targetMarkers3D.length - 1; i >= 0; i--) {
                const m = Game3D.targetMarkers3D[i];
                m.time += delta;
                const progress = m.time / m.maxLife;

                m.mesh.rotation.y += delta * 2.2;
                const pulse = 1.0 + Math.sin(m.time * 6.5) * 0.22;
                m.mesh.scale.set(pulse, pulse, pulse);

                if (m.mesh.material) {
                    m.mesh.material.opacity = Math.max(0, 0.9 * (1 - progress));
                }
                if (m.pillar && m.pillar.material) {
                    m.pillar.material.opacity = Math.max(0, 0.45 * (1 - progress));
                }

                if (m.time >= m.maxLife) {
                    Game3D.scene.remove(m.mesh);
                    Game3D.targetMarkers3D.splice(i, 1);
                }
            }
        }

        // 8. Khởi Động Hồi 2: Chế Độ Sa Bàn Thực Chiến Trực Quan
        function khoiDongChienTranHoi2() {
            AudioEngine.playWarDrum();
            chuyenDoiThoiTiet3Hoi(2); // Chuyển sang Hồi 2: Giông bão chiến trường & bọt sóng bãi cọc
