        /*  10. PHẦN 4 CSS: ĐIỀU KHIỂN CHUỘT, BẪY CHIẾN THUẬT & ĐẠO LÀM TƯỚNG 3D     */
        /* ========================================================================== */
        /* Thanh Thông Báo Giai Đoạn Trận Đánh */
        .battle-stage-banner {
            position: absolute;
            top: 75px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, rgba(20, 26, 38, 0.95) 0%, rgba(10, 14, 20, 0.96) 100%);
            border: 1.5px solid var(--gold-primary);
            box-shadow: 0 4px 20px rgba(0,0,0,0.7), 0 0 15px rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 6px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 14;
            pointer-events: auto;
        }

        .stage-pulse-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #2ECC71;
            box-shadow: 0 0 10px #2ECC71;
            animation: pulseDot 1.2s infinite;
        }

