        /* ========================================================================== */
        /*  G. DỰNG BÃI CỌC NGẦM BỊT SẮT 3D (INSTANCED MESH 60 FPS)                   */
        /* ========================================================================== */
        function dungBaiCocNgam3D() {
            const count = 320; // Hơn 300 cọc cắm so le hình chữ chi
            
            // 1. Thân cọc gỗ (Cylinder thuôn nhọn)
            const stakeBodyGeo = new THREE.CylinderGeometry(0.35, 0.55, 6.5, 7);
            const stakeBodyMat = new THREE.MeshStandardMaterial({
                color: 0x4A3423,
                roughness: 0.92,
                metalness: 0.08
            });
            const instancedStakeBody = new THREE.InstancedMesh(stakeBodyGeo, stakeBodyMat, count);
            instancedStakeBody.castShadow = true;
            instancedStakeBody.receiveShadow = true;

            // 2. Đầu cọc bịt sắt sắc bén (Cone kim loại sáng bóng)
            const stakeTipGeo = new THREE.ConeGeometry(0.42, 1.8, 7);
            const stakeTipMat = new THREE.MeshStandardMaterial({
                color: 0x8A9BA8,
                roughness: 0.28,
                metalness: 0.85
            });
            const instancedStakeTip = new THREE.InstancedMesh(stakeTipGeo, stakeTipMat, count);
            instancedStakeTip.castShadow = true;
            instancedStakeTip.receiveShadow = true;

            const dummy = new THREE.Object3D();
            let index = 0;

            // Trải cọc ngầm ở đoạn thắt cửa sông (Z từ -50 đến +30, X từ -26 đến +26)
            for (let z = -55; z <= 35; z += 5.5) {
                for (let x = -26; x <= 26; x += 5.2) {
                    if (index >= count) break;

                    // Thêm nhiễu ngẫu nhiên tạo thế cọc tự nhiên như thật
                    const posX = x + (Math.random() - 0.5) * 3.2;
                    const posZ = z + (Math.random() - 0.5) * 3.2;
                    const posY = -3.8; // Cắm sâu dưới đáy bùn

                    // Độ nghiêng cọc: Nghiêng ngược dòng nước hướng ra biển để đâm thủng đáy thuyền địch
                    const tiltX = (Math.random() - 0.5) * 0.18;
                    const tiltZ = 0.22 + Math.random() * 0.24; // Hướng đón đầu thuyền

                    // 1. Ma trận thân cọc gỗ
                    dummy.position.set(posX, posY + 3.25, posZ);
                    dummy.rotation.set(tiltX, Math.random() * Math.PI, tiltZ);
                    dummy.scale.set(1, 1 + (Math.random() - 0.5) * 0.3, 1);
                    dummy.updateMatrix();
                    instancedStakeBody.setMatrixAt(index, dummy.matrix);

                    // 2. Ma trận đầu bịt sắt nằm ngay đỉnh cọc
                    dummy.position.set(posX - tiltZ * 1.5, posY + 6.6, posZ);
                    dummy.scale.set(1, 1, 1);
                    dummy.updateMatrix();
                    instancedStakeTip.setMatrixAt(index, dummy.matrix);

                    index++;
                }
            }

            instancedStakeBody.instanceMatrix.needsUpdate = true;
            instancedStakeTip.instanceMatrix.needsUpdate = true;

            const stakeGroup = new THREE.Group();
            stakeGroup.add(instancedStakeBody);
            stakeGroup.add(instancedStakeTip);
            Game3D.scene.add(stakeGroup);
            Game3D.stakeField = stakeGroup;
        }

