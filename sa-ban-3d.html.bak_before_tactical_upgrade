        /* ========================================================================== */
        /*  O. PHẦN 5: BÌNH MINH HÒA BÌNH, QUYẾT SÁCH HẬU CHIẾN & BẢO TÀNG 3D        */
        /* ========================================================================== */

        // 1. Chuyển Đổi Môi Trường 3D Sang Bình Minh Hòa Bình
        function chuyenSangBinhMinhHoaBinh() {
            Game3D.isPostWar = true;
            Game3D.cheDoCamera = 'FIRST_PERSON';
            chuyenDoiThoiTiet3Hoi(3); // Chuyển sang Hồi 3: Bình minh rạng đông, God-rays & nước xanh biếc

            // Chuyển màu bầu trời, sương mù & ánh sáng sang ánh vàng bình minh rực rỡ
            if (Game3D.scene.fog) {
                Game3D.scene.fog.color.setHex(0xE0BB6B);
                Game3D.scene.fog.density = 0.0022;
            }

            Game3D.scene.traverse(obj => {
                if (obj.isDirectionalLight) {
                    obj.color.setHex(0xFFE49A);
                    obj.intensity = 1.75;
                } else if (obj.isHemisphereLight) {
                    obj.color.setHex(0xFFF5E1);
                    obj.groundColor.setHex(0x334422);
                    obj.intensity = 1.2;
                }
            });

            // Mặt nước sông trong xanh êm ả, ánh vàng phản chiếu
            if (Game3D.waterMesh) {
                Game3D.waterMesh.material.color.setHex(0x1B7286);
                Game3D.waterMesh.material.roughness = 0.08;
                Game3D.waterMesh.material.metalness = 0.25;
            }

            // Chuyển đổi hạt tàn lửa sang đốm sáng hoàng kim & cánh hoa sen bay trong gió
            if (Game3D.particles) {
                const colors = Game3D.particles.geometry.attributes.color;
                if (colors) {
                    const count = colors.count;
                    const cGold = new THREE.Color(0xFFD700);
                    const cLotus = new THREE.Color(0xFFAAA6);
                    for (let i = 0; i < count; i++) {
                        const c = (i % 2 === 0) ? cGold : cLotus;
                        colors.setXYZ(i, c.r, c.g, c.b);
                    }
                    colors.needsUpdate = true;
                }
                const speeds = Game3D.particles.geometry.userData.speeds;
                for (let i = 0; i < speeds.length / 3; i++) {
                    speeds[i * 3 + 0] = (Math.random() - 0.5) * 0.12;
                    speeds[i * 3 + 1] = -0.06 - Math.random() * 0.08;
                    speeds[i * 3 + 2] = (Math.random() - 0.5) * 0.15;
                }
            }

            // Đưa Tướng quân vào vị trí dạo bước trên bến sông
            if (Game3D.player && Game3D.player.mesh) {
                Game3D.player.pos.set(-30, 2.4, 20);
                Game3D.player.rotationY = Math.PI / 2;
                Game3D.player.mesh.position.copy(Game3D.player.pos);
            }

            // Tàu giặc hạ buồm cắm cờ trắng hòa bình
            const dich = Game3D.units.dichLauThuyen;
            if (dich && dich.flagship) {
                dich.flagship.rotation.z = 0;
                dich.flagship.rotation.x = 0;
            }

            // Dựng 4 Khu Quyết Sách Hậu Chiến Ven Sông
            tao4CongTrinhHauChien3D();

            // Ẩn biển tên thời chiến
            Object.values(Game3D.congTrinhHauPhuong).forEach(fac => {
                if (fac.labelEl) fac.labelEl.style.display = 'none';
            });

            // Cập nhật Banner & Nhiệm vụ HUD
            const banner = document.getElementById('battle-stage-banner');
            const bannerText = document.getElementById('stage-banner-text');
            if (banner) banner.style.display = 'flex';
            if (bannerText) {
                bannerText.textContent = "🕊️ HỒI 3: BÌNH MINH HÒA BÌNH — NHẬP VAI KHẢO SÁT DỌC BỜ SÔNG & BÙ ĐẮP HẬU CHIẾN";
            }

            const questInst = document.getElementById('hud-quest-instruction');
            if (questInst) {
                questInst.innerHTML = '<b>Bình Minh Hòa Bình:</b> Khói lửa đã tan! Giang sơn sạch bóng quân thù. Dùng phím <b>W, A, S, D</b> điều khiển Tướng quân chạy dọc bờ sông đến <b>4 địa điểm hậu chiến</b> và nhấn <b>[Phím E]</b> để thực hiện quyết sách nhân đạo!';
            }

            const btnCall = document.getElementById('btn-call-battle');
            if (btnCall) {
                btnCall.innerHTML = '<span>🕊️</span> <span>Bình Minh Hòa Bình</span>';
                btnCall.style.borderColor = '#38EF7D';
                btnCall.onclick = () => datGocNhinCamera('FIRST_PERSON');
            }

            hienThiThongBaoPopup("🕊️ BÌNH MINH HÒA BÌNH", "Khói lửa tan dần! Hãy dạo bước bờ sông thực hiện 4 quyết sách nhân văn bù đắp hậu chiến!");
            phatGiongDoc("Khói lửa đã tan! Bình minh hòa bình rạng rỡ trên sông Bạch Đằng. Mời Đô úy dạo bước bờ sông thực hiện 4 quyết sách hậu chiến nhân văn cứu giúp muôn dân và mở khóa các bảo vật truyền quốc!");
        }

        // 2. Dựng 4 Công Trình Hậu Chiến 3D
        function tao4CongTrinhHauChien3D() {
