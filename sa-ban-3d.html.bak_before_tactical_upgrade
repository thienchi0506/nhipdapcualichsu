        // 5. Khởi Tạo Engine 3D Bảo Tàng Cổ Vật Xoay 360 Độ
        function khoiTaoRelicViewer() {
            const canvas = document.getElementById('relic-3d-canvas');
            if (!canvas || Game3D.relicViewer.renderer) return;

            const wrap = document.getElementById('relic-canvas-wrap');
            const width = wrap ? wrap.clientWidth : 420;
            const height = wrap ? wrap.clientHeight : 350;

            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0c1219);

            const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
            camera.position.set(0, 3.2, 7.5);
            camera.lookAt(0, 1.2, 0);

            const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.35;

            // Bệ Đá Cổ 3D
            const pedGeo = new THREE.CylinderGeometry(2.2, 2.6, 0.6, 32);
            const pedMat = new THREE.MeshStandardMaterial({ color: 0x222b38, roughness: 0.8, metalness: 0.2 });
            const pedestal = new THREE.Mesh(pedGeo, pedMat);
            pedestal.position.y = -0.3;
            scene.add(pedestal);

            // Viền vàng hoàng kim bệ đá
            const rimGeo = new THREE.TorusGeometry(2.25, 0.08, 16, 64);
            rimGeo.rotateX(Math.PI / 2);
            const rimMat = new THREE.MeshStandardMaterial({ color: 0xD4AF37, roughness: 0.3, metalness: 0.8 });
            const rim = new THREE.Mesh(rimGeo, rimMat);
            rim.position.y = 0;
            scene.add(rim);

            // Ánh sáng Spotlight & Directional Light
            const ambLight = new THREE.AmbientLight(0xffffff, 0.85);
            scene.add(ambLight);

            const spotLight = new THREE.SpotLight(0xFFEAA7, 2.8);
            spotLight.position.set(5, 8, 6);
            spotLight.angle = 0.65;
            spotLight.penumbra = 0.5;
            scene.add(spotLight);

            const cyanBackLight = new THREE.DirectionalLight(0x00E5FF, 1.3);
            cyanBackLight.position.set(-5, 4, -5);
            scene.add(cyanBackLight);

            const modelGroup = new THREE.Group();
            modelGroup.position.set(0, 0.4, 0);
            scene.add(modelGroup);

            Game3D.relicViewer = {
                scene: scene,
                camera: camera,
                renderer: renderer,
                modelGroup: modelGroup,
                pedestal: pedestal,
                autoSpin: true,
                isDragging: false,
                prevMouse: { x: 0, y: 0 },
                rotationY: 0,
                rotationX: 0
            };

            // Kéo chuột xoay 360 độ
            canvas.addEventListener('pointerdown', (e) => {
                Game3D.relicViewer.isDragging = true;
                Game3D.relicViewer.prevMouse = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('pointermove', (e) => {
                if (!Game3D.relicViewer.isDragging) return;
                const dx = e.clientX - Game3D.relicViewer.prevMouse.x;
                const dy = e.clientY - Game3D.relicViewer.prevMouse.y;
                Game3D.relicViewer.rotationY += dx * 0.015;
                Game3D.relicViewer.rotationX = Math.max(-0.6, Math.min(0.6, Game3D.relicViewer.rotationX + dy * 0.01));
                Game3D.relicViewer.prevMouse = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('pointerup', () => {
                Game3D.relicViewer.isDragging = false;
            });

            // Vòng lặp render riêng cho Cổ vật 3D
            function relicRenderLoop() {
                requestAnimationFrame(relicRenderLoop);
                const modal = document.getElementById('modal-museum-3d');
                if (!modal || !modal.classList.contains('open')) return;

                const rv = Game3D.relicViewer;
                if (!rv || !rv.renderer) return;

                if (rv.autoSpin && !rv.isDragging) {
                    rv.rotationY += 0.014;
                }

                rv.modelGroup.rotation.y = rv.rotationY;
                rv.modelGroup.rotation.x = rv.rotationX;

                rv.renderer.render(rv.scene, rv.camera);
            }
            relicRenderLoop();
        }

