        function thucHienNangCap(structureId, tierIndex) {
            const fac = Game3D.congTrinhHauPhuong[structureId];
            if (!fac) return;
            const tier = fac.tiers[tierIndex];
            if (!tier || tier.unlocked) return;

            // Xử lý nút xuất quân đặc biệt ở Đài Chỉ Huy
            if (tier.isBattleTrigger) {
                dongModalNangCap();
                chuyenVaoThucChien();
                return;
            }

            if (Game3D.nganKho < tier.cost) {
                alert("Ngân khố không đủ! Hãy cân đối quân nhu.");
                return;
            }

            // Trừ chi phí
            Game3D.nganKho -= tier.cost;
            tier.unlocked = true;
            fac.capDo = Math.max(fac.capDo, tier.level);

            // Áp dụng bồi hoàn chỉ số quân cơ
            if (structureId === 'xuongDeoCoc') {
                if (tierIndex === 1) Game3D.siKhi = Math.min(100, Game3D.siKhi + 20);
                if (tierIndex === 2) { Game3D.siKhi = 100; Game3D.thuongBinh = 0; }
                phatGiongDoc("Bãi cọc đã được gia cố! Quân dân Yên Hưng nức lòng ủng hộ!");
            } else if (structureId === 'loRenQuanKhi') {
                if (tierIndex === 0) Game3D.quanLuc += 2500;
                if (tierIndex === 1) Game3D.siKhi = Math.min(100, Game3D.siKhi + 15);
                if (tierIndex === 2) phatGiongDoc("50 bè lửa hỏa công đã hạ thủy, sẵn sàng xuôi gió thiêu rụi hạm đội Hoằng Tháo!");
            } else if (structureId === 'quanYVien') {
                if (tierIndex === 0) Game3D.thuongBinh = 0;
                if (tierIndex === 1) { Game3D.nhanDao += 150; Game3D.siKhi = Math.min(100, Game3D.siKhi + 30); }
                if (tierIndex === 2) Game3D.nhanDao += 50;
                phatGiongDoc("Tấm lòng nhân hậu của Đô úy đã thấu tận lòng ba quân! Sĩ khí dâng cao như sóng biển!");
            } else if (structureId === 'daiChiHuy') {
                if (tierIndex === 0) Game3D.siKhi = Math.min(100, Game3D.siKhi + 20);
                if (tierIndex === 1) Game3D.quanLuc += 5000;
                phatGiongDoc("10.000 phục binh đã ém sẵn hai bên bờ lau sậy theo đúng sa bàn!");
            }

            // Cập nhật giao diện HUD
            capNhatHUD();

            // Mở lại modal để cập nhật trạng thái mới
            moBangNangCapCongTrinh(structureId);
        }

