            Game3D.postWarSitesCreated = true;

            const woodMat = new THREE.MeshStandardMaterial({ color: 0x4A3525, roughness: 0.9 });
            const stoneMat = new THREE.MeshStandardMaterial({ color: 0x3E444E, roughness: 0.85 });
