        // 2. Tạo Thẻ Máu & Sĩ Khí Nổi 3D Của 5 Đạo Quân
        function taoThanhMauDaoQuan() {
            const container = document.getElementById('unit-labels-container');
            if (!container) return;

            Object.values(Game3D.units).forEach(u => {
                const tag = document.createElement('div');
                tag.className = 'unit-hud-tag';

                const isEnemy = (u.type === 'dich');
                tag.innerHTML = `
                    <div class="unit-hud-header">
                        <span>${u.icon} ${u.name}</span>
                        <span id="hp-txt-${u.id}">100%</span>
                    </div>
                    <div class="unit-bars-wrap">
                        <div class="unit-bar-bg" title="Lực lượng máu (HP)">
                            <div class="unit-bar-fill ${isEnemy ? 'enemy-hp' : 'hp'}" id="bar-hp-${u.id}" style="width: 100%;"></div>
                        </div>
                        <div class="unit-bar-bg" title="Sĩ khí quân sĩ">
                            <div class="unit-bar-fill morale" id="bar-morale-${u.id}" style="width: 100%;"></div>
                        </div>
                    </div>
                `;
                tag.style.pointerEvents = 'auto';
                tag.style.cursor = 'pointer';
                tag.title = isEnemy ? 'Hạm Đội Địch - Click để công kích khi đang chọn quân' : `Click để chọn & chỉ huy ${u.name}`;
                tag.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (u.type === 'ta') {
                        chonDaoQuan3D(u);
                    } else if (u.type === 'dich' && Game3D.selectedUnit) {
                        raLenhTanCongMucTieu(u);
                    }
                });
                container.appendChild(tag);
                u.labelEl = tag;
            });
        }

        function capNhatThanhMauDaoQuan3D() {
            if (!Game3D.camera) return;

            const tempV = new THREE.Vector3();

            Object.values(Game3D.units).forEach(u => {
                if (!u.labelEl) return;

                // Chiều cao nhô lên tùy theo kích cỡ đạo quân
                const heightOffset = (u.id === 'dichLauThuyen') ? 14 : 4.5;
                tempV.set(u.pos.x, u.pos.y + heightOffset, u.pos.z);
                tempV.project(Game3D.camera);

                if (tempV.z > 1.0 || Game3D.cheDoCamera === 'LOBBY') {
                    u.labelEl.style.display = 'none';
                    return;
                }

                const x = (tempV.x * 0.5 + 0.5) * window.innerWidth;
                const y = (-(tempV.y * 0.5) + 0.5) * window.innerHeight;

                u.labelEl.style.left = `${x}px`;
                u.labelEl.style.top = `${y}px`;
                u.labelEl.style.display = 'block';

                // Cập nhật giá trị máu & sĩ khí
                const barHp = document.getElementById(`bar-hp-${u.id}`);
                const barMorale = document.getElementById(`bar-morale-${u.id}`);
                const hpTxt = document.getElementById(`hp-txt-${u.id}`);

                if (barHp) barHp.style.width = `${Math.max(0, u.hp)}%`;
                if (barMorale) barMorale.style.width = `${Math.max(0, u.morale)}%`;
                if (hpTxt) hpTxt.textContent = `${Math.max(0, Math.round(u.hp))}%`;
            });
        }

