        // 5. Cập nhật Điều khiển Nhân vật & Tương tác trong Render Loop
        function xuLyDieuKhienNhanVat(delta, elapsed) {
            const p = Game3D.player;
            if (!p.mesh) return;

            let moveX = 0;
            let moveZ = 0;

            if (Game3D.keys.up)    moveZ -= 1;
            if (Game3D.keys.down)  moveZ += 1;
            if (Game3D.keys.left)  moveX -= 1;
            if (Game3D.keys.right) moveX += 1;

            const isMoving = (moveX !== 0 || moveZ !== 0);
            p.isMoving = isMoving;

            if (isMoving) {
                // Chuẩn hóa vector di chuyển
                const len = Math.hypot(moveX, moveZ);
                moveX /= len;
                moveZ /= len;

                // Góc xoay hướng mặt của Tướng quân
                const targetAngle = Math.atan2(moveX, moveZ);
                // Nội suy góc xoay mượt mà
                let diff = targetAngle - p.rotationY;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI)  diff -= Math.PI * 2;
                p.rotationY += diff * 0.18;
                p.mesh.rotation.y = p.rotationY;

                // Cập nhật vị trí
                p.pos.x += moveX * p.speed * delta;
                p.pos.z += moveZ * p.speed * delta;

                // Giới hạn biên di chuyển trong khu vực doanh trại ven sông
                p.pos.x = Math.max(-46, Math.min(-24, p.pos.x));
                p.pos.z = Math.max(-55, Math.min(50, p.pos.z));

                // Điều chỉnh độ cao Y theo địa hình
                if (p.pos.x > -30 && p.pos.z > 15) {
                    p.pos.y = 2.8; // Trên cầu cảng bến gỗ
                } else {
                    p.pos.y = 2.2; // Trên nền đất bãi sông
                }
                p.mesh.position.copy(p.pos);

                // Hoạt ảnh bước đi vung tay vung chân
                p.walkCycle += delta * 12;
                p.leftLeg.rotation.x = Math.sin(p.walkCycle) * 0.55;
                p.rightLeg.rotation.x = -Math.sin(p.walkCycle) * 0.55;
                p.leftArm.rotation.x = -Math.sin(p.walkCycle) * 0.45;
                p.rightArm.rotation.x = Math.sin(p.walkCycle) * 0.45;
                p.cape.rotation.x = 0.2 + Math.abs(Math.sin(p.walkCycle)) * 0.25;
            } else {
                // Trở về tư thế đứng nghiêm (Idle)
                p.leftLeg.rotation.x *= 0.82;
                p.rightLeg.rotation.x *= 0.82;
                p.leftArm.rotation.x *= 0.82;
                p.rightArm.rotation.x *= 0.82;
                p.cape.rotation.x = 0.15;
            }

            // Hiệu ứng vòng sáng nhấp nháy dưới chân các công trình
            const targetStructures = Game3D.isPostWar ? Game3D.congTrinhHauChien : Game3D.congTrinhHauPhuong;

            Object.values(targetStructures).forEach((fac, idx) => {
                if (fac.ringMesh) {
                    fac.ringMesh.material.opacity = 0.4 + Math.sin(elapsed * 4 + idx) * 0.35;
                }
            });

            // Kiểm tra cự ly tương tác với các công trình
            let nearestFac = null;
            let minDist = 7.5; // Bán kính nhận diện tương tác 7.5m

            Object.values(targetStructures).forEach(fac => {
                const dist = Math.hypot(p.pos.x - fac.pos.x, p.pos.z - fac.pos.z);
                if (dist < minDist) {
                    minDist = dist;
                    nearestFac = fac;
                }
            });

            const promptPill = document.getElementById('interaction-prompt-pill');
            const promptText = document.getElementById('interaction-prompt-text');

            if (nearestFac) {
                if (Game3D.isPostWar) {
                    Game3D.activePostWarSite = nearestFac.id;
                    if (promptPill && promptText) {
                        promptText.textContent = `🕊️ Bấm [E] thực hiện ${nearestFac.name}`;
                        promptPill.classList.add('show');
                    }
                } else {
                    Game3D.activeStructure = nearestFac.id;
                    if (promptPill && promptText) {
                        promptText.textContent = `⚔️ Bấm [E] để vào ${nearestFac.name}`;
                        promptPill.classList.add('show');
                    }
                }
            } else {
                Game3D.activeStructure = null;
                Game3D.activePostWarSite = null;
                if (promptPill) promptPill.classList.remove('show');
            }

            // Trong Chế Độ [🎥 Góc Nhìn Nhập Vai], Camera tự động đi sau lưng nhân vật
            if (Game3D.cheDoCamera === 'FIRST_PERSON') {
                const camDist = 12.0;
                const camH = 6.0;
                Game3D.targetCamPos.set(
                    p.pos.x - Math.sin(p.rotationY) * camDist,
                    p.pos.y + camH,
                    p.pos.z - Math.cos(p.rotationY) * camDist
                );
                Game3D.targetCamLook.set(
                    p.pos.x + Math.sin(p.rotationY) * 6,
                    p.pos.y + 2.5,
                    p.pos.z + Math.cos(p.rotationY) * 6
                );
            }
        }

