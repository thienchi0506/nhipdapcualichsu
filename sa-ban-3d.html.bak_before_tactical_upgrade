        /*  C. KHỞI TẠO THREE.JS ENGINE 3D & ÁNH SÁNG MÔI TRƯỜNG                     */
        /* ========================================================================== */
        function khoiTaoThreeJSEngine() {
            const container = document.getElementById('webgl-canvas-container');
            const canvas = document.getElementById('webgl-canvas');

            // 1. Scene
            Game3D.scene = new THREE.Scene();
            // Sương mù thời gian thực tạo chiều sâu huyền bí cho sông nước
            Game3D.scene.fog = new THREE.FogExp2(0x0c151f, 0.0035);

            // 2. Camera
            Game3D.camera = new THREE.PerspectiveCamera(
                55,
                window.innerWidth / window.innerHeight,
                0.8,
                1500
            );
            Game3D.camera.position.set(0, 35, 120);

            // 3. Renderer
            Game3D.renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                antialias: true,
                powerPreference: 'high-performance'
            });
            Game3D.renderer.setSize(window.innerWidth, window.innerHeight);
            Game3D.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            Game3D.renderer.shadowMap.enabled = true;
            Game3D.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            Game3D.renderer.toneMapping = THREE.ACESFilmicToneMapping;
            Game3D.renderer.toneMappingExposure = 1.15;

            // 4. Ánh sáng Môi Trường (Lighting)
            thietLapAnhSang3D();

            // 5. Dựng Địa Hình Núi Non Hai Bên Bờ & Bến Gỗ
            dungDiaHinhSongNui();

            // 6. Dựng Mặt Nước Sông Bạch Đằng Sóng Nhấp Nhô
            dungMatNuocSong3D();

            // 7. Dựng Bãi Cọc Ngầm Bịt Sắt 3D (InstancedMesh 60 FPS)
            dungBaiCocNgam3D();

            // 8. Hệ Thống Hạt Tàn Lửa & Đốm Sáng Không Gian (Particles)
            dungHeThongHatTanLua();

            // 9. Dựng Nhân Vật Tướng Lĩnh 3D & 4 Công Trình Hậu Phương (Phần 2)
            taoNhanVatTuongLinh3D();
            tao4CongTrinhHauPhuong3D();
            taoBienTenNoiCongTrinh();
            dangKySuKienBanPhimRPG();

            // 10. Dựng Các Đạo Quân 3D & Thanh Tuyệt Kỹ Danh Tướng (Phần 3)
            taoCacDaoQuan3D();
            taoThanhMauDaoQuan();
            dangKyPhimTuyetKy();

            // 11. Dựng Vòng Sáng Chọn Quân 3D & Khởi tạo Raycasting Chọn / Điều Quân (Phần 4)
            taoVongSangChonQuan3D();
            khoiTaoRaycastingChonQuan();

            // 12. Lắng nghe Tương tác Chuột & Resize
            dangKySuKienChuotVaManHinh();

            // 13. Khởi tạo Radar Sa Bàn Minimap 2D & Tải Dữ Liệu Danh Tướng (Bước 6)
            taiProfileDanhTuong();
            khoiTaoMinimap2D();

            // Khởi tạo các hệ thống Môi trường 3D & Vật lý Va chạm 3 Hồi
            khoiTaoDomDomHauPhuong();
            khoiTaoBotSongBaiCoc();
            khoiTaoVatLyVoTauVaChay();
            khoiTaoGodRays();
            chuyenDoiThoiTiet3Hoi(1); // Mặc định Hồi 1: Đêm Doanh Trại

            // Chạy Render Loop
            renderLoop3D();
        }

