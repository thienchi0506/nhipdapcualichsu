        /*  2. Đom đóm bay quanh 4 công trình hậu phương (Hồi 1)                      */
        /*  3. Bọt sóng trắng xóa xoáy quanh hơn 300 đầu cọc gỗ bịt sắt (Hồi 2)       */
        /*  4. Mảnh gỗ văng 3D, Cột nước bắn cao, Lửa & Khói đen, Chìm tàu (Hồi 2)    */
        /*  5. Tia nắng rạng đông (God-Rays) ấm áp & Nước trong biếc (Hồi 3)          */
        /* ========================================================================== */

        Game3D.currentAct = 1;
        Game3D.stormLightningTimer = 0;

        // 1. CHUYỂN ĐỔI THỜI TIẾT & ÁNH SÁNG 3 HỒI
        function chuyenDoiThoiTiet3Hoi(hoi) {
            Game3D.currentAct = hoi;

            if (hoi === 1) {
                // HỒI 1 (CHUẨN BỊ DOANH TRẠI): Đêm sương mù huyền ảo, ánh đuốc lửa trại bập bùng
                if (Game3D.scene && Game3D.scene.fog) {
                    Game3D.scene.fog.color.setHex(0x0A1118);
                    Game3D.scene.fog.density = 0.0035;
                }
                if (Game3D.renderer) Game3D.renderer.setClearColor(0x0A1118, 1);
                if (Game3D.hemiLight) {
                    Game3D.hemiLight.color.setHex(0x223344);
                    Game3D.hemiLight.groundColor.setHex(0x111A24);
                    Game3D.hemiLight.intensity = 0.52;
                }
                if (Game3D.sunLight) {
                    Game3D.sunLight.color.setHex(0x7799BB);
                    Game3D.sunLight.intensity = 0.65;
                }
                if (Game3D.waterMesh) {
                    Game3D.waterMesh.material.color.setHex(0x0E2E38);
                    Game3D.waterMesh.material.roughness = 0.22;
                    Game3D.waterMesh.material.metalness = 0.42;
                }
                if (Game3D.firefliesMesh) Game3D.firefliesMesh.visible = true;
                if (Game3D.foamMesh) Game3D.foamMesh.visible = false;
                if (Game3D.godRaysGroup) Game3D.godRaysGroup.visible = false;

            } else if (hoi === 2) {
                // HỒI 2 (THỰC CHIẾN THỦY TRIỀU): Bầu trời chuyển sắc giông bão chiến trường
                if (Game3D.scene && Game3D.scene.fog) {
                    Game3D.scene.fog.color.setHex(0x161C24);
                    Game3D.scene.fog.density = 0.0042;
                }
                if (Game3D.renderer) Game3D.renderer.setClearColor(0x161C24, 1);
                if (Game3D.hemiLight) {
                    Game3D.hemiLight.color.setHex(0x3B4656);
                    Game3D.hemiLight.groundColor.setHex(0x1D232C);
                    Game3D.hemiLight.intensity = 0.82;
                }
                if (Game3D.sunLight) {
                    Game3D.sunLight.color.setHex(0xD0DCE8);
                    Game3D.sunLight.intensity = 0.95;
                }
                if (Game3D.waterMesh) {
                    Game3D.waterMesh.material.color.setHex(0x103B47);
                    Game3D.waterMesh.material.roughness = 0.38;
                    Game3D.waterMesh.material.metalness = 0.32;
                }
                if (Game3D.firefliesMesh) Game3D.firefliesMesh.visible = false;
                if (Game3D.foamMesh) Game3D.foamMesh.visible = true;
                if (Game3D.godRaysGroup) Game3D.godRaysGroup.visible = false;

            } else if (hoi === 3) {
                // HỒI 3 (BÌNH MINH HÒA BÌNH): Mặt trời rạng đông tỏa tia nắng God-rays ấm áp
                if (Game3D.scene && Game3D.scene.fog) {
                    Game3D.scene.fog.color.setHex(0xE0BB6B);
                    Game3D.scene.fog.density = 0.0020;
                }
                if (Game3D.renderer) Game3D.renderer.setClearColor(0xE0BB6B, 1);
                if (Game3D.hemiLight) {
                    Game3D.hemiLight.color.setHex(0xFFF5E1);
                    Game3D.hemiLight.groundColor.setHex(0x334422);
                    Game3D.hemiLight.intensity = 1.35;
                }
                if (Game3D.sunLight) {
                    Game3D.sunLight.color.setHex(0xFFE49A);
                    Game3D.sunLight.intensity = 1.95;
                }
                if (Game3D.waterMesh) {
                    Game3D.waterMesh.material.color.setHex(0x1A7588);
                    Game3D.waterMesh.material.roughness = 0.08;
                    Game3D.waterMesh.material.metalness = 0.28;
                }
                if (Game3D.firefliesMesh) Game3D.firefliesMesh.visible = false;
                if (Game3D.foamMesh) Game3D.foamMesh.visible = false;
                if (Game3D.godRaysGroup) Game3D.godRaysGroup.visible = true;
            }
        }

        // Chớp lóe giông bão thời gian thực trong Hồi 2
        function capNhatGiongBaoHoi2(delta) {
            if (Game3D.currentAct !== 2) return;
            Game3D.stormLightningTimer = (Game3D.stormLightningTimer || 0) + delta;
            if (Game3D.stormLightningTimer > 7.5 + Math.random() * 5.0) {
                Game3D.stormLightningTimer = 0;
                if (Game3D.sunLight) {
                    const origInt = Game3D.sunLight.intensity;
                    Game3D.sunLight.intensity = 2.8;
                    setTimeout(() => {
                        if (Game3D.sunLight && Game3D.currentAct === 2) {
                            Game3D.sunLight.intensity = origInt;
                        }
                    }, 85);
                }
            }
        }

        // 2. ĐOM ĐÓM BAY QUANH 4 CÔNG TRÌNH HẬU PHƯƠNG (HỒI 1)
        function khoiTaoDomDomHauPhuong() {
            const centers = [
                { x: -36, y: 3.5, z: 35 },   // xuongDeoCoc
                { x: -42, y: 3.5, z: 5 },    // loRenQuanKhi
                { x: -46, y: 3.5, z: -25 },  // quanYVien
                { x: -28, y: 3.5, z: -50 }   // daiChiHuy
            ];

            const totalCount = 140;
            const geo = new THREE.BufferGeometry();
            const positions = new Float32Array(totalCount * 3);
            const params = [];

            for (let i = 0; i < totalCount; i++) {
                const cIdx = i % centers.length;
                const c = centers[cIdx];
                const r = 3 + Math.random() * 8.5;
                const ang = Math.random() * Math.PI * 2;
                const yOff = (Math.random() - 0.5) * 2.5;

                positions[i * 3 + 0] = c.x + Math.cos(ang) * r;
                positions[i * 3 + 1] = c.y + yOff;
                positions[i * 3 + 2] = c.z + Math.sin(ang) * r;

                params.push({
                    cIdx: cIdx,
                    radius: r,
                    angle: ang,
                    speed: (0.32 + Math.random() * 0.48) * (Math.random() < 0.5 ? 1 : -1),
                    baseY: c.y,
                    yFreq: 1 + Math.random() * 2,
                    yAmp: 0.8 + Math.random() * 1.2
                });
            }

            geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geo.userData = { params: params, centers: centers };

            const mat = new THREE.PointsMaterial({
                color: 0xB8FF33,
                size: 2.2,
                transparent: true,
                opacity: 0.92,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            Game3D.firefliesMesh = new THREE.Points(geo, mat);
            Game3D.scene.add(Game3D.firefliesMesh);
        }

        function capNhatDomDomHauPhuong(elapsed) {
            if (!Game3D.firefliesMesh || !Game3D.firefliesMesh.visible) return;
            const pos = Game3D.firefliesMesh.geometry.attributes.position.array;
            const params = Game3D.firefliesMesh.geometry.userData.params;
            const centers = Game3D.firefliesMesh.geometry.userData.centers;
            const len = params.length;

            for (let i = 0; i < len; i++) {
                const p = params[i];
                p.angle += p.speed * 0.02;
                const c = centers[p.cIdx];

                pos[i * 3 + 0] = c.x + Math.cos(p.angle) * p.radius;
                pos[i * 3 + 1] = p.baseY + Math.sin(elapsed * p.yFreq + i) * p.yAmp;
                pos[i * 3 + 2] = c.z + Math.sin(p.angle) * p.radius;
            }
            Game3D.firefliesMesh.geometry.attributes.position.needsUpdate = true;
            Game3D.firefliesMesh.material.opacity = 0.72 + Math.sin(elapsed * 4) * 0.25;
        }

        // 3. BỌT SÓNG TRẮNG XÓA (FOAM & WAKE) XOÁY QUANH HƠN 300 ĐẦU CỌC (HỒI 2)
        function khoiTaoBotSongBaiCoc() {
            const foamCount = 480;
            const geo = new THREE.BufferGeometry();
            const positions = new Float32Array(foamCount * 3);
            const velocities = new Float32Array(foamCount * 3);

            for (let i = 0; i < foamCount; i++) {
                // Trải rộng khắp vùng bãi cọc: x [-28, 28], z [-38, 24]
                positions[i * 3 + 0] = (Math.random() - 0.5) * 56;
                positions[i * 3 + 1] = Game3D.thuyTrieu.mucNuocY + 0.05;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 62 - 7;

                velocities[i * 3 + 0] = (Math.random() - 0.5) * 0.45;
                velocities[i * 3 + 1] = 0;
                velocities[i * 3 + 2] = -0.6 - Math.random() * 0.85; // Cuộn xiết theo triều rút
            }

            geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geo.userData = { vels: velocities };

            const mat = new THREE.PointsMaterial({
                color: 0xFFFFFF,
                size: 2.4,
                transparent: true,
                opacity: 0.88,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            Game3D.foamMesh = new THREE.Points(geo, mat);
            Game3D.foamMesh.visible = false;
            Game3D.scene.add(Game3D.foamMesh);
        }

        function capNhatBotSongBaiCoc(delta, elapsed) {
            if (!Game3D.foamMesh || !Game3D.foamMesh.visible) return;
            const pos = Game3D.foamMesh.geometry.attributes.position.array;
            const vels = Game3D.foamMesh.geometry.userData.vels;
            const len = pos.length / 3;
            const waterY = Game3D.thuyTrieu.mucNuocY + 0.06;

            for (let i = 0; i < len; i++) {
                pos[i * 3 + 0] += Math.sin(elapsed * 2.8 + i) * 0.14 + vels[i * 3 + 0] * delta;
                pos[i * 3 + 1] = waterY + Math.sin(pos[i * 3 + 0] * 0.2 + elapsed * 3.2) * 0.18;
                pos[i * 3 + 2] += vels[i * 3 + 2] * delta * 15;

                // Tái tạo bọt sóng khi trôi khỏi bãi cọc
                if (pos[i * 3 + 2] < -42) {
                    pos[i * 3 + 0] = (Math.random() - 0.5) * 56;
                    pos[i * 3 + 2] = 22 + Math.random() * 6;
                }
            }
            Game3D.foamMesh.geometry.attributes.position.needsUpdate = true;
        }

        // 4. VẬT LÝ VA CHẠM CỌC SẮT & VỠ TÀU 3D CHI TIẾT
        function khoiTaoVatLyVoTauVaChay() {
            // A. Mảnh gỗ ván thuyền văng tung tóe trong không gian 3D
            const splinterCount = 80;
            const splintersGroup = new THREE.Group();
            const splinterMeshes = [];
            const splinterGeo = new THREE.BoxGeometry(0.38, 0.09, 0.62);
            const splinterMat = new THREE.MeshStandardMaterial({
                color: 0x5C3A21,
                roughness: 0.95,
                metalness: 0.05
            });

            for (let i = 0; i < splinterCount; i++) {
                const m = new THREE.Mesh(splinterGeo, splinterMat);
                m.visible = false;
                m.castShadow = true;
                splintersGroup.add(m);
                splinterMeshes.push({
                    mesh: m,
                    active: false,
                    vx: 0, vy: 0, vz: 0,
                    rotVx: 0, rotVy: 0, rotVz: 0,
                    life: 0
                });
            }
            Game3D.scene.add(splintersGroup);
            Game3D.splinterMeshes = splinterMeshes;

            // B. Cột nước bắn lên cao (Water Splash Columns)
            const splashCount = 130;
            const splashGeo = new THREE.BufferGeometry();
            const splashPositions = new Float32Array(splashCount * 3);
            const splashVels = [];
            for (let i = 0; i < splashCount; i++) {
                splashPositions[i * 3 + 0] = 0;
                splashPositions[i * 3 + 1] = -100;
                splashPositions[i * 3 + 2] = 0;
                splashVels.push({ vx: 0, vy: 0, vz: 0, active: false, life: 0 });
            }
            splashGeo.setAttribute('position', new THREE.BufferAttribute(splashPositions, 3));
            const splashMat = new THREE.PointsMaterial({
                color: 0xE0F7FA,
                size: 2.2,
                transparent: true,
                opacity: 0.92,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });
            Game3D.splashMesh = new THREE.Points(splashGeo, splashMat);
            Game3D.splashMesh.userData = { vels: splashVels };
            Game3D.scene.add(Game3D.splashMesh);

            // C. Khói đen và lửa bốc cháy ngùn ngụt trên boong tàu
            const fireSmokeCount = 220;
            const fsGeo = new THREE.BufferGeometry();
            const fsPositions = new Float32Array(fireSmokeCount * 3);
            const fsColors = new Float32Array(fireSmokeCount * 3);
            const fsData = [];

            for (let i = 0; i < fireSmokeCount; i++) {
                fsPositions[i * 3 + 0] = 0;
                fsPositions[i * 3 + 1] = -100;
                fsPositions[i * 3 + 2] = 0;

                const isSmoke = (i >= 85);
                if (isSmoke) {
                    fsColors[i * 3 + 0] = 0.16;
                    fsColors[i * 3 + 1] = 0.16;
                    fsColors[i * 3 + 2] = 0.16;
                } else {
                    // Lửa cam đỏ vàng rực
                    fsColors[i * 3 + 0] = 1.0;
                    fsColors[i * 3 + 1] = 0.35 + Math.random() * 0.45;
                    fsColors[i * 3 + 2] = 0.05;
                }

                fsData.push({
                    isSmoke: isSmoke,
                    vy: isSmoke ? (2.6 + Math.random() * 3.8) : (1.9 + Math.random() * 2.9),
                    vx: (Math.random() - 0.5) * 1.6 - (isSmoke ? 0.85 : 0),
                    vz: (Math.random() - 0.5) * 1.6,
                    life: Math.random(),
                    maxLife: isSmoke ? 3.6 : 1.3
                });
            }

            fsGeo.setAttribute('position', new THREE.BufferAttribute(fsPositions, 3));
            fsGeo.setAttribute('color', new THREE.BufferAttribute(fsColors, 3));
            fsGeo.userData = { data: fsData };

            const fsMat = new THREE.PointsMaterial({
                size: 3.5,
                vertexColors: true,
                transparent: true,
                opacity: 0.86,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            Game3D.fireSmokeMesh = new THREE.Points(fsGeo, fsMat);
            Game3D.scene.add(Game3D.fireSmokeMesh);

            // Đèn ánh lửa bập bùng trên xác tàu
            Game3D.shipFireLight = new THREE.PointLight(0xFF4500, 0, 40, 1.6);
            Game3D.scene.add(Game3D.shipFireLight);
        }

        // Kích hoạt nổ mảnh vỡ và cột nước va chạm
        function phatNoManhVoVaCotNuoc(originX, originY, originZ) {
            // Mảnh gỗ ván vỡ văng tứ tán
            if (Game3D.splinterMeshes) {
                Game3D.splinterMeshes.forEach(sp => {
                    if (!sp.active) {
                        sp.active = true;
                        sp.mesh.visible = true;
                        sp.mesh.position.set(
                            originX + (Math.random() - 0.5) * 4.5,
                            originY + Math.random() * 1.5,
                            originZ + (Math.random() - 0.5) * 6.5
                        );
                        sp.vx = (Math.random() - 0.5) * 15;
                        sp.vy = 6.5 + Math.random() * 11;
                        sp.vz = (Math.random() - 0.5) * 15;
                        sp.rotVx = (Math.random() - 0.5) * 14;
                        sp.rotVy = (Math.random() - 0.5) * 14;
                        sp.rotVz = (Math.random() - 0.5) * 14;
                        sp.life = 0;
                    }
                });
            }

            // Cột nước bắn lên cao
            if (Game3D.splashMesh) {
                const pos = Game3D.splashMesh.geometry.attributes.position.array;
                const vels = Game3D.splashMesh.userData.vels;
                const len = vels.length;

                for (let i = 0; i < len; i++) {
                    const v = vels[i];
                    v.active = true;
                    v.life = 0;
                    pos[i * 3 + 0] = originX + (Math.random() - 0.5) * 6.5;
                    pos[i * 3 + 1] = originY;
                    pos[i * 3 + 2] = originZ + (Math.random() - 0.5) * 8.5;

                    const ang = Math.random() * Math.PI * 2;
                    const spd = 2.2 + Math.random() * 4.5;
                    v.vx = Math.cos(ang) * spd;
                    v.vy = 8.5 + Math.random() * 13;
                    v.vz = Math.sin(ang) * spd;
                }
                Game3D.splashMesh.geometry.attributes.position.needsUpdate = true;
            }
        }

        // Cập nhật vật lý mảnh vỡ, cột nước, lửa khói và chìm tàu trong render loop
        function capNhatVatLyVoTauVaChay(delta, elapsed) {
            // Mảnh gỗ
            if (Game3D.splinterMeshes) {
                Game3D.splinterMeshes.forEach(sp => {
                    if (sp.active) {
                        sp.life += delta;
                        sp.vy -= 18 * delta; // Trọng lực
                        sp.mesh.position.x += sp.vx * delta;
                        sp.mesh.position.y += sp.vy * delta;
                        sp.mesh.position.z += sp.vz * delta;

                        sp.mesh.rotation.x += sp.rotVx * delta;
                        sp.mesh.rotation.y += sp.rotVy * delta;
                        sp.mesh.rotation.z += sp.rotVz * delta;

                        if (sp.mesh.position.y < (Game3D.thuyTrieu.mucNuocY - 2) || sp.life > 3.0) {
                            sp.active = false;
                            sp.mesh.visible = false;
                        }
                    }
                });
            }

            // Cột nước
            if (Game3D.splashMesh) {
                const pos = Game3D.splashMesh.geometry.attributes.position.array;
                const vels = Game3D.splashMesh.userData.vels;
                const len = vels.length;

                for (let i = 0; i < len; i++) {
                    const v = vels[i];
                    if (v.active) {
                        v.life += delta;
                        v.vy -= 22 * delta; // Trọng lực nước
                        pos[i * 3 + 0] += v.vx * delta;
                        pos[i * 3 + 1] += v.vy * delta;
                        pos[i * 3 + 2] += v.vz * delta;

                        if (pos[i * 3 + 1] < Game3D.thuyTrieu.mucNuocY || v.life > 1.8) {
                            v.active = false;
                            pos[i * 3 + 1] = -100;
                        }
                    }
                }
                Game3D.splashMesh.geometry.attributes.position.needsUpdate = true;
            }

            // Lửa và khói bốc cháy trên hạm đội giặc
            const dich = Game3D.units && Game3D.units.dichLauThuyen;
            if (dich && Game3D.combatPhase === 'NUOC_RUT_PHA_GIAC' && Game3D.fireSmokeMesh) {
                const pos = Game3D.fireSmokeMesh.geometry.attributes.position.array;
                const data = Game3D.fireSmokeMesh.geometry.userData.data;
                const len = data.length;
                const shipPos = dich.mesh.position;

                for (let i = 0; i < len; i++) {
                    const d = data[i];
                    d.life += delta;

                    pos[i * 3 + 0] += d.vx * delta;
                    pos[i * 3 + 1] += d.vy * delta;
                    pos[i * 3 + 2] += d.vz * delta;

                    if (d.life > d.maxLife) {
                        d.life = 0;
                        pos[i * 3 + 0] = shipPos.x + (Math.random() - 0.5) * 6;
                        pos[i * 3 + 1] = shipPos.y + 1.2 + Math.random() * 1.5;
                        pos[i * 3 + 2] = shipPos.z + (Math.random() - 0.5) * 12;
                    }
                }
                Game3D.fireSmokeMesh.geometry.attributes.position.needsUpdate = true;

                // Ánh đèn lửa trại trên xác tàu
                if (Game3D.shipFireLight) {
                    Game3D.shipFireLight.position.set(shipPos.x, shipPos.y + 3.5, shipPos.z);
                    Game3D.shipFireLight.intensity = 2.5 + Math.sin(elapsed * 16) * 0.9;
                }

                // Vật lý thân tàu nghiêng dần và chìm xuống đáy sông
                if (dich.flagship) {
                    dich.flagship.rotation.z = Math.min(0.62, dich.flagship.rotation.z + delta * 0.08); // Nghiêng mạn
                    dich.flagship.rotation.x = -0.32; // Mũi cắm xuống đáy sông
                    dich.pos.y = Math.max(-1.85, dich.pos.y - delta * 0.16); // Chìm dần
                    dich.mesh.position.y = dich.pos.y;
                }
            } else {
                if (Game3D.shipFireLight) Game3D.shipFireLight.intensity = 0;
            }
        }

        // 5. TIA NẮNG RẠNG ĐÔNG (GOD-RAYS) CHO HỒI 3
        function khoiTaoGodRays() {
            const group = new THREE.Group();
            const rayCount = 8;
            const rayGeo = new THREE.CylinderGeometry(0.8, 14, 130, 8, 1, true);
            const rayMat = new THREE.MeshBasicMaterial({
                color: 0xFFE082,
                transparent: true,
                opacity: 0.18,
                blending: THREE.AdditiveBlending,
                side: THREE.DoubleSide,
                depthWrite: false
            });

            for (let i = 0; i < rayCount; i++) {
                const mesh = new THREE.Mesh(rayGeo, rayMat);
                mesh.position.set(70 + (Math.random() - 0.5) * 20, 95 + (Math.random() - 0.5) * 20, 50 + (Math.random() - 0.5) * 20);
                mesh.rotation.x = 0.85 + (Math.random() - 0.5) * 0.25;
                mesh.rotation.z = -0.75 + (Math.random() - 0.5) * 0.25;
                mesh.rotation.y = Math.random() * Math.PI;
                group.add(mesh);
            }

            group.visible = false;
            Game3D.godRaysGroup = group;
            Game3D.scene.add(group);
        }

        function capNhatGodRays(elapsed) {
            if (!Game3D.godRaysGroup || !Game3D.godRaysGroup.visible) return;
            Game3D.godRaysGroup.children.forEach((mesh, idx) => {
                mesh.rotation.y += 0.002 * (idx % 2 === 0 ? 1 : -1);
                mesh.material.opacity = 0.15 + Math.sin(elapsed * 0.8 + idx) * 0.06;
            });
        }

