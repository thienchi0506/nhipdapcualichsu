        // 5. Cập nhật Cooldown & Hiệu Ứng Chiến Thuật trong Render Loop
        function capNhatTuyetKyCooldown(delta) {
            // Hồi phục Điểm Mưu Lược tự động (+2.5 điểm/giây)
            if (Game3D.muuLuoc < 100) {
                Game3D.muuLuoc = Math.min(100, Game3D.muuLuoc + delta * 2.5);
                const valMuuLuoc = document.getElementById('val-muu-luoc');
                if (valMuuLuoc) valMuuLuoc.textContent = `${Math.round(Game3D.muuLuoc)} / 100`;
            }

            // Cập nhật Cooldown 4 Tuyệt kỹ
            for (let i = 1; i <= 4; i++) {
                const s = Game3D.skills[i];
                const btn = document.getElementById(`btn-skill-${i}`);
                const cdOverlay = document.getElementById(`cd-overlay-${i}`);

                if (s.currentCd > 0) {
                    s.currentCd = Math.max(0, s.currentCd - delta);
                    const pct = (s.currentCd / s.cd) * 100;
                    if (cdOverlay) {
                        cdOverlay.style.height = `${pct}%`;
                        cdOverlay.textContent = `${Math.ceil(s.currentCd)}s`;
                    }
                    if (btn) btn.classList.add('on-cd');
                } else {
                    if (cdOverlay) {
                        cdOverlay.style.height = '0%';
                        cdOverlay.textContent = '';
                    }
                    if (btn) btn.classList.remove('on-cd');
                }
            }
        }

        function capNhatHieuUngChienThuat3D(delta, elapsed) {
            // 1. Cập nhật di chuyển các mũi tên lửa 3D theo đường cong Parabol
            for (let i = Game3D.arrows3D.length - 1; i >= 0; i--) {
                const a = Game3D.arrows3D[i];
                a.progress += a.speed * delta;

                if (a.progress >= 1.0) {
                    Game3D.scene.remove(a.mesh);
                    Game3D.arrows3D.splice(i, 1);
                    continue;
                }

                // Công thức Parabol Bezier bậc 2
                const t = a.progress;
                const px = THREE.MathUtils.lerp(a.start.x, a.end.x, t);
                const pz = THREE.MathUtils.lerp(a.start.z, a.end.z, t);
                const py = THREE.MathUtils.lerp(a.start.y, a.end.y, t) + Math.sin(t * Math.PI) * a.height;

                a.mesh.position.set(px, py, pz);
                a.mesh.lookAt(a.end.x, a.end.y, a.end.z);
            }

            // 2. Di chuyển Thuyền Nhẹ (Rút lui khi dùng Skill 1)
            const tn = Game3D.units.thuyenNhe;
            if (tn && tn.mesh && tn.isRetreating) {
                if (tn.pos.z > tn.targetZ) {
                    tn.pos.z -= tn.speed * delta;
                    tn.mesh.position.z = tn.pos.z;
                }
            }

            // 3. Di chuyển Hạm Đội Giặc (Tiến vào bãi cọc)
            const dich = Game3D.units.dichLauThuyen;
            if (dich && dich.mesh && !dich.surrendered) {
                if (dich.pos.z > dich.targetZ) {
                    dich.pos.z -= dich.speed * delta;
                    dich.mesh.position.z = dich.pos.z;
                }
            }

            // 4. Di chuyển Bè Lửa Hỏa Công lao xuống phía giặc
            const be = Game3D.units.beLua;
            if (be && be.mesh && be.active) {
                if (be.pos.z < be.targetZ) {
                    be.pos.z += be.speed * delta;
                    be.mesh.position.z = be.pos.z;
                }
            }

            // 5. Cập nhật các hiệu ứng hào quang 3D (Waves, Beams, Peace Ring)
            for (let i = Game3D.skillEffects.length - 1; i >= 0; i--) {
                const eff = Game3D.skillEffects[i];
                if (eff.type === 'ripple' || eff.type === 'peace') {
                    eff.scale += delta * 18;
                    eff.mesh.scale.set(eff.scale, eff.scale, eff.scale);
                    eff.opacity = Math.max(0, eff.opacity - delta * 0.45);
                    eff.mesh.material.opacity = eff.opacity;

                    if (eff.scale >= eff.maxScale || eff.opacity <= 0) {
                        Game3D.scene.remove(eff.mesh);
                        Game3D.skillEffects.splice(i, 1);
                    }
                } else if (eff.type === 'beam') {
                    eff.life -= delta;
                    eff.mesh.material.opacity = (eff.life / eff.duration) * 0.8;
                    if (eff.life <= 0) {
                        Game3D.scene.remove(eff.mesh);
                        Game3D.skillEffects.splice(i, 1);
                    }
                }
            }
        }

