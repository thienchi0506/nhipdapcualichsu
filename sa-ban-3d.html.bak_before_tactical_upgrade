            if (titleEl) titleEl.textContent = fac.name.toUpperCase();
            if (subtitleEl) subtitleEl.textContent = fac.subtitle;
            if (npcAvatar) npcAvatar.textContent = fac.avatar;
            if (npcName) npcName.textContent = fac.npcName;
            if (npcDialogue) npcDialogue.textContent = fac.dialogue;
            if (treasuryVal) treasuryVal.textContent = `${Game3D.nganKho.toLocaleString('vi-VN')} 💰`;

            // Render danh sách các bậc nâng cấp
            if (tiersContainer) {
                tiersContainer.innerHTML = '';
                fac.tiers.forEach((tier, idx) => {
                    const card = document.createElement('div');
                    card.className = `upgrade-tier-card ${tier.unlocked ? 'unlocked' : ''}`;

                    let btnHtml = '';
                    if (tier.unlocked) {
                        btnHtml = `<button class="btn-do-upgrade" disabled style="background:#234433; border-color:#2ECC71; color:#2ECC71;">✓ ĐÃ NÂNG CẤP</button>`;
                    } else if (tier.isBattleTrigger) {
                        btnHtml = `<button class="btn-do-upgrade" onclick="thucHienNangCap('${fac.id}', ${idx})" style="background:linear-gradient(135deg, #7B1E1E 0%, #D4AF37 100%);">⚔️ XUẤT TRẬN NGAY</button>`;
                    } else {
                        const canAfford = Game3D.nganKho >= tier.cost;
                        btnHtml = `<button class="btn-do-upgrade" onclick="thucHienNangCap('${fac.id}', ${idx})" ${canAfford ? '' : 'disabled'}>
                            ${canAfford ? 'Nâng Cấp Ngay' : 'Thiếu Ngân Khố'}
                        </button>`;
                    }

                    card.innerHTML = `
                        <div class="tier-info-left">
                            <div class="tier-title-row">
                                <span class="tier-name">${tier.title}</span>
                                <span class="tier-badge ${tier.unlocked ? 'done' : ''}">BẬC ${tier.level}</span>
                            </div>
                            <div class="tier-desc">${tier.desc}</div>
                            <div class="tier-benefit">✨ Hiệu quả: ${tier.benefit}</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:14px;">
                            ${tier.cost > 0 ? `<div class="tier-cost">💰 -${tier.cost.toLocaleString('vi-VN')}</div>` : ''}
                            ${btnHtml}
                        </div>
                    `;
                    tiersContainer.appendChild(card);
                });
            }

            if (modal) modal.classList.add('open');

            // Phát giọng đọc dẫn chuyện của NPC
            phatGiongDoc(fac.voiceText);
        }

