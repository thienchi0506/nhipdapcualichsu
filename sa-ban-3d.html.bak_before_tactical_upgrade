        /*  PHẦN 3: HỆ THỐNG ĐỘI HÌNH BINH CHỦNG 3D & BỘ TUYỆT KỸ DANH TƯỚNG          */
        /* ========================================================================== */
        // 1. Dựng Mô Hình 3D Cho 5 Đạo Quân Trên Sông & Trên Bờ
        function taoCacDaoQuan3D() {
            const woodHullMat = new THREE.MeshStandardMaterial({ color: 0x422F22, roughness: 0.85 });
            const darkWoodMat = new THREE.MeshStandardMaterial({ color: 0x1E1916, roughness: 0.9 });
            const bronzeMat   = new THREE.MeshStandardMaterial({ color: 0xD4AF37, metalness: 0.8, roughness: 0.3 });
            const sailRedMat  = new THREE.MeshStandardMaterial({ color: 0x9B2226, roughness: 0.5, side: THREE.DoubleSide });
            const sailBlackMat= new THREE.MeshStandardMaterial({ color: 0x15181C, roughness: 0.6, side: THREE.DoubleSide });
            const greenMat    = new THREE.MeshStandardMaterial({ color: 0x1E5631, roughness: 0.7 });
            const whiteMat    = new THREE.MeshStandardMaterial({ color: 0xEAE6DF, roughness: 0.6 });

            // -------------------------------------------------------------
            // ĐẠO QUÂN 1: 🟦 ĐỘI THUYỀN NHẸ TIÊN PHONG (TA)
            // -------------------------------------------------------------
            const thuyenNheGroup = new THREE.Group();

            function taoMotThuyenNhe(offsetX, offsetZ, rotY) {
                const boat = new THREE.Group();
                boat.position.set(offsetX, 0, offsetZ);
                boat.rotation.y = rotY;

                // Thân thuyền thon lướt sóng
                const hullGeo = new THREE.BoxGeometry(1.6, 1.1, 7.5);
                const hull = new THREE.Mesh(hullGeo, woodHullMat);
                hull.position.y = 0.55;
                hull.castShadow = true;
                boat.add(hull);

                // Mũi nhọn bọc đồng (Ram)
                const bowGeo = new THREE.ConeGeometry(1.1, 2.2, 4);
                bowGeo.rotateZ(Math.PI / 2);
                bowGeo.rotateY(Math.PI / 4);
                const bow = new THREE.Mesh(bowGeo, bronzeMat);
                bow.position.set(0, 0.6, -4.5);
                bow.castShadow = true;
                boat.add(bow);

                // Cột buồm & Lá cờ Tiên Phong đỏ viền vàng
                const mastGeo = new THREE.CylinderGeometry(0.1, 0.14, 5.5, 8);
                const mast = new THREE.Mesh(mastGeo, woodHullMat);
                mast.position.set(0, 3.2, -0.5);
                boat.add(mast);

                const flagGeo = new THREE.PlaneGeometry(1.8, 1.4);
                const flag = new THREE.Mesh(flagGeo, sailRedMat);
                flag.position.set(0.9, 4.8, -0.5);
                boat.add(flag);

