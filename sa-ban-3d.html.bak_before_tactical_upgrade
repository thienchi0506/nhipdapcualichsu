        function dangKySuKienChuotVaManHinh() {
            const container = document.getElementById('webgl-canvas-container');

            window.addEventListener('resize', () => {
                if (!Game3D.camera || !Game3D.renderer) return;
                Game3D.camera.aspect = window.innerWidth / window.innerHeight;
                Game3D.camera.updateProjectionMatrix();
                Game3D.renderer.setSize(window.innerWidth, window.innerHeight);
            });

            // Kéo chuột để xoay quanh cảnh vật
            window.addEventListener('pointerdown', (e) => {
                // Chỉ nhận khi không click trúng các nút UI
                if (e.target.closest('.interactive') || e.target.closest('.modal-3d-container')) return;
                Game3D.isDragging = true;
                Game3D.previousMousePosition = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('pointermove', (e) => {
                if (!Game3D.isDragging) return;
                const deltaX = e.clientX - Game3D.previousMousePosition.x;
                const deltaY = e.clientY - Game3D.previousMousePosition.y;

                if (Game3D.cheDoCamera === 'LOBBY' || Game3D.cheDoCamera === 'TACTICAL') {
                    Game3D.sphericalCoords.theta -= deltaX * 0.005;
                    Game3D.sphericalCoords.phi = Math.max(0.4, Math.min(1.45, Game3D.sphericalCoords.phi - deltaY * 0.005));
                } else if (Game3D.cheDoCamera === 'FIRST_PERSON') {
                    Game3D.targetCamLook.x += deltaX * 0.08;
                    Game3D.targetCamLook.y = Math.max(-5, Math.min(25, Game3D.targetCamLook.y - deltaY * 0.06));
                }

                Game3D.previousMousePosition = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('pointerup', () => {
                Game3D.isDragging = false;
            });

            // Cuộn chuột để zoom gần / xa
            window.addEventListener('wheel', (e) => {
                if (e.target.closest('.modal-3d-container')) return;
                Game3D.sphericalCoords.radius = Math.max(45, Math.min(220, Game3D.sphericalCoords.radius + e.deltaY * 0.08));
            }, { passive: true });
        }

        /* ========================================================================== */
        /*  J. CƠ CHẾ THỦY TRIỀU SỐNG ĐỘNG (TIDE ENGINE)                              */
        /* ========================================================================== */
        function capNhatThuyTrieu3D(delta) {
            const t = Game3D.thuyTrieu;

            if (t.cheDoTuDong) {
                if (t.dangTang) {
                    t.phanTram += t.tocDoChuKy * delta * 50;
                    if (t.phanTram >= 100) {
                        t.phanTram = 100;
                        t.dangTang = false;
                    }
                } else {
                    t.phanTram -= t.tocDoChuKy * delta * 50;
                    if (t.phanTram <= 10) {
                        t.phanTram = 10;
                        t.dangTang = true;
                    }
                }
            }

            // Tính mực nước Y theo %: 0% -> Y = -3.2m (Cực kiệt) | 100% -> Y = +1.3m (Đỉnh triều)
            t.mucNuocY = -3.2 + (t.phanTram / 100) * 4.5;

            // Cập nhật vị trí Y mặt nước 3D mượt mà
            if (Game3D.waterMesh) {
                Game3D.waterMesh.position.y = t.mucNuocY;
            }

            // Cập nhật UI Đồng Hồ Thủy Triều
            const indicator = document.getElementById('tide-water-indicator');
            const lblPhase = document.getElementById('tide-phase-label');
            const lblHeight = document.getElementById('tide-metric-height');

            if (indicator) indicator.style.height = `${Math.round(t.phanTram)}%`;
            if (lblPhase && lblHeight) {
                if (t.phanTram > 80) {
                    lblPhase.textContent = `ĐỈNH TRIỀU (${Math.round(t.phanTram)}%)`;
                    lblPhase.style.color = '#38EF7D';
                    lblHeight.textContent = `Mực nước: +${t.mucNuocY.toFixed(1)}m (Cọc ngầm chìm hẳn)`;
                } else if (t.dangTang) {
                    lblPhase.textContent = `TRIỀU ĐANG DÂNG (${Math.round(t.phanTram)}%)`;
                    lblPhase.style.color = '#5DADE2';
                    lblHeight.textContent = `Mực nước: ${t.mucNuocY.toFixed(1)}m (Nước đang cuồn cuộn)`;
                } else {
                    lblPhase.textContent = `TRIỀU RÚT XIẾT (${Math.round(t.phanTram)}%)`;
                    lblPhase.style.color = '#E74C3C';
                    lblHeight.textContent = `Mực nước: ${t.mucNuocY.toFixed(1)}m (Đầu cọc nhô lên bẫy địch!)`;
                }
            }
        }

