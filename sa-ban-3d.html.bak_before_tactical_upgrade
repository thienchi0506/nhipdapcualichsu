        /* ========================================================================== */
        /*  B. ĐỒNG BỘ ÂM THANH LOCALSTORAGE & GIỌNG ĐỌC AI (WEB SPEECH)              */
        /* ========================================================================== */
        const bgMusic = document.getElementById('bg-music');

        function khoiDongAmThanh() {
            if (!bgMusic) return;

            // Khôi phục thời gian phát từ localStorage
            const savedTime = localStorage.getItem('audioTime');
            if (savedTime && !isNaN(savedTime)) {
                bgMusic.currentTime = parseFloat(savedTime);
            }

            // Đọc trạng thái đã lưu
            const savedMusicState = localStorage.getItem('nhacNenBat');
            if (savedMusicState === 'false') {
                Game3D.cheDoNhac = false;
                capNhatNutNhac(false);
            } else {
                batDauPhatNhac();
            }

            // Đồng bộ tiến độ nhạc mỗi 500ms
            setInterval(() => {
                if (bgMusic && !bgMusic.paused) {
                    localStorage.setItem('audioTime', bgMusic.currentTime);
                }
            }, 500);

            // Tự động tạm dừng khi chuyển tab trình duyệt
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    if (bgMusic && !bgMusic.paused) bgMusic.pause();
                } else {
                    if (Game3D.cheDoNhac && bgMusic && bgMusic.paused) {
                        bgMusic.play().catch(() => {});
                    }
                }
            });

            // Unlock AudioContext trên cử chỉ đầu tiên của người dùng
            window.addEventListener('pointerdown', function moKhoaAudio() {
                AudioEngine.init();
                if (Game3D.cheDoNhac && bgMusic.paused) {
                    bgMusic.play().catch(() => {});
                }
                window.removeEventListener('pointerdown', moKhoaAudio);
            }, { once: true });
        }

        function batDauPhatNhac() {
            if (!bgMusic) return;
            bgMusic.volume = 0.65;
            bgMusic.play().then(() => {
                capNhatNutNhac(true);
            }).catch(err => {
                console.log("Cần tương tác người dùng để phát nhạc:", err);
            });
        }

        function toggleNhacNen() {
            Game3D.cheDoNhac = !Game3D.cheDoNhac;
            localStorage.setItem('nhacNenBat', Game3D.cheDoNhac);
            if (Game3D.cheDoNhac) {
                batDauPhatNhac();
            } else {
                if (bgMusic) bgMusic.pause();
                capNhatNutNhac(false);
            }
        }

        function capNhatNutNhac(bat) {
            const btn = document.getElementById('btn-toggle-music');
            const lbl = document.getElementById('lbl-music-status');
            if (btn && lbl) {
                if (bat) {
                    btn.classList.add('active');
                    lbl.textContent = 'Nhạc: Bật';
                } else {
                    btn.classList.remove('active');
                    lbl.textContent = 'Nhạc: Tắt';
                }
            }
        }

        // Hệ thống Giọng đọc AI Tiếng Việt tự động Ducking âm lượng nhạc
        function phatGiongDoc(cauThoai) {
            if (!Game3D.cheDoGiongDoc || !('speechSynthesis' in window)) return;

            window.speechSynthesis.cancel(); // Hủy giọng đọc dở dang

            const utterance = new SpeechSynthesisUtterance(cauThoai);
            utterance.lang = 'vi-VN';
            utterance.rate = 0.95;
            utterance.pitch = 0.92;

            // Tìm kiếm giọng tiếng Việt chuẩn nếu có
            const voices = window.speechSynthesis.getVoices();
            const viVoice = voices.find(v => v.lang.includes('vi') || v.lang.includes('VN'));
            if (viVoice) utterance.voice = viVoice;

            // Ducking nhạc nền khi giọng đọc phát
            utterance.onstart = () => {
                if (bgMusic && !bgMusic.paused) {
                    bgMusic.volume = 0.2;
                }
            };

            utterance.onend = utterance.onerror = () => {
                if (bgMusic && !bgMusic.paused && Game3D.cheDoNhac) {
                    bgMusic.volume = 0.65;
                }
            };

            window.speechSynthesis.speak(utterance);
        }

        function toggleGiongDoc() {
            Game3D.cheDoGiongDoc = !Game3D.cheDoGiongDoc;
            const btn = document.getElementById('btn-toggle-voice');
            const lbl = document.getElementById('lbl-voice-status');
            if (btn && lbl) {
                if (Game3D.cheDoGiongDoc) {
                    btn.classList.add('active');
                    lbl.textContent = 'Giọng Đọc: Bật';
                    phatGiongDoc("Hệ thống dẫn chuyện đã kích hoạt!");
                } else {
                    btn.classList.remove('active');
                    lbl.textContent = 'Giọng Đọc: Tắt';
                    window.speechSynthesis.cancel();
                }
            }
        }

