        // 9. Dựng Chiến Lũy Tre 3D Cho Chiến Dịch 2: Sông Như Nguyệt (1077)
        function taoChienLuyLuyTre3D() {
            if (Game3D.bambooRampartMesh) {
                Game3D.bambooRampartMesh.visible = true;
                return;
            }

            const rampartGroup = new THREE.Group();
            const bambooGreenMat = new THREE.MeshStandardMaterial({ color: 0x4CAF50, roughness: 0.6 });
            const earthMat = new THREE.MeshStandardMaterial({ color: 0x5D4037, roughness: 0.9 });
            const leafMat = new THREE.MeshStandardMaterial({ color: 0x81C784, roughness: 0.8 });

            for (let i = 0; i < 26; i++) {
                const cluster = new THREE.Group();
                const z = -50 + i * 4.2;
                const x = 32 + (Math.sin(i * 1.5) * 4);
                const y = 3.2;

                const wallGeo = new THREE.BoxGeometry(3.5, 1.8, 4.5);
                const wall = new THREE.Mesh(wallGeo, earthMat);
                wall.position.set(0, 0, 0);
                cluster.add(wall);

                for (let b = 0; b < 7; b++) {
                    const bx = (Math.random() - 0.5) * 2.2;
                    const bz = (Math.random() - 0.5) * 2.8;
                    const h = 7.5 + Math.random() * 3.5;
                    const bGeo = new THREE.CylinderGeometry(0.08, 0.12, h, 8);
                    const stem = new THREE.Mesh(bGeo, bambooGreenMat);
                    stem.position.set(bx, h / 2 + 0.8, bz);
                    stem.rotation.z = (Math.random() - 0.5) * 0.15;
                    cluster.add(stem);

