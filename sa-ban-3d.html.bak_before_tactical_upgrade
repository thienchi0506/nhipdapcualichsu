                    col.position.set(cx, 2.0, cz);
                    g2.add(col);
                }
            }
            const ring2Geo = new THREE.RingGeometry(3.0, 4.0, 32);
            ring2Geo.rotateX(-Math.PI / 2);
            const ring2 = new THREE.Mesh(ring2Geo, new THREE.MeshBasicMaterial({ color: 0xF39C12, transparent: true, opacity: 0.8, side: THREE.DoubleSide }));
            ring2.position.y = 0.1;
            g2.add(ring2);
            site2.ringMesh = ring2;
            Game3D.scene.add(g2);

            // 3. ĐÀN TẾ & BIA TƯỞNG NIỆM BẾN SÔNG (pos: -22, 2.8, -18)
            const site3 = Game3D.congTrinhHauChien.danTeTuongNiem;
            const g3 = new THREE.Group();
            g3.position.set(site3.pos.x, site3.pos.y, site3.pos.z);
            const steleGeo = new THREE.BoxGeometry(1.6, 3.2, 0.4);
            const stele = new THREE.Mesh(steleGeo, stoneMat);
            stele.position.y = 1.6;
            g3.add(stele);
            const burnerGeo = new THREE.CylinderGeometry(0.7, 0.5, 0.9, 16);
            const burner = new THREE.Mesh(burnerGeo, goldMat);
            burner.position.set(0, 0.45, 1.2);
            g3.add(burner);
            const ring3Geo = new THREE.RingGeometry(3.0, 4.0, 32);
            ring3Geo.rotateX(-Math.PI / 2);
            const ring3 = new THREE.Mesh(ring3Geo, new THREE.MeshBasicMaterial({ color: 0x9B59B6, transparent: true, opacity: 0.8, side: THREE.DoubleSide }));
            ring3.position.y = 0.1;
            g3.add(ring3);
            site3.ringMesh = ring3;
            Game3D.scene.add(g3);

            // 4. BẾN THUYỀN CẤP LƯƠNG PHÓNG THÍCH TÙ BINH (pos: -14, 2.8, -40)
            const site4 = Game3D.congTrinhHauChien.benThuyenHoaBinh;
