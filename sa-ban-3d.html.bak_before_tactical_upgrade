        // 1. Web Audio API Engine Tự Tổng Hợp (Zero File Ngoài)
        const AudioEngine = {
            ctx: null,
            init: function() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            },
            // a. Tiếng trống trận dồn dập (War Drums)
            playWarDrum: function() {
                this.init();
                if (!this.ctx) return;
                const t = this.ctx.currentTime;
                [0, 0.12, 0.28].forEach((offset, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    const startFreq = idx === 0 ? 115 : (idx === 1 ? 95 : 82);
                    osc.frequency.setValueAtTime(startFreq, t + offset);
                    osc.frequency.exponentialRampToValueAtTime(32, t + offset + 0.35);

                    gain.gain.setValueAtTime(idx === 2 ? 0.85 : 0.6, t + offset);
                    gain.gain.exponentialRampToValueAtTime(0.001, t + offset + 0.36);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(t + offset);
                    osc.stop(t + offset + 0.38);
                });
            },
            // b. Tiếng bật dây cung & rít gió (Bow Pluck & Arrow Flight)
            playArrow: function() {
                this.init();
                if (!this.ctx) return;
                const t = this.ctx.currentTime;
                // Dây cung bật nảy (Pluck)
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(480, t);
                osc.frequency.exponentialRampToValueAtTime(130, t + 0.12);
                gain.gain.setValueAtTime(0.55, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + 0.14);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(t);
                osc.stop(t + 0.15);

                // Mũi tên xé gió
                const bufferSize = Math.floor(this.ctx.sampleRate * 0.25);
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufferSize) * Math.PI);
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(750, t + 0.04);
                filter.frequency.exponentialRampToValueAtTime(2400, t + 0.22);
                const nGain = this.ctx.createGain();
                nGain.gain.setValueAtTime(0.3, t + 0.04);
                nGain.gain.exponentialRampToValueAtTime(0.001, t + 0.28);
                noise.connect(filter);
                filter.connect(nGain);
                nGain.connect(this.ctx.destination);
                noise.start(t + 0.04);
            },
            // c. Tiếng va chạm cọc gỗ vỡ & bọc sắt đâm thủng (Wood splinter & iron spike impact)
            playStakeImpact: function() {
                this.init();
                if (!this.ctx) return;
                const t = this.ctx.currentTime;
                // Tiếng kim loại đâm thủng (Metallic Clank)
                const osc1 = this.ctx.createOscillator();
                const osc2 = this.ctx.createOscillator();
                const mGain = this.ctx.createGain();
                osc1.type = 'square';
                osc2.type = 'sawtooth';
                osc1.frequency.setValueAtTime(620, t);
                osc2.frequency.setValueAtTime(930, t);
                mGain.gain.setValueAtTime(0.45, t);
                mGain.gain.exponentialRampToValueAtTime(0.001, t + 0.32);
                osc1.connect(mGain);
                osc2.connect(mGain);
                mGain.connect(this.ctx.destination);
                osc1.start(t);
                osc2.start(t);
                osc1.stop(t + 0.33);
                osc2.stop(t + 0.33);

                // Tiếng ván gỗ vỡ & đập mạnh (Heavy Wood Crack)
                const dOsc = this.ctx.createOscillator();
                const dGain = this.ctx.createGain();
                dOsc.type = 'sine';
                dOsc.frequency.setValueAtTime(160, t);
                dOsc.frequency.exponentialRampToValueAtTime(35, t + 0.42);
                dGain.gain.setValueAtTime(0.85, t);
                dGain.gain.exponentialRampToValueAtTime(0.001, t + 0.45);
                dOsc.connect(dGain);
                dGain.connect(this.ctx.destination);
                dOsc.start(t);
                dOsc.stop(t + 0.46);
            },
            // d. Tiếng chuông ngân hòa bình (Peace harmonic chimes)
            playPeaceBell: function() {
                this.init();
                if (!this.ctx) return;
                const t = this.ctx.currentTime;
                const freqs = [528, 660, 792, 1056];
                freqs.forEach((f, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(f, t);
                    gain.gain.setValueAtTime(0.3 / (idx + 1), t);
                    gain.gain.exponentialRampToValueAtTime(0.0001, t + 2.6);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(t);
                    osc.stop(t + 2.8);
                });
            },
            // e. Fanfare vinh danh huân chương (Heroic achievement fanfare)
            playFanfare: function() {
                this.init();
                if (!this.ctx) return;
                const t = this.ctx.currentTime;
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((pitch, idx) => {
                    const noteTime = t + idx * 0.11;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(pitch, noteTime);
                    const dur = (idx === 3) ? 0.95 : 0.16;
                    gain.gain.setValueAtTime(0.5, noteTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, noteTime + dur);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(noteTime);
                    osc.stop(noteTime + dur + 0.05);
                });
            }
        };

