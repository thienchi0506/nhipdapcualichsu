            g1.add(pot);
            const ring1Geo = new THREE.RingGeometry(3.0, 4.0, 32);
            ring1Geo.rotateX(-Math.PI / 2);
            const ring1 = new THREE.Mesh(ring1Geo, new THREE.MeshBasicMaterial({ color: 0x2ECC71, transparent: true, opacity: 0.8, side: THREE.DoubleSide }));
            ring1.position.y = 0.1;
            g1.add(ring1);
            site1.ringMesh = ring1;
            Game3D.scene.add(g1);

            // 2. ĐÀI BAN CHIẾU KHOAN THƯ SỨC DÂN (pos: -38, 2.8, 8)
