        /* ========================================================================== */
        /*  K. RENDER LOOP CHÍNH (60 FPS MƯỢT MÀ)                                     */
        /* ========================================================================== */
        function renderLoop3D() {
            requestAnimationFrame(renderLoop3D);

            const delta = Game3D.clock.getDelta();
            const elapsed = Game3D.clock.getElapsedTime();

            // 1. Cập nhật sóng nước nhấp nhô thời gian thực
            if (Game3D.waterMesh) {
                const pos = Game3D.waterMesh.geometry.attributes.position;
                const base = Game3D.waterMesh.geometry.userData.basePositions;
                const count = pos.count;

                for (let i = 0; i < count; i++) {
                    const u = base[i * 3 + 0];
                    const v = base[i * 3 + 2];
                    // Phương trình sóng đa tầng mô phỏng thủy triều cuồn cuộn
                    const wave1 = Math.sin(u * 0.12 + elapsed * 2.2) * 0.35;
                    const wave2 = Math.cos(v * 0.08 + elapsed * 1.8) * 0.45;
                    const wave3 = Math.sin((u + v) * 0.06 + elapsed * 1.4) * 0.25;

                    pos.array[i * 3 + 1] = wave1 + wave2 + wave3;
                }
                pos.needsUpdate = true;
            }

            // 2. Cập nhật Thủy Triều
            capNhatThuyTrieu3D(delta);

            // 3. Ánh lửa trại bập bùng
            Game3D.fireLights.forEach(f => {
                f.light.intensity = f.baseIntensity + Math.sin(elapsed * 12 + f.offset) * 0.45;
            });

            // 4. Di chuyển các hạt tàn lửa bay lơ lửng
            if (Game3D.particles) {
                const pos = Game3D.particles.geometry.attributes.position.array;
                const speeds = Game3D.particles.geometry.userData.speeds;
                const len = pos.length / 3;

                for (let i = 0; i < len; i++) {
                    pos[i * 3 + 0] += speeds[i * 3 + 0];
                    pos[i * 3 + 1] += speeds[i * 3 + 1];
                    pos[i * 3 + 2] += speeds[i * 3 + 2];

                    // Tái tạo hạt khi bay quá cao hoặc trôi xa
                    if (pos[i * 3 + 1] > 28 || pos[i * 3 + 2] < -120) {
                        pos[i * 3 + 0] = (Math.random() - 0.5) * 110;
                        pos[i * 3 + 1] = 1 + Math.random() * 2;
                        pos[i * 3 + 2] = (Math.random() - 0.5) * 180 + 30;
                    }
                }
                Game3D.particles.geometry.attributes.position.needsUpdate = true;
            }

            // 5. Cập nhật các Hệ thống Môi trường & Vật lý 3D 3 Hồi
            capNhatDomDomHauPhuong(elapsed);
            capNhatBotSongBaiCoc(delta, elapsed);
            capNhatVatLyVoTauVaChay(delta, elapsed);
            capNhatGodRays(elapsed);
            capNhatGiongBaoHoi2(delta);

            // 6. Điều khiển Nhân vật Tướng lĩnh 3D & Kiểm tra Tương tác Hậu phương (Phần 2)
            xuLyDieuKhienNhanVat(delta, elapsed);

            // 6. Cập nhật Biển Tên 3D Nổi của 4 Công Trình
            capNhatBienTenNoi3D();

            // 7. Cập nhật Cooldown & Hiệu Ứng Tuyệt Kỹ Danh Tướng 3D (Phần 3)
            capNhatTuyetKyCooldown(delta);
            capNhatHieuUngChienThuat3D(delta, elapsed);
            capNhatThanhMauDaoQuan3D();

            // 8. Vòng Lặp Thực Chiến Trận Đồ & Va Chạm Bãi Cọc 3D (Phần 4)
            kiemTraVongLapChienTran(delta, elapsed);
            capNhatMarkerDiemDen3D(delta);

            // 8b. Cập nhật Radar Sa Bàn Minimap 2D (Bước 6)
            capNhatMinimap2D();

            // Cập nhật vị trí & hiệu ứng Vòng Sáng Chọn Quân 3D
            if (Game3D.selectionRing3D && Game3D.selectionRing3D.visible && Game3D.selectedUnit) {
                Game3D.selectionRing3D.position.set(Game3D.selectedUnit.pos.x, 1.4, Game3D.selectedUnit.pos.z);
                const ringScale = 1.0 + Math.sin(elapsed * 5.5) * 0.08;
                Game3D.selectionRing3D.scale.set(ringScale, ringScale, ringScale);
            }

            // 9. Cập nhật Vị trí & Góc nhìn Camera mượt mà (Lerp)
            if (Game3D.cheDoCamera === 'LOBBY') {
                // Quay vòng nhẹ nhàng quanh dòng sông ở sảnh chờ
                if (!Game3D.isDragging) {
                    Game3D.sphericalCoords.theta += 0.002;
                }
                const r = Game3D.sphericalCoords.radius;
                const th = Game3D.sphericalCoords.theta;
                const ph = Game3D.sphericalCoords.phi;

                Game3D.targetCamPos.x = r * Math.sin(ph) * Math.sin(th);
                Game3D.targetCamPos.y = r * Math.cos(ph);
                Game3D.targetCamPos.z = r * Math.sin(ph) * Math.cos(th);
            } else if (Game3D.cheDoCamera === 'TACTICAL') {
                const r = Game3D.sphericalCoords.radius;
                const th = Game3D.sphericalCoords.theta;
                const ph = Math.min(1.1, Game3D.sphericalCoords.phi);

                Game3D.targetCamPos.x = r * Math.sin(ph) * Math.sin(th);
                Game3D.targetCamPos.y = Math.max(65, r * Math.cos(ph));
                Game3D.targetCamPos.z = r * Math.sin(ph) * Math.cos(th);
            } else if (Game3D.cheDoCamera === 'CINEMATIC') {
                // Tọa độ mục tiêu targetCamPos & targetCamLook được đặt trực tiếp theo sự kiện kịch tính
            }

            Game3D.camera.position.lerp(Game3D.targetCamPos, 0.04);
            Game3D.currentCamLook.lerp(Game3D.targetCamLook, 0.05);
            Game3D.camera.lookAt(Game3D.currentCamLook);

            // Render khung cảnh
            Game3D.renderer.render(Game3D.scene, Game3D.camera);
        }

