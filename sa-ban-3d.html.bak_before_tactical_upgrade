        function dangKyPhimTuyetKy() {
            window.addEventListener('keydown', (e) => {
                if (e.key === '1') thiTrienTuyetKy(1);
                if (e.key === '2') thiTrienTuyetKy(2);
                if (e.key === '3') thiTrienTuyetKy(3);
                if (e.key === '4') thiTrienTuyetKy(4);
            });
        }

        // 4. BỘ TUYỆT KỸ DANH TƯỚNG 3D (4 HERO TACTICAL SKILLS)
        function thiTrienTuyetKy(skillId) {
            const skill = Game3D.skills[skillId];
            if (!skill) return;

            if (skill.currentCd > 0) {
                hienThiThongBaoPopup(`⏳ ${skill.name}`, `Đang hồi chiêu (${Math.ceil(skill.currentCd)}s)!`);
                return;
            }

            if (Game3D.muuLuoc < skill.cost) {
                hienThiThongBaoPopup(`⚡ Thiếu Mưu Lược`, `Cần ${skill.cost} Mưu Lược để thi triển!`);
                return;
            }

            // Khấu trừ Mưu Lược & Kích hoạt Cooldown
            Game3D.muuLuoc -= skill.cost;
            skill.currentCd = skill.cd;

            const valMuuLuoc = document.getElementById('val-muu-luoc');
            if (valMuuLuoc) valMuuLuoc.textContent = `${Math.round(Game3D.muuLuoc)} / 100`;

            // -------------------------------------------------------------
            // KỸ NĂNG 1: 🌊 THỦY TRIỀU DẪN DỤ (KẾ GIẢ THUA)
            // -------------------------------------------------------------
            if (skillId === 1) {
                AudioEngine.playWarDrum();
                hienThiThongBaoPopup("🌊 THỦY TRIỀU DẪN DỤ", "Kế giả thua nhử toàn bộ hạm đội giặc vào bãi cọc ngầm!");
                phatGiongDoc("Thuyền nhẹ giả thua rút lui! Giặc tưởng bở đang dốc toàn lực đuổi theo vào bãi cọc!");

                const tn = Game3D.units.thuyenNhe;
                const dich = Game3D.units.dichLauThuyen;

                if (tn) {
                    tn.targetZ = -45; // Thuyền nhẹ rút lui vượt qua bãi cọc
                    tn.speed = 18;
                    tn.isRetreating = true;
                }

                if (dich) {
                    dich.targetZ = 2; // Giặc đuổi sâu vào đúng bãi cọc ngầm
                    dich.speed = 9;
                }

                // Tạo hiệu ứng sóng âm lan tỏa 3D (Acoustic Wave)
                const rippleGeo = new THREE.RingGeometry(2, 4, 32);
                rippleGeo.rotateX(-Math.PI / 2);
                const rippleMat = new THREE.MeshBasicMaterial({ color: 0x1ABC9C, transparent: true, opacity: 0.9, side: THREE.DoubleSide });
                const ripple = new THREE.Mesh(rippleGeo, rippleMat);
                ripple.position.set(0, 1.4, 25);
                Game3D.scene.add(ripple);

                Game3D.skillEffects.push({
                    mesh: ripple,
                    type: 'ripple',
                    scale: 1,
                    maxScale: 38,
                    opacity: 0.9
                });
            }

            // -------------------------------------------------------------
            // KỸ NĂNG 2: 📜 THẦN THI KHÍCH LỆ / HÀO KHÍ VẠN QUÂN
            // -------------------------------------------------------------
            else if (skillId === 2) {
                AudioEngine.playFanfare();
