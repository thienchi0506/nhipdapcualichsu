        // 7. Chọn Cổ Vật Hiển Thị Trong Showcase
        function chonBaoVatShowcase(relicId) {
            const r = Game3D.relics[relicId];
            if (!r) return;
            Game3D.activeRelicId = relicId;

            const eraEl = document.getElementById('relic-era-tag');
            const titleEl = document.getElementById('active-relic-title');
            const descEl = document.getElementById('active-relic-desc');
            const quoteEl = document.getElementById('relic-lore-quote');
            const statusEl = document.getElementById('relic-status-badge');

            if (eraEl) eraEl.textContent = r.era;
            if (titleEl) titleEl.textContent = `${r.icon} ${r.name}`;
            if (descEl) descEl.textContent = r.desc;
            if (quoteEl) quoteEl.textContent = r.lore;

            if (statusEl) {
                if (r.unlocked) {
                    statusEl.textContent = '✨ ĐÃ MỞ KHÓA';
                    statusEl.className = 'relic-status-badge';
                } else {
                    statusEl.textContent = '🔒 CHƯA MỞ KHÓA (HOÀN THÀNH HẬU CHIẾN)';
                    statusEl.className = 'relic-status-badge locked';
                }
            }

            // Đổi mô hình 3D trên bệ đá
            if (Game3D.relicViewer && Game3D.relicViewer.modelGroup) {
                while (Game3D.relicViewer.modelGroup.children.length > 0) {
                    Game3D.relicViewer.modelGroup.remove(Game3D.relicViewer.modelGroup.children[0]);
                }
                const newMesh = taoMoHinhBaoVat3D(relicId);
                Game3D.relicViewer.modelGroup.add(newMesh);
                Game3D.relicViewer.rotationY = 0;
                Game3D.relicViewer.rotationX = 0;
            }

            capNhatDanhSachRelicThumbnails();
        }

        // 8. Cập Nhật Danh Sách Thẻ Cổ Vật Thu Nhỏ
        function capNhatDanhSachRelicThumbnails() {
            const container = document.getElementById('relics-thumbnails-grid');
            if (!container) return;

            container.innerHTML = '';
            Object.values(Game3D.relics).forEach(r => {
                const card = document.createElement('div');
                card.className = `relic-mini-card ${r.unlocked ? '' : 'locked'} ${r.id === Game3D.activeRelicId ? 'active' : ''}`;
                card.onclick = () => chonBaoVatShowcase(r.id);
                card.innerHTML = `
                    <div class="relic-mini-icon">${r.icon}</div>
                    <div class="relic-mini-name">${r.name}</div>
                    <div style="font-size:0.6rem; color:${r.unlocked ? '#38EF7D' : '#E74C3C'}; margin-top:2px;">
                        ${r.unlocked ? '✓ Đã Mở' : '🔒 Khóa'}
                    </div>
                `;
                container.appendChild(card);
            });
        }

