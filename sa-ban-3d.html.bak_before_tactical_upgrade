        // 4. Thực Thi Quyết Sách Hậu Chiến & Mở Khóa Bảo Vật
        function thucThiQuyetSachHauChien(siteId) {
            const id = siteId || Game3D.activePostWarSite;
            const site = Game3D.congTrinhHauChien[id];
            if (!site || site.completed) return;

            site.completed = true;
            dongModal('modal-postwar-decision');

            if (id === 'tramQuanY') {
                Game3D.thuongBinh = 0;
                Game3D.nhanDao += 500;
                AudioEngine.playPeaceBell();
                moKhoaHuanChuong('tuongQuanNhanNghia');
                hienThiThongBaoPopup("🌿 CHỮA LÀNH THƯƠNG BINH", "Toàn bộ thương binh ta và địch đã được chữa lành! Thương binh về 0!");
            } else if (id === 'daiBanChieu') {
                Game3D.siKhi = 100;
                Game3D.nganKho = Math.max(0, Game3D.nganKho - 2000);
                Game3D.nhanDao += 600;
                AudioEngine.playPeaceBell();
                hienThiThongBaoPopup("📜 KHOAN THƯ SỨC DÂN", "Ban chiếu cấp ruộng đất cho tử sĩ, nhân dân hoan ca mừng thái bình!");
            } else if (id === 'danTeTuongNiem') {
                Game3D.nhanDao += 700;
                Game3D.siKhi = 100;
                AudioEngine.playPeaceBell();
                hienThiThongBaoPopup("🏺 LẬP ĐÀN TẾ TƯỞNG NIỆM", "Hóa giải hận thù, cầu siêu cho anh linh muôn người về cõi an lạc!");
            } else if (id === 'benThuyenHoaBinh') {
                Game3D.nhanDao += 1000;
                AudioEngine.playPeaceBell();
                moKhoaHuanChuong('suGiaThaiBinh');
                hienThiThongBaoPopup("🕊️ PHÓNG THÍCH TÙ BINH", "Cấp thuyền lương đưa tù binh về đoàn tụ gia đình! Nền hòa bình muôn thuở!");
            }
            capNhatHUD();

            if (site.labelEl) {
                site.labelEl.innerHTML = `<span>${site.icon}</span> <span>${site.name}</span> <span style="color:#38EF7D;">[✓ Xong]</span>`;
