        // Xử lý nạp ảnh tự động: Local -> Online -> SVG Fallback
        function xuLyLoiAnhNhanVat(imgEl, nvId) {
            if (!imgEl) return;
            var nv = danhSachNhanVat.find(function(item) { return item.id === nvId; });
            if (!nv) return;

            // Nếu đang thử ảnh cục bộ mà lỗi, chuyển sang link online (nếu chưa thử)
            if (!imgEl.dataset.triedOnline && nv.hinhAnhOnline) {
                imgEl.dataset.triedOnline = "true";
                imgEl.src = nv.hinhAnhOnline;
                return;
            }

            // Nếu online cũng không tải được (hoặc offline) -> hiển thị tranh SVG cổ phong
            imgEl.onerror = null;
            imgEl.src = taoChanDungCoPhongSVG(nv);
        }

        // Tạo giao diện danh sách thẻ bài nhân vật (Cards Grid)
        function renderDanhSachNhanVatHtml(activeCat) {
            activeCat = activeCat || 'all';

            var tabsHtml = `
                <div class="modal-tabs">
                    <button class="modal-tab-btn ${activeCat === 'all' ? 'active' : ''}" onclick="locNhanVat('all', this)">Tất Cả (${danhSachNhanVat.length})</button>
                    <button class="modal-tab-btn ${activeCat === 'de-vuong' ? 'active' : ''}" onclick="locNhanVat('de-vuong', this)">👑 Đế Vương</button>
                    <button class="modal-tab-btn ${activeCat === 'danh-tuong' ? 'active' : ''}" onclick="locNhanVat('danh-tuong', this)">⚔️ Danh Tướng</button>
                    <button class="modal-tab-btn ${activeCat === 'danh-nhan' ? 'active' : ''}" onclick="locNhanVat('danh-nhan', this)">📜 Danh Nhân Văn Hóa</button>
                    <button class="modal-tab-btn ${activeCat === 'nu-kiet' ? 'active' : ''}" onclick="locNhanVat('nu-kiet', this)">🌸 Nữ Kiệt</button>
                </div>
            `;

            var cardsHtml = `<div class="character-cards-grid" id="grid-nhan-vat">`;
            danhSachNhanVat.forEach(function(nv) {
                var isVisible = (activeCat === 'all' || nv.theLoai === activeCat);
                cardsHtml += `
                    <div class="character-card" data-cat="${nv.theLoai}" style="display: ${isVisible ? 'flex' : 'none'};" onclick="xemChiTietNhanVat('${nv.id}', true)">
                        <div class="character-card__badge">${nv.icon} ${nv.thoiKy}</div>
                        <div class="character-card__portrait-box">
                            <div class="character-card__portrait-frame">
                                <img src="${nv.hinhAnh}" 
                                     alt="${nv.ten}" 
                                     class="character-card__img" 
                                     loading="lazy"
                                     onerror="xuLyLoiAnhNhanVat(this, '${nv.id}')" />
                                <div class="character-card__overlay-vignette"></div>
                                <div class="character-card__seal-stamp">ĐẠI VIỆT</div>
                            </div>
                        </div>
                        <div class="character-card__info">
                            <span class="character-card__title-tag">${nv.danhHieu}</span>
                            <h4 class="character-card__name">${nv.ten}</h4>
                            <p class="character-card__desc">${nv.tieuSu.length > 110 ? nv.tieuSu.substring(0, 110) + '...' : nv.tieuSu}</p>
                            <button class="character-card__btn" onclick="event.stopPropagation(); xemChiTietNhanVat('${nv.id}', true)">
                                📜 Xem Binh Nghiệp ➔
                            </button>
                        </div>
                    </div>
                `;
            });
            cardsHtml += `</div>`;

            return tabsHtml + cardsHtml;
        }

        // Lọc thẻ nhân vật theo danh mục
        function locNhanVat(cat, btn) {
            var btns = document.querySelectorAll('.modal-tab-btn');
            btns.forEach(function(b) { b.classList.remove('active'); });
            if (btn) btn.classList.add('active');

            var cards = document.querySelectorAll('#grid-nhan-vat .character-card, #grid-nhan-vat .modal-card');
            cards.forEach(function(c) {
                if (cat === 'all' || c.getAttribute('data-cat') === cat) {
                    c.style.display = 'flex';
                } else {
                    c.style.display = 'none';
                }
            });
        }

