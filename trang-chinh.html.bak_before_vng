                            <option value="nghi-an">Đề xuất giải mã Nghi án Sử Việt</option>
                            <option value="khac">Ý kiến đóng góp phát triển web</option>
                        </select>
                        <textarea id="qa-content" rows="4" placeholder="Nội dung tư liệu hoặc thắc mắc của bạn..." required></textarea>
                        <button type="submit">Gửi Tư Liệu Đóng Góp →</button>
                    </form>
                `;
            }

            titleEl.innerHTML = titleText;
            bodyEl.innerHTML = bodyHtml;
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function dongModalDuLieu(event) {
            var overlay = document.getElementById('antique-modal-overlay');
            if (overlay) {
                overlay.classList.remove('open');
            }
            document.body.style.overflow = '';

            // Dừng phát video trong modal nếu đang chạy
            var vid = document.getElementById('modal-video-player');
            if (vid) {
                vid.pause();
            }

            capNhatBreadcrumb('Trang chủ');
        }

        function locNhanVat(cat, btn) {
            var btns = document.querySelectorAll('.modal-tab-btn');
            btns.forEach(function(b) { b.classList.remove('active'); });
            if (btn) btn.classList.add('active');

            var cards = document.querySelectorAll('#grid-nhan-vat .modal-card');
            cards.forEach(function(c) {
                if (cat === 'all' || c.getAttribute('data-cat') === cat) {
                    c.style.display = 'flex';
                } else {
                    c.style.display = 'none';
                }
            });
        }

        function chuyenVideoModal(videoSrc, videoTitle, btn) {
            var btns = document.querySelectorAll('.modal-tab-btn');
            btns.forEach(function(b) { b.classList.remove('active'); });
            if (btn) btn.classList.add('active');

            var player = document.getElementById('modal-video-player');
            var desc = document.getElementById('modal-video-desc');
            if (player) {
                player.src = videoSrc;
                player.play().catch(function() {});
            }
            if (desc) {
                desc.innerHTML = '⚔️ <strong>' + videoTitle + ' (' + videoSrc + '):</strong> Thước phim tư liệu lịch sử Đại Việt hào hùng, khơi dậy niềm tự hào dân tộc và lòng biết ơn tổ tiên.';
            }
        }

        function guiDongGopTuLieu(event) {
            event.preventDefault();
            var name = document.getElementById('qa-sender-name').value;
            alert('Cảm ơn bạn ' + name + ' đã gửi đóng góp tư liệu quý báu cho dự án Dấu Chân Lịch Sử! Ban biên tập sẽ kiểm duyệt và cập nhật sớm nhất.');
            dongModalDuLieu();
        }

    </script>

    <!-- ============================================================ -->
    <!--  HỘP THOẠI MODAL CỔ TRANG TƯƠNG TÁC CHO CÁC MỤC MENU          -->
    <!-- ============================================================ -->
    <div class="antique-modal-overlay" id="antique-modal-overlay" onclick="dongModalDuLieu(event)">
        <div class="antique-modal-box" onclick="event.stopPropagation()">
            <div class="antique-modal-header">
                <h3 class="antique-modal-title" id="modal-header-title">
                    🏛️ Tiêu Đề Modal
                </h3>
                <button class="antique-modal-close" onclick="dongModalDuLieu()" aria-label="Đóng">✕</button>
            </div>
            <div class="antique-modal-body" id="modal-body-content">
                <!-- Nội dung động được chèn bằng JavaScript -->
            </div>
        </div>
    </div>

</body>
</html>