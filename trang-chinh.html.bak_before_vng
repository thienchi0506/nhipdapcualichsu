        function chonTabMenu(event, tabName, targetId) {
            if (event) event.preventDefault();

            // Cập nhật active class trên menu
            var items = document.querySelectorAll('.sub-navbar__item');
            items.forEach(function(item) {
                if (item.getAttribute('data-name') === tabName) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });

            if (tabName === 'Trang chủ') {
                capNhatBreadcrumb('Trang chủ');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else if (tabName === 'Dòng lịch sử') {
                capNhatBreadcrumb('Trang chủ > Dòng lịch sử');
                var target = document.getElementById('interactive-timeline');
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        }


