        var mocHienTai = 0;

        function chonMocLichSu(index) {
            if (index < 0 || index >= duLieuDongLichSu.length) return;
            mocHienTai = index;
            var moc = duLieuDongLichSu[index];

            // Cập nhật class active cho dots
            var nodes = document.querySelectorAll('.tl-node');
            nodes.forEach(function(node, i) {
                if (i === index) node.classList.add('active');
                else node.classList.remove('active');
            });

            // Hiệu ứng mượt cho card nội dung
            var card = document.getElementById('tl-content-card');
            if (card) {
                card.style.opacity = '0.4';
                card.style.transform = 'translateY(6px)';
                setTimeout(function() {
                    document.getElementById('tl-display-title').textContent = moc.tieuDe;
                    document.getElementById('tl-display-period').textContent = moc.nam;
                    document.getElementById('tl-display-text').textContent = moc.noiDung;
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, 150);
            }

            capNhatBreadcrumb('Trang chủ > Dòng lịch sử > ' + moc.tenMoc);
        }

        function chuyenMocTruoc() {
            var idx = (mocHienTai - 1 + duLieuDongLichSu.length) % duLieuDongLichSu.length;
            chonMocLichSu(idx);
        }

        function chuyenMocSau() {
            var idx = (mocHienTai + 1) % duLieuDongLichSu.length;
            chonMocLichSu(idx);
        }


