        // Xử lý nạp ảnh tự động: Local -> Online -> SVG Fallback
        function xuLyLoiAnhNhanVat(imgEl, nvId) {
            if (!imgEl) return;
            var nv = danhSachNhanVat.find(function(item) { return item.id === nvId; });
            if (!nv) return;

            // Nếu đang thử ảnh cục bộ mà lỗi, chuyển sang link online (nếu chưa thử)
            if (!imgEl.dataset.triedOnline && nv.hinhAnhOnline) {
                imgEl.dataset.triedOnline = "true";
                imgEl.src = nv.hinhAnhOnline;
                return;
            }

            // Nếu online cũng không tải được (hoặc offline) -> hiển thị tranh SVG cổ phong
            imgEl.onerror = null;
            imgEl.src = taoChanDungCoPhongSVG(nv);
        }

