        function taoHatTanLuaMepCanh(curX, curY, curAngle, curScale) {
            var rad = curAngle * Math.PI / 180;
            var cosA = Math.cos(rad);
            var sinA = Math.sin(rad);

            // Véc tơ gió ngược quán tính theo chiều bay
            var windVx = -cosA * (4.5 * curScale);
            var windVy = -sinA * (4.5 * curScale);
            var normVx = -sinA;
            var normVy = cosA;

            // Duy trì số lượng hạt tàn lửa đỏ cam & bụi vàng xấp xỉ 120 hạt
            var needed = 120 - chimLacParticles.length;
            if (needed <= 0) return;
            var count = Math.min(Math.max(8, Math.floor(needed * 0.65)), 22);

            for (var k = 0; k < count; k++) {
                var pt = CHIM_LAC_EMITTERS[Math.floor(Math.random() * CHIM_LAC_EMITTERS.length)];
                var dx = pt[0] * curScale;
                var dy = pt[1] * curScale;
                var emitX = curX + dx * cosA - dy * sinA + (Math.random() - 0.5) * 10;
                var emitY = curY + dx * sinA + dy * cosA + (Math.random() - 0.5) * 10;

                // Lực quán tính gió kết hợp độ xòe bắn tung tóe (lateral spray)
                var latSpeed = (Math.random() - 0.5) * 5.2 * curScale;
                var pVx = windVx + normVx * latSpeed + (Math.random() - 0.5) * 2.2;
                var pVy = windVy + normVy * latSpeed + (Math.random() - 0.5) * 2.2;

                var isGoldDust = Math.random() < 0.45;
                var color = isGoldDust 
                    ? BANG_MAU_BUI_VANG[Math.floor(Math.random() * BANG_MAU_BUI_VANG.length)]
                    : BANG_MAU_LUA_DO_CAM[Math.floor(Math.random() * BANG_MAU_LUA_DO_CAM.length)];

                chimLacParticles.push({
                    x: emitX,
                    y: emitY,
                    vx: pVx,
                    vy: pVy,
                    size: isGoldDust ? (Math.random() * 2.6 + 1.4) : (Math.random() * 4.6 + 2.4),
                    life: Math.floor(Math.random() * 35 + 40),
                    maxLife: 75,
                    color: color,
                    isGoldDust: isGoldDust,
                    sparkle: Math.random() * Math.PI * 2,
                    sparkleSpeed: Math.random() * 0.25 + 0.12
                });
            }
        }

        /**
         * Loại 2: Thả chiếc lông vũ ánh sáng vàng kim nhỏ rơi lơ lửng dọc quỹ đạo
         */
        function taoLongVuVangKim(curX, curY, curAngle, curScale) {
            // Duy trì tối đa 15 chiếc lông vũ ánh sáng vàng kim nhỏ
            if (chimLacFeathers.length >= 15) return;

            var rad = curAngle * Math.PI / 180;
            // Thả lông vũ rơi ra từ vệt sau cánh và thân chim
            var offsetDist = (Math.random() * -140 - 50) * curScale;
            var spreadLat = (Math.random() - 0.5) * 90 * curScale;
            var spawnX = curX + Math.cos(rad) * offsetDist - Math.sin(rad) * spreadLat;
            var spawnY = curY + Math.sin(rad) * offsetDist + Math.cos(rad) * spreadLat;

            chimLacFeathers.push({
                x: spawnX,
                y: spawnY,
                vx: (Math.random() - 0.5) * 0.9 - Math.cos(rad) * 0.9,
                vy: Math.random() * 0.7 + 0.6, // Rơi lơ lửng bồng bềnh rất chậm
                size: Math.random() * 6 + 12,  // Lông vũ nhỏ thanh thoát (12 - 18px)
                angle: Math.random() * Math.PI * 2,
                rotSpeed: (Math.random() - 0.5) * 0.038, // Xoay nhẹ nhàng trong gió
                wobble: Math.random() * Math.PI * 2,
                wobbleSpeed: Math.random() * 0.045 + 0.035,
                wobbleAmp: Math.random() * 1.6 + 0.9,
                life: Math.floor(Math.random() * 60 + 90), // Tuổi thọ đủ để rơi chao liệng bồng bềnh
                maxLife: 150
            });
        }

        /**
         * Khi lông vũ tan biến -> Bùng phát thành chùm đốm lửa nhỏ
         */
        function tanBienThanhDomLua(x, y) {
            var sparkCount = Math.floor(Math.random() * 3 + 4);
            for (var m = 0; m < sparkCount; m++) {
                var ang = Math.random() * Math.PI * 2;
                var spd = Math.random() * 2.4 + 0.8;
                chimLacParticles.push({
                    x: x + (Math.random() - 0.5) * 6,
                    y: y + (Math.random() - 0.5) * 6,
                    vx: Math.cos(ang) * spd,
                    vy: Math.sin(ang) * spd,
                    size: Math.random() * 3.2 + 1.8,
                    life: Math.floor(Math.random() * 16 + 16),
                    maxLife: 32,
                    color: Math.random() < 0.6 ? '#FFD700' : '#FF5722',
                    isGoldDust: false,
                    sparkle: Math.random() * Math.PI,
