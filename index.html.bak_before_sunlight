                });
            }
        }

        /**
         * Vẽ chi tiết một chiếc lông vũ ánh sáng vàng kim nhỏ trên Canvas
         */
        function veChiTietLongVuVang(ctx, f) {
            var progress = f.life / f.maxLife;
            // Hiện dần, bay bồng bềnh rồi tan biến êm dịu
            var alpha = Math.sin(progress * Math.PI);

            ctx.save();
            ctx.translate(f.x, f.y);
            ctx.rotate(f.angle);
            ctx.globalAlpha = Math.max(0, Math.min(1, alpha * 0.94));

            var s = f.size;

            // Quầng phát quang vàng kim
            ctx.shadowColor = '#FFD700';
            ctx.shadowBlur = 12 * alpha;

            // Dải màu chuyển sắc thân lông vũ từ trắng kim sang vàng rực và cam lửa
            var grad = ctx.createLinearGradient(0, -s, 0, s);
            grad.addColorStop(0, '#FFFFFF');
            grad.addColorStop(0.25, '#FFF5D6');
            grad.addColorStop(0.65, '#FFD700');
            grad.addColorStop(1, '#FF6B00');
            ctx.fillStyle = grad;

            // Phiến lông bên trái (Left Vane)
            ctx.beginPath();
            ctx.moveTo(0, -s);
            ctx.bezierCurveTo(-s * 0.38, -s * 0.45, -s * 0.36, s * 0.35, 0, s);
            ctx.bezierCurveTo(-s * 0.12, s * 0.3, -s * 0.08, -s * 0.3, 0, -s);
            ctx.fill();

            // Phiến lông bên phải (Right Vane)
            ctx.beginPath();
            ctx.moveTo(0, -s);
            ctx.bezierCurveTo(s * 0.35, -s * 0.5, s * 0.34, s * 0.35, 0, s);
            ctx.bezierCurveTo(s * 0.12, s * 0.3, s * 0.08, -s * 0.3, 0, -s);
            ctx.fill();

            // Sống lông ánh sáng ở giữa (Central Rachis Shaft)
            ctx.strokeStyle = '#FFFFFF';
            ctx.lineWidth = 1.0;
            ctx.beginPath();
            ctx.moveTo(0, -s * 1.05);
            ctx.quadraticCurveTo(s * 0.05, 0, 0, s * 1.15);
            ctx.stroke();

            // Các đường khía tơ lông ánh sáng mảnh
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.75)';
            ctx.lineWidth = 0.65;
            ctx.beginPath();
            ctx.moveTo(0, -s * 0.5); ctx.lineTo(-s * 0.25, -s * 0.3);
            ctx.moveTo(0, -s * 0.2); ctx.lineTo(-s * 0.28, 0);
            ctx.moveTo(0, s * 0.2);  ctx.lineTo(-s * 0.22, s * 0.4);
            ctx.moveTo(0, -s * 0.4); ctx.lineTo(s * 0.24, -s * 0.2);
            ctx.moveTo(0, 0);        ctx.lineTo(s * 0.26, s * 0.2);
            ctx.moveTo(0, s * 0.3);  ctx.lineTo(s * 0.20, s * 0.5);
            ctx.stroke();

            ctx.restore();
        }

        // Tương thích ngược với hàm tạo hạt cũ
        function taoHatTanLua(x, y, vx, vy, isStar) {
            chimLacParticles.push({
                x: x, y: y,
                vx: vx || (Math.random() - 0.5) * 2,
                vy: vy || (Math.random() - 0.5) * 2,
                size: isStar ? (Math.random() * 7 + 4) : (Math.random() * 3.5 + 2),
                life: Math.floor(Math.random() * 25 + 25),
                maxLife: 50,
                color: isStar ? '#FFFDF5' : '#FF9100',
                isGoldDust: !isStar,
                sparkle: Math.random() * Math.PI,
                sparkleSpeed: 0.15
            });
        }

        
        /**
         * =========================================================================
         * HIỆU ỨNG SÓNG XUNG KÍCH HOÀNG KIM (GOLDEN SHOCKWAVE RING) & GOD-RAYS
         * Tỏa rộng toàn màn hình từ tâm ngực chim và tia sáng chiếu qua sải cánh
         * =========================================================================
         */

        /**
         * Vẽ Sóng Xung Kích Hoàng Kim bung nở nhanh từ tâm ngực chim tỏa ra toàn màn hình
         */
        function veSongXungKichHoangKim(ctx, cx, cy, progress, W, H) {
            if (progress <= 0 || progress >= 1.0) return;
            var maxR = Math.sqrt(W * W + H * H) * 0.78;
            // Easing out cubic: Nở bung cực nhanh ở giai đoạn đầu, lan tỏa sâu rộng
            var ease = 1 - Math.pow(1 - progress, 3);
            var r = maxR * ease;
            var alpha = Math.sin(progress * Math.PI); // Hiện sáng rồi tan biến êm

            if (alpha <= 0.01) return;

            ctx.save();
            ctx.globalCompositeOperation = 'screen';

            // Vành 1: Vành sóng xung kích chính (Primary Golden-Red Shockwave Front)
            var ringWidth = 24 + 75 * progress;
            var rInner = Math.max(0, r - ringWidth);
            var rOuter = r + ringWidth * 0.55;

            var shockGrad = ctx.createRadialGradient(cx, cy, rInner, cx, cy, rOuter);
            shockGrad.addColorStop(0, 'rgba(255, 61, 0, 0)');
            shockGrad.addColorStop(0.35, 'rgba(255, 107, 0, ' + (alpha * 0.75).toFixed(3) + ')');
            shockGrad.addColorStop(0.65, 'rgba(255, 215, 0, ' + (alpha * 0.95).toFixed(3) + ')');
            shockGrad.addColorStop(0.85, 'rgba(255, 255, 245, ' + (alpha * 1.0).toFixed(3) + ')');
            shockGrad.addColorStop(1, 'rgba(255, 87, 34, 0)');

            ctx.fillStyle = shockGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, rOuter, 0, Math.PI * 2);
            ctx.fill();

            // Vành 2: Vành sóng hài thứ cấp chạy tiếp ứng (Trailing Harmonic Ripple)
            if (progress > 0.12) {
                var p2 = (progress - 0.12) / 0.88;
                var ease2 = 1 - Math.pow(1 - p2, 3);
                var r2 = maxR * 0.82 * ease2;
                var alpha2 = Math.sin(p2 * Math.PI) * 0.68;
                var rw2 = 18 + 48 * p2;

                var grad2 = ctx.createRadialGradient(cx, cy, Math.max(0, r2 - rw2), cx, cy, r2 + rw2 * 0.45);
                grad2.addColorStop(0, 'rgba(255, 145, 0, 0)');
                grad2.addColorStop(0.5, 'rgba(255, 215, 0, ' + (alpha2 * 0.82).toFixed(3) + ')');
                grad2.addColorStop(0.8, 'rgba(255, 255, 245, ' + (alpha2 * 0.92).toFixed(3) + ')');
                grad2.addColorStop(1, 'rgba(255, 61, 0, 0)');

                ctx.fillStyle = grad2;
                ctx.beginPath();
                ctx.arc(cx, cy, r2 + rw2 * 0.45, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.restore();
        }

        /**
         * Vẽ các tia sáng (God-rays) hoàng kim chiếu xuyên qua sải cánh tỏa ra toàn không gian
         */
        function veTiaSangGodRays(ctx, cx, cy, intensity, birdAngle, W, H) {
            if (intensity <= 0.02) return;

            var numRays = 16;
            var rayLength = Math.max(W, H) * 1.38;
            var baseAngle = birdAngle * Math.PI / 180;

            ctx.save();
            ctx.globalCompositeOperation = 'screen';

            // 16 tia sáng hình nan quạt chiếu xuyên qua sải cánh
            for (var i = 0; i < numRays; i++) {
                var ang = baseAngle + (i * (Math.PI * 2 / numRays)) + Math.sin(i * 1.7) * 0.12;
                var beamWidth = 0.08 + Math.sin(i * 2.3) * 0.035; // Chiều rộng góc nan quạt
                var flicker = 0.82 + 0.18 * Math.sin(Date.now() * 0.008 + i * 1.5);
                var rayAlpha = intensity * flicker * 0.52;

                var aLeft = ang - beamWidth;
                var aRight = ang + beamWidth;

                var x1 = cx + Math.cos(aLeft) * rayLength;
                var y1 = cy + Math.sin(aLeft) * rayLength;
                var x2 = cx + Math.cos(aRight) * rayLength;
                var y2 = cy + Math.sin(aRight) * rayLength;

                var rayGrad = ctx.createRadialGradient(cx, cy, 10, cx, cy, rayLength);
                rayGrad.addColorStop(0, 'rgba(255, 255, 250, ' + (rayAlpha * 1.25).toFixed(3) + ')');
                rayGrad.addColorStop(0.25, 'rgba(255, 229, 127, ' + (rayAlpha * 0.98).toFixed(3) + ')');
                rayGrad.addColorStop(0.60, 'rgba(255, 145, 0, ' + (rayAlpha * 0.58).toFixed(3) + ')');
                rayGrad.addColorStop(0.85, 'rgba(255, 61, 0, ' + (rayAlpha * 0.25).toFixed(3) + ')');
                rayGrad.addColorStop(1, 'rgba(216, 38, 0, 0)');

                ctx.fillStyle = rayGrad;
                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.lineTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.closePath();
                ctx.fill();
            }

            // Quầng sáng chói lọi bùng nổ tại tâm ngực chim
            var coreGlowR = 75 * intensity;
            var coreGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, coreGlowR);
            coreGrad.addColorStop(0, 'rgba(255, 255, 255, ' + (intensity * 0.98).toFixed(2) + ')');
            coreGrad.addColorStop(0.4, 'rgba(255, 229, 127, ' + (intensity * 0.88).toFixed(2) + ')');
            coreGrad.addColorStop(0.8, 'rgba(255, 107, 0, ' + (intensity * 0.55).toFixed(2) + ')');
            coreGrad.addColorStop(1, 'rgba(255, 61, 0, 0)');
            ctx.fillStyle = coreGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, coreGlowR, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }

        
        /**
         * =========================================================================
         * ĐỒNG BỘ ĐÔI CÁNH RỰC LỬA VỚI ĐƯỜNG CẮT CLIP-PATH CHUYỂN TRANG
         * VỆT CẮT LỬA HOÀNG KIM (BLAZING TEAR LINE) BÁM SÁT THEO SẢI CÁNH CHIM HẠC
         * =========================================================================
         */

        /**
         * Tính toán đa giác clip-path và 2 đầu mút đường cắt dựa trực tiếp theo vị trí và góc sải cánh Chim Hạc
         */
        function tinhToanClipVaDauMutTheoCanh(wingX, wingY, birdAngle, W, H) {
            var rad = birdAngle * Math.PI / 180;
            var nx = Math.cos(rad);
            var ny = Math.sin(rad);

            var corners = [
                { x: 0, y: 0 },
                { x: W, y: 0 },
                { x: W, y: H },
                { x: 0, y: H }
            ];

            function inside(p) {
                return nx * (p.x - wingX) + ny * (p.y - wingY) <= 0;
            }

            var allInside = corners.every(inside);
            if (allInside) {
                return {
                    polygonStr: 'polygon(0 0, 100% 0, 100% 100%, 0 100%)',
                    cutEnds: null
                };
            }

            var allOutside = corners.every(function(p) { return !inside(p); });
            if (allOutside) {
                return {
                    polygonStr: 'polygon(0 0, 0 0, 0 0, 0 0)',
                    cutEnds: null
                };
            }

            function intersect(p1, p2) {
                var d1 = nx * (p1.x - wingX) + ny * (p1.y - wingY);
                var d2 = nx * (p2.x - wingX) + ny * (p2.y - wingY);
                var t = d1 / (d1 - d2);
                return {
                    x: p1.x + t * (p2.x - p1.x),
                    y: p1.y + t * (p2.y - p1.y)
                };
            }

            var out = [];
            var cutPts = [];

            for (var i = 0; i < 4; i++) {
                var cur = corners[i];
                var prev = corners[(i + 3) % 4];
                var inCur = inside(cur);
                var inPrev = inside(prev);

                if (inCur) {
                    if (!inPrev) {
                        var pt1 = intersect(prev, cur);
                        out.push(pt1);
                        cutPts.push(pt1);
                    }
                    out.push(cur);
                } else if (inPrev) {
                    var pt2 = intersect(prev, cur);
                    out.push(pt2);
                    cutPts.push(pt2);
                }
            }

            var polyStr = 'polygon(' + out.map(function(p) {
                return ((p.x / W) * 100).toFixed(2) + '% ' + ((p.y / H) * 100).toFixed(2) + '%';
            }).join(', ') + ')';

            var cutEnds = null;
            if (cutPts.length >= 2) {
                cutEnds = {
                    x1: cutPts[0].x, y1: cutPts[0].y,
                    x2: cutPts[1].x, y2: cutPts[1].y
                };
            }

            return {
                polygonStr: polyStr,
                cutEnds: cutEnds
            };
        }

        /**
         * Vẽ Vệt Cắt Lửa Hoàng Kim (Blazing Tear Line) chạy chéo màn hình bám sát theo sải cánh Chim Hạc
         * Chim Hạc bay tới đâu, vệt lửa rực sáng xé màn đêm tới đó để lộ ra giao diện trang-chinh.html bên dưới
         */
        function veVetCatLuaHoangKim(ctx, cutEnds, birdX, birdY, birdAngle, birdScale, elapsed, W, H) {
            if (!cutEnds) return;
            var x1 = cutEnds.x1, y1 = cutEnds.y1;
            var x2 = cutEnds.x2, y2 = cutEnds.y2;
            var dx = x2 - x1, dy = y2 - y1;
            var len = Math.hypot(dx, dy);
            if (len < 5) return;

            var tx = dx / len, ty = dy / len;
            var rad = birdAngle * Math.PI / 180;
            var fx = Math.cos(rad), fy = Math.sin(rad);

            // Vector pháp tuyến hướng về phía bóng tối (chiều tiến về phía trước của Chim Hạc)
            var nx = -ty, ny = tx;
            if (nx * fx + ny * fy < 0) {
                nx = -nx;
                ny = -ny;
            }

            ctx.save();
            ctx.globalCompositeOperation = 'screen';

            // 1. LỚP QUẦNG LỬA ĐỎ CAM NỞ RỘNG (Broad Atmospheric Fiery Bloom)
            var glowW = 42 + 14 * Math.sin(elapsed * 0.008);
            ctx.strokeStyle = 'rgba(255, 61, 0, 0.45)';
            ctx.lineWidth = glowW;
            ctx.shadowColor = '#FF3D00';
            ctx.shadowBlur = 38;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();

            // 2. LỚP DẢI LỤA PLASMA VÀNG KIM RỰC RỠ (Molten Golden Ribbon)
            var goldW = 18 + 6 * Math.sin(elapsed * 0.012);
            ctx.strokeStyle = 'rgba(255, 215, 0, 0.88)';
            ctx.lineWidth = goldW;
            ctx.shadowColor = '#FFB300';
            ctx.shadowBlur = 22;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();

            // 3. LÕI NHIỆT TRẮNG KIM SẮC BÉN XÉ MÀN ĐÊM (White-Hot Incandescent Cutting Core)
            ctx.strokeStyle = '#FFFDF5';
            ctx.lineWidth = 4.5;
            ctx.shadowColor = '#FFFFFF';
            ctx.shadowBlur = 12;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();

            // 4. ĐƯỜNG RĂNG CƯA LỬA XÉ RÁCH KHÔNG GIAN (Jagged Molten Fracture Seam)
            var numSteps = 56;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            for (var i = 1; i <= numSteps; i++) {
                var s = i / numSteps;
                var px = x1 + dx * s;
                var py = y1 + dy * s;
                var distB = Math.hypot(px - birdX, py - birdY);
                var prox = Math.max(0.35, 1.85 - distB / (W * 0.42));
                var noise = Math.sin(s * 46 + elapsed * 0.018) * 0.65 + Math.sin(s * 110 - elapsed * 0.026) * 0.35;
                var tearOffset = noise * (16 * prox);
                ctx.lineTo(px + nx * tearOffset, py + ny * tearOffset);
            }
            ctx.strokeStyle = '#FFE57F';
            ctx.lineWidth = 3.5;
            ctx.shadowColor = '#FF9100';
            ctx.shadowBlur = 16;
            ctx.stroke();

            // 5. CÁC LƯỠI LỬA MÂY PHƯƠNG ĐÔNG PHUN TRÀO XÉ MÀN ĐÊM (Oriental Cloud Flames)
            var numFlames = 20;
            for (var f = 0; f < numFlames; f++) {
                var sF = (f + 0.5) / numFlames;
                var bx = x1 + dx * sF;
                var by = y1 + dy * sF;
                var distBF = Math.hypot(bx - birdX, by - birdY);
                var proxF = Math.max(0.38, 1.85 - distBF / (W * 0.4));

                var fLen = (36 + 32 * proxF) * (0.85 + 0.3 * Math.sin(elapsed * 0.015 + f * 1.85));
                var fWidth = 8 + 6 * proxF;
                var sway = Math.sin(elapsed * 0.012 + f * 2.2) * (14 * proxF);

                var tipX = bx + nx * fLen + tx * sway;
                var tipY = by + ny * fLen + ty * sway;
                var ctrl1X = bx - tx * fWidth + nx * (fLen * 0.45);
                var ctrl1Y = by - ty * fWidth + ny * (fLen * 0.45);
                var ctrl2X = bx + tx * fWidth + nx * (fLen * 0.45);
                var ctrl2Y = by + ty * fWidth + ny * (fLen * 0.45);

                var flameGrad = ctx.createLinearGradient(bx, by, tipX, tipY);
                flameGrad.addColorStop(0, 'rgba(255, 255, 245, 0.95)');
                flameGrad.addColorStop(0.35, 'rgba(255, 215, 0, 0.85)');
                flameGrad.addColorStop(0.70, 'rgba(255, 87, 34, 0.65)');
                flameGrad.addColorStop(1, 'rgba(123, 30, 30, 0)');

                ctx.fillStyle = flameGrad;
                ctx.beginPath();
                ctx.moveTo(bx - tx * (fWidth * 0.5), by - ty * (fWidth * 0.5));
                ctx.quadraticCurveTo(ctrl1X, ctrl1Y, tipX, tipY);
                ctx.quadraticCurveTo(ctrl2X, ctrl2Y, bx + tx * (fWidth * 0.5), by + ty * (fWidth * 0.5));
                ctx.closePath();
                ctx.fill();
            }

            // 6. CUNG PLASMA RỰC LỬA NỐI TRỰC TIẾP HAI ĐẦU CÁNH VỚI ĐƯỜNG CẮT (Wing Plasma Arcs)
            var cosA = Math.cos(rad);
            var sinA = Math.sin(rad);
            var fxTip = birdX + (-180 * birdScale) * cosA - (-120 * birdScale) * sinA;
            var fyTip = birdY + (-180 * birdScale) * sinA + (-120 * birdScale) * cosA;
            var bxTip = birdX + (130 * birdScale) * cosA - (-110 * birdScale) * sinA;
            var byTip = birdY + (130 * birdScale) * sinA + (-110 * birdScale) * cosA;

            function veCungPlasmaNoiCanh(tipX, tipY, wingColor) {
                var vtx = tipX - x1, vty = tipY - y1;
                var proj = Math.max(0, Math.min(len, vtx * tx + vty * ty));
                var anchorX = x1 + tx * proj;
                var anchorY = y1 + ty * proj;

                var midX = (tipX + anchorX) * 0.5 + nx * (16 * Math.sin(elapsed * 0.02 + tipX));
                var midY = (tipY + anchorY) * 0.5 + ny * (16 * Math.sin(elapsed * 0.02 + tipY));

                ctx.strokeStyle = wingColor;
                ctx.lineWidth = 4.2 * Math.min(birdScale, 2.0);
                ctx.shadowColor = '#FFD700';
                ctx.shadowBlur = 18;
                ctx.beginPath();
                ctx.moveTo(tipX, tipY);
                ctx.quadraticCurveTo(midX, midY, anchorX, anchorY);
                ctx.stroke();

                ctx.strokeStyle = '#FFFDF5';
                ctx.lineWidth = 1.8 * Math.min(birdScale, 2.0);
                ctx.beginPath();
                ctx.moveTo(tipX, tipY);
                ctx.quadraticCurveTo(midX, midY, anchorX, anchorY);
                ctx.stroke();
            }

            veCungPlasmaNoiCanh(fxTip, fyTip, 'rgba(255, 179, 0, 0.90)');
            veCungPlasmaNoiCanh(bxTip, byTip, 'rgba(255, 107, 0, 0.90)');

            // 7. QUẦNG LỬA BÙNG CHÁY TẠI ĐIỂM GIAO NHAU GIỮA THÂN CHIM VÀ VỆT CẮT (Wing Crucible Burst)
            var crucibleR = (70 + 20 * Math.sin(elapsed * 0.01)) * Math.min(birdScale, 2.2);
            var cGrad = ctx.createRadialGradient(birdX, birdY, 4, birdX, birdY, crucibleR);
            cGrad.addColorStop(0, 'rgba(255, 255, 250, 0.95)');
            cGrad.addColorStop(0.35, 'rgba(255, 229, 127, 0.85)');
            cGrad.addColorStop(0.70, 'rgba(255, 107, 0, 0.55)');
            cGrad.addColorStop(1, 'rgba(255, 61, 0, 0)');

            ctx.fillStyle = cGrad;
            ctx.beginPath();
            ctx.arc(birdX, birdY, crucibleR, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }

        function khoiChayChuyenCanhChimLac() {
            if (chimLacDangBay || chimLacDaKetThuc) return;
            chimLacDangBay = true;
            chimLacParticles = [];
            chimLacFeathers = [];

            var layer = document.getElementById('chim-lac-transition-layer');
            var iframe = document.getElementById('chim-lac-preload-frame');
            var birdWrap = document.getElementById('chim-lac-bird-wrapper');
            chimLacCanvas = document.getElementById('chim-lac-particles-canvas');

            if (!layer || !iframe || !birdWrap || !chimLacCanvas) {
                ketThucChuyenCanhChimLac();
                return;
            }

            // Kích hoạt hiển thị khung chuyển cảnh
            layer.style.display = 'block';
            birdWrap.style.opacity = '1';

            // Thiết lập kích thước Canvas
            var W = chimLacCanvas.width = window.innerWidth;
            var H = chimLacCanvas.height = window.innerHeight;
            chimLacCtx = chimLacCanvas.getContext('2d');

            var startTime = performance.now();
            var TONG_THOI_GIAN = 2800; // Tổng thời lượng 2.8 giây theo đúng kịch bản

            function loopChuyenCanh(now) {
                var elapsed = now - startTime;
                if (elapsed > TONG_THOI_GIAN) {
                    elapsed = TONG_THOI_GIAN;
                }

                var W_cur = window.innerWidth;
                var H_cur = window.innerHeight;
                if (chimLacCanvas.width !== W_cur || chimLacCanvas.height !== H_cur) {
                    W = chimLacCanvas.width = W_cur;
                    H = chimLacCanvas.height = H_cur;
                }

                var curX, curY, curScale, curAngle, dCut;

                // =========================================================================
                // GIAI ĐOẠN 1 (0s - 1.0s): Xuất phát từ góc trên cùng bên trái màn hình
                // (x: -10%, y: -10%, scale: 0.4) bay chéo hướng về chính giữa màn hình
                // =========================================================================
                if (elapsed < 1000) {
                    var p1 = elapsed / 1000;
                    var e1 = p1 * p1 * (3 - 2 * p1); // Easing mượt mà

                    curX = (-0.10 + 0.60 * e1) * W; // -10% -> 50%
                    curY = (-0.10 + 0.60 * e1) * H; // -10% -> 50%
                    curScale = 0.40 + 1.80 * e1;    // 0.4 -> 2.2
                    curAngle = 36 + 4 * Math.sin(p1 * Math.PI);
                    dCut = 0.50 * e1;               // 0.0 -> 0.5 (vén dần đến đường chéo tâm)
                }
                // =========================================================================
                // GIAI ĐOẠN 2 (1.0s - 1.8s): Phóng to uy nghi ở giữa màn hình
                // (x: 50%, y: 50%, scale: 2.2), sải rộng đôi cánh vàng rực rỡ
                // Đường cắt chia đôi: nửa trên-trái hiện Sảnh Chính, nửa dưới-phải là index
                // =========================================================================
                else if (elapsed < 1800) {
                    var p2 = (elapsed - 1000) / 800;
                    var wave = Math.sin(p2 * Math.PI);

                    curX = (0.50 + 0.04 * p2) * W;
                    curY = (0.50 + 0.04 * p2 - 0.02 * wave) * H;
                    curScale = 2.20 + 0.12 * wave;
                    curAngle = 38 + 5 * Math.sin(p2 * Math.PI * 2);
                    dCut = 0.50 + 0.04 * p2;        // Cắt ngang đúng trục chéo chia đôi màn hình
                }
                // =========================================================================
                // GIAI ĐOẠN 3 (1.8s - 2.8s): Bay vút ra góc dưới cùng bên phải
                // (x: 115%, y: 115%), kéo đường cắt mở rộng hết 100% sang trang-chinh.html
                // =========================================================================
                else {
                    var p3 = (elapsed - 1800) / 1000;
                    var e3 = p3 * p3 * 0.7 + p3 * 0.3; // Gia tốc bay vút

                    curX = (0.54 + 0.61 * e3) * W;  // 54% -> 115%
                    curY = (0.54 + 0.61 * e3) * H;  // 54% -> 115%
                    curScale = 2.20 - 0.90 * p3;    // Thuôn dài và vút về phía chân trời
                    curAngle = 40 + 8 * p3;
                    dCut = 0.54 + 0.46 * p3;        // Mở rộng từ 54% đến 100% toàn màn hình
                }

                // Cập nhật tọa độ và kích thước Chim Lạc SVG
                birdWrap.style.transform = 'translate(' + curX.toFixed(1) + 'px, ' + curY.toFixed(1) + 'px) rotate(' + curAngle.toFixed(1) + 'deg) scale(' + curScale.toFixed(2) + ')';

                // =========================================================================
                // BÙNG LỚN HÀO QUANG ĐÔI CÁNH LỬA KHI CHIM HẠC BAY TỚI CHÍNH GIỮA MÀN HÌNH
                // =========================================================================
                var auraWings = document.getElementById('blazing-aura-wings');
                if (auraWings) {
                    var auraScale = 1.0;
                    var auraOpacity = 0.75;
                    var auraGlow = 18;

                    if (elapsed < 1000) {
                        // Giai đoạn 1: Lớn dần khi lao về phía trung tâm màn hình
                        var e1 = (elapsed / 1000) * (elapsed / 1000) * (3 - 2 * (elapsed / 1000));
                        auraScale = 1.0 + 0.35 * e1;
                        auraOpacity = 0.75 + 0.18 * e1;
                        auraGlow = 18 + 12 * e1;
                    } else if (elapsed < 1800) {
                        // Giai đoạn 2: BÙNG LỚN CỰC ĐẠI KHI Ở CHÍNH GIỮA MÀN HÌNH (GẤP 1.75 LẦN, RỰC SÁNG 100%)
                        var p2 = (elapsed - 1000) / 800;
                        var wave = Math.sin(p2 * Math.PI);
                        auraScale = 1.35 + 0.40 * wave; // Bùng nổ lên tới 1.75x
                        auraOpacity = 0.90 + 0.10 * wave; // Đạt 1.0 cực đại
                        auraGlow = 30 + 35 * wave; // Quầng hào quang tỏa rộng đến 65px
                    } else {
                        // Giai đoạn 3: Duy trì vệt lửa thần tốc vút bay
                        var p3 = (elapsed - 1800) / 1000;
                        auraScale = 1.35 - 0.25 * p3;
                        auraOpacity = 0.95 - 0.35 * p3;
                        auraGlow = 30 - 15 * p3;
                    }

                    auraWings.style.transform = 'scale(' + auraScale.toFixed(3) + ')';
                    auraWings.style.opacity = auraOpacity.toFixed(2);
                    auraWings.style.filter = 'drop-shadow(0 0 ' + auraGlow.toFixed(1) + 'px #FF6B00) drop-shadow(0 0 ' + (auraGlow * 1.8).toFixed(1) + 'px rgba(255, 61, 0, 0.75))';
                    window.__aura_peak_scale = Math.max(window.__aura_peak_scale || 0, auraScale);

                // =========================================================================
                // VÒNG HÀO QUANG TRỐNG ĐỒNG ĐÔNG SƠN RỰC LỬA XOAY TRÒN (PROGRESS 0.35 - 0.75)
                // Kèm 4 phù điêu chữ triện / chim Lạc nhỏ bay vòng quanh trước khi vút bay
                // =========================================================================
                var drumHalo = document.getElementById('lac-dong-son-solar-halo');
                var drumDisc = document.getElementById('lac-drum-rotating-disc');
                var satellitesOrbit = document.getElementById('lac-halo-satellites-orbit');

                var progress = elapsed / TONG_THOI_GIAN; // 0.0 -> 1.0

                if (drumHalo) {
                    if (progress >= 0.35 && progress <= 0.75) {
                        // Chuẩn hóa pNorm từ 0.0 đến 1.0 trong khoảng thời gian [0.35, 0.75]
                        var pNorm = (progress - 0.35) / 0.40;
                        var waveHalo = Math.sin(pNorm * Math.PI); // 0 -> 1.0 -> 0

                        var hScale = 0.50 + 0.65 * waveHalo; // 0.5x -> 1.15x
                        var hOpacity = Math.min(1.0, waveHalo * 1.08); // 0 -> 1.0 -> 0

                        drumHalo.style.opacity = hOpacity.toFixed(3);
                        drumHalo.style.transform = 'scale(' + hScale.toFixed(3) + ')';
                        window.__halo_peak_opacity = Math.max(window.__halo_peak_opacity || 0, hOpacity);

                        // Xoay mặt trống đồng theo chiều kim đồng hồ và 4 phù điêu vệ tinh ngược chiều
                        if (drumDisc) {
                            var spinDeg = (progress - 0.35) * 380;
                            drumDisc.style.transform = 'rotate(' + spinDeg.toFixed(1) + 'deg)';
                        }
                        if (satellitesOrbit) {
                            var orbitDeg = -(progress - 0.35) * 520;
                            satellitesOrbit.style.transform = 'rotate(' + orbitDeg.toFixed(1) + 'deg)';
                        }
                    } else {
                        drumHalo.style.opacity = '0';
                        drumHalo.style.transform = 'scale(0.3)';
                    }
                }

                }


                // =========================================================================
                // ĐỒNG BỘ HOÀN HẢO GIỮA ĐÔI CÁNH RỰC LỬA VỚI ĐƯỜNG CẮT CLIP-PATH CHUYỂN TRANG
                // =========================================================================
                var radA = curAngle * Math.PI / 180;
                var wingDx = -4 * curScale;
                var wingDy = -34 * curScale;
                var wingX = curX + wingDx * Math.cos(radA) - wingDy * Math.sin(radA);
                var wingY = curY + wingDx * Math.sin(radA) + wingDy * Math.cos(radA);

                var clipResult = tinhToanClipVaDauMutTheoCanh(wingX, wingY, curAngle, W, H);
                var cutEnds = clipResult.cutEnds;
                iframe.style.clipPath = clipResult.polygonStr;
                iframe.style.webkitClipPath = clipResult.polygonStr;

                // =========================================================================
                // VẼ CANVAS: DẢI LỤA ÁNH SÁNG CẮT NGANG & CÁC HẠT TÀN LỬA VÀNG KIM
                // =========================================================================
                chimLacCtx.clearRect(0, 0, W, H);

                // =========================================================================
                // KÍCH HOẠT SÓNG XUNG KÍCH HOÀNG KIM & GOD-RAYS CHIẾU XUYÊN QUA SẢI CÁNH
                // Bùng nổ khi Chim Hạc phóng to cực đại ở chính giữa màn hình (Giai đoạn 2)
                // =========================================================================
                var radAngle = curAngle * Math.PI / 180;
                var chestDx = 20 * curScale;
                var chestDy = -8 * curScale;
                var chestX = curX + chestDx * Math.cos(radAngle) - chestDy * Math.sin(radAngle);
                var chestY = curY + chestDx * Math.sin(radAngle) + chestDy * Math.cos(radAngle);

                // 1. Vẽ các tia sáng (God-rays) chiếu xuyên qua sải cánh (từ 0.95s đến 1.85s)
                var rayIntensity = 0;
                if (elapsed >= 950 && elapsed <= 1850) {
                    var pRay = (elapsed - 950) / 900;
                    rayIntensity = Math.sin(pRay * Math.PI); // Đỉnh cực đại 1.0 ở chính giữa màn hình
                    window.__godrays_peak_intensity = Math.max(window.__godrays_peak_intensity || 0, rayIntensity);
                }
                if (rayIntensity > 0.01) {
                    veTiaSangGodRays(chimLacCtx, chestX, chestY, rayIntensity, curAngle, W, H);
                }

                // 2. Vẽ Sóng Xung Kích Hoàng Kim (Golden Shockwave Ring) bung nở ra toàn màn hình
                if (elapsed >= 1200 && elapsed <= 1850) {
                    var sProgress = (elapsed - 1200) / 650; // 0.0 -> 1.0
                    window.__shockwave_active = true;
                    veSongXungKichHoangKim(chimLacCtx, chestX, chestY, sProgress, W, H);
                }


                // =========================================================================
                // VẼ VỆT CẮT LỬA HOÀNG KIM (BLAZING TEAR LINE) BÁM SÁT THEO SẢI CÁNH CHIM HẠC
                // Xé màn đêm chia tách index.html để lộ giao diện trang-chinh.html bên dưới
                // =========================================================================
                if (clipResult.cutEnds) {
                    veVetCatLuaHoangKim(chimLacCtx, clipResult.cutEnds, curX, curY, curAngle, curScale, elapsed, W, H);
                    window.__tear_line_active = true;

                    // Bắn các đốm tàn lửa nóng chảy dọc theo vệt cắt xé toạc màn đêm
                    if (Math.random() < 0.85) {
                        for (var e = 0; e < 3; e++) {
                            var sE = Math.random();
                            var emX = clipResult.cutEnds.x1 + (clipResult.cutEnds.x2 - clipResult.cutEnds.x1) * sE;
                            var emY = clipResult.cutEnds.y1 + (clipResult.cutEnds.y2 - clipResult.cutEnds.y1) * sE;
                            var radTear = curAngle * Math.PI / 180;
                            var fxTear = Math.cos(radTear), fyTear = Math.sin(radTear);
                            chimLacParticles.push({
                                x: emX,
                                y: emY,
                                vx: (Math.random() - 0.5) * 4 + fxTear * (Math.random() * 3 + 1),
                                vy: (Math.random() - 0.5) * 4 + fyTear * (Math.random() * 3 + 1),
                                size: Math.random() * 4 + 2,
                                life: Math.floor(Math.random() * 22 + 20),
                                maxLife: 42,
                                color: Math.random() < 0.35 ? '#FFFDF5' : (Math.random() < 0.7 ? '#FFD700' : '#FF5722'),
                                isGoldDust: true,
                                sparkle: Math.random() * Math.PI,
                                sparkleSpeed: 0.2
                            });
                        }
                    }
                }

                // =========================================================================
                // HỆ THỐNG HẠT (PARTICLE SYSTEM):
                // (1) 120 hạt tàn lửa đỏ cam & bụi vàng bắn tung tóe theo lực quán tính gió
                // (2) 15 chiếc lông vũ ánh sáng vàng kim nhỏ rơi lơ lửng, xoay nhẹ rồi tan biến
                // =========================================================================

                // (1) Bắn các hạt tàn lửa đỏ cam & bụi vàng từ mép sau hai cánh và bộ đuôi
                taoHatTanLuaMepCanh(curX, curY, curAngle, curScale);

                // Phát hạt tia lửa lấp lánh dọc theo đường cắt chia đôi màn hình
                if (cutEnds && Math.random() < 0.6) {
                    var rPos = Math.random();
                    var lineSparksX = cutEnds.x1 + (cutEnds.x2 - cutEnds.x1) * rPos;
                    var lineSparksY = cutEnds.y1 + (cutEnds.y2 - cutEnds.y1) * rPos;
                    taoHatTanLua(lineSparksX, lineSparksY, (Math.random() - 0.5) * 1.8, (Math.random() - 0.5) * 1.8, true);
                }

                // (2) Thả 15 chiếc lông vũ ánh sáng vàng kim nhỏ rơi lơ lửng dọc quỹ đạo đường bay
                if (chimLacFeathers.length < 15 && Math.random() < 0.85) {
                    taoLongVuVangKim(curX, curY, curAngle, curScale);
                }

                // -------------------------------------------------------------------------
                // CẬP NHẬT & KẾT XUẤT LOẠI 1: 120 HẠT TÀN LỬA ĐỎ CAM & BỤI VÀNG
                // -------------------------------------------------------------------------
                chimLacCtx.save();
                for (var idx = chimLacParticles.length - 1; idx >= 0; idx--) {
                    var pt = chimLacParticles[idx];
                    pt.x += pt.vx;
                    pt.y += pt.vy;
                    pt.vy += 0.038; // Trọng lực nhẹ
                    pt.vx *= 0.985; // Ma sát không khí
                    pt.vy *= 0.985;
                    pt.sparkle += pt.sparkleSpeed;
                    pt.life--;

                    if (pt.life <= 0) {
                        chimLacParticles.splice(idx, 1);
                        continue;
                    }

                    var progress = pt.life / pt.maxLife;
                    var alpha = progress;
                    var twinkle = 0.85 + 0.15 * Math.sin(pt.sparkle);

                    chimLacCtx.save();
                    chimLacCtx.globalAlpha = Math.max(0, Math.min(1, alpha * twinkle));

                    if (pt.isGoldDust) {
                        // Bụi vàng kim lấp lánh
                        chimLacCtx.fillStyle = pt.color;
                        chimLacCtx.shadowColor = '#FFD700';
                        chimLacCtx.shadowBlur = 8;
                        chimLacCtx.beginPath();
                        chimLacCtx.arc(pt.x, pt.y, Math.max(0.6, pt.size * alpha), 0, Math.PI * 2);
                        chimLacCtx.fill();
                    } else {
                        // Tàn lửa đỏ cam phát sáng quầng nhiệt
                        var radGrad = chimLacCtx.createRadialGradient(pt.x, pt.y, 0, pt.x, pt.y, pt.size * 1.4);
                        radGrad.addColorStop(0, '#FFFFFF');
                        radGrad.addColorStop(0.3, pt.color);
                        radGrad.addColorStop(1, 'rgba(216, 38, 0, 0)');
                        chimLacCtx.fillStyle = radGrad;
                        chimLacCtx.shadowColor = '#FF5722';
                        chimLacCtx.shadowBlur = 12;
                        chimLacCtx.beginPath();
                        chimLacCtx.arc(pt.x, pt.y, Math.max(0.8, pt.size * 1.4 * alpha), 0, Math.PI * 2);
                        chimLacCtx.fill();
                    }
                    chimLacCtx.restore();
                }
                chimLacCtx.restore();

                // -------------------------------------------------------------------------
                // CẬP NHẬT & KẾT XUẤT LOẠI 2: 15 CHIẾC LÔNG VŨ ÁNH SÁNG VÀNG KIM NHỎ
                // Rơi lơ lửng, chao liệng xoay nhẹ trong gió rồi tan biến thành đốm lửa
                // -------------------------------------------------------------------------
                chimLacCtx.save();
                for (var fIdx = chimLacFeathers.length - 1; fIdx >= 0; fIdx--) {
                    var f = chimLacFeathers[fIdx];

                    // Chuyển động chao liệng khí động học bồng bềnh
                    f.wobble += f.wobbleSpeed;
                    f.x += f.vx + Math.sin(f.wobble) * f.wobbleAmp;
                    f.y += f.vy;
                    f.angle += Math.sin(f.wobble) * f.rotSpeed;
                    f.life--;

                    // Khi hết vòng đời -> Tan biến thành chùm đốm lửa rực rỡ
                    if (f.life <= 0) {
                        tanBienThanhDomLua(f.x, f.y);
                        chimLacFeathers.splice(fIdx, 1);
                        continue;
                    }

                    // Vẽ chiếc lông vũ vàng kim
                    veChiTietLongVuVang(chimLacCtx, f);
                }
                chimLacCtx.restore();

                // Tiếp tục vòng lặp hoặc kết thúc khi chạm mốc 2.8s
                if (elapsed < TONG_THOI_GIAN) {
                    animChimLacId = requestAnimationFrame(loopChuyenCanh);
                } else {
                    ketThucChuyenCanhChimLac();
                }
            }

            animChimLacId = requestAnimationFrame(loopChuyenCanh);
        }

        /**
         * Kết thúc chuyển cảnh và điều hướng sang trang-chinh.html
         */
        function ketThucChuyenCanhChimLac(event) {
            if (event) event.stopPropagation();
            if (chimLacDaKetThuc) return;
            chimLacDaKetThuc = true;
            videoDaKetThuc = true;
            if (animChimLacId) cancelAnimationFrame(animChimLacId);

            // [BẢO TOÀN NHẠC NỀN] Lưu chính xác tiến trình phát nhạc vào localStorage
            var nhac = document.getElementById('bg-music');
            if (nhac && !nhac.paused) {
                localStorage.setItem('audioTime', nhac.currentTime);
                localStorage.setItem('nhacDangPhat', 'true');
            }

            // Đánh dấu đã qua màn chuyển cảnh Chim Lạc thành công
            sessionStorage.setItem('daXemChuyenCanh', 'true');
            sessionStorage.setItem('vuaXemChimLac', 'true');

            // Đảm bảo clip-path mở 100% toàn màn hình
            var iframe = document.getElementById('chim-lac-preload-frame');
            if (iframe) {
                iframe.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
                iframe.style.webkitClipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
            }

            // Điều hướng sang trang chính mượt mà
            window.location.replace(window.TRANG_DICH || TRANG_DICH);
        }

        // Tương thích ngược với lời gọi ketThucChuyenCanh cũ
        window.ketThucChuyenCanh = ketThucChuyenCanhChimLac;

        /**
         * Xử lý khi người dùng nhấn nút "⚔️ BẮT ĐẦU HÀNH TRÌNH"
         */
        function batDauHanhTrinh(event) {
            if (event) event.preventDefault();

            // [BẢO TOÀN NHẠC NỀN] Nhạc tiếp tục phát thông suốt khi Chim Lạc bay qua
            var nhacNen = document.getElementById('bg-music');
            if (nhacNen && nhacNen.paused && localStorage.getItem('nhacDangPhat') !== 'false') {
                nhacNen.play().then(function() {
                    dangPhatNhac = true;
                    var bars = document.getElementById('sound-bars');
                    if (bars) bars.classList.add('playing');
                    var text = document.getElementById('audio-text');
                    if (text) text.textContent = 'Đang phát';
                    localStorage.setItem('nhacDangPhat', 'true');
                }).catch(function(e) {
                    console.warn('Không thể tự động phát nhạc:', e);
                });
            }

            // Bắt đầu chuyến bay Chim Lạc vén màn lịch sử
            khoiChayChuyenCanhChimLac();
        }

        // Tải trước tài nguyên khi trang index vừa sẵn sàng
        window.addEventListener('DOMContentLoaded', function() {
            var ifr = document.getElementById('chim-lac-preload-frame');
            if (ifr && !ifr.src) {
                ifr.src = 'trang-chinh.html?chuyen_canh=chim_lac';
            }
        });

        // Phục hồi trạng thái nếu người dùng quay lại từ trang chính bằng nút Back
        window.addEventListener('pageshow', function(event) {
            chimLacDangBay = false;
            chimLacDaKetThuc = false;
            videoDaKetThuc = false;
