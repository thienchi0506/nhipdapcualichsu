        /**
         * Hàm tính toán đa giác clip-path theo tiến độ vén màn d (0.0 đến 1.0)
         * - d = 0.0: 0% hiển thị (chưa vén)
         * - d = 0.5: đường cắt chéo đi qua tâm nối góc trên-phải (100% 0) với góc dưới-trái (0 100%)
         * - d = 1.0: 100% hiển thị (vén trọn vẹn toàn màn hình)
         */
        function tinhToanClipPolygon(d) {
            if (d <= 0.001) {
                return 'polygon(0 0, 0 0, 0 0, 0 0)';
            }
            if (d <= 0.5) {
                var k = d * 2; // Từ 0 đến 1
                var pX = (k * 100).toFixed(2);
                var pY = (k * 100).toFixed(2);
                return 'polygon(0 0, ' + pX + '% 0, 0 ' + pY + '%)';
            } else {
                var m = (d - 0.5) * 2; // Từ 0 đến 1
                var mY = (m * 100).toFixed(2);
                var mX = (m * 100).toFixed(2);
                return 'polygon(0 0, 100% 0, 100% ' + mY + '%, ' + mX + '% 100%, 0 100%)';
            }
        }

        /**
