        // 16 điểm mép sau hai cánh và bộ đuôi trong hệ tọa độ chuẩn Chim Lạc
        var CHIM_LAC_EMITTERS = [
            [-158.0, -80.8], [-136.8, -61.6], [-112.8, -42.0], [-87.2, -22.4], [-60.8, -4.0], [-56.0, -16.0], // Mép sau cánh chính
