<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dấu Chân Lịch Sử — Hành Trình Bốn Ngàn Năm</title>

    <!-- Font chữ từ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">

    <style>
        /* ====================================================== */
        /*  RESET & BIẾN MÀU                                       */
        /* ====================================================== */
        :root {
            --vang-dong:     #D4AF37;
            --do-ba-trau:    #7B1E1E;
            --nau-den:       #2C1E18;
            --nen-toi:       #1E1815;
            --chu-sang:      #E8D5B0;
            --vang-nhat:     #FFF3D6;
        }

        *, *::before, *::after {
            margin: 0; padding: 0; box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow: hidden; /* Khoá cuộn - trang splash fullscreen */
        }

        body {
            font-family: 'Noto Serif', 'Times New Roman', serif;
            color: var(--chu-sang);
            background: var(--nen-toi);
        }

        /* ====================================================== */
        /*  NỀN TOÀN MÀN HÌNH VỚI ẢNH LỊCH SỬ                    */
        /* ====================================================== */

        .splash {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            z-index: 1;

            /* Ảnh nền: Chiến thắng Điện Biên Phủ */
            background:
                url('anh-nen.jpg') center 40% / cover no-repeat;
            background-color: var(--nen-toi);
        }

        /* Canvas hoạt họa chuyển động sống động cho nhân vật (tay chân, cờ, vũ khí) */
        .splash__animated-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0;
            transition: opacity 0.8s ease-in-out;
        }

        .splash__animated-canvas.loaded {
            opacity: 1;
        }

        /* Video hoạt họa AI nền (hero-loop.mp4) */
        #hero-bg-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 42%;
            pointer-events: none;
            z-index: 0;
            transition: opacity 0.8s ease-in-out;
        }

        /* ====================================================== */
        /*  LỚP OVERLAY TỐI + HIỆU ỨNG VIGNETTE                  */
        /* ====================================================== */

        .splash__overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(
                    180deg,
                    rgba(30, 24, 21, 0.80) 0%,
                    rgba(123, 30, 30, 0.40) 30%,
                    rgba(44, 30, 24, 0.35) 55%,
                    rgba(30, 24, 21, 0.85) 100%
                );
            z-index: 1;
        }

        /* Hiệu ứng Vignette (tối 4 góc) tạo chiều sâu */
        .splash__vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(
                ellipse at center,
                transparent 50%,
                rgba(10, 8, 6, 0.6) 100%
            );
            z-index: 2;
            pointer-events: none;
        }

        /* ====================================================== */
        /*  HIỆU ỨNG HẠT LỬA BAY (Fire Sparks)                   */
        /* ====================================================== */

        .particles-container {
            position: absolute;
            inset: 0;
            z-index: 3;
            pointer-events: none;
            overflow: hidden;
        }

        .spark {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            animation: sparkRise linear infinite;
        }

        @keyframes sparkRise {
            0% {
                opacity: 0;
                transform: translateY(0) scale(1);
            }
            10% {
                opacity: 1;
            }
            80% {
                opacity: 0.6;
            }
            100% {
                opacity: 0;
                transform: translateY(-100vh) scale(0.3);
            }
        }

        /* ====================================================== */
        /*  HIỆU ỨNG SƯƠNG MÙ (Fog)                              */
        /* ====================================================== */

        .fog {
            position: absolute;
            bottom: 0;
            left: -10%;
            width: 120%;
            height: 30%;
            z-index: 3;
            pointer-events: none;
            background: linear-gradient(
                0deg,
                rgba(30, 24, 21, 0.7) 0%,
                transparent 100%
            );
            animation: fogDrift 8s ease-in-out infinite alternate;
        }

        @keyframes fogDrift {
            0%   { transform: translateX(-3%); opacity: 0.7; }
            100% { transform: translateX(3%);  opacity: 0.5; }
        }

        /* ====================================================== */
        /*  VIỀN HOA VĂN TRANG TRÍ (trên & dưới)                  */
        /* ====================================================== */

        .ornament-top, .ornament-bottom {
            position: absolute;
            left: 0; right: 0;
            height: 6px;
            z-index: 10;
            background:
                linear-gradient(90deg,
                    transparent 0%,
                    var(--vang-dong) 15%,
                    var(--vang-dong) 50%,
                    var(--vang-dong) 85%,
                    transparent 100%
                );
            opacity: 0.6;
        }

        .ornament-top    { top: 0; }
        .ornament-bottom { bottom: 0; }

        .side-ornament {
            position: absolute;
            top: 10%; bottom: 10%;
            width: 3px;
            z-index: 10;
            pointer-events: none;
        }
        .side-ornament--left  { left: 20px; }
        .side-ornament--right { right: 20px; }

        .side-ornament::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                repeating-linear-gradient(
                    180deg,
                    var(--vang-dong) 0px,
                    var(--vang-dong) 8px,
                    transparent 8px,
                    transparent 20px
                );
            opacity: 0.25;
        }

        /* ====================================================== */
        /*  NỘI DUNG CHÍNH - TIÊU ĐỀ & CTA                       */
        /* ====================================================== */

        .splash__content {
            position: relative;
            z-index: 5;
            max-width: 800px;
            padding: 20px;
        }

        .emblem {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 15px;
            animation: emblemPulse 2s ease-in-out infinite;
            filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.5));
        }

        @keyframes emblemPulse {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(212,175,55,0.5)); }
            50%      { transform: scale(1.08); filter: drop-shadow(0 0 25px rgba(212,175,55,0.8)); }
        }

        .splash__quote {
            font-size: clamp(0.85rem, 2vw, 1rem);
            color: rgba(232, 213, 176, 0.7);
            font-style: italic;
            margin-bottom: 20px;
            letter-spacing: 1px;
            animation: fadeInSlow 0.9s ease-out 0.15s both;
        }

        .splash__line {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
            animation: fadeInSlow 0.9s ease-out 0.3s both;
        }

        .splash__line span {
            display: inline-block;
            width: 60px;
            height: 1.5px;
            background: linear-gradient(90deg, transparent, var(--vang-dong), transparent);
        }

        .splash__line em {
            color: var(--vang-dong);
            font-size: 1.2rem;
        }

        .splash__title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.2rem, 7vw, 4.5rem);
            font-weight: 900;
            color: var(--vang-dong);
            line-height: 1.15;
            letter-spacing: 5px;
            text-shadow:
                0 0 30px rgba(212, 175, 55, 0.4),
                2px 4px 8px rgba(0, 0, 0, 0.7);
            margin-bottom: 8px;
            animation: titleReveal 0.9s ease-out 0.45s both;
        }

        @keyframes titleReveal {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.95);
                letter-spacing: 15px;
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                letter-spacing: 5px;
            }
        }

        .splash__subtitle {
            font-size: clamp(0.95rem, 2.5vw, 1.3rem);
            color: var(--chu-sang);
            margin-bottom: 30px;
            letter-spacing: 3px;
            animation: fadeInSlow 0.9s ease-out 0.65s both;
        }

        .splash__desc {
            font-size: clamp(0.9rem, 1.8vw, 1.05rem);
            color: rgba(212, 196, 168, 0.85);
            line-height: 1.9;
            max-width: 600px;
            margin: 0 auto 35px;
            animation: fadeInSlow 0.9s ease-out 0.85s both;
        }

        .splash__desc .highlight {
            color: var(--vang-dong);
            font-weight: 700;
        }

        @keyframes fadeInSlow {
            from { opacity: 0; transform: translateY(15px); }
            to   { opacity: 1; transform: translateY(0);    }
        }

        /* ====================================================== */
        /*  DÒNG CHỮ CÂU NÓI NỔI TIẾNG                           */
        /* ====================================================== */

        .famous-quotes {
            position: relative;
            height: 28px;
            overflow: hidden;
            margin-bottom: 35px;
            animation: fadeInSlow 0.9s ease-out 1.0s both;
        }

        .famous-quotes__track {
            animation: quoteScroll 12s ease-in-out infinite;
        }

        .famous-quotes__item {
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(0.8rem, 1.6vw, 0.92rem);
            color: rgba(212, 175, 55, 0.7);
            font-style: italic;
            white-space: nowrap;
        }

        @keyframes quoteScroll {
            0%, 22%   { transform: translateY(0); }
            25%, 47%  { transform: translateY(-28px); }
            50%, 72%  { transform: translateY(-56px); }
            75%, 97%  { transform: translateY(-84px); }
            100%      { transform: translateY(-112px); }
        }

        /* ====================================================== */
        /*  NÚT "BẮT ĐẦU HÀNH TRÌNH"                             */
        /* ====================================================== */

        .cta-wrapper {
            animation: fadeInSlow 0.9s ease-out 1.2s both;
        }

        .splash__cta {
            position: relative;
            display: inline-block;
            padding: 16px 48px;
            background: linear-gradient(135deg, var(--do-ba-trau), #5A1515);
            color: var(--vang-dong);
            border: 2px solid var(--vang-dong);
            border-radius: 50px;
            font-family: 'Noto Serif', serif;
            font-size: clamp(1rem, 2.5vw, 1.15rem);
            font-weight: 700;
            letter-spacing: 2px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.4s ease;
            overflow: hidden;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
        }

        .splash__cta::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(212, 175, 55, 0.25),
                transparent
            );
            animation: shimmer 2s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%   { left: -100%; }
            100% { left: 200%; }
        }

        .splash__cta::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50px;
            border: 1px solid var(--vang-dong);
            opacity: 0;
            animation: ctaPulseRing 1.8s ease-in-out infinite;
        }

        @keyframes ctaPulseRing {
            0%, 100% { opacity: 0; transform: scale(1); }
            50%      { opacity: 0.5; transform: scale(1.05); }
        }

        .splash__cta:hover {
            background: linear-gradient(135deg, #9B3030, var(--do-ba-trau));
            transform: translateY(-4px) scale(1.03);
            box-shadow:
                0 8px 30px rgba(212, 175, 55, 0.35),
                0 0 40px rgba(123, 30, 30, 0.3);
            border-color: var(--vang-nhat);
        }

        .splash__cta:active {
            transform: translateY(-1px) scale(1);
        }

        .cta-hint {
            display: block;
            margin-top: 12px;
            font-size: 0.75rem;
            color: rgba(184, 168, 138, 0.5);
            letter-spacing: 1px;
            animation: fadeInSlow 0.9s ease-out 1.35s both;
        }

        /* ====================================================== */
        /*  TIMELINE NHỎ Ở CẠNH PHẢI                             */
        /* ====================================================== */

        .timeline-strip {
            position: absolute;
            right: 35px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 5;
            display: flex;
            flex-direction: column;
            gap: 22px;
            animation: fadeInSlow 0.9s ease-out 1.3s both;
        }

        .timeline-strip__dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 1.5px solid var(--vang-dong);
            background: transparent;
            position: relative;
            cursor: default;
            transition: all 0.3s ease;
        }

        .timeline-strip__dot::after {
            content: attr(data-year);
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.65rem;
            color: rgba(212, 175, 55, 0.5);
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .timeline-strip__dot:hover {
            background: var(--vang-dong);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
        }

        .timeline-strip__dot:hover::after {
            opacity: 1;
        }

        .timeline-strip__line {
            width: 1px;
            height: 18px;
            background: linear-gradient(180deg, rgba(212,175,55,0.3), rgba(212,175,55,0.1));
            margin: 0 auto;
        }

        /* ====================================================== */
        /*  ÂM THANH NHỎ GÓC DƯỚI TRÁI                            */
        /* ====================================================== */

        .audio-badge {
            position: absolute;
            bottom: 25px;
            left: 25px;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(44, 30, 24, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            animation: fadeInSlow 0.9s ease-out 1.45s both;
        }

        .audio-badge:hover {
            background: rgba(44, 30, 24, 0.9);
            border-color: var(--vang-dong);
        }

        .audio-badge__icon {
            font-size: 1.1rem;
        }

        .audio-badge__text {
            font-size: 0.75rem;
            color: var(--chu-sang);
        }

        .sound-bars {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            height: 14px;
        }

        .sound-bars span {
            display: block;
            width: 2.5px;
            background: var(--vang-dong);
            border-radius: 1px;
            animation: none;
        }

        .sound-bars.playing span {
            animation: barJump 0.6s ease-in-out infinite alternate;
        }

        .sound-bars span:nth-child(1) { height: 4px; animation-delay: 0s; }
        .sound-bars span:nth-child(2) { height: 8px; animation-delay: 0.1s; }
        .sound-bars span:nth-child(3) { height: 5px; animation-delay: 0.2s; }
        .sound-bars span:nth-child(4) { height: 10px; animation-delay: 0.15s; }
        .sound-bars span:nth-child(5) { height: 6px; animation-delay: 0.25s; }

        @keyframes barJump {
            0%   { height: 3px; }
            100% { height: 14px; }
        }

        /* ====================================================== */
        /*  HIỆU ỨNG CHUYỂN CẢNH VIDEO (Cinematic Video Transition)*/
        /* ========================================================================== */
        /*  HIỆU ỨNG CHUYỂN CẢNH CÁNH CHIM LẠC VÉN MÀN LỊCH SỬ (SVG & CLIP-PATH WIPE) */
        /* ========================================================================== */

        #chim-lac-transition-layer {
            position: fixed;
            inset: 0;
            z-index: 99990;
            overflow: hidden;
            pointer-events: none;
            display: none;
        }

        #chim-lac-preload-frame {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            border: none;
            z-index: 99991;
            pointer-events: none;
            clip-path: polygon(0 0, 0 0, 0 0, 0 0);
            will-change: clip-path;
            background: #0c0907;
        }

        #chim-lac-particles-canvas {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 99995;
        }

        #chim-lac-bird-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 480px;
            height: 320px;
            margin-left: -240px;
            margin-top: -160px;
            pointer-events: none;
            z-index: 99998;
            will-change: transform;
            opacity: 0;
            filter: drop-shadow(0 0 18px #FFD700) drop-shadow(0 0 40px #D4AF37) drop-shadow(0 0 70px rgba(255, 215, 0, 0.8));
        }

        /* ========================================================================= */
        /* CHUYỂN ĐỘNG VỖ CÁNH THEO KHỚP GIẢI PHẪU 3D & LỰC NÂNG KHÍ ĐỘNG HỌC       */
        /* Khớp bả vai chính xác, độ trễ pha bầu cánh - đầu lông, thân chim nhấp nhô */
        /* ========================================================================= */

        /* 1. CÁNH CHÍNH (FOREGROUND WING) - KHỚP BẢ VAI (520px, 340px) */
        #bird-wing-front, .lac-anim-wing-main {
            transform-origin: 520px 340px;
            transform-box: view-box;
            animation: flapMasterWingMain 1.08s ease-in-out infinite;
        }

        /* 2. CÁNH PHỤ (BACKGROUND WING) - KHỚP BẢ VAI SAU (660px, 290px) */
        #bird-wing-back, .lac-anim-wing-sub {
            transform-origin: 660px 290px;
            transform-box: view-box;
            animation: flapMasterWingSub 1.08s ease-in-out infinite;
        }

        /* 3. ĐỘ TRỄ PHA KHÍ ĐỘNG HỌC CÁC ĐẦU LÔNG VŨ CÁNH CHÍNH */
        #lac-front-primary-feathers-fan, .lac-anim-feathers-fan {
            transform-origin: 460px 330px;
            transform-box: view-box;
            animation: flapPrimaryFeathersFlex 1.08s ease-in-out infinite;
        }

        /* 4. ĐỘ TRỄ PHA KHÍ ĐỘNG HỌC CÁC ĐẦU LÔNG VŨ CÁNH PHỤ */
        #lac-back-feathers-fan, .lac-anim-back-feathers-fan {
            transform-origin: 670px 300px;
            transform-box: view-box;
            animation: flapBackFeathersFlex 1.08s ease-in-out infinite;
        }

        /* 5. THÂN CHIM NHẤP NHÔ THEO LỰC NÂNG KHÍ ĐỘNG HỌC (AERODYNAMIC LIFT BOBBING) */
        #bird-torso-legs, .lac-anim-torso-bob {
            transform-origin: 550px 420px;
            transform-box: view-box;
            animation: flapTorsoLiftBob 1.08s ease-in-out infinite;
        }

        /* 6. ĐẦU & CỔ CHIM ỔN ĐỊNH TIỀN ĐÌNH (HEAD/NECK VESTIBULAR STABILIZATION) */
        #bird-head-neck, .lac-anim-head-neck {
            transform-origin: 620px 370px;
            transform-box: view-box;
            animation: flapHeadNeckStabilize 1.08s ease-in-out infinite;
        }

        /* 7. HÀO QUANG CÁNH LỬA ĐỒNG BỘ VỖ CÁNH 3D */
        #lac-aura-front-mantle, #lac-aura-front-feathers {
            transform-origin: 520px 340px;
            animation: flapMasterWingMain 1.08s ease-in-out infinite;
        }
        #lac-aura-back-mantle, #lac-aura-back-feathers {
            transform-origin: 660px 290px;
            animation: flapMasterWingSub 1.08s ease-in-out infinite;
        }

        /* ------------------------------------------------------------------------- */
        /* KEYFRAMES KHỚP GIẢI PHẪU & KHÍ ĐỘNG HỌC (KHÔNG DÙNG SCALE CO GIÃN ĐƠN ĐIỆU) */
        /* ------------------------------------------------------------------------- */

        @keyframes flapMasterWingMain {
            0%, 100% {
                transform: rotate(-18deg); /* Đỉnh hành trình nâng cánh (Upstroke Apex) */
            }
            35% {
                transform: rotate(0deg);   /* Giữa hành trình đập cánh xuống sinh công (Mid-Downstroke) */
            }
            50% {
                transform: rotate(15deg);  /* Đáy hành trình đập cánh sinh lực nâng cực đại (Bottom Downstroke) */
            }
            85% {
                transform: rotate(-2deg);  /* Nâng cánh thu hồi chuẩn bị chu kỳ mới */
            }
        }

        @keyframes flapMasterWingSub {
            0%, 100% {
                transform: rotate(14deg);
            }
            35% {
                transform: rotate(-2deg);
            }
            50% {
                transform: rotate(-13deg);
            }
            85% {
                transform: rotate(2deg);
            }
        }

        /* Khi vai đập xuống, lực cản không khí uốn cong đầu lông vểnh ngược lên;
           Khi vai nâng lên, đầu lông rủ xuống lướt gió mềm mại */
        @keyframes flapPrimaryFeathersFlex {
            0%, 100% {
                transform: rotate(8deg);   /* Đầu lông rủ xuống ở đỉnh hành trình */
            }
            30% {
                transform: rotate(-11deg); /* Đầu lông uốn cong vểnh lên mạnh nhất do lực cản gió */
            }
            50% {
                transform: rotate(-4deg);  /* Giữ độ cong ở đáy hành trình */
            }
            75% {
                transform: rotate(9deg);   /* Rủ xuống để lướt êm khi thu cánh lên */
            }
        }

        @keyframes flapBackFeathersFlex {
            0%, 100% {
                transform: rotate(-7deg);
            }
            30% {
                transform: rotate(9deg);
            }
            50% {
                transform: rotate(3deg);
            }
            75% {
                transform: rotate(-8deg);
            }
        }

        /* Thân chim nhấp nhô theo lực nâng: Khi cánh đập xuống (50%), thân chim được nâng bổng lên (-9px);
           Khi cánh nâng lên (0% / 100%), thân chim chìm nhẹ xuống (+5px) */
        @keyframes flapTorsoLiftBob {
            0%, 100% {
                transform: translateY(5px) rotate(-1.0deg);
            }
            50% {
                transform: translateY(-9px) rotate(1.4deg);
            }
        }

        @keyframes flapHeadNeckStabilize {
            0%, 100% {
                transform: translateY(-2px) rotate(0.8deg);
            }
            50% {
                transform: translateY(3px) rotate(-1.2deg);
            }
        }

        .lac-anim-tail {
            animation: undulateMasterTail 0.85s ease-in-out infinite alternate;
        }

        /* Animation rung rinh lướt gió tinh tế cho Đôi chân hạc dài */
        @keyframes streamMasterLegs {
            0%   { transform: rotate(0deg); }
            50%  { transform: rotate(-1.5deg) translateY(-1.5px); }
            100% { transform: rotate(1.2deg) translateY(1px); }
        }

        .lac-anim-legs {
            transform-origin: 468px 496px;
            animation: streamMasterLegs 0.85s ease-in-out infinite alternate;
        }

        /* ====================================================== */

        .corner-badge {
            position: absolute;
            bottom: 25px;
            right: 25px;
            z-index: 10;
            font-size: 0.7rem;
            color: rgba(184, 168, 138, 0.35);
            letter-spacing: 1px;
            animation: fadeInSlow 0.9s ease-out 1.45s both;
        }

        /* ====================================================== */
        /*  RESPONSIVE                                             */
        /* ====================================================== */

        @media (max-width: 768px) {
            .timeline-strip { display: none; }
            .side-ornament  { display: none; }

            .splash__title {
                letter-spacing: 3px;
            }

            .splash__cta {
                padding: 14px 36px;
                font-size: 0.95rem;
            }

            .corner-badge { display: none; }
        }

        @media (max-width: 600px) {
            .page-transition__hint {
                bottom: 18px;
                font-size: 0.72rem;
                white-space: normal;
                width: 90%;
            }
        }

        @media (max-width: 480px) {
            .famous-quotes { display: none; }

            .audio-badge {
                bottom: 15px;
                left: 15px;
                padding: 6px 12px;
            }
        }
    
        /* ========================================================================= */
        /* HIỆU ỨNG RÃNH HOA VĂN PHÁT SÁNG RỰC LỬA - DÒNG KIM LOẠI NÓNG CHẢY ĐÔNG SƠN */
        /* stroke-dasharray & stroke-dashoffset kết hợp filter: drop-shadow(0 0 8px #FF6B00) */
        /* ========================================================================= */
        .lac-molten-stream {
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            filter: drop-shadow(0 0 8px #FF6B00) drop-shadow(0 0 3px #FFE57F);
            pointer-events: none;
        }

        /* 1. Luồng kim loại nóng chảy trên Mặt Trời 12 tia (Bầu Cánh) */
        .lac-molten-sun-star {
            stroke: url(#moltenFireStreamGrad);
            stroke-width: 1.8px;
            stroke-dasharray: 14 20;
            animation: lacMoltenStarFlow 2.6s linear infinite;
        }
        .lac-molten-sun-ray {
            stroke: #FFFDF5;
            stroke-width: 1.4px;
            stroke-dasharray: 8 12;
            animation: lacMoltenRayPulse 1.8s ease-in-out infinite alternate;
        }
        .lac-molten-sun-ring {
            stroke: url(#moltenFireStreamGrad);
            stroke-width: 1.6px;
            stroke-dasharray: 18 24;
            animation: lacMoltenRingRotateCW 3.4s linear infinite;
        }
        .lac-molten-sun-ring-ccw {
            stroke: #FFD700;
            stroke-width: 1.4px;
            stroke-dasharray: 14 20;
            animation: lacMoltenRingRotateCCW 2.8s linear infinite;
        }

        /* 2. Luồng kim loại nóng chảy trên 16 vòng xoắn ốc lông cánh (Covert Scales) */
        .lac-molten-spiral {
            stroke: url(#moltenFireStreamGrad);
            stroke-width: 1.8px;
            stroke-dasharray: 9 14;
            animation: lacMoltenSpiralInward 2.2s linear infinite;
        }

        /* 3. Luồng kim loại nóng chảy trên phù điêu xoắn ốc kép đùi/thân */
        .lac-molten-double-spiral-1 {
            stroke: url(#moltenFireStreamGrad);
            stroke-width: 2.4px;
            stroke-dasharray: 18 26;
            animation: lacMoltenSpiralInward 2.5s linear infinite;
        }
        .lac-molten-double-spiral-2 {
            stroke: #FFE57F;
            stroke-width: 2.2px;
            stroke-dasharray: 16 24;
            animation: lacMoltenSpiralOutward 2.5s linear infinite;
        }
        .lac-molten-thigh-ring {
            stroke: #FF6B00;
            stroke-width: 1.6px;
            stroke-dasharray: 15 20;
            animation: lacMoltenRingRotateCW 3.0s linear infinite;
        }

        /* 4. Luồng kim loại nóng chảy trên Giáp Ngực (Breast Gorget) */
        .lac-molten-gorget-meander {
            stroke: url(#moltenFireStreamGrad);
            stroke-width: 2.0px;
            stroke-dasharray: 16 22;
            animation: lacMoltenMeanderRun 3.2s linear infinite;
        }
        .lac-molten-gorget-arc {
            stroke: #FFD700;
            stroke-width: 1.8px;
            stroke-dasharray: 14 20;
            animation: lacMoltenRingRotateCW 2.9s linear infinite;
        }
        .lac-molten-gorget-sun {
            stroke: #FFFDF5;
            stroke-width: 1.6px;
            stroke-dasharray: 10 16;
            animation: lacMoltenRingRotateCCW 2.0s linear infinite;
        }

        /* Keyframes chuyển động tuần hoàn dòng kim loại nóng chảy */
        @keyframes lacMoltenStarFlow {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -170; }
        }
        @keyframes lacMoltenRayPulse {
            0% { stroke-dashoffset: 0; opacity: 0.75; }
            50% { stroke-dashoffset: 20; opacity: 1; filter: drop-shadow(0 0 10px #FF9100) drop-shadow(0 0 4px #FFF); }
            100% { stroke-dashoffset: 40; opacity: 0.75; }
        }
        @keyframes lacMoltenRingRotateCW {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -210; }
        }
        @keyframes lacMoltenRingRotateCCW {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: 210; }
        }
        @keyframes lacMoltenSpiralInward {
            0% { stroke-dashoffset: 60; }
            100% { stroke-dashoffset: 0; }
        }
        @keyframes lacMoltenSpiralOutward {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -60; }
        }
        @keyframes lacMoltenMeanderRun {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -228; }
        }

    
        /* ========================================================================= */
        /* HÀO QUANG ĐÔI CÁNH LỬA BÁN TRONG SUỐT (#blazing-aura-wings)               */
        /* Vươn rộng gấp 1.4 lần sải cánh thật, mix-blend-mode: screen               */
        /* ========================================================================= */
        #blazing-aura-wings {
            mix-blend-mode: screen;
            pointer-events: none;
            transform-origin: 580px 330px;
            opacity: 0.75;
            filter: drop-shadow(0 0 16px rgba(255, 107, 0, 0.85)) drop-shadow(0 0 32px rgba(255, 61, 0, 0.6));
            transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.35s ease, filter 0.35s ease;
        }

        .lac-aura-wings-idle {
            animation: lacAuraIdleSurge 3.6s ease-in-out infinite alternate;
        }

        @keyframes lacAuraIdleSurge {
            0% {
                transform: scale(1.0);
                opacity: 0.72;
                filter: drop-shadow(0 0 16px rgba(255, 107, 0, 0.85)) drop-shadow(0 0 30px rgba(255, 61, 0, 0.55));
            }
            50% {
                transform: scale(1.06);
                opacity: 0.88;
                filter: drop-shadow(0 0 24px rgba(255, 145, 0, 0.95)) drop-shadow(0 0 45px rgba(255, 61, 0, 0.8));
            }
            100% {
                transform: scale(1.0);
                opacity: 0.72;
                filter: drop-shadow(0 0 16px rgba(255, 107, 0, 0.85)) drop-shadow(0 0 30px rgba(255, 61, 0, 0.55));
            }
        }

        .lac-flame-feather-wave {
            animation: lacFlameWaveFlicker 2.4s ease-in-out infinite alternate;
            transform-origin: 520px 340px;
        }

        @keyframes lacFlameWaveFlicker {
            0% {
                opacity: 0.82;
                transform: scale(0.98) rotate(-0.5deg);
            }
            50% {
                opacity: 0.98;
                transform: scale(1.03) rotate(0.8deg);
            }
            100% {
                opacity: 0.85;
                transform: scale(1.0) rotate(-0.2deg);
            }
        }

    
        /* ========================================================================= */
        /* NÂNG CẤP BỘ ĐUÔI CHIM LẠC & VỆT ĐUÔI SAO CHỔI RỰC LỬA (COMET FIRE TRAIL)  */
        /* 4 dải lông đuôi dài uốn lượn như dải lụa lửa theo hàm sóng Math.sin(time) */
        /* ========================================================================= */
        .lac-anim-plume-1 {
            transform-origin: 445px 440px;
            animation: lacPlumeWave1 3.4s ease-in-out infinite;
        }
        .lac-anim-plume-2 {
            transform-origin: 445px 445px;
            animation: lacPlumeWave2 3.4s ease-in-out infinite 0.35s;
        }
        .lac-anim-plume-3 {
            transform-origin: 445px 450px;
            animation: lacPlumeWave3 3.4s ease-in-out infinite 0.70s;
        }
        .lac-anim-plume-4 {
            transform-origin: 445px 455px;
            animation: lacPlumeWave4 3.4s ease-in-out infinite 1.05s;
        }

        @keyframes lacPlumeWave1 {
            0%, 100% { transform: rotate(0deg) skewY(0deg); }
            50% { transform: rotate(4.2deg) skewY(2.2deg); }
        }
        @keyframes lacPlumeWave2 {
            0%, 100% { transform: rotate(0deg) skewY(0deg); }
            50% { transform: rotate(5.0deg) skewY(2.6deg); }
        }
        @keyframes lacPlumeWave3 {
            0%, 100% { transform: rotate(0deg) skewY(0deg); }
            50% { transform: rotate(5.6deg) skewY(3.0deg); }
        }
        @keyframes lacPlumeWave4 {
            0%, 100% { transform: rotate(0deg) skewY(0deg); }
            50% { transform: rotate(6.2deg) skewY(3.4deg); }
        }

        /* Hào quang mắt phụng đồng tâm nổi bật */
        .lac-ocellus-divine-highlight {
            filter: drop-shadow(0 0 10px #FFD700) drop-shadow(0 0 20px #FF5722);
            animation: lacOcellusPulseGlow 2.4s ease-in-out infinite alternate;
        }
        @keyframes lacOcellusPulseGlow {
            0% {
                filter: drop-shadow(0 0 8px #FFD700) drop-shadow(0 0 16px #FF5722);
            }
            50% {
                filter: drop-shadow(0 0 16px #FFF5D6) drop-shadow(0 0 28px #FF9100) drop-shadow(0 0 42px #FF3D00);
            }
            100% {
                filter: drop-shadow(0 0 8px #FFD700) drop-shadow(0 0 16px #FF5722);
            }
        }

        /* Vệt sao chổi plasma chạy tuần hoàn */
        .lac-comet-core-filament {
            stroke-dasharray: 22 28;
            animation: lacCometFilamentRun 1.8s linear infinite;
            filter: drop-shadow(0 0 8px #FFD700) drop-shadow(0 0 16px #FF5722);
        }
        @keyframes lacCometFilamentRun {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -200; }
        }

        .lac-comet-ribbon {
            animation: lacCometRibbonBreathe 2.8s ease-in-out infinite alternate;
        }
        @keyframes lacCometRibbonBreathe {
            0% { opacity: 0.82; transform: scale(1.0); }
            50% { opacity: 0.98; transform: scale(1.04); }
            100% { opacity: 0.82; transform: scale(1.0); }
        }

    
        /* ========================================================================= */
        /* VÒNG HÀO QUANG TRỐNG ĐỒNG ĐÔNG SƠN RỰC LỬA (#lac-dong-son-solar-halo)      */
        /* Xuất hiện khi Chim Hạc bay gần tâm màn hình (progress từ 0.35 đến 0.75)    */
        /* ========================================================================= */
        #lac-dong-son-solar-halo {
            transform-origin: 580px 360px;
            transform-box: view-box;
            pointer-events: none;
            mix-blend-mode: screen;
            transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
        }

        #lac-drum-rotating-disc {
            transform-origin: 580px 360px;
            transform-box: view-box;
            animation: lacDrumSpinClockwise 18s linear infinite;
        }
        @keyframes lacDrumSpinClockwise {
            0%   { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        #lac-halo-satellites-orbit {
            transform-origin: 580px 360px;
            transform-box: view-box;
            animation: lacSatellitesOrbitCCW 12s linear infinite;
        }
        @keyframes lacSatellitesOrbitCCW {
            0%   { transform: rotate(0deg); }
            100% { transform: rotate(-360deg); }
        }

        .lac-satellite-medallion {
            animation: lacMedallionPulse 2.4s ease-in-out infinite alternate;
        }
        @keyframes lacMedallionPulse {
            0%   { filter: drop-shadow(0 0 8px #FFD700) drop-shadow(0 0 16px #FF5722); }
            100% { filter: drop-shadow(0 0 16px #FFF5D6) drop-shadow(0 0 28px #FF9100) drop-shadow(0 0 45px #FF3D00); }
        }

    </style>
</head>
<body>

    <!-- ============================================================ -->
    <!--  HIỆU ỨNG CHUYỂN CẢNH CÁNH CHIM LẠC VÉN MÀN LỊCH SỬ           -->
    <!--  (Interactive SVG & Clip-Path Wipe Transition 100% HTML/CSS/JS) -->
    <!-- ============================================================ -->
    <div id="chim-lac-transition-layer" onclick="ketThucChuyenCanhChimLac(event)">
        <!-- Khung hiển thị tải sẵn giao diện trang-chinh.html nằm bên dưới lớp cắt -->
        <iframe id="chim-lac-preload-frame" src="trang-chinh.html?chuyen_canh=chim_lac" title="Sảnh Chính Trang Web"></iframe>

        <!-- Canvas dải lụa ánh sáng và hạt tàn lửa vàng kim bay lấp lánh -->
        <canvas id="chim-lac-particles-canvas"></canvas>

        <!-- Chim Lạc Đông Sơn Vector (SVG) sải rộng đôi cánh phát hào quang vàng kim -->
        <div id="chim-lac-bird-wrapper">
            <!-- CHIM LẠC PHÙ ĐIÊU ĐỒNG ĐÚC 3D (TỶ LỆ GIẢI PHẪU CHUẨN XÁC ĐÔNG SƠN) -->
            <svg id="lac-bird-master" viewBox="0 0 1200 800" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="overflow: visible;">
    <defs>
        <!-- ========================================================================= -->
        <!-- BỘ LỌC PHÙ ĐIÊU ĐỒNG ĐÚC 3D (3D Cast Bronze Relief Filter)                  -->
        <!-- Tái tạo chất cảm Vàng Đúc Cổ Đông Sơn chạm nổi, phản quang kim khí & bóng  -->
        <!-- ========================================================================= -->
        <filter id="bronze-relief-3d" x="-25%" y="-25%" width="150%" height="150%">
            <!-- 1. Làm mờ cạnh Alpha để tính toán pháp tuyến bề mặt (Surface Normal) -->
            <feGaussianBlur in="SourceAlpha" stdDeviation="3.2" result="blurMap"/>

            <!-- 2. Nguồn sáng điểm chiếu xiên góc tạo điểm sáng Specular kim khí 3D -->
            <feSpecularLighting in="blurMap" surfaceScale="5.5" specularConstant="1.35" specularExponent="24" lighting-color="#FFF5D6" result="specular3D">
                <fePointLight x="620" y="-180" z="460"/>
            </feSpecularLighting>

            <!-- 3. Giới hạn ánh sáng Specular vào khuôn hình của chim Lạc -->
            <feComposite in="specular3D" in2="SourceAlpha" operator="in" result="specularClipped"/>

            <!-- 4. Hòa trộn lớp ánh sáng nổi khối kim khí lên đồ họa màu gốc -->
            <feComposite in="SourceGraphic" in2="specularClipped" operator="arithmetic" k1="0" k2="1.0" k3="0.85" k4="0" result="reliefGraphic"/>

            <!-- 5. Đổ bóng kép tách lớp phù điêu với nền -->
            <feDropShadow dx="0" dy="7" stdDeviation="12" flood-color="#5C3A21" flood-opacity="0.75" result="dropShadowInner"/>
            <feDropShadow dx="0" dy="16" stdDeviation="26" flood-color="#2C1E18" flood-opacity="0.65" result="dropShadowOuter"/>
        </filter>

        <!-- ========================================================================= -->
        <!-- BỘ 5 GRADIENT TÁI TẠO CHẤT LIỆU VÀNG ĐÚC CỔ ĐÔNG SƠN CHẠM NỔI 3D          -->
        <!-- Đón sáng: #FFF5D6, #F7E08B | Thân chính: #D4AF37, #C59B27 | Rãnh: #5C3A21, #2C1E18 -->
        <!-- ========================================================================= -->

        <!-- 1. Gradient Thân chim & Cổ chữ S (Linear) -->
        <linearGradient id="bronzeBodyGrad" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#2C1E18"/>
            <stop offset="18%" stop-color="#5C3A21"/>
            <stop offset="42%" stop-color="#C59B27"/>
            <stop offset="68%" stop-color="#D4AF37"/>
            <stop offset="88%" stop-color="#F7E08B"/>
            <stop offset="100%" stop-color="#FFF5D6"/>
        </linearGradient>

        <!-- 2. Gradient Cánh chính đón sáng mạnh vươn dài (Linear) -->
        <linearGradient id="bronzeWingMainGrad" x1="15%" y1="100%" x2="85%" y2="0%">
            <stop offset="0%" stop-color="#2C1E18"/>
            <stop offset="22%" stop-color="#5C3A21"/>
            <stop offset="48%" stop-color="#C59B27"/>
            <stop offset="72%" stop-color="#D4AF37"/>
            <stop offset="90%" stop-color="#F7E08B"/>
            <stop offset="100%" stop-color="#FFF5D6"/>
        </linearGradient>

        <!-- 3. Gradient Cánh phụ sau lưng tạo độ sâu không gian 3D (Linear) -->
        <linearGradient id="bronzeWingSubGrad" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#2C1E18"/>
            <stop offset="35%" stop-color="#5C3A21"/>
            <stop offset="70%" stop-color="#C59B27"/>
            <stop offset="88%" stop-color="#D4AF37"/>
            <stop offset="100%" stop-color="#F7E08B"/>
        </linearGradient>

        <!-- 4. Gradient Bộ đuôi 3 tầng lông vũ uốn lượn (Linear) -->
        <linearGradient id="bronzeTailGrad" x1="10%" y1="15%" x2="90%" y2="85%">
            <stop offset="0%" stop-color="#FFF5D6"/>
            <stop offset="20%" stop-color="#F7E08B"/>
            <stop offset="50%" stop-color="#D4AF37"/>
            <stop offset="72%" stop-color="#C59B27"/>
            <stop offset="90%" stop-color="#5C3A21"/>
            <stop offset="100%" stop-color="#2C1E18"/>
        </linearGradient>

        <!-- 5. Gradient Phù điêu tròn Mắt thần & Núm đồng tâm (Radial) -->
        <radialGradient id="eyeDivineGlow" cx="45%" cy="40%" r="55%">
            <stop offset="0%" stop-color="#FFF5D6"/>
            <stop offset="28%" stop-color="#F7E08B"/>
            <stop offset="55%" stop-color="#D4AF37"/>
            <stop offset="78%" stop-color="#C59B27"/>
            <stop offset="92%" stop-color="#5C3A21"/>
            <stop offset="100%" stop-color="#2C1E18"/>
        </radialGradient>
        <!-- Gradient Con ngươi mắt thần rực sáng ánh lửa vàng Đông Sơn -->
        <radialGradient id="eyeFireGlow" cx="42%" cy="40%" r="58%">
            <stop offset="0%" stop-color="#FFFFFF"/>
            <stop offset="25%" stop-color="#FFF5D6"/>
            <stop offset="50%" stop-color="#FFD700"/>
            <stop offset="75%" stop-color="#FF8C00"/>
            <stop offset="90%" stop-color="#5C3A21"/>
            <stop offset="100%" stop-color="#2C1E18"/>
        </radialGradient>
    
        <!-- ========================================================================= -->
        <!-- BỘ LỌC NGỌN LỬA THIÊNG RUNG RINH BẬP BÙNG THEO THỜI GIAN THỰC              -->
        <!-- Sử dụng feTurbulence và feDisplacementMap tạo chuyển động sóng lửa hữu cơ   -->
        <!-- ========================================================================= -->
        <filter id="sacred-fire-flicker" x="-50%" y="-50%" width="200%" height="200%">
            <!-- 1. Tạo bản đồ nhiễu động dạng fractal biến thiên theo thời gian -->
            <feTurbulence id="fire-turbulence" type="fractalNoise" baseFrequency="0.045 0.09" numOctaves="3" result="fireNoise">
                <animate attributeName="baseFrequency" dur="1.8s" 
                         values="0.035 0.07; 0.055 0.12; 0.04 0.085; 0.06 0.14; 0.035 0.07" 
                         repeatCount="indefinite"/>
            </feTurbulence>

            <!-- 2. Biến dạng hình học các lưỡi lửa theo bản đồ nhiễu động -->
            <feDisplacementMap in="SourceGraphic" in2="fireNoise" scale="9.5" 
                               xChannelSelector="R" yChannelSelector="G" result="displacedFire"/>

            <!-- 3. Khuếch tán quầng hào quang rực lửa xung quanh ngọn lửa -->
            <feGaussianBlur in="displacedFire" stdDeviation="2.2" result="flameGlow"/>
            <feMerge>
                <feMergeNode in="flameGlow"/>
                <feMergeNode in="displacedFire"/>
            </feMerge>
        </filter>

        <!-- Dải màu chuyển sắc Ngọn Lửa Thiêng Phương Đông (Sacred Fire Gradient) -->
        <!-- Trắng Kim (#FFFDF5) -> Vàng Rực (#FFD700) -> Cam Đỏ Lửa (#FF5722) -> Đỏ Thẫm (#7B1E1E) -->
        <linearGradient id="sacredFireGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFFDF5"/>
            <stop offset="26%" stop-color="#FFD700"/>
            <stop offset="65%" stop-color="#FF5722"/>
            <stop offset="100%" stop-color="#7B1E1E"/>
        </linearGradient>

    
        <!-- Dải màu Kim Loại Nóng Chảy Đông Sơn (Molten Bronze & Fire Flow Gradients) -->
        <linearGradient id="moltenFireStreamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFFDF5"/>
            <stop offset="25%" stop-color="#FFE57F"/>
            <stop offset="55%" stop-color="#FF9100"/>
            <stop offset="85%" stop-color="#FF5722"/>
            <stop offset="100%" stop-color="#D82600"/>
        </linearGradient>

        <linearGradient id="moltenGoldCoreGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#FF5722"/>
            <stop offset="40%" stop-color="#FFF5D6"/>
            <stop offset="70%" stop-color="#FFD700"/>
            <stop offset="100%" stop-color="#FF3D00"/>
        </linearGradient>

        <radialGradient id="moltenCorePulseGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#FFFFFF"/>
            <stop offset="45%" stop-color="#FFF5D6"/>
