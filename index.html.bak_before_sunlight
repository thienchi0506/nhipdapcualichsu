        </script>

    <!-- ========================================================================= -->
    <!-- HIỆU ỨNG THỊ GIÁC: CON TRỎ CHUỘT 'ĐỐM LỬA LỊCH SỬ' (GOLDEN EMBER CURSOR) -->
    <!-- ========================================================================= -->
    <script>
    (function khoiTaoDomLuaLichSu() {
        var canvas = document.createElement('canvas');
        canvas.id = 'golden-ember-canvas';
        canvas.style.position = 'fixed';
        canvas.style.top = '0';
        canvas.style.left = '0';
        canvas.style.width = '100vw';
        canvas.style.height = '100vh';
        canvas.style.pointerEvents = 'none';
        canvas.style.zIndex = '999999';
        document.body.appendChild(canvas);

        var ctx = canvas.getContext('2d');
        var width = canvas.width = window.innerWidth;
        var height = canvas.height = window.innerHeight;

        window.addEventListener('resize', function() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        var particles = [];
        var emberColors = [
            { r: 255, g: 215, b: 0 },    // Vàng kim nguyên chất
            { r: 245, g: 180, b: 35 },   // Vàng đồng Đông Sơn
            { r: 255, g: 140, b: 20 },   // Cam lửa thiêng
            { r: 220, g: 50, b: 20 },    // Đỏ son hào khí
            { r: 255, g: 245, b: 180 }   // Ánh sáng lõi tàn lửa
        ];

        var lastMouseX = null;
        var lastMouseY = null;

        function taoHatDomLua(x, y, count) {
            for (var i = 0; i < count; i++) {
                var c = emberColors[Math.floor(Math.random() * emberColors.length)];
                var angle = Math.random() * Math.PI * 2;
                var speed = Math.random() * 1.6 + 0.3;
                var size = Math.random() * 3.2 + 1.2;
                particles.push({
                    x: x + (Math.random() - 0.5) * 8,
                    y: y + (Math.random() - 0.5) * 8,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - (Math.random() * 0.7 + 0.3),
                    size: size,
                    color: c,
                    alpha: Math.random() * 0.45 + 0.55,
                    decay: Math.random() * 0.02 + 0.015,
                    rotation: Math.random() * Math.PI,
                    rotSpeed: (Math.random() - 0.5) * 0.1
                });
            }
        }

        window.addEventListener('mousemove', function(e) {
            var x = e.clientX;
            var y = e.clientY;
            var count = 3;
            if (lastMouseX !== null && lastMouseY !== null) {
                var dist = Math.hypot(x - lastMouseX, y - lastMouseY);
                count = Math.min(6, Math.max(2, Math.floor(dist / 8)));
            }
            taoHatDomLua(x, y, count);
            lastMouseX = x;
            lastMouseY = y;
        });

        window.addEventListener('touchmove', function(e) {
            if (e.touches && e.touches[0]) {
                taoHatDomLua(e.touches[0].clientX, e.touches[0].clientY, 3);
            }
        }, { passive: true });

        function animate() {
            ctx.clearRect(0, 0, width, height);

            if (particles.length > 0) {
                for (var i = particles.length - 1; i >= 0; i--) {
                    var p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy -= 0.015;
                    p.vx += (Math.random() - 0.5) * 0.04;
                    p.alpha -= p.decay;
                    p.size *= 0.985;
                    p.rotation += p.rotSpeed;

                    if (p.alpha <= 0 || p.size <= 0.3) {
                        particles.splice(i, 1);
                        continue;
                    }

                    ctx.save();
                    ctx.globalAlpha = p.alpha;
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rotation);

                    var grad = ctx.createRadialGradient(0, 0, 0, 0, 0, p.size * 2.2);
                    grad.addColorStop(0, 'rgba(' + p.color.r + ',' + p.color.g + ',' + p.color.b + ',1)');
                    grad.addColorStop(0.5, 'rgba(' + p.color.r + ',' + p.color.g + ',' + p.color.b + ',0.4)');
                    grad.addColorStop(1, 'rgba(' + p.color.r + ',' + p.color.g + ',' + p.color.b + ',0)');

                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(0, 0, p.size * 2.2, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = 'rgba(255, 255, 245, 0.95)';
                    ctx.beginPath();
                    ctx.arc(0, 0, p.size * 0.55, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.restore();
                }
            }

            requestAnimationFrame(animate);
        }

        requestAnimationFrame(animate);
    })();
    
    // =========================================================================
    // HOẠT HÓA NGỌN LỬA THIÊNG RUNG RINH BẬP BÙNG THEO THỜI GIAN THỰC (REAL-TIME TURBULENCE FLICKER)
    // Kết hợp feTurbulence và feDisplacementMap tạo hiệu ứng ngọn lửa mây sống động
    // =========================================================================
    (function initSacredFireAnimation() {
        var fireTurb = document.getElementById('fire-turbulence');
        if (!fireTurb) return;
        var start = performance.now();
        function updateFire(now) {
            var t = (now - start) * 0.0035;
            // Biến thiên tần số baseFrequency đa chiều tạo chuyển động mây lửa bập bùng
            var fx = 0.045 + Math.sin(t * 1.7) * 0.012 + Math.cos(t * 2.9) * 0.008;
            var fy = 0.095 + Math.cos(t * 2.1) * 0.025 + Math.sin(t * 4.3) * 0.015;
            fireTurb.setAttribute('baseFrequency', fx.toFixed(4) + ' ' + fy.toFixed(4));
            requestAnimationFrame(updateFire);
        }
        requestAnimationFrame(updateFire);
    })();


    // =========================================================================
    // HOẠT HÓA 4 DẢI LÔNG ĐUÔI UỐN LƯỢN MỀM MẠI NHƯ DẢI LỤA LỬA THEO HÀM SÓNG Math.sin(time)
    // =========================================================================
    (function initTailSinusoidalWave() {
        var p1 = document.getElementById('lac-tail-major-plume-1');
        var p2 = document.getElementById('lac-tail-major-plume-2');
        var p3 = document.getElementById('lac-tail-major-plume-3');
        var p4 = document.getElementById('lac-tail-major-plume-4');
        if (!p1 || !p2 || !p3 || !p4) return;
        var start = performance.now();
        function updateTailWaves(now) {
            var t = (now - start) * 0.0022;
            p1.style.transform = 'rotate(' + (Math.sin(t + 0.0) * 4.2).toFixed(2) + 'deg) skewY(' + (Math.sin(t + 0.4) * 2.2).toFixed(2) + 'deg)';
            p2.style.transform = 'rotate(' + (Math.sin(t + 0.8) * 4.9).toFixed(2) + 'deg) skewY(' + (Math.sin(t + 1.2) * 2.6).toFixed(2) + 'deg)';
            p3.style.transform = 'rotate(' + (Math.sin(t + 1.6) * 5.5).toFixed(2) + 'deg) skewY(' + (Math.sin(t + 2.0) * 3.0).toFixed(2) + 'deg)';
            p4.style.transform = 'rotate(' + (Math.sin(t + 2.4) * 6.2).toFixed(2) + 'deg) skewY(' + (Math.sin(t + 2.8) * 3.4).toFixed(2) + 'deg)';
            requestAnimationFrame(updateTailWaves);
        }
        requestAnimationFrame(updateTailWaves);
    })();

</script>

