<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Thao Trường Khảo Thí - Rèn Luyện Tư Duy Lịch Sử</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--paper:#F4ECD8;--red:#7B1E1E;--red-dark:#541212;--gold:#D4AF37;--gold-light:#F7E8B5;--ink:#2C1E18;--card:#FFFDF8;--green:#2E6F40;--wrong:#B71C1C}*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Noto Serif','Times New Roman',serif;background-color:var(--paper);background-image:radial-gradient(#d4af3724 1px,transparent 0);background-size:24px 24px;color:var(--ink);line-height:1.6;min-height:100vh;display:flex;flex-direction:column}.header{position:sticky;top:0;z-index:5;padding:15px 20px;background:linear-gradient(135deg,var(--red-dark),var(--red));border-bottom:4px double var(--gold);color:var(--gold-light);box-shadow:0 4px 12px #2c1e1855}.header-inner{max-width:1000px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.home{padding:7px 13px;color:var(--gold-light);text-decoration:none;border:1px solid var(--gold);border-radius:6px}.header h1{font-size:clamp(18px,3vw,25px);text-align:center;color:var(--gold)}.commander{font-size:14px;padding:5px 11px;border:1px solid var(--gold);border-radius:18px}main{max-width:900px;width:100%;margin:auto;padding:30px 16px 48px;flex:1}.screen{display:none;animation:fade .25s ease}.screen.active{display:block}@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.panel{position:relative;padding:28px 22px;background:var(--card);border:2px solid var(--gold);border-radius:10px;box-shadow:0 8px 24px #2c1e181f;overflow:hidden}.panel:before{content:'';position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,var(--red),var(--gold),var(--red))}.intro{text-align:center;margin-bottom:25px}.intro h2{font-size:26px;color:var(--red)}.intro p{color:#5a463c}.group{margin-bottom:22px}.label{display:block;margin-bottom:10px;padding-left:10px;border-left:4px solid var(--gold);color:var(--red);font-weight:bold}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.grid.three{grid-template-columns:repeat(3,1fr)}.choice{padding:12px 8px;border:2px solid #cbbba0;border-radius:7px;background:#efe6d0;color:var(--ink);font:inherit;font-size:14px;font-weight:bold;cursor:pointer}.choice small{display:block;font-weight:normal;font-size:11px}.choice.selected{background:var(--red);color:var(--gold-light);border-color:var(--gold)}.start,.submit,.action{padding:11px 18px;border:1px solid var(--gold);border-radius:7px;background:var(--red);color:var(--gold-light);font:inherit;font-weight:bold;cursor:pointer}.start{width:100%;padding:14px;margin-top:5px;font-size:17px;text-transform:uppercase}.status{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 15px;margin-bottom:18px;background:var(--ink);border:2px solid var(--gold);border-radius:8px;color:var(--gold-light)}.timer{font-size:19px;color:var(--gold);font-weight:bold}.timer.warning{color:white;background:var(--wrong);padding:2px 9px;border-radius:5px;animation:pulse .8s infinite alternate}@keyframes pulse{to{transform:scale(1.05)}}.dots{display:flex;justify-content:center;flex-wrap:wrap;gap:7px;margin-bottom:16px}.dot{width:32px;height:32px;border:1px solid #b8a68e;border-radius:50%;background:var(--card);color:var(--ink);font-weight:bold;cursor:pointer}.dot.answered{background:var(--gold)}.dot.current{background:var(--red);color:var(--gold-light);border-color:var(--gold)}.meta{color:var(--red);font-size:13px;font-weight:bold;margin-bottom:8px;text-transform:uppercase}.question{font-size:18px;font-weight:bold;margin-bottom:18px}.options{display:grid;gap:10px;margin-bottom:20px}.option{display:flex;align-items:flex-start;gap:12px;padding:12px;border:2px solid #d5c5a1;border-radius:8px;background:#faf4e6;color:var(--ink);text-align:left;font:inherit;cursor:pointer}.option.selected{border-color:var(--red);background:#fdf0e6;font-weight:bold}.letter{flex:none;width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:#e2d5b5;font-weight:bold}.option.selected .letter{background:var(--red);color:var(--gold-light)}.nav{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding-top:14px;border-top:1px dashed #d5c5a1}.nav button{padding:9px 13px;border:1px solid #b8a68e;border-radius:6px;font:inherit;font-weight:bold;cursor:pointer;background:#e8dec5;color:var(--ink)}.nav button:disabled{opacity:.45;cursor:not-allowed}.submit{background:var(--red)}.result{text-align:center;padding:20px 10px;background:#d4af371c;border:1px solid var(--gold);border-radius:8px}.score{width:115px;height:115px;display:grid;align-content:center;margin:0 auto 12px;border:4px double var(--gold);border-radius:50%;background:var(--red);color:var(--gold)}.score strong{font-size:30px}.result h2{color:var(--red)}.stats{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin:12px}.stats span{padding:5px 12px;background:var(--card);border:1px solid #cbbba0;border-radius:18px;font-weight:bold;font-size:14px}.review-title{margin:20px 0 12px;color:var(--red);border-bottom:2px solid var(--gold)}.review{padding:14px;margin:12px 0;background:var(--card);border:1px solid #d5c5a1;border-left:5px solid var(--wrong);border-radius:7px}.review.correct{border-left-color:var(--green)}.review p{margin:8px 0}.review-answer{color:var(--green);font-weight:bold}.review-wrong{color:var(--wrong);text-decoration:line-through}.advice{padding:10px;background:#fff9e6;border:1px solid var(--gold);border-radius:6px}.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:20px}.action.secondary{background:#e8dec5;color:var(--ink);text-decoration:none}.footer{padding:16px;text-align:center;background:var(--ink);color:var(--gold);border-top:3px solid var(--gold);font-size:14px}@media(max-width:650px){.grid,.grid.three{grid-template-columns:1fr 1fr}.header-inner{justify-content:center}.header h1{order:-1;width:100%}.panel{padding:24px 14px}.nav{flex-direction:column}.nav button{width:100%}}
</style></head>
<body>
<header class="header"><div class="header-inner"><a class="home" href="trang-chinh.html">⬅ Về Sảnh Chính</a><h1>⚔️ Thao Trường Khảo Thí</h1><div class="commander" id="commander">🎖️ Tướng quân: Khách</div></div></header>
<main>
<section class="screen active" id="setup"><div class="panel"><div class="intro"><h2>Thiết Lập Trận Đồ Khảo Thí</h2><p>Chọn khối lớp, mức độ tư duy và thời gian làm bài</p></div>
<div class="group"><label class="label">1. Chọn Khối Lớp</label><div class="grid" id="grade-select"><button class="choice selected" data-value="all">Tổng Hợp<small>Khối 10, 11, 12</small></button><button class="choice" data-value="10">Khối 10</button><button class="choice" data-value="11">Khối 11</button><button class="choice" data-value="12">Khối 12</button></div></div>
<div class="group"><label class="label">2. Chọn Mức Độ Tư Duy</label><div class="grid" id="level-select"><button class="choice selected" data-value="all">Toàn Diện<small>Tất cả mức độ</small></button><button class="choice" data-value="Nhận biết cơ bản">Nhận Biết</button><button class="choice" data-value="Thông hiểu">Thông Hiểu</button><button class="choice" data-value="Tư duy phản biện">Phản Biện</button></div></div>
<div class="group"><label class="label">3. Thời Gian Làm Bài</label><div class="grid three" id="time-select"><button class="choice selected" data-value="300">05:00 phút</button><button class="choice" data-value="180">03:00 phút</button><button class="choice" data-value="55">00:55 giây<small>Thử thách</small></button></div></div><button class="start" id="start">🥁 Bắt Đầu Khảo Thí</button></div></section>
<section class="screen" id="quiz"><div class="status"><div><span id="progress">Câu 1 / 9</span> · <span id="filter-label"></span></div><div class="timer" id="timer">05:00</div></div><div class="dots" id="dots"></div><div class="panel"><div class="meta" id="meta"></div><div class="question" id="question"></div><div class="options" id="options"></div><div class="nav"><button id="prev">⬅ Câu trước</button><button id="next">Câu tiếp theo ➔</button><button class="submit" id="submit">📜 Nộp bài</button></div></div></section>
<section class="screen" id="result"><div class="panel"><div class="result"><div class="score"><strong id="score">0.0</strong><small>Thang điểm 10</small></div><h2 id="rank"></h2><div class="stats"><span id="correct"></span><span id="elapsed"></span><span id="bonus"></span></div><p id="comment"></p></div><h2 class="review-title">🔍 Phân Tích & Lời Khuyên</h2><div id="reviews"></div><div class="actions"><button class="action" id="again">🔄 Luyện tập lại</button><a href="trang-chinh.html" class="action secondary">⬅ Về Sảnh Chính</a></div></div></section>
</main><footer class="footer"><strong>Thao Trường Khảo Thí - Dự Án Nghiên Cứu Khoa Học Kỹ Thuật Cấp THPT</strong><br>Rèn luyện tư duy lịch sử và đúc kết bài học kiến tạo hòa bình</footer>
<script>
const questionBank=[
{grade:10,level:'Nhận biết cơ bản',question:'Biểu tượng tiêu biểu nhất cho trình độ kỹ thuật đúc đồng và đời sống tâm linh của cư dân Văn Lang – Âu Lạc là gì?',options:['Trống đồng Đông Sơn','Phù điêu Chăm-pa','Đồng tiền La Mã','Tháp gốm thời Lý'],answer:0,explanation:'Trống đồng Đông Sơn thể hiện kỹ thuật luyện kim và đời sống cộng đồng của cư dân Việt cổ.'},
{grade:10,level:'Thông hiểu',question:'Vì sao các nền văn minh cổ đại phương Đông hình thành dọc theo những dòng sông lớn?',options:['Có nhiều mỏ vàng','Đất phù sa, nguồn nước thuận lợi cho nông nghiệp và trị thủy','Núi cao cách biệt','Chỉ sống bằng nghề biển'],answer:1,explanation:'Sông lớn cung cấp nước, phù sa và thúc đẩy cộng đồng hợp tác làm thủy lợi.'},
{grade:10,level:'Tư duy phản biện',question:'Học lịch sử có vai trò gì với người trẻ trong kỷ nguyên AI?',options:['Không còn cần thiết','Chỉ dành cho nhà khảo cổ','Giữ bản sắc, kiểm chứng thông tin và định hướng công nghệ nhân văn','Chỉ để nhớ ngày tháng'],answer:2,explanation:'Tư duy sử học giúp kiểm chứng nguồn tin và hiểu cội nguồn trong môi trường số.'},
{grade:11,level:'Nhận biết cơ bản',question:'Quốc gia Đông Nam Á nào giữ được nền độc lập tương đối trước làn sóng thực dân phương Tây?',options:['Miến Điện','Xiêm (Thái Lan)','Phi-líp-pin','Mã Lai'],answer:1,explanation:'Xiêm tiến hành cải cách và ngoại giao linh hoạt, giữ được độc lập tương đối.'},
{grade:11,level:'Thông hiểu',question:'Cải cách hành chính của vua Minh Mạng có ý nghĩa quan trọng nào?',options:['Xóa bỏ chế độ quân chủ','Tạo ra các vùng cát cứ','Thống nhất hành chính, tăng cường tập quyền và đặt nền móng cấp tỉnh','Thay chữ Hán bằng chữ Quốc ngữ'],answer:2,explanation:'Cải cách thống nhất quản trị từ trung ương đến địa phương trên cả nước.'},
{grade:11,level:'Tư duy phản biện',question:'Vì sao sau khi đánh bại quân xâm lược, các triều đại Đại Việt chủ động nghị hòa?',options:['Không thể tiếp tục chiến đấu','Lo ngại phương Tây','Để chấm dứt chiến tranh, bảo toàn sinh mạng và giữ hòa khí bang giao','Đổi đất lấy vàng'],answer:2,explanation:'Mở đường nghị hòa thể hiện tầm nhìn chiến lược và tinh thần nhân đạo.'},
{grade:12,level:'Nhận biết cơ bản',question:'Sự kiện nào tháng 7/1995 đánh dấu bước ngoặt hội nhập khu vực của Việt Nam?',options:['Gia nhập ASEAN','Ký Hiệp định Giơ-ne-vơ','Thông qua UNCLOS','Thành lập AEC'],answer:0,explanation:'Việt Nam chính thức gia nhập ASEAN ngày 28/7/1995.'},
{grade:12,level:'Thông hiểu',question:'Thời điểm thể hiện rõ nghệ thuật chớp thời cơ trong Cách mạng tháng Tám năm 1945 là khi nào?',options:['Chiến tranh thế giới thứ hai bùng nổ','Nhật đảo chính Pháp','Nhật đầu hàng Đồng minh, trước khi quân Đồng minh vào Đông Dương','Sau khi quân Đồng minh đã vào'],answer:2,explanation:'Thời cơ xuất hiện khi Nhật đầu hàng, chính quyền tay sai hoang mang, còn quân Đồng minh chưa vào.'},
{grade:12,level:'Tư duy phản biện',question:'Ngoại giao “Cây tre Việt Nam” phản ánh bài học lịch sử cốt lõi nào?',options:['Khép kín biên giới','Kiên định độc lập và lợi ích quốc gia, linh hoạt trong sách lược','Chỉ quan hệ với cường quốc','Thay đổi mục tiêu độc lập'],answer:1,explanation:'Kiên định nguyên tắc, linh hoạt trong ứng xử giúp bảo vệ lợi ích quốc gia và hòa bình.'}
];
let grade='all',level='all',timeLimit=300,questions=[],answers=[],index=0,remaining=0,elapsed=0,timerId=null;
const $=id=>document.getElementById(id);function choose(group,callback){$(group).addEventListener('click',event=>{const button=event.target.closest('.choice');if(!button)return;$(group).querySelectorAll('.choice').forEach(item=>item.classList.toggle('selected',item===button));callback(button.dataset.value)})}
choose('grade-select',value=>grade=value);choose('level-select',value=>level=value);choose('time-select',value=>timeLimit=Number(value));const savedName=localStorage.getItem('dcls_playerName')||localStorage.getItem('tenNguoiDung');if(savedName) $('commander').textContent='🎖️ Tướng quân: '+savedName;
function screen(id){document.querySelectorAll('.screen').forEach(item=>item.classList.toggle('active',item.id===id));window.scrollTo({top:0,behavior:'smooth'})}
function startQuiz(){questions=questionBank.filter(item=>(grade==='all'||String(item.grade)===grade)&&(level==='all'||item.level===level));if(!questions.length){alert('Không tìm thấy câu hỏi phù hợp.');return}answers=Array(questions.length).fill(null);index=0;remaining=timeLimit;elapsed=0;$('filter-label').textContent=`${grade==='all'?'Tổng hợp 3 khối':'Khối '+grade} · ${level==='all'?'Đa cấp độ':level}`;screen('quiz');renderQuestion();updateTimer();clearInterval(timerId);timerId=setInterval(()=>{remaining--;elapsed++;updateTimer();if(remaining<=0){clearInterval(timerId);finishQuiz()}},1000)}
function updateTimer(){const min=Math.floor(remaining/60),sec=remaining%60;$('timer').textContent=String(min).padStart(2,'0')+':'+String(sec).padStart(2,'0');$('timer').classList.toggle('warning',remaining<60)}
function renderQuestion(){const item=questions[index];$('progress').textContent=`Câu ${index+1} / ${questions.length}`;$('meta').textContent=`Khối ${item.grade} · ${item.level}`;$('question').textContent=`Câu ${index+1}: ${item.question}`;$('dots').replaceChildren(...questions.map((_,i)=>{const button=document.createElement('button');button.className='dot'+(answers[i]!==null?' answered':'')+(i===index?' current':'');button.textContent=i+1;button.onclick=()=>{index=i;renderQuestion()};return button}));const letters=['A','B','C','D'];$('options').replaceChildren(...item.options.map((text,i)=>{const button=document.createElement('button');button.className='option'+(answers[index]===i?' selected':'');button.innerHTML=`<span class="letter">${letters[i]}</span><span></span>`;button.querySelector('span:last-child').textContent=text;button.onclick=()=>{answers[index]=i;renderQuestion()};return button}));$('prev').disabled=index===0;$('next').disabled=index===questions.length-1}
$('start').onclick=startQuiz;$('prev').onclick=()=>{if(index>0){index--;renderQuestion()}};$('next').onclick=()=>{if(index<questions.length-1){index++;renderQuestion()}};$('submit').onclick=()=>{const unanswered=answers.filter(value=>value===null).length;if(unanswered&&!confirm(`Còn ${unanswered} câu chưa trả lời. Vẫn nộp bài?`))return;finishQuiz()};
function finishQuiz(){clearInterval(timerId);const correctCount=questions.reduce((sum,item,i)=>sum+(answers[i]===item.answer?1:0),0),score=(correctCount/questions.length*10).toFixed(1),bonus=correctCount*20,peace=parseInt(localStorage.getItem('dcls_peaceScore')||'1000',10);$('score').textContent=score;$('correct').textContent=`✅ Đúng: ${correctCount}/${questions.length} câu`;$('elapsed').textContent=`⏱️ ${Math.floor(elapsed/60)} phút ${elapsed%60} giây`;$('bonus').textContent=`🕊️ +${bonus} Điểm Thái Bình`;localStorage.setItem('dcls_peaceScore',String(peace+bonus));const numeric=Number(score);$('rank').textContent=numeric>=8.5?'🏆 Bậc Đại Tướng Thông Tuệ':numeric>=6.5?'⚔️ Chiến Lược Gia Bản Lĩnh':'📜 Tân Binh Cần Rèn Luyện';$('comment').textContent=numeric>=8.5?'Xuất sắc! Ngài nắm vững sự kiện và tư duy lịch sử.':numeric>=6.5?'Khá lắm! Hãy xem lại những câu còn nhầm lẫn.':'Hãy ghé Tàng Thư Các củng cố kiến thức rồi thử lại nhé.';$('reviews').replaceChildren(...questions.map((item,i)=>{const right=answers[i]===item.answer,card=document.createElement('article');card.className='review'+(right?' correct':'');const answer=answers[i]===null?'Chưa trả lời':item.options[answers[i]];card.innerHTML=`<strong>Câu ${i+1} · Khối ${item.grade} · ${right?'✔ Chính xác':answers[i]===null?'⚠ Chưa trả lời':'✖ Chưa chính xác'}</strong><p>${item.question}</p><p class="${right?'review-answer':'review-wrong'}">Lựa chọn của bạn: ${answer}</p><p class="review-answer">Đáp án đúng: ${item.options[item.answer]}</p><div class="advice">💡 ${item.explanation}</div>`;return card}));screen('result')}
$('again').onclick=()=>{clearInterval(timerId);screen('setup')};
</script></body></html>
